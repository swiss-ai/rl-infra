# Site / user settings for rl-infra. Copy to site.env (gitignored) and edit.
# Sourced by setup.sh and the backend launchers. Every value is a default only:
# an environment variable of the same name set at launch time wins.

# Slurm
: "${ACCOUNT:=your_account}"
: "${DEFAULT_PARTITION:=normal}"
# Comma-separated nodes to keep out of every job; set EXCLUDE_NODES= at launch for none.
: "${EXCLUDE_NODES=}"

# Scratch filesystem: job outputs (Slurm/Ray logs, checkpoints, metrics) and caches.
: "${SCRATCH:=/iopsstor/scratch/cscs/$USER}"
: "${OUT:=${SCRATCH}/nemo-rl}"

# NeMo-RL source clone, mounted over /opt/nemo-rl in the container (setup.sh creates it).
: "${NEMO_RL_DIR:=$HOME/projects/nemo-rl}"

# Container image: a persistent master copy and the working copy jobs read. Scratch is
# purged, so the launcher re-stages the working copy from the master when it is missing.
: "${IMAGE_MASTER:=/capstor/store/cscs/swissai/infra01/MLLM/containers/nvcr.io#nvidia+nemo-rl+v0.7.0.aarch64.sqsh}"
: "${IMAGE_WORK:=${SCRATCH}/container-images/nemo-rl-v0.7.0.sqsh}"

# Name of the installed EDF (~/.edf/<name>.toml, written by setup.sh).
: "${EDF_NAME:=nemo-rl}"
