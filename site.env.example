# Personal settings for rl-infra. Copy to site.env (gitignored) and edit, or leave it out:
# everything has a default in sites/<SITE>.env (the cluster profile) and the stack env files.
# A variable set here wins over those; an environment variable set at launch wins over this.
# See sites/load.sh for the full order.

# Cluster profile; detected from the filesystems when unset (alps, hangang).
# : "${SITE:=hangang}"

# Slurm
# : "${ACCOUNT:=your_account}"
# : "${DEFAULT_PARTITION:=normal}"
# : "${EXCLUDE_NODES=node0001,node0002}"

# Where jobs write (logs, checkpoints, metrics, caches) and where the source clones live.
# : "${SCRATCH:=/path/to/scratch/$USER}"
# : "${PROJECTS_DIR:=$HOME/projects}"

# Weights & Biases for every run (named after the run); the API key goes in ~/.wandb_api_key
# (chmod 600), or the file named by WANDB_KEY_FILE.
# : "${WANDB_PROJECT:=chonk-rl}"
# : "${WANDB_ENTITY:=your_team}"

# Lean task with a Kimina Lean Server (backends/nemo-rl/lean-kimina): a Lean toolchain and a Lake project with
# Mathlib compiled for it, both at the pin's REPL_TAG (v4.34.0). Only read.
# : "${LEAN_TOOLCHAIN:=$HOME/.elan/toolchains/leanprover--lean4---v4.34.0}"
# : "${LEAN_PROJECT:=/path/to/a/lake/project/with/mathlib}"
