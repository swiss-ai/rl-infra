From 81ec73b58a3a85ace342f801385954613be079de Mon Sep 17 00:00:00 2001
From: davmels <davmelous@gmail.com>
Date: Sat, 14 Nov 2026 08:52:44 +0900
Subject: [PATCH 61/61] ScienceWorld: mark episodes the simulator lost with
 mask_sample

Rollouts that read mask_sample from the environment metadata (branch apertus2-openqa) give such episodes
zero weight; elsewhere the key is ignored.

---
 nemo_rl/environments/scienceworld_environment.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/nemo_rl/environments/scienceworld_environment.py b/nemo_rl/environments/scienceworld_environment.py
index afada05ef..ed8c11360 100644
--- a/nemo_rl/environments/scienceworld_environment.py
+++ b/nemo_rl/environments/scienceworld_environment.py
@@ -649,6 +649,9 @@ class ScienceWorldEnvironment(EnvironmentInterface[ScienceWorldMetadata]):
                     **meta,
                     "episode": episode,
                     "frame_metrics": self._metrics(meta["sciworld"], episode),
+                    # An episode the simulator lost is not the model's doing: GRPO gives
+                    # it zero weight where the rollout reads mask_sample (apertus2-openqa).
+                    "mask_sample": end == "env_error",
                 }
             )
 
