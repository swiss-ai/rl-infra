From ca1b3ff25012efc3cb4120192b5704411c192596 Mon Sep 17 00:00:00 2001
From: Ramon Kaspar <ramonkaspar@gmail.com>
Date: Wed, 25 Nov 2026 14:36:10 +0100
Subject: [PATCH 72/72] NeMo Gym: env.nemo_gym.env_vars sets the environment of
 the Gym actor and its servers

Gym finds servers outside its checkout only through NEMO_GYM_EXTRA_ROOTS, and a server
requirements.txt can read an environment variable (for example the path of the Gym checkout).
A task file could not set either: the job environment is the same for every task. Now
env.nemo_gym.env_vars goes into the environment of each Gym actor before Gym starts, and the
servers inherit it as subprocesses. The key leaves Gym global config, like the other keys
of NeMo-RL.
---
 nemo_rl/environments/nemo_gym.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/nemo_rl/environments/nemo_gym.py b/nemo_rl/environments/nemo_gym.py
index 991477dfa..c7a0e5f47 100644
--- a/nemo_rl/environments/nemo_gym.py
+++ b/nemo_rl/environments/nemo_gym.py
@@ -343,6 +343,9 @@ class NemoGymConfig(TypedDict):
     # absent (the default) for environments where an empty rollout is a genuine
     # bug worth surfacing loudly.
     mask_degenerate_rollouts: NotRequired[bool]
+    # Environment variables of the Gym actor, which its servers inherit: for example NEMO_GYM_EXTRA_ROOTS for
+    # servers outside the Gym checkout, or a variable that a server's requirements.txt reads.
+    env_vars: NotRequired[Dict[str, str]]
 
 
 # Gym control-plane server name (the model server hosting the ledger) and the
@@ -591,6 +594,8 @@ class NemoGym(EnvironmentInterface):
         scheduled onto reserved nodes) and spun up explicitly once the vLLM
         server URLs are available, overlapping with vLLM model loading.
         """
+        # Before Gym starts: its servers are subprocesses, which inherit this environment.
+        os.environ.update(self.cfg.get("env_vars") or {})
         self.node_ip = _get_node_ip_local()
         _gym_port_low = self.cfg.get("port_range_low", DEFAULT_GYM_PORT_RANGE_LOW)
         _gym_port_high = self.cfg.get("port_range_high", DEFAULT_GYM_PORT_RANGE_HIGH)
@@ -1624,6 +1629,8 @@ def _build_gym_actor_config(
     mask_degenerate_rollouts = nemo_gym_dict.pop("mask_degenerate_rollouts", None)
     if mask_degenerate_rollouts is not None:
         masking_flags["mask_degenerate_rollouts"] = bool(mask_degenerate_rollouts)
+    # Set in the actor's environment at spinup, not part of Gym's global config.
+    env_vars = {key: str(value) for key, value in (nemo_gym_dict.pop("env_vars", None) or {}).items()}
 
     # Pass prebuilt cache + venv dirs through the global config so the gym reuses
     # image-baked venvs instead of rebuilding them.
@@ -1654,6 +1661,7 @@ def _build_gym_actor_config(
         **port_range,
         **multimodal_flags,
         **masking_flags,
+        env_vars=env_vars,
     )
 
 
