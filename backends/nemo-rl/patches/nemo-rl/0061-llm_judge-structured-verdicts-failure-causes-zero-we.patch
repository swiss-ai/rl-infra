+# The justify rules with a JSON answer, for structured outputs.
+JUSTIFY_JSON_PROMPT = (
+    "===== System role =====\n"
+    + _GRADING_RULES
+    + """
+- Be concise. Do NOT reveal or rewrite the GOLD.
+
+Answer with a JSON object: "reasoning" (one or two sentences on why they are or are not equivalent), then
+"verdict": "A=B" if they are equivalent, "A!=B" if not.
+
+===== Inputs =====
+QUESTION:
+{question}
+
+GOLD:
+{expected_answer}
+
+CANDIDATE:
+{generated_answer}"""
+)
+
+
+def justify_schema(max_reasoning_chars: int) -> dict[str, Any]:
+    return {
+        "type": "object",
+        "properties": {
+            "reasoning": {"type": "string", "maxLength": max_reasoning_chars},
+            "verdict": {"type": "string", "enum": ["A=B", "A!=B"]},
+        },
+        "required": ["reasoning", "verdict"],
+        "additionalProperties": False,
+    }
+
+
 # The same rules with a one-word answer, so the first token carries the verdict.
 VERDICT_SYSTEM = _GRADING_RULES + (
     "\n\nAnswer with exactly one word: Yes if the CANDIDATE is equivalent to GOLD, No otherwise."
@@ -223,6 +266,15 @@ def verdict_probability(
     return p_yes / (p_yes + p_no)
 
 
+def justify_json_label(text: str) -> bool | None:
+    """True/False from a structured justify answer's "verdict"; None if it does not parse."""
+    try:
+        verdict = json.loads(text).get("verdict")
+    except (ValueError, AttributeError):
+        return None
+    return {"A=B": True, "A!=B": False}.get(verdict)
+
+
 def justify_label(text: str) -> bool | None:
     """True for [[A=B]], False for [[A!=B]], whichever comes first; None without a label."""
     eq, neq = text.find(EQUAL), text.find(NOT_EQUAL)
