     sample_count = sum(len(data.dataset) for data in data_list)
     print(f"  ✓ Training dataset loaded with {sample_count} samples.")
@@ -314,6 +316,7 @@ def setup_response_data(
             agent_name_sources=_combine_agent_name_source_sets(
                 val_agent_name_source_sets
             ),
+            drop_long_prompts=data_config.get("drop_long_prompts", False),
         )
         print(f"  ✓ Validation dataset loaded with {len(val_dataset)} samples.")
 
diff --git a/tests/unit/data/test_drop_long_prompts.py b/tests/unit/data/test_drop_long_prompts.py
new file mode 100644
index 000000000..524fb77ae
--- /dev/null
+++ b/tests/unit/data/test_drop_long_prompts.py
@@ -0,0 +1,52 @@
+"""data.drop_long_prompts: rows with a prompt of max_seq_length tokens or more are left out at setup."""
+
+from nemo_rl.data.datasets.processed_dataset import AllTaskProcessedDataset
+
+
+def _processor(entry, task_data_spec, tokenizer, max_seq_length, idx):
+    # A prompt of entry["n"] tokens, cut and masked when too long, as the math processors do.
+    length = entry["n"]
+    return {
+        "message_log": [],
+        "length": length,
+        "loss_multiplier": 0.0 if length >= max_seq_length else 1.0,
+        "idx": idx,
+        "task_name": entry["task_name"],
+    }
+
+
+ROWS = [{"n": n, "task_name": "t"} for n in (10, 100, 99, 200, 5)]
+
+
+def test_keeps_every_row_by_default():
+    ds = AllTaskProcessedDataset(ROWS, None, None, _processor, max_seq_length=100)
+    assert len(ds) == 5
+    assert [ds[i]["length"] for i in range(len(ds))] == [10, 100, 99, 200, 5]
+
+
+def test_drops_rows_at_or_above_the_limit_and_keeps_original_indices():
+    ds = AllTaskProcessedDataset(
+        ROWS, None, None, _processor, max_seq_length=100, drop_long_prompts=True
+    )
+    assert len(ds) == 3
+    assert [ds[i]["length"] for i in range(len(ds))] == [10, 99, 5]
+    assert [ds[i]["idx"] for i in range(len(ds))] == [0, 2, 4]
+
+
+def test_without_a_limit_nothing_is_dropped():
+    ds = AllTaskProcessedDataset(
+        ROWS, None, None, _processor, max_seq_length=None, drop_long_prompts=True
+    )
+    assert len(ds) == 5
+
+
+def test_large_dataset_is_filtered_in_worker_processes(monkeypatch, capsys):
+    monkeypatch.setenv("NRL_DROP_LONG_PROMPTS_WORKERS", "4")
+    rows = [{"n": i % 200, "task_name": "t"} for i in range(10000)]
+    ds = AllTaskProcessedDataset(
+        rows, None, None, _processor, max_seq_length=100, drop_long_prompts=True
+    )
+    assert len(ds) == 5000
+    assert all(ds[i]["length"] < 100 for i in range(0, len(ds), 97))
+    assert ds[4999]["idx"] == 9899
+    assert "on 4 process(es)" in capsys.readouterr().out
