+
+def _sample_meta(kind: str = "problem", prompt_tokens: int = 100) -> dict[str, Any]:
+    return {
+        "tutoring": {
+            "kind": kind,
+            "problem": "Solve 2x + 4 = 10.",
+            "answer": "3",
+            "subject": None if kind == "problem" else "algebra",
+            "locale": "en_US",
+            "language": "English",
+            "persona_name": "Alex",
+            "persona_text": "Alex, high school student",
+            "learner_system": "You are Alex, a learner.",
+            "interaction_style": "neutral",
+            "disclosure_style": "incremental",
+            "patience": 0.5,
+            "opener": "Can you help me solve 2x + 4 = 10?",
+        },
+        "prompt_tokens": prompt_tokens,
+    }
+
+
+def _assistant_msg(reply: str, think: str = "thinking", truncated: bool = False) -> list[dict[str, Any]]:
+    return [
+        {
+            "role": "assistant",
+            "content": f"<|out|>think<|hdr|>{think}<|/out|><|out|>reply<|hdr|>{reply}<|/out|><|wait|>",
+            "apertus2_output": Apertus2Output(
+                think=think,
+                reply=reply,
+                claim=None,
+                calls=[],
+                error=None,
+                truncated=truncated,
+            ),
+        }
+    ]
+
+
+class _FakePoolServer:
+    def __init__(self, handler) -> None:
+        self._handler = handler
+        self.requests: list[dict[str, Any]] = []
+        self._runner: web.AppRunner | None = None
+        self.base_url = ""
+
+    async def __aenter__(self) -> "_FakePoolServer":
+        app = web.Application()
+
+        async def chat_completions(request: web.Request) -> web.Response:
+            body = await request.json()
+            self.requests.append(body)
+            status, payload = self._handler(body, len(self.requests))
+            return web.json_response(payload, status=status)
+
+        app.router.add_post("/v1/chat/completions", chat_completions)
+        self._runner = web.AppRunner(app)
+        await self._runner.setup()
+        site = web.TCPSite(self._runner, "127.0.0.1", 0)
+        await site.start()
+        port = site._server.sockets[0].getsockname()[1]  # type: ignore[union-attr]
+        self.base_url = f"http://127.0.0.1:{port}/v1"
+        return self
+
+    async def __aexit__(self, *exc: Any) -> None:
+        if self._runner is not None:
+            await self._runner.cleanup()
+
+
+def _ok_completion(content: str, logprobs: list[dict[str, Any]] | None = None) -> tuple[int, dict[str, Any]]:
+    choice: dict[str, Any] = {"message": {"role": "assistant", "content": content}}
+    if logprobs is not None:
+        choice["logprobs"] = {"content": [{"top_logprobs": logprobs}]}
+    return 200, {"choices": [choice]}
+
+
+def _patch_encoding(monkeypatch: pytest.MonkeyPatch, env: Any) -> None:
+    monkeypatch.setattr(env, "_encode_user_turn", lambda text: [101] * max(1, len(text.split())))
+    monkeypatch.setattr(env, "_count_text_tokens", lambda text: max(1, len(text.split())))
+
