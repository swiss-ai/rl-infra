+    lp = expected_score_from_logprobs(
+        [{"token": "3", "logprob": math.log(0.25)}, {"token": "5", "logprob": math.log(0.75)}]
+    )
+    assert lp is not None and math.isclose(lp, 4.5, rel_tol=1e-5)
+
+    hyg = compute_hygiene_flags(
+        ["Line repeated over and over again here\n" * 4 + "As Gemma I say <|im_end|>"],
+        ["checking 幂函数 here"],
+        locale="en_US",
