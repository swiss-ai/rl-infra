+def _write_prompts_dir(tmp_path: Path) -> str:
+    d = tmp_path / "prompts"
+    d.mkdir()
+    files = {
+        "learner_followup.txt": (
+            "Write next USER message in {language}.\n\n"
+            "<CHAT_HISTORY>\n{chat_history}\n</CHAT_HISTORY>\n\n"
+            "{role_anchor}{frustration_block}\n\nNow write one USER message."
