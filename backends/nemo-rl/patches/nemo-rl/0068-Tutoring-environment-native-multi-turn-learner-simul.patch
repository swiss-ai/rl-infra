+def apertus2_tutoring_data_processor(
+    datum_dict: dict[str, Any],
+    task_data_spec: TaskDataSpec,
+    tokenizer: TokenizerType,
+    max_seq_length: int,
+    idx: int,
+) -> DatumSpec:
+    """A multi-turn learner simulation opening prompt in the Apertus 2 message format.
+
+    The row's user message holds the precomputed learner opener; ``tutoring`` carries
+    the learner system prompt, persona/behavioral metadata, and optional reference answer
+    or per-row ``behavior`` override (injected into the Apertus 2 system frame).
+    """
+    spec = dict(datum_dict["tutoring"])
+    user_text = (
+        datum_dict["messages"][0]["content"]
+        if datum_dict.get("messages")
+        else spec["opener"]
+    )
+    assert task_data_spec.system_prompt, (
+        "Apertus 2 needs system_prompt_file: a JSON file with the system frame."
+    )
+    frame = json.loads(task_data_spec.system_prompt)
+    if spec.get("behavior"):
+        frame["behavior"] = spec["behavior"]
+    token_ids = torch.tensor(
+        encode_prompt(
+            tokenizer.name_or_path,
+            system_prompt=json.dumps(frame),
+            user_text=user_text,
+        ),
+        dtype=torch.long,
+    )
+    message_log: LLMMessageLogType = [
+        {"role": "user", "content": user_text, "token_ids": token_ids}
+    ]
+    length = len(token_ids)
+    loss_multiplier = 1.0
+    if length >= max_seq_length:
+        message_log[0]["token_ids"] = token_ids[: min(4, max_seq_length)]
+        loss_multiplier = 0.0
+    return {
+        "message_log": message_log,
+        "length": length,
+        "extra_env_info": {"tutoring": spec, "prompt_tokens": int(length)},
+        "loss_multiplier": loss_multiplier,
+        "idx": idx,
+        "task_name": datum_dict["task_name"],
+    }
+
