+def test_multi_turn_early_stop_and_judge_averaging(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    prompts_dir = _write_prompts_dir(tmp_path)
+    judge_scores_seq = [
+        {"helpfulness": 4, "accuracy": 5, "coherence": 4, "pedagogical_quality": 4},
+        {"helpfulness": 5, "accuracy": 5, "coherence": 4, "pedagogical_quality": 5},
+        {"helpfulness": 3, "accuracy": 5, "coherence": 4, "pedagogical_quality": 3},
+    ]
+    judge_idx = {"i": 0}
+    learner_turn = {"n": 0}
+
+    def handler(body: dict[str, Any], _count: int) -> tuple[int, dict[str, Any]]:
+        sys_msg = body["messages"][0]["content"]
+        user_msg = body["messages"][-1]["content"]
+        if "expert judge" in sys_msg:
+            return _ok_completion(json.dumps({"explanation": "in character", "rating": "success"}))
+        if user_msg.startswith("Does this end?"):
+            return _ok_completion("yes")
+        if sys_msg == "You are a judge.":
+            sc = judge_scores_seq[judge_idx["i"] % len(judge_scores_seq)]
+            judge_idx["i"] += 1
+            return _ok_completion(json.dumps({k: {"reasoning": "ok", "score": v} for k, v in sc.items()}))
+        learner_turn["n"] += 1
+        if learner_turn["n"] < 3:
+            return _ok_completion("Wait, why subtract 4 first?")
+        return _ok_completion("Thanks, that makes total sense now.")
+
+    async def run() -> None:
+        async with _FakePoolServer(handler) as srv:
+            env = TutoringEnvCls(
+                {
+                    "judge_pool": "judge_mock",
+                    "tokenizer_path": "mock",
+                    "prompts_dir": prompts_dir,
+                    "max_turns": 8,
+                    "min_turns": 3,
+                    "wrapup_from_turn": 2,
+                    "axes": {"helpfulness": 1, "accuracy": 1, "coherence": 1, "pedagogical_quality": 1},
+                    "judge_samples": 3,
+                    "pool_urls": [srv.base_url],
+                    "pool_model": "mock-gemma",
+                }
+            )
+            _patch_encoding(monkeypatch, env)
+            meta = _sample_meta()
+            # Turn 1: continues, uses mid anchor
+            out1 = await env.step([_assistant_msg("Subtract 4 from both sides.")], [meta])
+            assert not out1.terminateds[0].item()
+            assert out1.rewards[0].item() == 0.0
+            assert out1.observations[0]["token_ids"]
+            # Turn 2: continues, wrap-up anchor active (>= wrapup_from_turn=2), "?" skips early stop
+            out2 = await env.step([_assistant_msg("Because 2x+4-4 leaves 2x=6.")], out1.metadata)
+            assert not out2.terminateds[0].item()
+            # Turn 3: no "?" -> early stop "yes" -> 3-sample judge average
+            out3 = await env.step([_assistant_msg("Then divide by 2 to get x=3.")], out2.metadata)
+            assert out3.terminateds[0].item()
+            assert not out3.metadata[0]["mask_sample"]
+            # Mean scores: helpfulness=4, accuracy=5, coherence=4, pedagogical_quality=4 -> mean (0.75+1+0.75+0.75)/4 = 0.8125
+            assert math.isclose(out3.rewards[0].item(), 0.8125, rel_tol=1e-5)
+            fm = out3.metadata[0]["frame_metrics"]
+            assert fm["tut_end/satisfied"] == 1.0
+            assert fm["tut_early_stop_turn"] == 3.0
+            # Verify wrap-up anchor appeared on turn 2+
+            learner_reqs = [r for r in srv.requests if r["messages"][0]["content"] == "You are Alex, a learner."]
+            assert "[ANCHOR_MID]" in learner_reqs[0]["messages"][1]["content"]
+            assert "[ANCHOR_WRAPUP]" in learner_reqs[1]["messages"][1]["content"]
+            await env.shutdown()
+
+    asyncio.run(run())
