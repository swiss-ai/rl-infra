+            # 2) Context margin reached (prompt_tokens=350 -> remaining < 200) -> triggers final judge cleanly
+            out_ctx = await env.step([_assistant_msg("Full clear answer.")], [_sample_meta(prompt_tokens=350)])
+            assert out_ctx.terminateds[0].item()
+            assert out_ctx.rewards[0].item() == 1.0
