+                    "min_remaining_tokens": 200,
+                    "judge_samples": 1,
+                    "axes": {"helpfulness": 1},
+                    "pool_urls": [srv.base_url],
+                    "pool_model": "mock-gemma",
+                }
+            )
+            _patch_encoding(monkeypatch, env)
+            # 1) Policy cut off -> reward 0, NOT masked
+            out_cut = await env.step([_assistant_msg("Halfway...", truncated=True)], [_sample_meta()])
