+def test_cutoff_not_masked_and_context_margin_judged(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    prompts_dir = _write_prompts_dir(tmp_path)
+
+    def handler(body: dict[str, Any], _count: int) -> tuple[int, dict[str, Any]]:
+        if body["messages"][0]["content"] == "You are a judge.":
+            return _ok_completion(json.dumps({"helpfulness": {"reasoning": "ok", "score": 5}}))
+        return _ok_completion("unused")
+
+    async def run() -> None:
+        async with _FakePoolServer(handler) as srv:
+            env = TutoringEnvCls(
+                {
