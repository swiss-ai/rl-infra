@@ -175,6 +175,134 @@ def test_chat_prompt_declares_the_request_tools(encoding):
     )
 
 
+def test_chat_prompt_reads_the_thinking_of_the_history(encoding):
+    call = {
+        "id": "call_1",
+        "type": "function",
+        "function": {"name": "get_weather", "arguments": '{"city":"Bern"}'},
+    }
+    prompt = encode_chat_prompt(
+        TOKENIZER,
+        system_prompt=SYSTEM_PROMPT,
+        messages=[
+            {"role": "user", "content": "Weather?"},
+            {
+                "role": "assistant",
+                "content": "<think>Look it up.</think>",
+                "tool_calls": [call],
+            },
+            {"role": "tool", "tool_call_id": "call_1", "content": "Sunny"},
+            {"role": "assistant", "content": "<think>Done.\nSay it.</think>Sunny."},
+            {"role": "user", "content": "Thanks"},
+        ],
+        tools=[WEATHER_TOOL],
+    )
+    assert prompt == encoding.encode_conversation(
+        Conversation(
+            system=_weather_system(),
+            items=[
+                User(payload="Weather?"),
+                Think(payload="Look it up."),
+                Call(name="get_weather", counter=0, payload='{"city":"Bern"}'),
+                Wait(),
+                Result(name="get_weather", counter=0, payload="Sunny"),
+                Think(payload="Done.\nSay it."),
+                Reply(payload="Sunny."),
+                Wait(),
+                User(payload="Thanks"),
+            ],
+        )
+    )
+
+
+def test_chat_prompt_has_no_empty_reply_next_to_a_call(encoding):
+    call = {
+        "id": "call_1",
+        "type": "function",
+        "function": {"name": "get_weather", "arguments": "{}"},
+    }
+    prompt = encode_chat_prompt(
+        TOKENIZER,
+        system_prompt=SYSTEM_PROMPT,
+        messages=[
+            {"role": "user", "content": "Weather?"},
+            {"role": "assistant", "content": "", "tool_calls": [call]},
+            {"role": "tool", "tool_call_id": "call_1", "content": "Sunny"},
+        ],
+        tools=[WEATHER_TOOL],
+    )
+    assert prompt == encoding.encode_conversation(
+        Conversation(
+            system=_weather_system(),
+            items=[
+                User(payload="Weather?"),
+                Think(payload=""),
+                Call(name="get_weather", counter=0, payload="{}"),
+                Wait(),
+                Result(name="get_weather", counter=0, payload="Sunny"),
+            ],
+        )
+    )
+
+
+def test_chat_prompt_reads_the_reasoning_fields_of_gym():
+    fields = {"reasoning": "Hm.", "reasoning_content": "Hm."}
+    only_reasoning = {"reasoning": "Hm."}
+    messages = [{"role": "user", "content": "Hi"}]
+    prompts = [
+        encode_chat_prompt(
+            TOKENIZER,
+            system_prompt=SYSTEM_PROMPT,
+            messages=[
+                *messages,
+                {"role": "assistant", "content": "Hello.", **given},
+                {"role": "user", "content": "Bye"},
+            ],
+            tools=None,
+        )
+        for given in (fields, only_reasoning, {"content": "<think>Hm.</think>Hello."})
+    ]
+    assert prompts[0] == prompts[1] == prompts[2]
+
+
+def test_chat_prompt_writes_past_arguments_compact(encoding):
+    call = {
+        "id": "call_1",
+        "type": "function",
+        "function": {"name": "get_weather", "arguments": '{"city": "Zürich"}'},
+    }
+    prompt = encode_chat_prompt(
+        TOKENIZER,
+        system_prompt=SYSTEM_PROMPT,
+        messages=[
+            {"role": "user", "content": "Weather?"},
+            {"role": "assistant", "content": "", "tool_calls": [call]},
+            {"role": "tool", "tool_call_id": "call_1", "content": "Sunny"},
+        ],
+        tools=[WEATHER_TOOL],
+    )
+    assert '<|hdr|>{"city":"Zürich"}<|/out|>' in encoding.decode_text(prompt)
+
+
+def test_chat_prompt_keeps_past_arguments_that_are_not_json(encoding):
+    call = {
+        "id": "call_1",
+        "type": "function",
+        "function": {"name": "get_weather", "arguments": '{"city": '},
+    }
+    prompt = encode_chat_prompt(
+        TOKENIZER,
+        system_prompt=SYSTEM_PROMPT,
+        messages=[
+            {"role": "user", "content": "Weather?"},
+            {"role": "assistant", "content": "", "tool_calls": [call]},
+            {"role": "tool", "tool_call_id": "call_1", "content": "Sunny"},
+        ],
+        tools=[WEATHER_TOOL],
+    )
+    assert '<|hdr|>{"city": <|/out|>' in encoding.decode_text(prompt)
+
+
