+def _tokenize_observation(
+    observation: dict[str, Any], tokenizer: TokenizerType
+) -> torch.Tensor:
+    """Return an environment observation's tokens.
+
+    An environment that encodes its own input frames (the Apertus 2 format, where
+    tokenizing text could turn payload into control tokens) passes them as
+    ``token_ids``; other observations are tokenized as plain text.
+    """
+    if observation.get("token_ids") is not None:
+        return torch.tensor(observation["token_ids"], dtype=torch.int64)
+    # TODO @sahilj: handle if we want these subsequent messages to have a chat template
+    tokenized = tokenizer(
+        observation["content"], return_tensors="pt", add_special_tokens=False
+    ).input_ids[0]
+    # tokenizer returns torch.float32 when the content is empty
+    return tokenized.to(dtype=torch.int64)
