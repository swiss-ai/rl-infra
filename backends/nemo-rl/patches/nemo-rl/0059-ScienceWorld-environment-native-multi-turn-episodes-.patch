+def apertus2_sciworld_data_processor(
+    datum_dict: dict[str, Any],
+    task_data_spec: TaskDataSpec,
+    tokenizer: TokenizerType,
+    max_seq_length: int,
+    idx: int,
+) -> DatumSpec:
+    """A ScienceWorld episode's opening prompt in the Apertus 2 message format.
+
+    The row's user message holds the instructions, the task and the first
+    observation; ``sciworld`` names the task, variation, simplifications and action
+    format for the environment. The tool format needs the ``act`` tool in the system
+    frame, and the reply format must not declare it.
+    """
+    spec = dict(datum_dict["sciworld"])
+    user_text = datum_dict["messages"][0]["content"]
+    assert task_data_spec.system_prompt, (
+        "Apertus 2 needs system_prompt_file: a JSON file with the system frame."
+    )
+    tools = json.loads(task_data_spec.system_prompt).get("tools") or []
+    declares_act = any(tool.get("name") == "act" for tool in tools)
+    assert declares_act == (spec["action_format"] == "tool"), (
+        f"Row action_format {spec['action_format']!r} needs a system frame "
+        f"{'with' if spec['action_format'] == 'tool' else 'without'} the act tool."
+    )
+    token_ids = torch.tensor(
+        encode_prompt(
+            tokenizer.name_or_path,
+            system_prompt=task_data_spec.system_prompt,
+            user_text=user_text,
+        ),
+        dtype=torch.long,
+    )
+    message_log: LLMMessageLogType = [
+        {"role": "user", "content": user_text, "token_ids": token_ids}
+    ]
+    length = len(token_ids)
+    loss_multiplier = 1.0
+    if length >= max_seq_length:
+        message_log[0]["token_ids"] = token_ids[: min(4, max_seq_length)]
+        loss_multiplier = 0.0
+    return {
+        "message_log": message_log,
+        "length": length,
+        "extra_env_info": {"sciworld": spec},
+        "loss_multiplier": loss_multiplier,
+        "idx": idx,
+        "task_name": datum_dict["task_name"],
+    }
+
+
 def vlm_hf_data_processor(
     datum_dict: dict[str, Any],
     task_data_spec: TaskDataSpec,
