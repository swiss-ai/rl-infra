From 9fd3aab1e73b9c26b4c8f4e3207ca6cf60b7573e Mon Sep 17 00:00:00 2001
From: davmels <davmelous@gmail.com>
Date: Thu, 8 Oct 2026 17:40:39 +0200
Subject: [PATCH] ray.sub: run on CSCS Alps (container engine, single srun,
 NUMA mem-bind)

- EDF mode: when EDF is set, sruns use --environment=$EDF instead of the
  pyxis --container-* flags.
- RAY_SINGLE_SRUN=1: start the Ray head and all workers in one srun step via
  a generated ray_cluster_dispatch.sh. Slingshot authorizes the network (VNI)
  per Slurm step, so NCCL fails between processes of separate sruns.
- SRUN_MEM_BIND: optional --mem-bind for every srun (bind host memory to the
  GH200 CPU NUMA nodes so it cannot spill onto GPU HBM).
- NUMA_WATCH: optional per-node watcher script started by the dispatch script.
- CONTAINER/MOUNTS default to empty so the script runs under set -u.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 ray.sub | 83 ++++++++++++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 73 insertions(+), 10 deletions(-)

diff --git a/ray.sub b/ray.sub
index 7237cbe1a..9b189cdec 100644
--- a/ray.sub
+++ b/ray.sub
@@ -96,8 +96,8 @@ detect_cpus_per_node() {
 # User defined variables
 ########################################################
 export OMP_NUM_THREADS=${OMP_NUM_THREADS:-16}
-CONTAINER=$CONTAINER
-MOUNTS=$MOUNTS
+CONTAINER=${CONTAINER:-}  # unused with EDF
+MOUNTS=${MOUNTS:-}
 COMMAND=${COMMAND:-}  # This is a script relative to the SLURM_SUBMIT_DIR. If left empty, it will leave the cluster idle after it's brought up.
 SETUP_COMMAND=${SETUP_COMMAND:-}  # Setup commands to run on all nodes before starting Ray.
 ########################################################
@@ -219,11 +219,25 @@ else
 fi
 
 COMMON_SRUN_ARGS="$GRES_ARG"
-COMMON_SRUN_ARGS+=" --no-container-mount-home"
-COMMON_SRUN_ARGS+=" --mpi=pmix"
-COMMON_SRUN_ARGS+=" --container-mounts=$MOUNTS"
-COMMON_SRUN_ARGS+=" --container-image=$CONTAINER"
-COMMON_SRUN_ARGS+=" --container-workdir=$SLURM_SUBMIT_DIR"
+if [[ -n "${EDF:-}" ]]; then
+  # CSCS Container Engine: image, mounts and workdir come from the EDF (~/.edf/$EDF.toml).
+  # No pyxis flags (--container-*) and no MPI: Ray does its own bootstrapping.
+  COMMON_SRUN_ARGS+=" --environment=$EDF"
+  HEAD_CONTAINER_ARGS=""
+  WORKER_CONTAINER_ARGS=""
+else
+  COMMON_SRUN_ARGS+=" --no-container-mount-home"
+  COMMON_SRUN_ARGS+=" --mpi=pmix"
+  COMMON_SRUN_ARGS+=" --container-mounts=$MOUNTS"
+  COMMON_SRUN_ARGS+=" --container-image=$CONTAINER"
+  COMMON_SRUN_ARGS+=" --container-workdir=$SLURM_SUBMIT_DIR"
+  HEAD_CONTAINER_ARGS="--container-name=ray-head"
+  WORKER_CONTAINER_ARGS="--container-name=ray-worker"
+fi
+# Optional --mem-bind for every srun step.
+if [[ -n "${SRUN_MEM_BIND:-}" ]]; then
+  COMMON_SRUN_ARGS+=" --mem-bind=$SRUN_MEM_BIND"
+fi
 # Pass partition/account explicitly for overlapping srun calls.
 COMMON_SRUN_ARGS+=" -p $SLURM_JOB_PARTITION"
 COMMON_SRUN_ARGS+=" -A $SLURM_JOB_ACCOUNT"
@@ -855,21 +869,60 @@ else
   echo "[INFO] SANDBOX_CONTAINER or SANDBOX_COMMAND not defined, skipping sandbox startup"
 fi
 
+_num_workers=$((SLURM_JOB_NUM_NODES - 1))
+if [[ "${RAY_SINGLE_SRUN:-0}" == "1" ]]; then
+  # Alps/Slingshot authorizes the CXI network (VNI) per Slurm step: processes in
+  # different sruns cannot share one NCCL/OFI communicator (fails with
+  # VNI_NOT_FOUND / PTLTE_NOT_FOUND). So run head and workers as the tasks of ONE
+  # srun; each task picks its role by hostname. Same approach as the Apertus fork's
+  # RAY_SINGLE_SRUN (Alvorecer721/Nemo-RL). Non-interactive runs only.
+  if [[ -z "$COMMAND" || -n "${SANDBOX_CONTAINER:-}" || -n "${SANDBOX_COMMAND:-}" ]]; then
+    echo "Error: RAY_SINGLE_SRUN=1 needs a non-interactive COMMAND and no sandbox." >&2
+    exit 1
+  fi
+  printf '%s\n' "$head_cmd" > "$LOG_DIR/ray_head_command.sh"
+  printf '%s\n' "$worker_cmd" > "$LOG_DIR/ray_worker_command.sh"
+  # The head records the driver's exit code, then writes ENDED, which makes the
+  # workers' monitor-sidecar stop them, so the shared step ends.
+  cat > "$LOG_DIR/ray_cluster_dispatch.sh" <<EOF
+if [[ -n "${NUMA_WATCH:-}" ]]; then
+  bash "${NUMA_WATCH:-}" > "$LOG_DIR/numa-hbm-\$SLURMD_NODENAME.log" 2>&1 &
+fi
+if [[ "\$SLURMD_NODENAME" == "$head_node" ]]; then
+  bash -x "$LOG_DIR/ray_head_command.sh" > "$LOG_DIR/ray-head.log" 2>&1
+  rc=\$?
+  echo "\$rc" > "$LOG_DIR/RAY_HEAD_EXIT_CODE"
+  touch "$LOG_DIR/ENDED"
+  exit "\$rc"
+fi
+exec bash -x "$LOG_DIR/ray_worker_command.sh" > "$LOG_DIR/ray-worker-\$SLURMD_NODENAME.log" 2>&1
+EOF
+  log_phase "launching Ray head + workers in one srun"
+  CLUSTER_CONTAINER_ARGS=${HEAD_CONTAINER_ARGS:+--container-name=ray-cluster}
+  srun $COMMON_SRUN_ARGS $CLUSTER_CONTAINER_ARGS --exact \
+    --nodes="$SLURM_JOB_NUM_NODES" \
+    --ntasks="$SLURM_JOB_NUM_NODES" \
+    --ntasks-per-node=1 \
+    --cpus-per-task=$CPUS_PER_WORKER \
+    --kill-on-bad-exit=0 \
+    -o "$LOG_DIR/ray-cluster-%t.log" \
+    bash "$LOG_DIR/ray_cluster_dispatch.sh" &
+  SRUN_PIDS["ray-cluster"]=$!
+else
 # Start the Ray head.
 log_phase "launching Ray head + worker sruns"
-srun $COMMON_SRUN_ARGS --container-name=ray-head --nodes=1 --ntasks=1 --cpus-per-task=$CPUS_PER_WORKER -w "$head_node" -o $LOG_DIR/ray-head.log bash -x -c "$head_cmd" &
+srun $COMMON_SRUN_ARGS $HEAD_CONTAINER_ARGS --nodes=1 --ntasks=1 --cpus-per-task=$CPUS_PER_WORKER -w "$head_node" -o $LOG_DIR/ray-head.log bash -x -c "$head_cmd" &
 SRUN_PIDS["ray-head"]=$!
 
 # Start the Ray workers (all nodes except the head) with a single batched srun, so
 # the number of srun/slurmctld RPCs stays constant regardless of node count. In
 # single-node mode there are no workers: the head already registers its GPUs as Ray
 # resources.
-_num_workers=$((SLURM_JOB_NUM_NODES - 1))
 if [[ $_num_workers -gt 0 ]]; then
   # srun -o with %t produces per-task log files; zero-pad to the worker-count
   # width so ray-worker-*.log filenames sort naturally (e.g. ray-worker-007.log).
   _task_digits=${#_num_workers}
-  srun $COMMON_SRUN_ARGS --container-name=ray-worker --exact \
+  srun $COMMON_SRUN_ARGS $WORKER_CONTAINER_ARGS --exact \
     --nodes=$_num_workers \
     --ntasks=$_num_workers \
     --ntasks-per-node=1 \
@@ -882,6 +935,7 @@ if [[ $_num_workers -gt 0 ]]; then
 else
   echo "[INFO] Single-node mode: head node is the only compute node, no workers to launch"
 fi
+fi
 
 # Wait for the head container to report, via a shared-FS file, that the Ray head
 # GCS is ready.
@@ -900,6 +954,15 @@ if [[ -n "$COMMAND" ]]; then
   # during bringup (e.g. a failed node), signal ENDED and stop promptly instead of
   # stalling until the head's 30-min worker deadline. check_srun_processes isn't used
   # here because it also watches the head, whose exit is the normal success path.
+  if [[ "${RAY_SINGLE_SRUN:-0}" == "1" ]]; then
+    # The shared step ends once the head has recorded the driver status and the
+    # workers have seen ENDED; the job's exit code is the driver's.
+    set +e
+    wait "${SRUN_PIDS["ray-cluster"]}"
+    exit_code=$(cat "$LOG_DIR/RAY_HEAD_EXIT_CODE" 2>/dev/null || echo 1)
+    touch "$LOG_DIR/ENDED"
+    exit "$exit_code"
+  fi
   set +e
   while kill -0 "${SRUN_PIDS["ray-head"]}" 2>/dev/null; do
     for _name in ray-workers sandbox; do
-- 
2.43.0

