From 91c4113ced673aa627c73464bb8c6c1e67e43827 Mon Sep 17 00:00:00 2001
From: davmels <davmelous@gmail.com>
Date: Thu, 29 Oct 2026 20:00:43 +0900
Subject: [PATCH 2/2] [EP] Serialize libfabric CXI setup across proxy threads

libfabric's CXI provider (up to at least v2.6) parses SLINGSHOT_DEVICES,
SLINGSHOT_SVC_IDS and SLINGSHOT_VNIS with strtok() inside fi_getinfo().
The proxy threads of a rank run CxiTransport::init() at the same time,
so one thread's parse can continue in another thread's string. The
rank's NIC is then missing from SLINGSHOT_DEVICES and libfabric falls
back to a service lookup by UID and GID, which finds nothing when the
process runs as root in a user namespace (Slurm with pyxis/enroot):
fi_domain() fails with -FI_ENOSYS ("Function not implemented") and the
proxy thread's exception aborts the process. NICs after the first entry
of SLINGSHOT_DEVICES are affected (cxi1 in practice); on GH200 nodes with
four NICs this stopped about one multi-node job in three at its first
dispatch, and a four-thread fi_getinfo() reproducer also segfaulted in
strtok() in most runs.

Hold a process-wide mutex from fi_getinfo() through fi_domain(); the
rest of the endpoint setup stays concurrent. The provider is fixed by
converting it to strtok_r(); this keeps UCCL working with libfabric
builds that predate that.

Co-authored-by: Raphael Kreft <71375341+RaphaelKreft@users.noreply.github.com>
---
 ep/src/cxi_transport.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/ep/src/cxi_transport.cpp b/ep/src/cxi_transport.cpp
index 3e92888..8cd8a57 100644
--- a/ep/src/cxi_transport.cpp
+++ b/ep/src/cxi_transport.cpp
@@ -8,6 +8,7 @@
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <mutex>
 #include <string>
 #include <sys/uio.h>
 
@@ -43,6 +44,13 @@ void CxiTransport::destroy() {}
 
 namespace {
 
+// libfabric's CXI provider reads SLINGSHOT_DEVICES, SLINGSHOT_SVC_IDS and
+// SLINGSHOT_VNIS with strtok() during fi_getinfo() (up to at least v2.6), so
+// proxy threads that set up at the same time can misread each other's lists:
+// the NIC then gets no service ID and fi_domain() fails with -FI_ENOSYS, or
+// the process crashes. Serialize the provider calls that parse them.
+std::mutex g_cxi_setup_mu;
+
 void check_fi(int rc, char const* what) {
   if (rc < 0) {
     throw std::runtime_error(std::string(what) +
@@ -152,6 +160,7 @@ void CxiTransport::init(ProxyCtx& ctx) {
   hints->domain_attr->threading = FI_THREAD_DOMAIN;
 
   fi_info* info = nullptr;
+  std::unique_lock<std::mutex> setup_lock(g_cxi_setup_mu);
   int rc = fi_getinfo(FI_VERSION(1, 15), nullptr, nullptr, 0, hints, &info);
   fi_freeinfo(hints);
   check_fi(rc, "fi_getinfo(cxi)");
@@ -161,6 +170,7 @@ void CxiTransport::init(ProxyCtx& ctx) {
 
     check_fi(fi_fabric(selected->fabric_attr, &fabric_, nullptr), "fi_fabric");
     check_fi(fi_domain(fabric_, selected, &domain_, nullptr), "fi_domain");
+    setup_lock.unlock();
 
     fi_cq_attr cq_attr = {};
     cq_attr.format = FI_CQ_FORMAT_DATA;
