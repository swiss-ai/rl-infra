+    def _replay_qb_indices(self, biased_scores: torch.Tensor, qb_indices: torch.Tensor) -> torch.Tensor:
+        """Router replay for quantile balancing: the replayed top-k indices for REPLAY_FORWARD and
+        REPLAY_BACKWARD, QB's own (recorded) for RECORD, unchanged without an action. Goes through
+        RouterReplay.get_replay_topk like the top-k path, so wrappers of it (e.g. NeMo RL's fallback for
+        tokens without rollout routes, which takes QB's pick for those rows) apply here too."""
+
+        def qb_topk(scores, topk, num_groups=None, group_topk=None):
+            return scores.gather(1, qb_indices), qb_indices
