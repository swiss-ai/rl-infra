+import pytest
+
+from nemo_rl.environments import nemo_gym as nemo_gym_mod
+from nemo_rl.environments.nemo_gym import (
+    NemoGym,
+    build_nemo_gym_actors,
+    build_nemo_gym_config,
+)
+
+_EOS = 7
+
+
+class _Tokenizer:
+    eos_token_id = _EOS
+
+    def apply_chat_template(self, messages, tokenize=True):
+        return [1, 2, 3]
+
+    def batch_decode(self, batch):
+        return [" ".join(map(str, token_ids)) for token_ids in batch]
+
+
+def _empty_result(*, mask_sample: bool) -> dict:
+    """A Gym /run result whose trial died before the first completed turn."""
+    return {
+        "instance_id": "swe_lego::some_task",
+        "response": {"output": []},
+        "responses_create_params": {"input": []},
+        "instance_config": {"mask_sample": mask_sample},
+    }
+
+
+def _postprocess(cfg: dict, nemo_gym_result: dict) -> dict:
+    class _MockSelf:
+        pass
+
+    mock_self = _MockSelf()
+    mock_self.cfg = cfg
+    return NemoGym.__ray_metadata__.modified_class._postprocess_nemo_gym_to_nemo_rl_result(
+        mock_self, {}, nemo_gym_result, _Tokenizer()
+    )
+
+
+def test_flagged_empty_rollout_becomes_zero_weight_stand_in():
+    result = _postprocess(
+        {"mask_degenerate_rollouts": True}, _empty_result(mask_sample=True)
+    )
+
+    user_message, assistant_message = result["message_log"]
+    assert user_message["role"] == "user"
+    assert user_message["token_ids"].tolist() == [_EOS]
+    assert assistant_message["role"] == "assistant"
+    assert assistant_message["token_ids"].tolist() == [_EOS]
+    assert assistant_message["generation_logprobs"].tolist() == [0.0]
+    assert result["input_message_log"] == [user_message]
+
+
+@pytest.mark.parametrize(
+    ("cfg", "mask_sample"),
+    [
+        ({}, True),
+        ({"mask_degenerate_rollouts": True}, False),
+        ({"mask_degenerate_rollouts": True, "require_routed_experts": True}, True),
+    ],
+    ids=["knob-off", "not-flagged", "router-replay"],
+)
+def test_empty_rollout_still_raises_when_masking_does_not_apply(cfg, mask_sample):
+    with pytest.raises(ValueError, match="no generation data"):
+        _postprocess(cfg, _empty_result(mask_sample=mask_sample))
+
+
+def test_build_nemo_gym_config_moves_mask_degenerate_rollouts_out_of_gym_config(
+    monkeypatch,
+):
+    monkeypatch.setattr(nemo_gym_mod, "get_nemo_gym_uv_cache_dir", lambda: None)
+    monkeypatch.setattr(nemo_gym_mod, "get_nemo_gym_venv_dir", lambda: None)
+
+    cfg = build_nemo_gym_config(
+        {"nemo_gym": {"config_paths": ["gym.yaml"], "mask_degenerate_rollouts": True}},
+        base_urls=[],
+        model_name="test-model",
+        enable_router_replay=False,
+        use_fastokens=False,
+    )
+
+    assert cfg["mask_degenerate_rollouts"] is True
+    assert "mask_degenerate_rollouts" not in cfg["initial_global_config_dict"]
+
+
+def test_mask_degenerate_rollouts_requires_should_mask_flagged_samples():
+    env_configs = {
+        "should_mask_flagged_samples": False,
+        "nemo_gym": {"config_paths": ["gym.yaml"], "mask_degenerate_rollouts": True},
+    }
+
+    with pytest.raises(ValueError, match="should_mask_flagged_samples"):
+        build_nemo_gym_actors(
+            env_configs,
+            base_urls=[],
+            model_name="test-model",
+            tokenizer=_Tokenizer(),
+            enable_router_replay=False,
+            use_fastokens=False,
+        )
