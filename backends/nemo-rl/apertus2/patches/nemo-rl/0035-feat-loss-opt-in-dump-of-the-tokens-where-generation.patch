+"""Opt-in dump of the tokens where the generation and trainer logprobs disagree.
+
+A diagnostic for a large ``token_mult_prob_error``: that metric is a token mean
+of ``exp(|generation - prev|)``, so a handful of tokens with a gap of 10+ nats
+dominate it and the metric alone cannot say which tokens they are. The policy
+gradient loss has, per microbatch, the generation logprobs (from the inference
+engine), ``prev_logprobs`` (trainer, before the update) and the training
+forward's logprobs; this module writes the worst tokens out with their context.
+
+Enabled by ``NRL_LOGPROB_DUMP_DIR`` in the policy workers' environment (for
+Megatron: ``policy.megatron_cfg.env_vars``). Each loss call then appends JSON
+lines to ``<dir>/logprob-<host>-<pid>.jsonl``:
+
+- one ``call`` record: rows, valid tokens, how many tokens exceed 1/2/5/10 nats,
+  and every row's ``seq_mult_prob_error``;
+- for each row whose largest gap reaches ``NRL_LOGPROB_DUMP_MIN_NATS``
+  (default 3): one ``seq`` record and up to ``NRL_LOGPROB_DUMP_MAX_TOKENS``
+  (default 32) ``tok`` records, worst first, each with
+  ``NRL_LOGPROB_DUMP_WINDOW`` (default 8) token ids on either side.
+
+Rows are identified by ``seq_key``, a hash of their token ids, so records of the
+same sequence from different ranks or passes can be joined offline. Tensor
+parallel ranks other than 0 hold the same data and write nothing.
+
+Unset, the hook costs one environment lookup. A failure is logged once and never
+raised: a diagnostic must not stop training.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+import os
+import socket
+import time
+from typing import Any, Optional, Sequence
+
+log = logging.getLogger(__name__)
+
+DIR_ENV = "NRL_LOGPROB_DUMP_DIR"
+MIN_NATS_ENV = "NRL_LOGPROB_DUMP_MIN_NATS"
+MAX_TOKENS_ENV = "NRL_LOGPROB_DUMP_MAX_TOKENS"
+WINDOW_ENV = "NRL_LOGPROB_DUMP_WINDOW"
+
+THRESHOLDS = (1.0, 2.0, 5.0, 10.0)
+# exp() of a larger gap overflows a float; the per-row error is a diagnostic only.
+_MAX_EXP_ARG = 50.0
+
+_state: dict[str, Any] = {"calls": 0, "warned": False}
+
+
+def enabled() -> bool:
+    """Whether the dump is switched on in this process."""
+    return bool(os.environ.get(DIR_ENV))
+
+
+def _gap(generation: float, prev: float) -> float:
+    gap = abs(generation - prev)
+    return gap if math.isfinite(gap) else 0.0
+
+
+def masked_runs(mask: Sequence[float]) -> list[tuple[int, int]]:
+    """Return the ``[start, end)`` index ranges of consecutive ``mask > 0`` entries.
+
+    In a multi-turn conversation each range is one generated burst.
+    """
+    runs: list[tuple[int, int]] = []
+    start: Optional[int] = None
+    for index, value in enumerate(mask):
+        if value > 0 and start is None:
+            start = index
+        elif value <= 0 and start is not None:
+            runs.append((start, index))
+            start = None
+    if start is not None:
+        runs.append((start, len(mask)))
+    return runs
+
+
+def _seq_key(input_ids: Optional[Sequence[int]], end: int) -> Optional[str]:
+    if input_ids is None:
+        return None
+    payload = ",".join(str(int(token)) for token in input_ids[:end]).encode()
+    return hashlib.sha1(payload).hexdigest()[:16]
+
+
+def _round(values: Sequence[float]) -> list[Optional[float]]:
+    return [round(v, 4) if math.isfinite(v) else None for v in values]
+
+
+def row_records(
+    *,
+    input_ids: Optional[Sequence[int]],
+    generation_logprobs: Sequence[float],
+    prev_logprobs: Sequence[float],
+    curr_logprobs: Sequence[float],
+    mask: Sequence[float],
+    advantages: Optional[Sequence[float]] = None,
+    min_nats: float = 3.0,
+    max_tokens: int = 32,
+    window: int = 8,
+) -> tuple[Optional[dict[str, Any]], list[dict[str, Any]]]:
+    """Build the ``seq`` record and the ``tok`` records of one row.
+
+    The logprob, mask and advantage lists are the loss function's ``[:, 1:]``
+    view: entry ``j`` scores token ``input_ids[j + 1]``. Positions in the records
+    (``pos``, ``run_start``) index ``input_ids``.
+
+    Returns ``(None, [])`` when no valid token's gap reaches ``min_nats``.
+    """
+    gaps = [
+        _gap(g, p) if m > 0 else 0.0
+        for g, p, m in zip(generation_logprobs, prev_logprobs, mask)
+    ]
+    max_gap = max(gaps, default=0.0)
+    if max_gap < min_nats:
+        return None, []
+
+    valid = [j for j, m in enumerate(mask) if m > 0]
+    runs = masked_runs(mask)
+    run_of: dict[int, tuple[int, int, int]] = {}
+    for run_index, (start, end) in enumerate(runs):
+        for j in range(start, end):
+            run_of[j] = (run_index, start, end)
+    last_pos = valid[-1] + 1
+    seq_key = _seq_key(input_ids, last_pos + 1)
+    seq_error = sum(math.exp(min(gaps[j], _MAX_EXP_ARG)) for j in valid) / len(valid)
+
+    seq = {
+        "kind": "seq",
+        "seq_key": seq_key,
+        "input_len": len(input_ids) if input_ids is not None else None,
+        "last_pos": last_pos,
+        "valid_tokens": len(valid),
+        "runs": len(runs),
+        "max_gap": round(max_gap, 4),
+        "seq_mult_prob_error": round(seq_error, 4),
+        "over": {f"{t:g}": sum(1 for j in valid if gaps[j] > t) for t in THRESHOLDS},
+    }
+
+    worst = sorted(
+        (j for j in valid if gaps[j] >= min_nats), key=lambda j: (-gaps[j], j)
+    )[:max_tokens]
+    tokens = []
+    for j in worst:
+        pos = j + 1
+        run_index, start, end = run_of[j]
+        lo, hi = max(0, j - 2), j + 3
+        record: dict[str, Any] = {
+            "kind": "tok",
+            "seq_key": seq_key,
+            "pos": pos,
+            "gap": round(gaps[j], 4),
+            "gen": round(generation_logprobs[j], 4),
+            "prev": round(prev_logprobs[j], 4),
+            "curr": round(curr_logprobs[j], 4),
+            "adv": round(advantages[j], 4) if advantages is not None else None,
+            "run": run_index,
+            "run_start": start + 1,
+            "run_offset": j - start,
+            "run_len": end - start,
+            "gen_ctx": _round(generation_logprobs[lo:hi]),
+            "prev_ctx": _round(prev_logprobs[lo:hi]),
+        }
+        if input_ids is not None:
+            record["token"] = int(input_ids[pos])
+            record["before"] = [int(t) for t in input_ids[max(0, pos - window) : pos]]
+            record["after"] = [int(t) for t in input_ids[pos + 1 : pos + 1 + window]]
+        tokens.append(record)
+    return seq, tokens
+
+
+def _env_float(name: str, default: float) -> float:
+    value = os.environ.get(name)
+    return float(value) if value else default
+
+
+def _env_int(name: str, default: int) -> int:
+    value = os.environ.get(name)
+    return int(value) if value else default
+
+
+def _is_duplicate_rank() -> bool:
+    """Tensor parallel ranks other than 0 see the same logprobs as rank 0."""
+    try:
+        from megatron.core import parallel_state
+
+        if parallel_state.model_parallel_is_initialized():
+            return parallel_state.get_tensor_model_parallel_rank() != 0
+    except Exception:  # noqa: BLE001  (no Megatron, or not initialized)
+        pass
+    return False
+
+
+def _global_rank() -> Optional[int]:
+    try:
+        import torch.distributed as dist
+
+        return dist.get_rank() if dist.is_initialized() else None
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def dump(
+    *,
+    input_ids: Any,
+    generation_logprobs: Any,
+    prev_logprobs: Any,
+    curr_logprobs: Any,
+    mask: Any,
+    advantages: Any = None,
+) -> None:
+    """Append this microbatch's records; never raises.
+
+    All tensors are ``[B, S - 1]`` (the loss function's ``[:, 1:]`` view) except
+    ``input_ids``, which is ``[B, S]`` or None.
+    """
+    try:
+        _dump(
+            input_ids=input_ids,
+            generation_logprobs=generation_logprobs,
+            prev_logprobs=prev_logprobs,
+            curr_logprobs=curr_logprobs,
+            mask=mask,
+            advantages=advantages,
+        )
+    except Exception as error:  # noqa: BLE001  (a diagnostic must not stop training)
+        if not _state["warned"]:
+            _state["warned"] = True
+            log.warning("logprob dump failed, continuing without it: %r", error)
+
+
+def _dump(
+    *,
+    input_ids: Any,
+    generation_logprobs: Any,
+    prev_logprobs: Any,
+    curr_logprobs: Any,
+    mask: Any,
+    advantages: Any,
+) -> None:
+    import torch
+
+    directory = os.environ.get(DIR_ENV)
+    if not directory or _is_duplicate_rank():
+        return
+    min_nats = _env_float(MIN_NATS_ENV, 3.0)
+    max_tokens = _env_int(MAX_TOKENS_ENV, 32)
+    window = _env_int(WINDOW_ENV, 8)
+
+    _state["calls"] += 1
+    with torch.no_grad():
+        generation = generation_logprobs.detach().float()
+        prev = prev_logprobs.detach().float()
+        curr = curr_logprobs.detach().float()
+        valid = mask.detach() > 0
+        gap = torch.nan_to_num((generation - prev).abs(), nan=0.0, posinf=0.0)
+        gap = torch.where(valid, gap, torch.zeros_like(gap))
+        valid_per_row = valid.sum(dim=-1)
+        seq_error = (torch.exp(gap.clamp(max=_MAX_EXP_ARG)) * valid).sum(
+            dim=-1
+        ) / valid_per_row.clamp(min=1)
+        row_max = gap.max(dim=-1).values
+        rows = torch.nonzero(row_max >= min_nats).flatten().tolist()
+        call = {
+            "kind": "call",
+            "call": _state["calls"],
+            "time": round(time.time(), 3),
+            "host": socket.gethostname(),
+            "pid": os.getpid(),
+            "rank": _global_rank(),
+            "rows": int(gap.shape[0]),
+            "valid_tokens": int(valid_per_row.sum()),
+            "max_gap": round(float(row_max.max()), 4) if gap.numel() else 0.0,
+            "over": {f"{t:g}": int((gap > t).sum()) for t in THRESHOLDS},
+            "seq_mult_prob_error": [
+                round(float(e), 4)
+                for e, n in zip(seq_error.tolist(), valid_per_row.tolist())
+                if n > 0
+            ],
+        }
+
+    records: list[dict[str, Any]] = [call]
+    for row in rows:
+        seq, tokens = row_records(
+            input_ids=input_ids[row].tolist() if input_ids is not None else None,
+            generation_logprobs=generation[row].tolist(),
+            prev_logprobs=prev[row].tolist(),
+            curr_logprobs=curr[row].tolist(),
+            mask=valid[row].float().tolist(),
+            advantages=advantages[row].detach().float().tolist()
+            if advantages is not None
+            else None,
+            min_nats=min_nats,
+            max_tokens=max_tokens,
+            window=window,
+        )
+        if seq is None:
+            continue
+        seq["call"] = _state["calls"]
+        seq["row"] = row
+        for token in tokens:
+            token["call"] = _state["calls"]
+        records.append(seq)
+        records.extend(tokens)
+
+    os.makedirs(directory, exist_ok=True)
+    path = os.path.join(
+        directory, f"logprob-{socket.gethostname()}-{os.getpid()}.jsonl"
+    )
+    with open(path, "a") as handle:
+        for record in records:
+            handle.write(json.dumps(record, separators=(",", ":")) + "\n")
