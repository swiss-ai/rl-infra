+"""Tests for the opt-in logprob outlier dump (nemo_rl.algorithms.loss.logprob_dump)."""
+
+import json
+import math
+
+import pytest
+
+from nemo_rl.algorithms.loss import logprob_dump
+from nemo_rl.algorithms.loss.logprob_dump import masked_runs, row_records
+
+# 12 tokens: prompt 0-2, burst A 3-5, tool output 6-8, burst B 9-11.
+IDS = [100, 101, 102, 7, 8, 9, 200, 201, 202, 10, 11, 12]
+# The loss function's [:, 1:] view: entry j scores IDS[j + 1].
+MASK = [0, 0, 1, 1, 1, 0, 0, 0, 1, 1, 1]
+
+
+def _lists(gaps: dict[int, float]):
+    prev = [-1.0] * len(MASK)
+    gen = [p + gaps.get(j, 0.0) for j, p in enumerate(prev)]
+    curr = [p - 0.01 for p in prev]
+    adv = [0.5] * len(MASK)
+    return gen, prev, curr, adv
+
+
+def test_masked_runs_finds_each_burst():
+    assert masked_runs(MASK) == [(2, 5), (8, 11)]
+    assert masked_runs([1, 1, 0, 1]) == [(0, 2), (3, 4)]
+    assert masked_runs([0, 0]) == []
+    assert masked_runs([]) == []
+
+
+def test_row_below_threshold_gives_nothing():
+    gen, prev, curr, adv = _lists({3: 2.9})
+    assert row_records(
+        input_ids=IDS,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=adv,
+        min_nats=3.0,
+    ) == (None, [])
+
+
+def test_masked_positions_are_ignored_even_with_a_large_gap():
+    # j = 5 and 6 score the tool output (mask 0): never reported.
+    gen, prev, curr, adv = _lists({5: 20.0, 6: 30.0})
+    seq, tokens = row_records(
+        input_ids=IDS,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=adv,
+    )
+    assert seq is None and tokens == []
+
+
+def test_token_record_locates_the_token_in_its_burst():
+    # j = 9 scores IDS[10] = 11, the second token of burst B (runs index 1).
+    gen, prev, curr, adv = _lists({9: 12.0, 3: 4.0})
+    seq, tokens = row_records(
+        input_ids=IDS,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=adv,
+        min_nats=3.0,
+        window=3,
+    )
+    assert seq is not None
+    assert seq["valid_tokens"] == 6
+    assert seq["runs"] == 2
+    assert seq["last_pos"] == 11
+    assert seq["input_len"] == 12
+    assert seq["max_gap"] == 12.0
+    assert seq["over"] == {"1": 2, "2": 2, "5": 1, "10": 1}
+    expected = (4 * 1.0 + math.exp(12.0) + math.exp(4.0)) / 6
+    assert seq["seq_mult_prob_error"] == pytest.approx(expected, rel=1e-4)
+
+    worst, second = tokens
+    assert worst["kind"] == "tok"
+    assert worst["seq_key"] == seq["seq_key"]
+    assert worst["pos"] == 10 and worst["token"] == 11
+    assert worst["gap"] == 12.0
+    assert worst["gen"] == 11.0 and worst["prev"] == -1.0 and worst["curr"] == -1.01
+    assert worst["adv"] == 0.5
+    assert worst["run"] == 1
+    assert worst["run_start"] == 9 and worst["run_offset"] == 1 and worst["run_len"] == 3
+    assert worst["before"] == [201, 202, 10]
+    assert worst["after"] == [12]
+    # j - 2 .. j + 2, cut at the end of the row
+    assert worst["gen_ctx"] == [-1.0, -1.0, 11.0, -1.0]
+    # j = 3 scores IDS[4] = 8, the second token of burst A
+    assert second["pos"] == 4 and second["token"] == 8 and second["run"] == 0
+    assert second["run_offset"] == 1
+
+
+def test_tokens_are_worst_first_and_capped():
+    gen, prev, curr, adv = _lists({2: 4.0, 3: 9.0, 4: 6.0, 8: 5.0})
+    _, tokens = row_records(
+        input_ids=IDS,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=adv,
+        max_tokens=2,
+    )
+    assert [t["pos"] for t in tokens] == [4, 5]
+    assert [t["gap"] for t in tokens] == [9.0, 6.0]
+
+
+def test_sequence_key_ignores_padding_and_distinguishes_sequences():
+    gen, prev, curr, adv = _lists({3: 5.0})
+    common = dict(
+        generation_logprobs=gen + [0.0, 0.0],
+        prev_logprobs=prev + [0.0, 0.0],
+        curr_logprobs=curr + [0.0, 0.0],
+        mask=MASK + [0, 0],
+        advantages=adv + [0.0, 0.0],
+    )
+    padded, _ = row_records(input_ids=IDS + [0, 0], **common)
+    plain, _ = row_records(
+        input_ids=IDS,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=adv,
+    )
+    other, _ = row_records(input_ids=[1] + IDS[1:] + [0, 0], **common)
+    assert padded["seq_key"] == plain["seq_key"]
+    assert other["seq_key"] != plain["seq_key"]
+
+
+def test_non_finite_logprobs_do_not_count_and_huge_gaps_do_not_overflow():
+    gen, prev, curr, adv = _lists({3: 900.0})
+    prev[4] = float("-inf")
+    seq, tokens = row_records(
+        input_ids=IDS,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=adv,
+    )
+    assert [t["pos"] for t in tokens] == [4]
+    assert math.isfinite(seq["seq_mult_prob_error"])
+    assert tokens[0]["prev_ctx"][3] is None
+
+
+def test_without_input_ids_records_have_no_tokens():
+    gen, prev, curr, adv = _lists({3: 5.0})
+    seq, tokens = row_records(
+        input_ids=None,
+        generation_logprobs=gen,
+        prev_logprobs=prev,
+        curr_logprobs=curr,
+        mask=MASK,
+        advantages=None,
+    )
