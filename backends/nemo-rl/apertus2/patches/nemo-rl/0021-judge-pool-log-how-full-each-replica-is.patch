+import json
+
+import pytest
+from ray.exceptions import RayError
+
+from nemo_rl.environments.judge_pool import _STATS, _write_stats, start_judge_pool
+
+
+class FakePool:
+    """Two replicas that answer `reads` times and then die."""
+
+    def __init__(self, reads):
+        self.reads = reads
+        self.names = None
+
+    def read_vllm_stats(self, names):
+        if self.reads == 0:
+            raise RayError("pool is gone")
+        self.reads -= 1
+        self.names = names
+        return [
+            {"vllm:num_requests_running": 128.0, "vllm:num_requests_waiting": 7.0},
+            {"vllm:num_requests_running": 3.0, "vllm:num_requests_waiting": 0.0},
+        ]
+
+
+def test_write_stats_logs_every_replica_until_the_pool_is_gone(tmp_path):
+    path = tmp_path / "logs" / "judge_stats.jsonl"
+    pool = FakePool(reads=2)
+
+    _write_stats(pool, str(path), interval_s=0)
+
+    lines = [json.loads(line) for line in path.read_text().splitlines()]
+    assert pool.names == _STATS
+    assert [line["replica"] for line in lines] == [0, 1, 0, 1]
+    assert lines[0]["num_requests_running"] == 128.0
+    assert lines[0]["num_requests_waiting"] == 7.0
+    assert lines[1]["num_requests_running"] == 3.0
+    assert lines[0]["time"] <= lines[2]["time"]
+
+
+def test_write_stats_appends_to_an_existing_file(tmp_path):
+    path = tmp_path / "judge_stats.jsonl"
+    _write_stats(FakePool(reads=1), str(path), interval_s=0)
+    _write_stats(FakePool(reads=1), str(path), interval_s=0)
+
+    assert len(path.read_text().splitlines()) == 4
+
+
+def test_stats_path_without_the_metrics_logger_fails_at_startup():
+    env_configs = {
+        "judge_pool": {
+            "stats_path": "judge_stats.jsonl",
+            "generation": {"vllm_cfg": {"enable_vllm_metrics_logger": False}},
+        }
+    }
+
+    with pytest.raises(AssertionError, match="enable_vllm_metrics_logger"):
+        start_judge_pool(env_configs, cluster_config={})
