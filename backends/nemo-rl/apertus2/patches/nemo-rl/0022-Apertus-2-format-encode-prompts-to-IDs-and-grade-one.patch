new file mode 100644
index 000000000..1f951e8e3
--- /dev/null
+++ b/tests/unit/data/test_apertus2_format.py
@@ -0,0 +1,171 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
