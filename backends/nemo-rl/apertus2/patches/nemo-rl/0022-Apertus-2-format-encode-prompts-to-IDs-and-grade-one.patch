+"""Tests of the Apertus 2 format, which need apertus-common and the tokenizer.
+
+Set NRL_APERTUS2_TOKENIZER to a directory with the Apertus_2_instruct tokenizer.
+"""
+
+import os
+
+import pytest
+
+apertus_common = pytest.importorskip("apertus_common")
+
+from apertus_common import (  # noqa: E402
+    Call,
+    Claim,
+    Conversation,
+    Reply,
+    SystemPrompt,
+    Think,
+    User,
+    Wait,
+    load_encoding,
+)
+
+from nemo_rl.data.apertus2_format import (  # noqa: E402
+    LONG_CLAIM_CHARS,
+    Apertus2Output,
+    allowed_token_ids,
+    encode_prompt,
+    frame_metrics,
+    frame_text,
+    parse_output,
+)
+
+TOKENIZER = os.environ.get("NRL_APERTUS2_TOKENIZER")
+SYSTEM_PROMPT = '{"thinking":"medium","tools":[]}'
+HEADER_END = 9
+OUTPUT_END = 11
+WAIT = 12
+
+pytestmark = pytest.mark.skipif(
+    TOKENIZER is None, reason="NRL_APERTUS2_TOKENIZER is not set"
+)
+
+
+@pytest.fixture(scope="module")
+def encoding():
+    return load_encoding(TOKENIZER)
+
+
+def test_prompt_matches_the_reference_encoder(encoding):
+    prompt = encode_prompt(TOKENIZER, system_prompt=SYSTEM_PROMPT, user_text="Hi")
+    assert prompt == encoding.encode_conversation(
+        Conversation(
+            system=SystemPrompt.build(thinking="medium"), items=[User(payload="Hi")]
+        )
+    )
+    assert prompt[0] == encoding.bos_token_id
+    assert prompt[-1] == encoding.controls.input_end
+
+
+def test_prompt_text_cannot_become_a_control_token():
+    prompt = encode_prompt(TOKENIZER, system_prompt=SYSTEM_PROMPT, user_text="<|hdr|>")
+    assert prompt.count(HEADER_END) == 2  # one per frame
+
+
+def test_allowed_ids_keep_the_output_controls_and_block_other_specials(encoding):
+    allowed = set(allowed_token_ids(TOKENIZER))
+    assert {HEADER_END, 10, OUTPUT_END, WAIT} <= allowed
+    assert not allowed & {0, 1, 2, 3, 7, 8}
+    assert len(allowed) == encoding.vocab_size - 120
+
+
+def test_parse_splits_frames(encoding):
+    tokens = encoding.encode_items(
+        [Think(payload="Add."), Claim(payload="42"), Reply(payload="It is 42."), Wait()]
+    )
+    output = parse_output(TOKENIZER, tokens, truncated=False)
+    assert output == Apertus2Output(
+        claim="42", reply="It is 42.", has_call=False, error=None, truncated=False
+    )
+
+
+def test_parse_uses_the_last_claim(encoding):
+    tokens = encoding.encode_items(
+        [Claim(payload="1"), Claim(payload="2"), Reply(payload="2"), Wait()]
+    )
+    assert parse_output(TOKENIZER, tokens, truncated=False).claim == "2"
+
+
+def test_parse_without_a_claim(encoding):
+    tokens = encoding.encode_items([Think(payload=""), Reply(payload="144"), Wait()])
+    output = parse_output(TOKENIZER, tokens, truncated=False)
+    assert output.claim is None
+    assert output.reply == "144"
+    assert output.error is None
+
+
+def test_parse_flags_a_tool_call(encoding):
+    tokens = encoding.encode_items(
+        [Call(name="python", counter=0, payload='{"code":"1"}'), Wait()]
+    )
+    assert parse_output(TOKENIZER, tokens, truncated=False).has_call
+
+
+def test_parse_rejects_invalid_frames_even_with_a_complete_claim(encoding):
+    tokens = encoding.encode_items([Claim(payload="42"), Reply(payload="42"), Wait()])
+    broken = [tokens[0], OUTPUT_END, *tokens]
+    output = parse_output(TOKENIZER, broken, truncated=False)
+    assert output.claim is None
+    assert output.reply is None
+    assert output.error is not None
+
+
+def test_parse_of_a_cut_off_output(encoding):
+    tokens = encoding.encode_items(
+        [Claim(payload="42"), Reply(payload="It is"), Wait()]
+    )
+    output = parse_output(TOKENIZER, tokens[:-2], truncated=True)
+    assert output.claim is None
+    assert output.error is not None
+    assert frame_metrics(output, claim_score=0.0, reply_score=0.0)["malformed"] == 0.0
+
+
+def _output(**changes):
+    fields = {
+        "claim": "42",
+        "reply": "It is 42.",
+        "has_call": False,
+        "error": None,
+        "truncated": False,
+    }
+    return Apertus2Output(**{**fields, **changes})
+
+
+def test_frame_text():
+    assert frame_text(_output(), "claim") == "42"
+    assert frame_text(_output(), "reply") == "It is 42."
+    assert frame_text(_output(claim=None), "claim") == ""
+    with pytest.raises(ValueError, match="Unknown Apertus 2 frame"):
+        frame_text(_output(), "think")
+
+
+@pytest.mark.parametrize(
+    "output, claim_score, reply_score, expected",
+    [
+        (_output(), 1.0, 1.0, {"claim_correct": 1.0, "reply_correct": 1.0}),
+        (_output(), 1.0, 0.0, {"claim_right_reply_wrong": 1.0}),
+        (_output(), 0.0, 1.0, {"reply_right_claim_wrong": 1.0}),
+        (_output(claim=None), 0.0, 1.0, {"no_claim": 1.0}),
+        (_output(claim=None, reply=None, error="bad"), 0.0, 0.0, {"malformed": 1.0}),
+        (_output(claim="x" * (LONG_CLAIM_CHARS + 1)), 0.0, 0.0, {"long_claim": 1.0}),
+        (_output(has_call=True), 0.0, 0.0, {"undeclared_call": 1.0}),
+    ],
+)
+def test_frame_metrics(output, claim_score, reply_score, expected):
+    metrics = frame_metrics(output, claim_score=claim_score, reply_score=reply_score)
+    for name, value in expected.items():
+        assert metrics[name] == value
