+def apertus2_math_data_processor(
+    datum_dict: dict[str, Any],
+    task_data_spec: TaskDataSpec,
+    tokenizer: TokenizerType,
+    max_seq_length: int,
+    idx: int,
+) -> DatumSpec:
+    """Like math_hf_data_processor, for the Apertus 2 message format.
+
+    The prompt is encoded to token IDs directly instead of being rendered to a
+    string and tokenized, so problem text cannot become control tokens.
+    """
+    user_message = datum_dict["messages"]
+    problem = user_message[0]["content"]
+    extra_env_info = {"ground_truth": user_message[1]["content"]}
+
+    assert task_data_spec.system_prompt, (
+        "Apertus 2 needs system_prompt_file: a JSON file with the system frame, "
+        'such as {"thinking":"medium","tools":[]}.'
+    )
+    formatted_content = (
+        task_data_spec.prompt.format(problem) if task_data_spec.prompt else problem
+    )
+    token_ids = torch.tensor(
+        encode_prompt(
+            tokenizer.name_or_path,
+            system_prompt=task_data_spec.system_prompt,
+            user_text=formatted_content,
+        ),
+        dtype=torch.long,
+    )
+    message_log: LLMMessageLogType = [
+        {"role": "user", "content": formatted_content, "token_ids": token_ids}
+    ]
+
+    length = len(token_ids)
+
+    loss_multiplier = 1.0
+    if length >= max_seq_length:
+        # make smaller and mask out
+        message_log[0]["token_ids"] = token_ids[: min(4, max_seq_length)]
+        loss_multiplier = 0.0
+
+    output: DatumSpec = {
+        "message_log": message_log,
+        "length": length,
+        "extra_env_info": extra_env_info,
+        "loss_multiplier": loss_multiplier,
+        "idx": idx,
+        "task_name": datum_dict["task_name"],
+    }
+    return output
+
+
 def vlm_hf_data_processor(
     datum_dict: dict[str, Any],
     task_data_spec: TaskDataSpec,
@@ -1014,6 +1069,7 @@ PROCESSOR_REGISTRY: Dict[str, TaskDataProcessFnCallable] = cast(
     Dict[str, TaskDataProcessFnCallable],
     {
         "default": math_hf_data_processor,
+        "apertus2_math_data_processor": apertus2_math_data_processor,
         "helpsteer3_data_processor": helpsteer3_data_processor,
         "kd_data_processor": kd_data_processor,
         "math_data_processor": math_data_processor,
