+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""The Apertus 2 message format for rollouts, on top of apertus-common.
+
+Apertus 2 has no chat template. Prompts are encoded from typed messages to token
+IDs, and generated tokens are split into frames at their control tokens, so that
+text can never pass for a control token.
+"""
+
+import json
+from dataclasses import dataclass
+from functools import lru_cache
+from typing import Any
+
+APERTUS2_OUTPUT_FORMAT = "apertus2"
+# A claim is a bare answer; a longer one is the model talking in the claim frame.
+LONG_CLAIM_CHARS = 40
+
+
+@dataclass
+class Apertus2Output:
+    """One burst of generated tokens, split into the frames rollouts care about.
+
+    Attributes:
+        claim: Payload of the last claim frame, or None if there is none.
+        reply: Payloads of the reply frames, joined, or None if there is none.
+        has_call: Whether the burst has a tool call frame.
+        error: The parser's message when the tokens are not valid frames.
+        truncated: Whether generation hit the token limit.
+    """
+
+    claim: str | None
+    reply: str | None
+    has_call: bool
+    error: str | None
+    truncated: bool
+
+
+@lru_cache(maxsize=1)
+def _get_encoding(tokenizer_path: str) -> Any:
+    # apertus-common is an optional dependency, needed only by this format. From
+    # the path, not the tokenizer object: load_encoding changes how the backend
+    # tokenizer it is given treats special tokens.
+    from apertus_common import load_encoding
+
+    return load_encoding(tokenizer_path)
+
+
+def encode_prompt(
+    tokenizer_path: str, *, system_prompt: str, user_text: str
+) -> list[int]:
+    """Encode a system frame and one user message, ending at ``<|/in|>``.
+
+    The model writes the first ``<|out|>`` itself, so nothing is prefilled.
+
+    Args:
+        tokenizer_path: Directory of the Apertus 2 tokenizer.
+        system_prompt: The system frame's JSON object, such as
+            ``{"thinking":"medium","tools":[]}``.
+        user_text: Text of the user message.
+
+    Returns:
+        The prompt's token IDs.
+    """
+    # apertus-common is an optional dependency, needed only by this format.
+    from apertus_common import Conversation, SystemPrompt, User
+
+    return _get_encoding(tokenizer_path).encode_conversation(
+        Conversation(
+            system=SystemPrompt.model_validate(json.loads(system_prompt)),
+            items=[User(payload=user_text)],
+        )
+    )
+
+
+def allowed_token_ids(tokenizer_path: str) -> list[int]:
+    """Return every token ID the model may generate, for vLLM's sampling params."""
+    encoding = _get_encoding(tokenizer_path)
+    forbidden = set(encoding.generation_constraints.forbidden_token_ids)
+    return [i for i in range(encoding.vocab_size) if i not in forbidden]
+
+
+def parse_output(
+    tokenizer_path: str, token_ids: list[int], *, truncated: bool
+) -> Apertus2Output:
+    """Split generated tokens into frames.
+
+    Tokens that are not valid frames give no claim and no reply, even where one
+    was already complete: only a whole, well-formed burst is graded.
+
+    Args:
+        tokenizer_path: Directory of the Apertus 2 tokenizer.
+        token_ids: The generated tokens, including ``<|wait|>``.
+        truncated: Whether generation hit the token limit.
+
+    Returns:
+        The frames of the burst.
+    """
+    # apertus-common is an optional dependency, needed only by this format.
+    from apertus_common import Call, Claim, Reply, StreamParseError
+
+    parser = _get_encoding(tokenizer_path).output_parser()
+    try:
+        parser.push_tokens(token_ids)
+        items = parser.finish().items
+    except StreamParseError as error:
+        return Apertus2Output(
+            claim=None,
+            reply=None,
+            has_call=False,
+            error=str(error),
+            truncated=truncated,
+        )
+
+    claims = [item.payload for item in items if isinstance(item, Claim)]
+    replies = [item.payload for item in items if isinstance(item, Reply)]
+    return Apertus2Output(
+        claim=claims[-1] if claims else None,
+        reply="".join(replies) if replies else None,
+        has_call=any(isinstance(item, Call) for item in items),
+        error=None,
+        truncated=truncated,
+    )
+
+
+def frame_text(output: Apertus2Output, frame: str) -> str:
+    """Return the text of a frame, empty if the output does not have it.
+
+    Args:
+        output: The parsed burst.
+        frame: "claim" or "reply".
+
+    Returns:
+        The frame's text.
+    """
+    if frame == "claim":
+        return output.claim or ""
+    if frame == "reply":
+        return output.reply or ""
+    raise ValueError(f"Unknown Apertus 2 frame {frame!r}: expected claim or reply.")
+
+
+def frame_metrics(
+    output: Apertus2Output, *, claim_score: float, reply_score: float
+) -> dict[str, float]:
+    """Return per-sample counts of how the frames came out, to average over a batch.
+
+    Args:
+        output: The parsed burst.
+        claim_score: Verifier score of the claim.
+        reply_score: Verifier score of the reply.
+
+    Returns:
+        One value per metric.
+    """
+    claim = output.claim
+    claim_right = claim_score > 0
+    reply_right = reply_score > 0
+    return {
+        "claim_correct": float(claim_right),
+        "reply_correct": float(reply_right),
+        "claim_right_reply_wrong": float(claim_right and not reply_right),
+        "reply_right_claim_wrong": float(reply_right and not claim_right),
+        "malformed": float(output.error is not None and not output.truncated),
+        "no_claim": float(output.error is None and claim is None),
+        "claim_chars": float(len(claim)) if claim else 0.0,
+        "long_claim": float(claim is not None and len(claim) > LONG_CLAIM_CHARS),
+        "undeclared_call": float(output.has_call),
+    }
