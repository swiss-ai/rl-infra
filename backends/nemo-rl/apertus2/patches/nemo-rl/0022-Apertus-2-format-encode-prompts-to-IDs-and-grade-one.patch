diff --git a/nemo_rl/data/apertus2_format.py b/nemo_rl/data/apertus2_format.py
new file mode 100644
index 000000000..73a2ed660
--- /dev/null
+++ b/nemo_rl/data/apertus2_format.py
@@ -0,0 +1,180 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+#
