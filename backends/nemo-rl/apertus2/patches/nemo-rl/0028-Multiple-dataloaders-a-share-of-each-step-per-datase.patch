+def _mean_by_task(
+    task_names: list[str], values: list[float], metric_name: str
+) -> dict[str, float]:
+    """Average values per task as ``{metric_name}_{task}``.
+
+    Empty for a single task, where the overall metric already says it all.
+    """
+    tasks = sorted(set(task_names))
+    if len(tasks) < 2:
+        return {}
+    return {
+        f"{metric_name}_{task}": sum(
+            value for name, value in zip(task_names, values) if name == task
+        )
+        / task_names.count(task)
+        for task in tasks
+    }
