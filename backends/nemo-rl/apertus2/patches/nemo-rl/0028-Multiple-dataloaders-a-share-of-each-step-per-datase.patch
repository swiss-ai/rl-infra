             break
+
+
+def _wrap(dataloaders: dict[str, StatefulDataLoader]) -> MultipleDataloaderWrapper:
+    return MultipleDataloaderWrapper(
+        expected_num_prompts=4,
+        data_config={
+            "custom_dataloader": "examples.custom_dataloader.custom_dataloader.example_custom_dataloader"
+        },
+        dataloaders=dataloaders,
+    )
+
+
+def test_multiple_dataloader_length_is_the_longest_dataloader(dataloaders):
+    assert len(_wrap(dataloaders)) == 2
+
+
+def test_multiple_dataloader_survives_pickling_before_the_first_pull(dataloaders):
+    # Async GRPO sends the wrapper to the trajectory collector, a Ray actor.
+    wrapped_dataloader = cloudpickle.loads(cloudpickle.dumps(_wrap(dataloaders)))
+
+    data = next(wrapped_dataloader)
+
+    content = sorted([message[0]["content"] for message in data["message_log"]])
+    assert content == ["0", "1", "2", "3"]
+
+
+def test_multiple_dataloader_state_resumes_each_dataloader(dataloaders):
+    wrapped_dataloader = _wrap(dataloaders)
+    next(wrapped_dataloader)
+
+    state = wrapped_dataloader.state_dict()
+
+    assert set(state) == {"dataloader1", "dataloader2"}
+    dataloaders["dataloader2"].load_state_dict(state["dataloader2"])
+    batch = next(iter(dataloaders["dataloader2"]))
+    assert [message[0]["content"] for message in batch["message_log"]] == ["4", "5"]
