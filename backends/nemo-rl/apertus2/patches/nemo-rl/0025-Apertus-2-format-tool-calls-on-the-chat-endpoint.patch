+        Wait(),
+    ]
+    first = _first_prompt(encoding)
+    prefix = first + encoding.encode_items(burst)
+    prompt = extend_chat_prompt(
+        TOKENIZER,
+        prefix_token_ids=prefix,
+        messages=[
+            {"role": "user", "content": "Weather?"},
+            _assistant("call_a"),
+            _tool("call_a", "Cold."),
+        ],
+    )
+    assert prompt[: len(prefix)] == prefix
+    assert prompt == encoding.encode_conversation(
+        Conversation(
+            system=_weather_system(),
+            items=[
+                User(payload="Weather?"),
+                *burst,
+                Result(name="get_weather", counter=3, payload="Cold."),
+            ],
+        )
+    )
