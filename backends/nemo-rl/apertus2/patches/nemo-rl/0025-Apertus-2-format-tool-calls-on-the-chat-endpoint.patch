 .../generation/vllm/vllm_worker_async.py      | 117 +++---
 tests/unit/data/test_apertus2_format.py       | 364 +++++++++++++++++-
 .../environments/test_math_environment.py     |   2 +-
 tests/unit/experience/test_rollouts.py        |  29 ++
 7 files changed, 625 insertions(+), 77 deletions(-)

diff --git a/nemo_rl/data/apertus2_format.py b/nemo_rl/data/apertus2_format.py
index 8b3bad357..22956f489 100644
--- a/nemo_rl/data/apertus2_format.py
+++ b/nemo_rl/data/apertus2_format.py
@@ -28,6 +28,21 @@ APERTUS2_OUTPUT_FORMAT = "apertus2"
 LONG_CLAIM_CHARS = 40
 
 
+@dataclass
+class Apertus2Call:
+    """One tool call frame.
+
+    Attributes:
+        name: Name of the tool, which may not be one the system frame declares.
+        counter: The number the model gave the call, which a result must repeat.
+        arguments: The frame's payload, which may not be valid JSON.
+    """
+
+    name: str
+    counter: int
+    arguments: str
+
+
 @dataclass
 class Apertus2Output:
     """One burst of generated tokens, split into the frames rollouts care about.
@@ -36,7 +51,7 @@ class Apertus2Output:
         think: Payloads of the think frames, joined, or None if there is none.
         claim: Payload of the last claim frame, or None if there is none.
         reply: Payloads of the reply frames, joined, or None if there is none.
-        has_call: Whether the burst has a tool call frame.
+        calls: The tool call frames, in order.
         error: The parser's message when the tokens are not valid frames.
         truncated: Whether generation hit the token limit.
     """
@@ -44,7 +59,7 @@ class Apertus2Output:
     think: str | None
     claim: str | None
     reply: str | None
-    has_call: bool
+    calls: list[Apertus2Call]
     error: str | None
     truncated: bool
 
@@ -87,7 +102,11 @@ def encode_prompt(
 
 
 def encode_chat_prompt(
-    tokenizer_path: str, *, system_prompt: str, messages: list[dict[str, Any]]
+    tokenizer_path: str,
+    *,
+    system_prompt: str,
+    messages: list[dict[str, Any]],
+    tools: list[dict[str, Any]] | None,
 ) -> list[int]:
     """Encode OpenAI-style chat messages, ending at ``<|/in|>``.
 
@@ -96,17 +115,95 @@ def encode_chat_prompt(
         system_prompt: The system frame's JSON object, such as
             ``{"thinking":"medium","tools":[]}``.
         messages: The request's messages.
+        tools: The request's OpenAI tool definitions, or None if it has none.
 
     Returns:
         The prompt's token IDs.
     """
     # apertus-common is an optional dependency, needed only by this format.
-    from apertus_common import from_openai
-
-    mapped = from_openai(messages, system_defaults=json.loads(system_prompt))
+    from apertus_common import MappingPolicy, from_openai
+
+    defaults = json.loads(system_prompt)
+    if tools and defaults.get("tools") == []:
+        del defaults["tools"]
+    mapped = from_openai(
+        messages,
+        # vLLM's request model adds fields of its own, which from_openai refuses.
+        tools=[{"type": tool["type"], "function": tool["function"]} for tool in tools]
+        if tools
+        else None,
+        system_defaults=defaults,
+        policy=MappingPolicy(merge_system_messages=True),
+    )
     return _get_encoding(tokenizer_path).encode_conversation(mapped.value)
 
 
+def _message_text(message: dict[str, Any]) -> str:
+    content = message["content"]
+    if isinstance(content, str):
+        return content
+    return "".join(part["text"] for part in content)
+
+
+def extend_chat_prompt(
+    tokenizer_path: str, *, prefix_token_ids: list[int], messages: list[dict[str, Any]]
+) -> list[int]:
+    """Add the messages after the last generated burst to the exact tokens so far.
+
+    The history is not encoded again: OpenAI messages cannot hold claims or a call's
+    counter, and rollouts must extend the tokens that were really generated.
+
+    Args:
+        tokenizer_path: Directory of the Apertus 2 tokenizer.
+        prefix_token_ids: The last prompt and its generated tokens.
+        messages: The request's messages, with the last burst as the last assistant
+            message.
+
+    Returns:
+        The prompt's token IDs, ending at ``<|/in|>``.
+    """
+    # apertus-common is an optional dependency, needed only by this format.
+    from apertus_common import Result, User
+
+    encoding = _get_encoding(tokenizer_path)
+    assert prefix_token_ids[-1] == encoding.controls.wait, (
+        "An Apertus 2 conversation continues only after a burst that ended at <|wait|>."
+    )
+    # A burst cannot contain <|/in|>, because the model may not generate it.
+    burst_start = len(prefix_token_ids) - prefix_token_ids[::-1].index(
+        encoding.controls.input_end
+    )
+    calls = parse_output(
+        tokenizer_path, prefix_token_ids[burst_start:], truncated=False
+    ).calls
+
+    last_assistant = max(
+        index
+        for index, message in enumerate(messages)
+        if message["role"] == "assistant"
+    )
+    call_ids = [call["id"] for call in messages[last_assistant].get("tool_calls", [])]
+    items: list[Any] = []
+    for message in messages[last_assistant + 1 :]:
+        if message["role"] == "tool":
+            call = calls[call_ids.index(message["tool_call_id"])]
+            items.append(
+                Result(
+                    name=call.name,
+                    counter=call.counter,
+                    payload=_message_text(message),
+                )
+            )
+        elif message["role"] == "user":
+            items.append(User(payload=_message_text(message)))
+        else:
+            raise ValueError(
+                f"Cannot continue an Apertus 2 conversation with a {message['role']!r} "
+                "message: expected tool or user."
+            )
+    return prefix_token_ids + encoding.encode_items(items)
+
+
 def allowed_token_ids(tokenizer_path: str) -> list[int]:
     """Return every token ID the model may generate, for vLLM's sampling params."""
     encoding = _get_encoding(tokenizer_path)
@@ -142,7 +239,7 @@ def parse_output(
             think=None,
             claim=None,
             reply=None,
-            has_call=False,
+            calls=[],
             error=str(error),
             truncated=truncated,
         )
@@ -154,7 +251,11 @@ def parse_output(
         think="".join(thoughts) if thoughts else None,
         claim=claims[-1] if claims else None,
         reply="".join(replies) if replies else None,
-        has_call=any(isinstance(item, Call) for item in items),
+        calls=[
+            Apertus2Call(name=item.name, counter=item.counter, arguments=item.payload)
+            for item in items
+            if isinstance(item, Call)
+        ],
         error=None,
         truncated=truncated,
     )
@@ -202,5 +303,5 @@ def frame_metrics(
         "no_claim": float(output.error is None and claim is None),
         "claim_chars": float(len(claim)) if claim else 0.0,
         "long_claim": float(claim is not None and len(claim) > LONG_CLAIM_CHARS),
-        "undeclared_call": float(output.has_call),
+        "undeclared_call": float(bool(output.calls)),
     }
diff --git a/nemo_rl/experience/rollouts.py b/nemo_rl/experience/rollouts.py
index 4038c8c8b..619e890f1 100644
--- a/nemo_rl/experience/rollouts.py
+++ b/nemo_rl/experience/rollouts.py
@@ -304,6 +304,37 @@ def _add_r3_fallback_metrics(
 _ROLLOUT_DUMP_LOCK = threading.Lock()
 
 
+def _tool_call_counts(full_result: dict[str, Any]) -> dict[str, int]:
+    """Count a rollout's tool calls and the ones the model got wrong.
+
+    A bad call goes back to the model as a tool error and the rollout goes on, so
+    nothing else in the metrics shows it.
+
+    Args:
+        full_result: The rollout's result from NeMo-Gym.
+
+    Returns:
+        The number of calls, of calls to undeclared tools, and of calls whose
+        arguments are not JSON.
+    """
+    response = full_result.get("response", {})
+    calls = [
+        item for item in response.get("output", []) if item["type"] == "function_call"
+    ]
+    declared = {tool.get("name") for tool in response.get("tools") or []}
+    bad_arguments = 0
+    for call in calls:
+        try:
+            json.loads(call["arguments"])
+        except json.JSONDecodeError:
+            bad_arguments += 1
+    return {
+        "tool_calls": len(calls),
+        "undeclared_tool_calls": sum(call["name"] not in declared for call in calls),
+        "bad_argument_tool_calls": bad_arguments,
+    }
+
+
 def nemo_gym_rollout_dump_path(env_config: dict[str, Any], filename: str) -> Optional[str]:
     """Return where to save a batch's full Gym results: ``env.rollout_dir``, or nowhere."""
     rollout_dir = env_config.get("rollout_dir")
@@ -3106,6 +3137,7 @@ def _postprocess_single_nemo_gym_group(
                     ),
                     default=0,
                 ),
+                **_tool_call_counts(r["full_result"]),
             }
             for r in results
         ]
@@ -3146,6 +3178,21 @@ def _postprocess_single_nemo_gym_group(
                 batch_size,
                 "total_reward",
             ),
+            **calculate_single_metric(
+                [m["tool_calls"] for m in all_sample_metrics],
+                batch_size,
+                "tool_calls_per_sample",
+            ),
+            **calculate_single_metric(
+                [m["undeclared_tool_calls"] for m in all_sample_metrics],
+                batch_size,
+                "undeclared_tool_calls_per_sample",
+            ),
+            **calculate_single_metric(
+                [m["bad_argument_tool_calls"] for m in all_sample_metrics],
+                batch_size,
+                "bad_argument_tool_calls_per_sample",
+            ),
             "natural_termination_rate": sum(
                 not m["hit_max_tokens"] for m in all_sample_metrics
             )
diff --git a/nemo_rl/models/generation/vllm/utils.py b/nemo_rl/models/generation/vllm/utils.py
index 25761276a..999a2f9d2 100644
--- a/nemo_rl/models/generation/vllm/utils.py
+++ b/nemo_rl/models/generation/vllm/utils.py
@@ -413,21 +413,29 @@ def apply_apertus2_output_to_chat_response_choices(
     response: Any,
     final_request_output: Any,
     tokenizer_path: str,
+    *,
+    tools_declared: bool,
 ) -> Any:
     """Replace chat response text with the frames parsed from the generated tokens.
 
-    The client gets the reply as content and the thinking as reasoning. An output
-    without a reply finishes as ``length``, so that clients treat it as a reply cut
-    off by the token limit.
+    The client gets the reply as content, the thinking as reasoning, and the calls as
+    tool calls with their arguments as written, so that a bad call reaches the agent
+    and its error goes back to the model. An output with neither a reply nor a usable
+    call finishes as ``length``, so that clients treat it as a reply cut off by the
+    token limit.
 
     Args:
         response: The ChatCompletionResponse.
         final_request_output: vLLM's final RequestOutput for the request.
         tokenizer_path: Directory of the Apertus 2 tokenizer.
+        tools_declared: Whether the request has tools. Without any, calls are ignored.
 
     Returns:
         The response, changed in place.
     """
+    # vLLM is installed only where generation runs.
+    from vllm.entrypoints.openai.engine.protocol import FunctionCall, ToolCall
+
     outputs = {output.index: output for output in final_request_output.outputs}
     for choice in response.choices:
         output = parse_output(
@@ -437,7 +445,15 @@ def apply_apertus2_output_to_chat_response_choices(
         )
         choice.message.content = output.reply or ""
         choice.message.reasoning = output.think or None
-        if not output.reply:
+        if tools_declared and output.calls and not output.truncated:
+            choice.message.tool_calls = [
+                ToolCall(
+                    function=FunctionCall(name=call.name, arguments=call.arguments)
+                )
+                for call in output.calls
+            ]
+            choice.finish_reason = "tool_calls"
+        elif not output.reply:
             choice.finish_reason = "length"
     return response
 
