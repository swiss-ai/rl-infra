+    )
+    second_burst = encoding.encode_items(
+        [Call(name="get_weather", counter=0, payload='{"city":"Bern"}'), Wait()]
+    )
+    prefix = _first_prompt(encoding) + first_burst + result + second_burst
+    prompt = extend_chat_prompt(
+        TOKENIZER,
+        prefix_token_ids=prefix,
