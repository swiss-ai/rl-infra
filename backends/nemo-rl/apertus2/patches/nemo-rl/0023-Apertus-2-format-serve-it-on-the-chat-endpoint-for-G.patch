@@ -136,6 +168,7 @@ def test_parse_of_a_cut_off_output(encoding):
 
 def _output(**changes):
     fields = {
+        "think": "Add.",
         "claim": "42",
         "reply": "It is 42.",
         "has_call": False,
@@ -169,3 +202,62 @@ def test_frame_metrics(output, claim_score, reply_score, expected):
