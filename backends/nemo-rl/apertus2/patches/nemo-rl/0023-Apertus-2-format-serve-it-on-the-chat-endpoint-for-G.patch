 import torch
 
+from nemo_rl.data.apertus2_format import parse_output
 from nemo_rl.data.multimodal_utils import (
     VLLM_CONTENT_KEY,
     VLLM_MULTI_MODAL_DATA_KEY,
@@ -408,6 +409,39 @@ def attach_routed_experts_to_chat_response_choices(
     return response
 
 
+def apply_apertus2_output_to_chat_response_choices(
+    response: Any,
+    final_request_output: Any,
+    tokenizer_path: str,
+) -> Any:
+    """Replace chat response text with the frames parsed from the generated tokens.
+
+    The client gets the reply as content and the thinking as reasoning. An output
+    without a reply finishes as ``length``, so that clients treat it as a reply cut
+    off by the token limit.
+
+    Args:
+        response: The ChatCompletionResponse.
+        final_request_output: vLLM's final RequestOutput for the request.
+        tokenizer_path: Directory of the Apertus 2 tokenizer.
+
+    Returns:
+        The response, changed in place.
+    """
+    outputs = {output.index: output for output in final_request_output.outputs}
+    for choice in response.choices:
+        output = parse_output(
+            tokenizer_path,
+            list(outputs[choice.index].token_ids),
+            truncated=choice.finish_reason == "length",
+        )
+        choice.message.content = output.reply or ""
+        choice.message.reasoning = output.think or None
+        if not output.reply:
+            choice.finish_reason = "length"
+    return response
+
+
 def attach_token_information_to_chat_response_choices(
     response: Any,
     final_request_output: Any,
