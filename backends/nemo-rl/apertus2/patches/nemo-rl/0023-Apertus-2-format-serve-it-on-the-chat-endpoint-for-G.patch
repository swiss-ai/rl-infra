+
+
+def _chat_response(finish_reason):
+    message = SimpleNamespace(content="decoded text", reasoning=None)
+    choice = SimpleNamespace(index=0, finish_reason=finish_reason, message=message)
+    return SimpleNamespace(choices=[choice])
+
+
+def _engine_output(token_ids):
+    return SimpleNamespace(outputs=[SimpleNamespace(index=0, token_ids=token_ids)])
+
+
+def test_chat_response_gets_the_reply_and_the_thinking(encoding):
+    tokens = encoding.encode_items(
+        [Think(payload="Add."), Claim(payload="42"), Reply(payload="It is 42."), Wait()]
+    )
+    response = apply_apertus2_output_to_chat_response_choices(
+        _chat_response("stop"), _engine_output(tokens), TOKENIZER
+    )
+    choice = response.choices[0]
+    assert choice.message.content == "It is 42."
+    assert choice.message.reasoning == "Add."
+    assert choice.finish_reason == "stop"
+
+
+def test_an_empty_think_is_no_reasoning(encoding):
+    tokens = encoding.encode_items([Think(payload=""), Reply(payload="Hi."), Wait()])
+    response = apply_apertus2_output_to_chat_response_choices(
+        _chat_response("stop"), _engine_output(tokens), TOKENIZER
+    )
+    assert response.choices[0].message.reasoning is None
+
+
+@pytest.mark.parametrize(
+    "items",
+    [
+        [Think(payload="Only thinking.")],
+        [Think(payload="Add."), Reply(payload=""), Wait()],
+        [Claim(payload="42"), Wait()],
+    ],
+)
+def test_output_without_a_reply_finishes_as_truncated(encoding, items):
+    response = apply_apertus2_output_to_chat_response_choices(
+        _chat_response("stop"), _engine_output(encoding.encode_items(items)), TOKENIZER
+    )
+    choice = response.choices[0]
+    assert choice.message.content == ""
+    assert choice.finish_reason == "length"
+
+
+def test_invalid_frames_finish_as_truncated(encoding):
+    tokens = encoding.encode_items([Reply(payload="42"), Wait()])
+    response = apply_apertus2_output_to_chat_response_choices(
+        _chat_response("stop"),
+        _engine_output([tokens[0], OUTPUT_END, *tokens]),
+        TOKENIZER,
+    )
+    assert response.choices[0].message.content == ""
+    assert response.choices[0].finish_reason == "length"
