+import pytest
+import torch
+
+from nemo_rl.utils import failure_forensics
+
+
+@pytest.fixture
+def forensics_dir(tmp_path, monkeypatch):
+    monkeypatch.setitem(failure_forensics._state, "dir", str(tmp_path))
+    monkeypatch.setitem(failure_forensics._state, "rank", 5)
+    monkeypatch.setitem(failure_forensics._state, "reports", 0)
+    monkeypatch.setitem(failure_forensics._state, "batch", None)
+    monkeypatch.setitem(failure_forensics._state, "train_calls", 0)
+    return tmp_path
+
+
+class Worker:
+    def __init__(self, error):
+        self.model = torch.nn.Linear(2, 2)
+        self.error = error
+        self.batch_seen = None
+
+    @failure_forensics.dump_on_failure
+    def train(self):
+        failure_forensics.note_batch({"input_ids": torch.ones(2, 3), "note": "not a tensor"})
+        self.batch_seen = failure_forensics._state["batch"]
+        self.model(torch.ones(1, 2)).sum().backward()
+        self.model.weight.grad[0, 1] = float("nan")
+        if self.error:
+            raise RuntimeError(self.error)
+        return "done"
+
+
+def test_nan_check_failure_names_the_parameter_and_saves_the_batch(forensics_dir):
+    worker = Worker("Rank 5: found NaN in local grad norm for bucket #0 in backward pass")
+
+    with pytest.raises(RuntimeError, match="found NaN"):
+        worker.train()
+
+    text = next(forensics_dir.glob("nonfinite-rank5-*.txt")).read_text()
+    assert "non-finite gradient elements: 1 of 6, in 1 parameters" in text
+    assert "1\t4\t0\tFalse\tweight" in text
+    assert "bias" not in text
+    saved = torch.load(next(forensics_dir.glob("nonfinite-rank5-*.pt")))
+    assert set(saved) == {"input_ids"}
+    assert saved["input_ids"].shape == (2, 3)
+
+
+def test_expert_parameters_and_main_grad_are_reported(forensics_dir):
+    model = torch.nn.Linear(2, 2)
+    model.weight.grad = torch.zeros_like(model.weight)
+    model.weight.main_grad = torch.full_like(model.weight, float("inf"))
+    model.weight.allreduce = False
+
+    failure_forensics.report_nonfinite_grads(model)
+
+    text = next(forensics_dir.glob("nonfinite-rank5-*.txt")).read_text()
+    assert "4\t4\t0\tTrue\tweight" in text
+
+
+def test_other_failures_do_not_scan_the_gradients(forensics_dir):
+    worker = Worker("some other failure")
+
+    with pytest.raises(RuntimeError, match="some other failure"):
+        worker.train()
+
+    assert not list(forensics_dir.glob("nonfinite-*"))
+
+
+def test_batch_is_released_when_train_returns(forensics_dir):
+    worker = Worker(None)
+
+    assert worker.train() == "done"
+
+    assert worker.batch_seen is not None
+    assert failure_forensics._state["batch"] is None
+
+
+def test_report_failure_does_not_replace_the_original_error(forensics_dir, monkeypatch, capsys):
+    worker = Worker("found Inf in local grad norm for bucket #0")
+    monkeypatch.setattr(torch, "save", lambda *args: (_ for _ in ()).throw(OSError("disk full")))
+
+    with pytest.raises(RuntimeError, match="found Inf"):
+        worker.train()
+
+    assert "gradient report failed" in capsys.readouterr().out
+
+
+def test_test_switch_poisons_the_chosen_train_call_only(forensics_dir, monkeypatch):
+    monkeypatch.setenv("NRL_FORENSICS_TEST_NAN", "2")
+    poisoned = []
+    monkeypatch.setattr(failure_forensics, "_poison_one_grad", poisoned.append)
+    worker = Worker(None)
+
+    worker.train()
+    assert poisoned == []
+    worker.train()
+    assert poisoned == [worker.model]
+    worker.train()
+    assert poisoned == [worker.model]
+
+
+def test_poisoned_gradient_is_nan():
+    model = torch.nn.Linear(2, 2)
+    failure_forensics._poison_one_grad(model)
+
+    model(torch.ones(1, 2)).sum().backward()
+
+    assert torch.isnan(model.weight.grad).all()
