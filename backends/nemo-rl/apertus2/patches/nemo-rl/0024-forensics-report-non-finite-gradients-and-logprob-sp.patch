 .../policy/workers/megatron_policy_worker.py  |   1 +
 nemo_rl/utils/failure_forensics.py            |  69 +++++++++-
 tests/unit/algorithms/test_loss_functions.py  |  37 +++++-
 tests/unit/utils/test_failure_forensics.py    | 122 ++++++++++++++++++
 5 files changed, 274 insertions(+), 2 deletions(-)
