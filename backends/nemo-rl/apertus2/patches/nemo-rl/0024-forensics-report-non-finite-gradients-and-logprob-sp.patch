diff --git a/nemo_rl/algorithms/loss/loss_functions.py b/nemo_rl/algorithms/loss/loss_functions.py
index 282154753..09732161f 100755
--- a/nemo_rl/algorithms/loss/loss_functions.py
+++ b/nemo_rl/algorithms/loss/loss_functions.py
@@ -12,6 +12,7 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 
+import math
 import warnings
 from typing import TYPE_CHECKING, Any, NotRequired, Optional, TypedDict, TypeVar
 
@@ -61,6 +62,41 @@ if TYPE_CHECKING:
 
 Tensor = TypeVar("Tensor", bound=torch.Tensor)
 
+# A token whose log-probability moves this far between get_logprobs and training is
+# reported: that is far more than one training step should move it.
+_LOG_RATIO_SPIKE = 10.0
+_RATIO_SPIKE = math.exp(_LOG_RATIO_SPIKE)
+_MAX_SPIKES_PER_MICROBATCH = 3
+
+
+def _report_ratio_spikes(
+    curr_logprobs: torch.Tensor,
+    prev_logprobs: torch.Tensor,
+    generation_logprobs: torch.Tensor,
+    mask: torch.Tensor,
+    input_ids: torch.Tensor,
+) -> None:
+    """Print the worst tokens of a microbatch past ``_LOG_RATIO_SPIKE``.
+
+    The three log-probabilities show which pass is the odd one out, and the tokens
+    leading up to the spike identify the sequence in the saved rollouts.
+    """
+    log_ratios = curr_logprobs - prev_logprobs
+    spiked = (log_ratios.abs() >= _LOG_RATIO_SPIKE) & mask.bool()
+    rows, positions = spiked.nonzero(as_tuple=True)
+    order = log_ratios[rows, positions].abs().argsort(descending=True)
+    rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+    for i in order[:_MAX_SPIKES_PER_MICROBATCH].tolist():
+        row, pos = rows[i].item(), positions[i].item()
+        print(
+            f"[ratio-spike] rank={rank} row={row} pos={pos} "
+            f"curr={curr_logprobs[row, pos].item():.3f} "
+            f"prev={prev_logprobs[row, pos].item():.3f} "
+            f"gen={generation_logprobs[row, pos].item():.3f} "
+            f"tokens={input_ids[row, max(pos - 6, 0) : pos + 2].tolist()}",
+            flush=True,
+        )
+
 
 class DraftCrossEntropyLossConfig(TypedDict):
     vocab_parallel_group: Optional[torch.distributed.ProcessGroup]
@@ -854,6 +890,17 @@ class ClippedPGLossFn(LossFunction):
                 probs_ratio_max = masked_ratios.max().item()
                 probs_ratio_clamped_min = masked_ratios_clamped.min().item()
                 probs_ratio_clamped_max = masked_ratios_clamped.max().item()
+                if not self.disable_ppo_ratio and (
+                    probs_ratio_max >= _RATIO_SPIKE
+                    or probs_ratio_min <= 1.0 / _RATIO_SPIKE
+                ):
+                    _report_ratio_spikes(
+                        curr_logprobs.detach(),
+                        prev_logprobs,
+                        generation_logprobs,
+                        mask,
+                        data["input_ids"],
+                    )
             else:
                 probs_ratio_min = float("inf")
                 probs_ratio_max = float("-inf")
