     build_exact_token_map,
@@ -3142,3 +3145,35 @@ def test_vocab_parallel_gather_columns_tp_sharded(monkeypatch):
     ref[..., idx].float().backward(grad_out)
     torch.testing.assert_close(shards[0].grad, ref.grad[..., :v_local])
     torch.testing.assert_close(shards[1].grad, ref.grad[..., v_local:])
+
+
+def test_ratio_spikes_are_reported_worst_first_and_capped(capsys):
+    curr = torch.zeros(2, 8)
+    prev = torch.zeros(2, 8)
+    generation = torch.full((2, 8), -1.0)
+    input_ids = torch.arange(18).reshape(2, 9)
+    mask = torch.ones(2, 8)
+    prev[0, 2] = -12.0  # curr far above prev
+    curr[1, 5] = -20.0  # curr far below prev
+    prev[1, 1] = -11.0
+    prev[1, 2] = -10.5
+    prev[0, 7] = -30.0  # the largest, but masked
+    mask[0, 7] = 0.0
+
+    _report_ratio_spikes(curr, prev, generation, mask, input_ids)
+
+    lines = capsys.readouterr().out.strip().splitlines()
+    assert len(lines) == 3
+    assert "row=1 pos=5 curr=-20.000 prev=0.000 gen=-1.000" in lines[0]
+    assert lines[0].endswith("tokens=[9, 10, 11, 12, 13, 14, 15]")
+    assert "row=0 pos=2 curr=0.000 prev=-12.000" in lines[1]
+    assert "row=1 pos=1" in lines[2]
+    assert not any("pos=7" in line for line in lines)
+
+
+def test_no_ratio_spike_prints_nothing(capsys):
+    logprobs = torch.full((1, 4), -1.0)
+
+    _report_ratio_spikes(logprobs, logprobs + 9.9, logprobs, torch.ones(1, 4), torch.zeros(1, 5))
+
+    assert capsys.readouterr().out == ""
