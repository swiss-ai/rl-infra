diff --git a/nemo_rl/utils/failure_forensics.py b/nemo_rl/utils/failure_forensics.py
index 2b2776f02..21d5814a2 100644
--- a/nemo_rl/utils/failure_forensics.py
+++ b/nemo_rl/utils/failure_forensics.py
@@ -27,13 +27,18 @@ Enabled by ``NRL_FORENSICS_DIR`` (one directory per run, shared by all ranks):
   of every live allocation with the Python stack that made it, written for
   out-of-memory errors only (PyTorch's, and NCCL's ``Cuda failure 'out of
   memory'``). Open it at https://pytorch.org/memory_viz.
+- ``nonfinite-rank<r>-<time>.txt``: written when ``train`` fails on Megatron's NaN or
+  Inf gradient check: how many elements are bad overall and in which parameters. The
+  batch this rank was training on goes to the ``.pt`` file of the same name.
 
 ``NRL_FORENSICS_TEST_OOM=1`` makes the first ``train`` call request 1 TiB of GPU
-memory, to check the whole path in a debug run.
+memory, and ``NRL_FORENSICS_TEST_NAN=<n>`` makes the gradient of one parameter NaN from
+the n-th ``train`` call on, to check the whole path in a debug run.
 """
 
 import functools
 import os
+import re
 import socket
 import threading
 import time
@@ -44,6 +49,8 @@ import torch
 
 _GB = float(1 << 30)
 _MAX_REPORTS = 5
+_MAX_NONFINITE_PARAMS = 50
+_NONFINITE_GRAD_ERROR = re.compile(r"found (NaN|Inf) in local grad norm")
 
 _state: dict[str, Any] = {
     "dir": None,
@@ -53,6 +60,8 @@ _state: dict[str, Any] = {
     "history": False,
     "reports": 0,
     "snapshots": 0,
+    "batch": None,
+    "train_calls": 0,
 }
 
 
@@ -134,6 +143,56 @@ def _on_torch_oom(device: int, alloc: int, device_total: int, device_free: int)
     )
 
 
+def note_batch(batch: Any) -> None:
+    """Keep a reference to the batch in training, for ``report_nonfinite_grads``."""
+    _state["batch"] = batch
+
+
+def _poison_one_grad(model: Any) -> None:
+    param = next(p for p in model.parameters() if p.requires_grad)
+    param.register_hook(lambda grad: grad * float("nan"))
+
+
+def report_nonfinite_grads(model: Any) -> None:
+    """Write which parameters hold non-finite gradients, and save the batch in training."""
+    if _state["dir"] is None:
+        return
+    stem = os.path.join(_state["dir"], f"nonfinite-rank{_state['rank']}-{_stamp()}")
+    try:
+        rows = []
+        checked = 0
+        for name, param in model.named_parameters():
+            grad = getattr(param, "main_grad", None)
+            if grad is None:
+                grad = param.grad
+            if grad is None:
+                continue
+            checked += grad.numel()
+            bad = int((~torch.isfinite(grad)).sum().item())
+            if bad:
+                bad_weights = int((~torch.isfinite(param.data)).sum().item())
+                expert = not getattr(param, "allreduce", True)
+                rows.append((bad, grad.numel(), bad_weights, expert, name))
+        rows.sort(reverse=True)
+        with open(f"{stem}.txt", "w") as f:
+            f.write(
+                f"rank={_state['rank']} host={socket.gethostname()} "
+                f"device={_state['device']} phase={_state['phase']}\n"
+                f"non-finite gradient elements: {sum(r[0] for r in rows)} of {checked}, "
+                f"in {len(rows)} parameters\n"
+                "bad_grads\tgrad_size\tbad_weights\texpert\tname\n"
+            )
+            for row in rows[:_MAX_NONFINITE_PARAMS]:
+                f.write("\t".join(str(value) for value in row) + "\n")
+        batch = _state["batch"]
+        if batch is not None:
+            tensors = {k: v.detach().cpu() for k, v in batch.items() if torch.is_tensor(v)}
+            torch.save(tensors, f"{stem}.pt")
+        print(f"[forensics] rank={_state['rank']} wrote {stem}.txt", flush=True)
+    except Exception as e:
+        print(f"[forensics] rank={_state['rank']} gradient report failed: {e!r}", flush=True)
+
+
 def dump_on_failure(fn: Callable) -> Callable:
     """Decorate a worker method so a failure inside it leaves a report behind."""
 
@@ -142,10 +201,18 @@ def dump_on_failure(fn: Callable) -> Callable:
         try:
             if fn.__name__ == "train" and os.environ.get("NRL_FORENSICS_TEST_OOM") == "1":
                 torch.empty(1 << 40, dtype=torch.uint8, device="cuda")
+            if fn.__name__ == "train":
+                _state["train_calls"] += 1
+                if str(_state["train_calls"]) == os.environ.get("NRL_FORENSICS_TEST_NAN"):
+                    _poison_one_grad(args[0].model)
             return fn(*args, **kwargs)
         except Exception as e:
             report(f"exception in {fn.__name__}", e)
+            if _NONFINITE_GRAD_ERROR.search(str(e)):
+                report_nonfinite_grads(args[0].model)
             raise
+        finally:
+            _state["batch"] = None
 
     return wrapper
 
