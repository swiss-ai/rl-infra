+++ b/nemo_rl/data/apertus2_format.py
@@ -67,6 +67,15 @@ class Apertus2Output:
     truncated: bool
 
 
+class TruncatedBurstError(ValueError):
+    """The last burst was cut off before ``<|wait|>``, so the conversation is over.
+
+    Generation stops only at ``<|wait|>`` or at a token limit, and nothing may follow
+    a frame the model did not finish. The server answers this like a prompt that
+    exceeds the context: the client ends the trajectory, as it would there.
+    """
+
+
 @lru_cache(maxsize=1)
 def _get_encoding(tokenizer_path: str) -> Any:
     # apertus-common is an optional dependency, needed only by this format. From
@@ -164,18 +173,34 @@ def extend_chat_prompt(
 
     Returns:
         The prompt's token IDs, ending at ``<|/in|>``.
+
+    Raises:
+        TruncatedBurstError: If the last burst hit a token limit before
+            ``<|wait|>``.
     """
     # apertus-common is an optional dependency, needed only by this format.
     from apertus_common import Result, User
 
     encoding = _get_encoding(tokenizer_path)
-    assert prefix_token_ids[-1] == encoding.controls.wait, (
+    wait = encoding.controls.wait
+    input_end = encoding.controls.input_end
+    if prefix_token_ids[-1] != wait and input_end in prefix_token_ids:
+        # A burst cannot contain <|/in|>, because the model may not generate it.
+        burst = prefix_token_ids[
+            len(prefix_token_ids) - prefix_token_ids[::-1].index(input_end) :
+        ]
+        # Generation stops at the first <|wait|>, so a burst without one was cut
+        # off. Anything else that does not end at <|wait|> is malformed.
+        if burst and wait not in burst:
+            raise TruncatedBurstError(
+                f"The last Apertus 2 burst ({len(burst)} tokens, after a prompt "
+                f"of {len(prefix_token_ids) - len(burst)}) was cut off before "
+                "<|wait|>, so the conversation cannot continue."
+            )
+    assert prefix_token_ids[-1] == wait, (
         "An Apertus 2 conversation continues only after a burst that ended at <|wait|>."
     )
-    # A burst cannot contain <|/in|>, because the model may not generate it.
-    burst_start = len(prefix_token_ids) - prefix_token_ids[::-1].index(
-        encoding.controls.input_end
-    )
+    burst_start = len(prefix_token_ids) - prefix_token_ids[::-1].index(input_end)
     calls = parse_output(
         tokenizer_path, prefix_token_ids[burst_start:], truncated=False
     ).calls
