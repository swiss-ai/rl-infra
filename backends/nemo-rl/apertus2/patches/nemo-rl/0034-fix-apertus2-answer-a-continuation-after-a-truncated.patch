+
+def _apertus2_http_worker(monkeypatch, *, max_model_len):
+    """An Apertus 2 HTTP server in token-in mode, on fake vLLM and apertus-common."""
+    from nemo_rl.data import apertus2_format
+
+    _, _, openai_serving_chat = _install_fake_vllm_openai_modules(monkeypatch)
+
+    async def render(self, *, request, messages, **kwargs):
+        return [messages], [{"prompt_token_ids": [0]}]
+
+    monkeypatch.setattr(
+        sys.modules["vllm.renderers.online_renderer"].OnlineRenderer,
+        "preprocess_chat",
+        render,
+        raising=False,
+    )
+    user = type("User", (), {"__init__": lambda self, payload: None})
+    monkeypatch.setitem(
+        sys.modules,
+        "apertus_common",
+        types.SimpleNamespace(
+            User=user,
+            Result=user,
+            Call=object,
+            Claim=object,
+            Reply=object,
+            Think=object,
+            StreamParseError=Exception,
+        ),
+    )
+    encoding = types.SimpleNamespace(
+        controls=types.SimpleNamespace(
+            wait=_APERTUS2_WAIT, input_end=_APERTUS2_INPUT_END
+        ),
+        encode_items=lambda items: [5, 6, _APERTUS2_INPUT_END] * len(items),
+        output_parser=lambda: types.SimpleNamespace(
+            push_tokens=lambda tokens: None,
+            finish=lambda: types.SimpleNamespace(items=[]),
+        ),
+    )
+    monkeypatch.setattr(apertus2_format, "_get_encoding", lambda path: encoding)
+
+    worker = VllmAsyncGenerationWorkerImpl.__new__(VllmAsyncGenerationWorkerImpl)
+    worker.cfg = {
+        "temperature": 1.0,
+        "top_p": 1.0,
+        "val_temperature": 0.0,
+        "val_top_p": 1.0,
+        "vllm_cfg": {},
+    }
+    worker.llm = MagicMock(model_config="model-config", renderer="renderer")
+    worker._http_engine_client = worker.llm
+    worker.llm_async_engine_args = MagicMock()
+    worker.llm_async_engine_args.create_model_config.return_value = MagicMock(
+        served_model_name="served-model", model="model-path"
+    )
+    worker.is_apertus2 = True
+    worker.model_name = "apertus2-tokenizer"
+    worker.allowed_token_ids = None
+    worker.thinking_token_budget = None
+    # Token capture in token-in mode: the ledger admitted the call with the prefix.
+    worker._capture_calls = {}
+    worker.token_capture = MagicMock()
+    worker._capture_admission = lambda request: types.SimpleNamespace(
+        mode="token_in"
+    )
+    worker._resolve_admission_prefix = lambda admission: list(
+        admission_prefix["ids"]
+    )
+    worker._enter_request_prefix = lambda request, prefix: setattr(
+        request, "required_prefix_token_ids", prefix
+    )
+    worker._abort_request_capture = MagicMock(wraps=worker._abort_request_capture)
+    admission_prefix = {"ids": []}
+
+    app = _FakeFastAPIApp()
+    worker._setup_vllm_openai_api_server(app)
+    serving_chat = openai_serving_chat.instances[0]
+    renderer = serving_chat.kwargs["online_renderer"]
+    renderer.model_config = types.SimpleNamespace(max_model_len=max_model_len)
+    chat_handler = next(
+        handler for path, handler in app.routes if path == "/v1/chat/completions"
+    )
+
+    served = {}
+
+    async def create_chat_completion(request, _raw_request):
+        _, engine_prompts = await renderer.preprocess_chat(
+            request, request.messages, None, "auto", {}
+        )
+        served["prompt_token_ids"] = engine_prompts[0]["prompt_token_ids"]
+        return served["prompt_token_ids"]
+
+    serving_chat.create_chat_completion = create_chat_completion
+
+    async def post(prefix):
+        admission_prefix["ids"] = prefix
+        request = types.SimpleNamespace(
+            top_k=-1,
+            top_p=1.0,
+            temperature=1.0,
+            max_tokens=None,
+            max_completion_tokens=None,
+            required_prefix_token_ids=None,
+            stream=False,
+            messages=[
+                {"role": "user", "content": "Task"},
+                {"role": "assistant", "content": "Working."},
+                {"role": "user", "content": "Go on."},
+            ],
+        )
+        return request, await chat_handler(request, MagicMock())
+
+    return worker, served, post
+
+
+def _assert_context_length_400(worker, request, response):
+    response_content = response.body.decode()
+    assert response.status_code == 400
+    assert "maximum context length" in response_content
+    assert _nemo_gym_recognizes_context_overflow(
+        status=response.status_code, response_content=response_content
+    )
+    error = json.loads(response_content)["error"]
+    assert error["type"] == "invalid_request_error"
+    assert error["param"] == "input_tokens"
+    # The call failed before the capture began it: nothing is staged or committed,
+    # and the one abort finds no state.
+    worker._abort_request_capture.assert_called_once_with(
+        request, reason="context_length"
+    )
+    worker.token_capture.begin_call.assert_not_called()
+    worker.token_capture.fail_call.assert_not_called()
+    worker.token_capture.complete_call_from_response.assert_not_called()
+    assert worker._capture_calls == {}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "burst_len",
+    [
+        pytest.param(124, id="cut_off_at_max_model_len"),
+        pytest.param(20, id="cut_off_at_max_new_tokens"),
+    ],
+)
+async def test_apertus2_continuation_after_a_cut_off_burst_returns_http_400(
+    monkeypatch, burst_len
+):
+    """Production job 5303503: this was an AssertionError, so HTTP 500, retried."""
+    worker, _, post = _apertus2_http_worker(monkeypatch, max_model_len=128)
+    prefix = _APERTUS2_PROMPT + [10] + [1000] * (burst_len - 1)
+    request, response = await post(prefix)
+    _assert_context_length_400(worker, request, response)
+    assert "cut off before <|wait|>" in response.body.decode()
+
+
+@pytest.mark.asyncio
+async def test_apertus2_continuation_beyond_max_model_len_returns_http_400(
+    monkeypatch,
+):
+    """Without a requested max_tokens, the extended prompt is still checked."""
