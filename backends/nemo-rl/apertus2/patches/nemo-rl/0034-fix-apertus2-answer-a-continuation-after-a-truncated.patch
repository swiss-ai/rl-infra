+"""Continuing an Apertus 2 conversation after a burst that was cut off.
+
+These run without apertus-common: a fake encoding stands in for it. The tests
+with the real encoding are in test_apertus2_format.py.
+"""
+
+import sys
+from dataclasses import dataclass
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+from nemo_rl.data import apertus2_format
+from nemo_rl.data.apertus2_format import (
+    TruncatedBurstError,
+    extend_chat_prompt,
+)
+
+INPUT_END = 8
+OUTPUT_START = 10
+OUTPUT_END = 11
+WAIT = 12
+TEXT = 1000
+PROMPT = [1, 2, 3, INPUT_END]
+
+
+@dataclass
+class _Item:
+    payload: str
+
+
+class _User(_Item):
+    pass
+
+
+class _Result(_Item):
+    def __init__(self, *, name, counter, payload):
+        super().__init__(payload)
+
+
+class _FakeEncoding:
+    controls = SimpleNamespace(wait=WAIT, input_end=INPUT_END)
+
+    @staticmethod
+    def encode_items(items):
+        return [token for item in items for token in (5, TEXT, INPUT_END)]
+
+    @staticmethod
+    def output_parser():
+        return SimpleNamespace(
+            push_tokens=lambda tokens: None,
+            finish=lambda: SimpleNamespace(items=[]),
+        )
+
+
+@pytest.fixture(autouse=True)
+def fake_encoding(monkeypatch):
+    """Stands in for apertus-common, which only the job image has."""
+    module = ModuleType("apertus_common")
+    module.User = _User
+    module.Result = _Result
+    module.StreamParseError = type("StreamParseError", (Exception,), {})
+    for name in ("Call", "Claim", "Reply", "Think"):
+        setattr(module, name, type(name, (), {}))
+    monkeypatch.setitem(sys.modules, "apertus_common", module)
+    monkeypatch.setattr(apertus2_format, "_get_encoding", lambda path: _FakeEncoding)
+
+
+def _extend(prefix):
+    return extend_chat_prompt(
+        "tokenizer",
+        prefix_token_ids=prefix,
+        messages=[
+            {"role": "user", "content": "Task"},
+            {"role": "assistant", "content": "Working."},
+            {"role": "user", "content": "Go on."},
+        ],
+    )
+
+
+def test_a_finished_burst_continues():
+    prefix = PROMPT + [OUTPUT_START, TEXT, OUTPUT_END, WAIT]
+    assert _extend(prefix) == prefix + [5, TEXT, INPUT_END]
+
+
+@pytest.mark.parametrize(
+    "burst",
+    [
+        # Cut off inside a frame, at max_model_len or max_new_tokens alike.
+        [OUTPUT_START, TEXT, TEXT],
+        # Cut off right after a frame closed.
+        [OUTPUT_START, TEXT, OUTPUT_END],
+        [OUTPUT_START],
+    ],
+)
+def test_a_burst_cut_off_before_wait_ends_the_conversation(burst):
+    with pytest.raises(TruncatedBurstError, match=r"cut off before <\|wait\|>"):
+        _extend(PROMPT + burst)
+
+
+def test_a_cut_off_burst_after_earlier_turns_ends_the_conversation():
+    earlier = PROMPT + [OUTPUT_START, TEXT, OUTPUT_END, WAIT, 5, TEXT, INPUT_END]
+    with pytest.raises(
+        TruncatedBurstError, match=r"\(3 tokens, after a prompt of 11\)"
+    ):
+        _extend(earlier + [OUTPUT_START, TEXT, TEXT])
+
+
+@pytest.mark.parametrize(
+    "prefix",
+    [
+        # No burst at all.
+        PROMPT,
+        # Tokens after <|wait|>, which ends generation.
+        PROMPT + [OUTPUT_START, TEXT, OUTPUT_END, WAIT, TEXT],
+        # No prompt the burst could follow.
+        [OUTPUT_START, TEXT, TEXT],
+    ],
+)
+def test_other_prefixes_that_do_not_end_at_wait_still_fail_loudly(prefix):
+    with pytest.raises(AssertionError, match=r"ended at <\|wait\|>"):
+        _extend(prefix)
+
+
+def test_the_truncation_error_is_not_an_assertion():
+    """The worker must be able to tell it apart from a broken prefix."""
+    assert not issubclass(TruncatedBurstError, AssertionError)
