+"""Reasoning Gym answers scored in the math environment (verifier_type: reasoning_gym).
+
+Each row's ground truth is a JSON object {"task", "question", "answer", "metadata"}: the
+reasoning_gym task name and the entry its scorer reads. The graded text (the claim frame with
+reward_frame: claim) is reduced to an answer: the last <answer>...</answer>, else the last
+\\boxed{...} with balanced braces, else the whole text. The task's own scorer,
+reasoning_gym.get_score_answer_fn(task)(answer, entry), gives the reward.
+
+- Scorers that eval() or parse_expr the answer are refused (score 0): the answer is model text.
+- Scores below MIN_SCORE count as 0: several scorers give 0.01 to any non-empty wrong answer.
+- Each scorer call runs under a SIGALRM timeout when the worker method runs on the main thread.
+"""
+
+import json
+import re
+import signal
+import threading
+from typing import Any, Union
+
+import ray
+
+# Scorers that run eval() or sympy's parse_expr on the model's answer.
+UNSAFE_TASKS = frozenset(
+    {
+        "n_queens",
+        "spiral_matrix",
+        "binary_matrix",
+        "string_insertion",
+        "countdown",
+        "puzzle24",
+        "simple_integration",
+        "intermediate_integration",
+        "polynomial_multiplication",
+    }
+)
+MIN_SCORE = 0.05
+TIMEOUT_S = 5
+
+_ANSWER_TAG = re.compile(r"<answer>(.*?)</answer>", re.S)
+
+
+def _last_boxed(text: str) -> str | None:
+    """Content of the last \\boxed{...}, braces balanced; None without one."""
+    start = text.rfind("\\boxed{")
+    if start < 0:
+        return None
+    i = start + len("\\boxed{")
+    depth = 1
+    for j in range(i, len(text)):
+        if text[j] == "{":
+            depth += 1
+        elif text[j] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[i:j]
+    return None
+
+
+def extract_answer(text: str) -> str | None:
+    """The answer in a graded frame: <answer> tags, else \\boxed{}, else the stripped text."""
+    text = (text or "").strip()
+    if not text:
+        return None
+    tags = _ANSWER_TAG.findall(text)
+    if tags:
+        return tags[-1].strip()
+    boxed = _last_boxed(text)
+    if boxed is not None:
+        return boxed.strip()
+    return text
+
+
+class _Timeout(Exception):
+    pass
+
+
+def _on_alarm(signum: int, frame: Any) -> None:
+    raise _Timeout()
+
+
+@ray.remote  # pragma: no cover
+class ReasoningGymVerifyWorker:
+    def __init__(self) -> None:
+        # Imported here: only runs with PYDEPS_RG have reasoning-gym in their overlay.
+        import reasoning_gym
+
+        self._rg = reasoning_gym
+        self._score_fns: dict[str, Any] = {}
+
+    def _score_fn(self, task: str) -> Any:
+        if task not in self._score_fns:
+            self._score_fns[task] = self._rg.get_score_answer_fn(task)
+        return self._score_fns[task]
+
+    def _score_one(self, response: str, ground_truth: str) -> tuple[float, str | None]:
+        gt = json.loads(ground_truth)
+        task = gt["task"]
+        answer = extract_answer(response)
+        if answer is None or task in UNSAFE_TASKS:
+            return 0.0, answer
+        entry = {
+            "question": gt.get("question", ""),
+            "answer": gt["answer"],
+            "metadata": gt["metadata"],
+        }
+        on_main = threading.current_thread() is threading.main_thread()
+        if on_main:
+            previous = signal.signal(signal.SIGALRM, _on_alarm)
+            signal.alarm(TIMEOUT_S)
+        try:
+            score = float(self._score_fn(task)(answer=answer, entry=entry))
+        finally:
+            if on_main:
+                signal.alarm(0)
+                signal.signal(signal.SIGALRM, previous)
+        return (score if score >= MIN_SCORE else 0.0), answer
+
+    def verify(
+        self,
+        pred_responses: list[str],
+        ground_truths: list[str],
+        return_extracted_answer: bool = False,
+        **kwargs: Any,
+    ) -> Union[list[float], tuple[list[float], list[str | None]]]:
+        """Score each response with its Reasoning Gym task; one score (and answer) per sample."""
+        results: list[float] = []
+        extracted_answers: list[str | None] = []
+        for response, ground_truth in zip(pred_responses, ground_truths):
+            try:
+                score, answer = self._score_one(response, ground_truth)
+            except (Exception, _Timeout):
+                score, answer = 0.0, None
+            results.append(score)
+            extracted_answers.append(answer)
+        if return_extracted_answer:
+            return results, extracted_answers
+        return results
