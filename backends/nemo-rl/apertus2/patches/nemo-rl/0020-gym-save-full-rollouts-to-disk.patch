From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: davmels <davmelous@gmail.com>
Date: Sat, 31 Oct 2026 19:00:00 +0900
Subject: [PATCH] gym: save full rollouts to disk

The only way to keep complete Gym results was log_nemo_gym_full_result_tables,
which needs W&B and uploads them, and the local dumps hold no text on the Gym
path. env.rollout_dir writes each full result as JSONL: train_weights<N>.jsonl
for the weights that generated it, and validation_step<N>.jsonl. Without
env.rollout_dir nothing is written.
---
diff --git a/nemo_rl/algorithms/async_utils/trajectory_collector.py b/nemo_rl/algorithms/async_utils/trajectory_collector.py
index a7255c5..27168a6 100644
--- a/nemo_rl/algorithms/async_utils/trajectory_collector.py
+++ b/nemo_rl/algorithms/async_utils/trajectory_collector.py
@@ -1521,6 +1521,7 @@ class AsyncTrajectoryCollector:
             # Import here to keep the NeMo-Gym dependency local to its backend.
             from nemo_rl.experience.rollouts import (
                 get_nemo_gym_thinking_tags,
+                nemo_gym_rollout_dump_path,
                 run_async_nemo_gym_rollout,
                 should_mask_flagged_samples,
             )
@@ -1558,6 +1559,11 @@ class AsyncTrajectoryCollector:
                 ),
                 deduplicate_multimodal_data=self._deduplicate_multimodal_data,
                 debug_payload_metrics=self._debug_payload_metrics,
+                # Named for the weights that generated them.
+                rollout_dump_path=nemo_gym_rollout_dump_path(
+                    self.master_config.env,
+                    f"train_weights{self.current_weight_version}.jsonl",
+                ),
             ):
                 task_index = rollout_result.task_index
                 if task_index is None:
