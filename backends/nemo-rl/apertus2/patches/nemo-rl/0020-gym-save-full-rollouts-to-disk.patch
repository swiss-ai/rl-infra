index dbb42bd..18e0677 100644
--- a/nemo_rl/algorithms/grpo.py
+++ b/nemo_rl/algorithms/grpo.py
@@ -109,6 +109,7 @@ from nemo_rl.experience.rollouts import (
     attach_initial_nemo_gym_image_payloads,
     backfill_missing_routed_experts,
     get_nemo_gym_thinking_tags,
+    nemo_gym_rollout_dump_path,
     run_async_multi_turn_rollout,
     run_multi_turn_rollout,
     run_nemo_gym_rollout_sync,
@@ -4364,6 +4365,9 @@ def validate(
                         master_config.grpo.deduplicate_multimodal_data
                     ),
                     debug_payload_metrics=master_config.grpo.debug_payload_metrics,
+                    rollout_dump_path=nemo_gym_rollout_dump_path(
+                        master_config.env, f"validation_step{step}.jsonl"
+                    ),
                 )
                 val_batch = nemo_gym_rollout_result.final_batch
                 gen_metrics = nemo_gym_rollout_result.rollout_metrics
diff --git a/nemo_rl/experience/rollouts.py b/nemo_rl/experience/rollouts.py
index 263fb22..38a518d 100644
--- a/nemo_rl/experience/rollouts.py
+++ b/nemo_rl/experience/rollouts.py
@@ -18,7 +18,9 @@
 import asyncio
 import copy
 import json
+import os
 import statistics
+import threading
 import uuid
 import warnings
 from collections import defaultdict
@@ -298,6 +300,24 @@ def _add_r3_fallback_metrics(
     )
 
 
+_ROLLOUT_DUMP_LOCK = threading.Lock()
+
+
+def nemo_gym_rollout_dump_path(env_config: dict[str, Any], filename: str) -> Optional[str]:
+    """Return where to save a batch's full Gym results: ``env.rollout_dir``, or nowhere."""
+    rollout_dir = env_config.get("rollout_dir")
+    return os.path.join(rollout_dir, filename) if rollout_dir else None
+
+
+def _save_nemo_gym_rollouts(path: str, results: list[dict]) -> None:
+    """Append the full Gym results of one prompt group to ``path`` as JSONL."""
+    lines = "".join(json.dumps(result["full_result"]) + "\n" for result in results)
+    with _ROLLOUT_DUMP_LOCK:
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "a") as f:
+            f.write(lines)
+
+
 def _mask_sample_flags(extras: Iterable[dict[str, Any] | None]) -> torch.Tensor:
     """Return True for samples the environment asks GRPO to mask from loss."""
     return torch.tensor(
@@ -2638,6 +2658,7 @@ async def run_async_nemo_gym_rollout(
     deduplicate_multimodal_data: bool = False,
     debug_payload_metrics: bool = False,
     identity_num_generations: Optional[int] = None,
+    rollout_dump_path: Optional[str] = None,
 ) -> AsyncGenerator[NemoGymRolloutResult, None]:
     """Stream complete NeMo-Gym prompt groups in group-completion order.
 
@@ -2855,6 +2876,7 @@ async def run_async_nemo_gym_rollout(
                         reward_penalty_config=reward_penalty_config,
                         thinking_tags=thinking_tags,
