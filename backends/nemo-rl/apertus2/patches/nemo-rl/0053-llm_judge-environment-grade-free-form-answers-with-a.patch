+_KV_PREFIX = "nrl_judge_pool/"
+
+
+def _publish(name: str, base_urls: list[str], model_name: str) -> None:
+    """Store a pool's server URLs and model name in Ray's key-value store."""
+    from ray.experimental import internal_kv
+
+    internal_kv._internal_kv_put(
+        _KV_PREFIX + name,
+        json.dumps({"base_urls": base_urls, "model": model_name}),
+        overwrite=True,
+    )
+
+
+def judge_pool_address(name: str, timeout_s: float) -> tuple[list[str], str]:
+    """Return a pool's server URLs and model name, waiting up to ``timeout_s`` for it to start.
+
+    Environments are created before the pools start, so they look the pool up when they
+    first need it. ``name`` is ``judge`` for ``env.judge_pool`` and ``judge_<name>`` for an
+    entry of ``env.extra_judge_pools``.
+    """
+    from ray.experimental import internal_kv
+
+    deadline = time.monotonic() + timeout_s
+    while True:
+        value = internal_kv._internal_kv_get(_KV_PREFIX + name)
+        if value:
+            entry = json.loads(value)
+            return entry["base_urls"], entry["model"]
+        if time.monotonic() > deadline:
+            raise TimeoutError(f"Judge pool {name} did not start within {timeout_s} s")
+        time.sleep(5.0)
+
+
