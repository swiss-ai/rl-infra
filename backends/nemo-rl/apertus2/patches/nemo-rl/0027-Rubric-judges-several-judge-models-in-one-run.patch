+    pools = {}
+    if env_configs.get("judge_pool"):
+        pools["judge"] = env_configs["judge_pool"]
+    for name, judge_config in (env_configs.get("extra_judge_pools") or {}).items():
+        pools[f"judge_{name}"] = judge_config
+    return pools
