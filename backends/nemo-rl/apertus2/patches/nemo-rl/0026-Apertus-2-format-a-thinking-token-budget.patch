+def test_think_markers_tokenize_to_the_think_frame():
+    """vLLM finds the budget's markers by token IDs, from these strings."""
+    transformers = pytest.importorskip("transformers")
+    tokenizer = transformers.AutoTokenizer.from_pretrained(TOKENIZER)
+
+    start = tokenizer.encode(APERTUS2_THINK_START, add_special_tokens=False)
+    end = tokenizer.encode(APERTUS2_THINK_END, add_special_tokens=False)
+
+    assert len(start) == 3
+    assert start[0] == OUTPUT_START and start[2] == HEADER_END
+    assert end == [OUTPUT_END]
+
+
 def test_chat_response_gets_the_reply_and_the_thinking(encoding):
