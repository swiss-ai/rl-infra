+def _patch_vllm_thinking_budget_scan(logger) -> None:
+    """Stop vLLM's V1 thinking budget from rescanning a request's output each step.
+
+    While a request thinks, ``_update_think_state`` searches all its output for the
+    end marker on every step, in Python, which costs about 0.7 ms per request at 6,000
+    tokens: as much as a whole engine step on long rollouts. Output already searched
+    cannot gain a marker, so the search resumes where the last one ended.
+    """
+    try:
+        file_to_patch = _get_vllm_file("v1/sample/thinking_budget_state.py")
+    except RuntimeError:
+        logger.warning("Could not locate thinking_budget_state.py for the scan patch.")
+        return
+
+    old_snippet = (
+        "            if end_thinking >= 0:\n"
+        "                end_thinking += scan_offset\n"
+        '            state["end_thinking"] = end_thinking\n'
+    )
+    new_snippet = (
+        "            if end_thinking >= 0:\n"
+        "                end_thinking += scan_offset\n"
+        '            elif state["start_thinking"] >= 0:  # searched output has no end\n'
+        '                state["scan_offset"] = max(\n'
+        "                    scan_offset,\n"
+        '                    len(state.get("output_tok_ids", []))\n'
+        "                    - len(self.think_end_token_ids)\n"
+        "                    + 1,\n"
+        "                )\n"
+        '            state["end_thinking"] = end_thinking\n'
+    )
+
+    with _locked_file_patch(file_to_patch) as (content, write_back):
+        if "# searched output has no end" in content:
+            logger.info("vLLM thinking budget scan patch already applied.")
+            return
+
+        if old_snippet not in content:
+            logger.warning(
+                "Could not apply the thinking budget scan patch: expected block not "
+                "found in %s. The vLLM version may have changed.",
+                file_to_patch,
+            )
+            return
+
+        content = content.replace(old_snippet, new_snippet, 1)
+        write_back(content)
+
+    logger.info("Successfully patched vLLM's thinking budget scan.")
+
+
 def _patch_vllm_radio_layerscale_loader(logger) -> None:
