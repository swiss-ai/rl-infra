From e069ecf4d67eb61d13c837fecfcb48f1beb05e0c Mon Sep 17 00:00:00 2001
From: davmels <davmelous@gmail.com>
Date: Sat, 17 Oct 2026 15:32:24 +0200
Subject: [PATCH 5/5] rollouts: re-raise per-sample generation errors

An error while generating one sample was printed and the sample kept with no
response and reward 0, so a generation backend that fails every request trained
on empty rollouts for hours. Re-raise it, so async GRPO's max_generation_failures
and the synchronous loop stop the run instead.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 nemo_rl/experience/rollouts.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/nemo_rl/experience/rollouts.py b/nemo_rl/experience/rollouts.py
index f77eb1169..263fb2285 100644
--- a/nemo_rl/experience/rollouts.py
+++ b/nemo_rl/experience/rollouts.py
@@ -1395,8 +1395,12 @@ async def run_sample_multi_turn_rollout(
                 )
 
         except Exception as e:
+            # Re-raise: a swallowed error leaves the sample with no response and
+            # reward 0, so a generation backend that fails every request trains on
+            # empty rollouts instead of stopping (async GRPO's
+            # max_generation_failures only sees errors that propagate).
             print(f"Error generating response for sample {sample_idx}: {e}")
-            break
+            raise
 
         # Create single-sample batch for environment interaction
         sample_batch = BatchedDataDict[DatumSpec](
