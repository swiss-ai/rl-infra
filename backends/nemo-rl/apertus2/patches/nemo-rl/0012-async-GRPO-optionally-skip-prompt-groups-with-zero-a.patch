@@ -2412,6 +2417,38 @@ def _build_async_grpo_train_data(
     return train_data
 
 
+def _rows_to_train(
+    rewards: torch.Tensor,
+    prompt_ids: torch.Tensor,
+    loss_tokens: torch.Tensor,
+    multiple: int,
+) -> torch.Tensor:
+    """Rows of the prompt groups whose rewards differ, padded to a multiple of ``multiple``.
+
+    A group whose rewards are all equal has zero GRPO advantage, so its rows add
+    nothing to the policy gradient. The padding takes rows of such groups, those
+    with the fewest loss tokens first, so the count splits evenly into the
+    optimizer steps and data-parallel ranks.
+    """
+    _, group = torch.unique(prompt_ids, dim=0, return_inverse=True)
+    num_groups = int(group.max().item()) + 1
+    r = rewards.float()
+    group_min = torch.full((num_groups,), float("inf")).scatter_reduce(
+        0, group, r, reduce="amin"
+    )
+    group_max = torch.full((num_groups,), float("-inf")).scatter_reduce(
+        0, group, r, reduce="amax"
+    )
+    has_signal = group_max[group] > group_min[group]
+    rows = torch.nonzero(has_signal).flatten()
+    padding = (-rows.numel()) % multiple if rows.numel() else multiple
+    if padding:
+        idle = torch.nonzero(~has_signal).flatten()
+        idle = idle[torch.argsort(loss_tokens[idle])][:padding]
+        rows = torch.cat([rows, idle])
+    return torch.sort(rows).values
+
