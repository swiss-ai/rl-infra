+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""A fixed-model vLLM pool for LLM judges, inside the job's Ray cluster.
+
+``env.judge_pool`` takes nodes out of ``cluster.num_nodes`` next to the trainer and
+inference partitions and serves a judge model on them with the same
+``VllmGeneration`` the policy uses, minus refit. The judge's URLs and model name go
+into the NeMo Gym server that ``gym_model_server`` names, so Gym sees an ordinary
+OpenAI-compatible model.
+
+The judge's ``generation`` block is a complete generation config. It inherits
+nothing from ``policy.generation``, whose settings are specific to the policy model.
+"""
+
+from copy import deepcopy
+from typing import Any, Optional
+
+# Keeps the pool alive: its Ray actors die with their handles.
+_judge_pool: Optional[Any] = None
+
+
+def judge_pool_num_nodes(env_configs: dict[str, Any]) -> int:
+    """Return how many nodes ``env.judge_pool`` takes from the cluster."""
+    judge_config = env_configs.get("judge_pool")
+    return judge_config["num_nodes"] if judge_config else 0
+
+
+def start_judge_pool(
+    env_configs: dict[str, Any], cluster_config: dict[str, Any]
+) -> None:
+    """Start the pool and point its Gym model server at it. No-op without a pool."""
+    global _judge_pool
+    judge_config = env_configs.get("judge_pool")
+    if not judge_config:
+        return
+
+    from nemo_rl.algorithms.utils import get_tokenizer
+    from nemo_rl.distributed.virtual_cluster import RayVirtualCluster
+    from nemo_rl.models.generation import configure_generation_config
+    from nemo_rl.models.generation.vllm import VllmGeneration
+
+    generation_config = deepcopy(judge_config["generation"])
+    tokenizer = get_tokenizer({"name": generation_config["model_name"]})
+    # is_eval: the judge reads its weights from disk, nothing refits it.
+    generation_config = configure_generation_config(
+        generation_config, tokenizer, is_eval=True
+    )
+
+    gpus_per_node = cluster_config["gpus_per_node"]
+    judge_cluster = RayVirtualCluster(
+        name="grpo_judge_cluster",
+        bundle_ct_per_node_list=[gpus_per_node] * judge_config["num_nodes"],
+        use_gpus=True,
+        num_gpus_per_node=gpus_per_node,
+        max_colocated_worker_groups=1,
+        port_range_low=cluster_config.get("master_port_range_low"),
+        port_range_high=cluster_config.get("master_port_range_high"),
+    )
+    _judge_pool = VllmGeneration(
+        cluster=judge_cluster, config=generation_config, name_prefix="vllm_judge"
+    )
+    _judge_pool.finish_generation()
+
+    server_name = judge_config.get("gym_model_server", "judge_model")
+    model_server = (
+        env_configs["nemo_gym"]
+        .setdefault(server_name, {})
+        .setdefault("responses_api_models", {})
+        .setdefault("vllm_model", {})
+    )
+    model_server["base_url"] = list(_judge_pool.dp_openai_server_base_urls)
+    model_server["model"] = generation_config["model_name"]
+    print(
+        f"  ✓ Judge pool ready on {judge_config['num_nodes']} node(s): "
+        f"{model_server['base_url']}",
+        flush=True,
+    )
-- 
