From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: davmels <davmelous@gmail.com>
Date: Sat, 31 Oct 2026 05:00:00 +0900
Subject: [PATCH] grpo: serve an LLM judge on its own nodes

env.judge_pool takes nodes out of cluster.num_nodes, next to the trainer
and inference partitions, and serves a fixed judge model on them with the
same VllmGeneration the policy uses. Its URLs and model name go into the
NeMo Gym model server it names, so a resources server can call the judge
like any other model. Without env.judge_pool nothing changes.

Gym's own local_vllm_model does not fit this image: it needs a vLLM of its
own and replaces vLLM's create_dp_placement_groups with a copy written for
another version.
---
diff --git a/nemo_rl/algorithms/grpo.py b/nemo_rl/algorithms/grpo.py
index 86efeca..dbb42bd 100644
--- a/nemo_rl/algorithms/grpo.py
+++ b/nemo_rl/algorithms/grpo.py
@@ -86,6 +86,7 @@ from nemo_rl.distributed.virtual_cluster import (
     prepare_segment_topology,
 )
 from nemo_rl.environments.interfaces import EnvironmentInterface
+from nemo_rl.environments.judge_pool import judge_pool_num_nodes, start_judge_pool
 from nemo_rl.environments.nemo_gym import (
     NemoGymShardSet,
     build_nemo_gym_actors,
@@ -848,6 +849,8 @@ def setup(
         as it is the K of a sharded one.
         """
         t0 = time.perf_counter()
+        # First: Gym's config needs the judges' URLs.
+        start_judge_pool(env_configs, cluster_config)
         shard_set = build_nemo_gym_actors(
             env_configs,
             base_urls=base_urls,
@@ -886,10 +889,12 @@ def setup(
     if total_nodes == 1:
         policy_nodes = total_nodes
     else:
-        policy_nodes = total_nodes - rm_nodes
+        judge_nodes = judge_pool_num_nodes(env_configs)
+        policy_nodes = total_nodes - rm_nodes - judge_nodes
         assert policy_nodes > 0, (
             "policy_nodes must be > 0, but got "
-            f"policy_nodes:{policy_nodes} + rm_nodes:{rm_nodes} = total_nodes:{total_nodes}"
+            f"policy_nodes:{policy_nodes} + rm_nodes:{rm_nodes} + judge_nodes:{judge_nodes} "
+            f"= total_nodes:{total_nodes}"
         )
 
     # Reserve nodes for non-colocated OPD teachers so training doesn't claim them.
diff --git a/nemo_rl/environments/judge_pool.py b/nemo_rl/environments/judge_pool.py
new file mode 100644
index 0000000..8d5671a
--- /dev/null
+++ b/nemo_rl/environments/judge_pool.py
@@ -0,0 +1,88 @@
