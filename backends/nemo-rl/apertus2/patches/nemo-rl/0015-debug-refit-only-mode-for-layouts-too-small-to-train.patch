+"""Refits without optimizer steps, for debug runs on layouts too small to train.
+
+``NRL_DEBUG_REFIT_ONLY=<eps>`` makes the Megatron worker's ``train`` run the forward
+pass only (as in eval mode) and then scale every weight by ``1 + eps`` and, on the
+next call, back by ``1 / (1 + eps)``. Each step therefore still ends with a refit that
+sends changed weights to the generation engines while they are generating, without
+the optimizer step (whose CPU-offloaded state the 4-node debug layout cannot hold).
+Use an eps of at least 0.01: smaller factors leave most bfloat16 weights unchanged.
+"""
+
+import os
+from typing import Any
+
+import torch
+
+
+_calls = 0
+
+
+def enabled() -> bool:
+    return float(os.environ.get("NRL_DEBUG_REFIT_ONLY", "0")) != 0
+
+
+def after_train(model: Any) -> None:
+    """Scale the weights for the coming refit; call at the end of ``train``."""
+    global _calls
+    eps = float(os.environ.get("NRL_DEBUG_REFIT_ONLY", "0"))
+    if eps == 0:
+        return
+    _calls += 1
+    scale = 1 + eps if _calls % 2 else 1 / (1 + eps)
+    with torch.no_grad():
+        for param in model.parameters():
+            param.mul_(scale)
+    print(
+        f"[debug-refit] train call {_calls}: weights scaled by {scale:.6f}", flush=True
+    )
