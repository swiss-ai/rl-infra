diff --git a/tests/unit/models/generation/test_vllm_generation.py b/tests/unit/models/generation/test_vllm_generation.py
index d8a33e575..eb684f17c 100644
--- a/tests/unit/models/generation/test_vllm_generation.py
+++ b/tests/unit/models/generation/test_vllm_generation.py
@@ -994,6 +994,22 @@ _APERTUS2_WAIT = 12
 _APERTUS2_PROMPT = [1, 2, 3, _APERTUS2_INPUT_END]
 
 
+class _FakeAdapterError(Exception):
+    """Stands in for apertus_common.errors.AdapterError; not a ValueError on purpose."""
+
+
+def _fake_from_openai(messages, **kwargs):
+    """Like apertus-common's from_openai: it refuses message fields it does not know."""
+    known = {"role", "content", "tool_calls", "tool_call_id", "name"}
+    for index, message in enumerate(messages):
+        unsupported = sorted(set(message) - known)
+        if unsupported:
+            raise _FakeAdapterError(
+                f"openai message {index}: unsupported fields: {unsupported}"
+            )
+    return types.SimpleNamespace(value="conversation")
+
+
 def _apertus2_http_worker(monkeypatch, *, max_model_len):
     """An Apertus 2 HTTP server in token-in mode, on fake vLLM and apertus-common."""
     from nemo_rl.data import apertus2_format
@@ -1021,13 +1037,21 @@ def _apertus2_http_worker(monkeypatch, *, max_model_len):
             Reply=object,
             Think=object,
             StreamParseError=Exception,
+            MappingPolicy=lambda **kwargs: None,
+            from_openai=_fake_from_openai,
         ),
     )
+    monkeypatch.setitem(
+        sys.modules,
+        "apertus_common.errors",
+        types.SimpleNamespace(AdapterError=_FakeAdapterError),
+    )
     encoding = types.SimpleNamespace(
         controls=types.SimpleNamespace(
             wait=_APERTUS2_WAIT, input_end=_APERTUS2_INPUT_END
         ),
         encode_items=lambda items: [5, 6, _APERTUS2_INPUT_END] * len(items),
+        encode_conversation=lambda conversation: list(_APERTUS2_PROMPT),
         output_parser=lambda: types.SimpleNamespace(
             push_tokens=lambda tokens: None,
             finish=lambda: types.SimpleNamespace(items=[]),
@@ -1051,6 +1075,7 @@ def _apertus2_http_worker(monkeypatch, *, max_model_len):
     )
     worker.is_apertus2 = True
     worker.model_name = "apertus2-tokenizer"
+    worker.apertus2_system_prompt = '{"thinking":"medium","tools":[]}'
     worker.allowed_token_ids = None
     worker.thinking_token_budget = None
     # Token capture in token-in mode: the ledger admitted the call with the prefix.
@@ -1088,7 +1113,7 @@ def _apertus2_http_worker(monkeypatch, *, max_model_len):
 
     serving_chat.create_chat_completion = create_chat_completion
 
-    async def post(prefix):
+    async def post(prefix, messages=None):
         admission_prefix["ids"] = prefix
         request = types.SimpleNamespace(
             top_k=-1,
@@ -1098,7 +1123,8 @@ def _apertus2_http_worker(monkeypatch, *, max_model_len):
             max_completion_tokens=None,
             required_prefix_token_ids=None,
             stream=False,
-            messages=[
+            messages=messages
+            or [
                 {"role": "user", "content": "Task"},
                 {"role": "assistant", "content": "Working."},
                 {"role": "user", "content": "Go on."},
@@ -1185,6 +1211,81 @@ async def test_apertus2_continuation_after_a_malformed_prefix_still_fails(
     }
 
 
+def _assert_invalid_history_400(worker, request, response, original_error):
+    response_content = response.body.decode()
+    assert response.status_code == 400
+    assert original_error in json.loads(response_content)["error"]["message"]
+    # Not a context overflow: Gym must not end the trajectory as one.
+    assert "context length" not in response_content
+    assert not _nemo_gym_recognizes_context_overflow(
+        status=response.status_code, response_content=response_content
+    )
+    error = json.loads(response_content)["error"]
+    assert error["type"] == "invalid_request_error"
+    assert error["param"] == "messages"
+    # The call failed before the capture began it: nothing is staged or committed.
+    worker._abort_request_capture.assert_called_once()
+    worker.token_capture.begin_call.assert_not_called()
+    worker.token_capture.complete_call_from_response.assert_not_called()
+    assert worker._capture_calls == {}
+
+
+def _apertus2_http_worker_without_prefix(monkeypatch):
+    """The admitted call has no token prefix, so the full history is encoded again."""
+    worker, served, post = _apertus2_http_worker(monkeypatch, max_model_len=128)
+    worker._resolve_admission_prefix = lambda admission: None
+    return worker, served, post
+
+
+@pytest.mark.asyncio
+async def test_apertus2_history_without_prefix_is_encoded_again(monkeypatch):
+    worker, served, post = _apertus2_http_worker_without_prefix(monkeypatch)
+    await post(None)
+    assert served["prompt_token_ids"] == _APERTUS2_PROMPT
+    worker.token_capture.begin_call.assert_called_once()
+
+
+@pytest.mark.asyncio
+async def test_apertus2_history_that_cannot_be_encoded_returns_http_400(
+    monkeypatch,
+):
+    """Production job 5316800: from_openai refused Gym's ``reasoning`` field on
+    an assistant message; the AdapterError became HTTP 500, which is retried."""
+    worker, _, post = _apertus2_http_worker_without_prefix(monkeypatch)
+    request, response = await post(
+        None,
+        messages=[
+            {"role": "user", "content": "Task"},
+            {"role": "assistant", "content": "Working.", "reasoning": "Hm."},
+            {"role": "user", "content": "Go on."},
+        ],
+    )
+    _assert_invalid_history_400(
+        worker,
+        request,
+        response,
+        "openai message 1: unsupported fields: ['reasoning']",
+    )
+
+
+@pytest.mark.asyncio
+async def test_apertus2_continuation_that_cannot_be_encoded_returns_http_400(
+    monkeypatch,
+):
+    worker, _, post = _apertus2_http_worker(monkeypatch, max_model_len=128)
+    request, response = await post(
+        _APERTUS2_PROMPT + [10, 1000, 11, _APERTUS2_WAIT],
+        messages=[
+            {"role": "user", "content": "Task"},
+            {"role": "assistant", "content": "Working."},
+            {"role": "system", "content": "Be brief."},
+        ],
+    )
+    _assert_invalid_history_400(
+        worker, request, response, "with a 'system' message: expected tool or user"
+    )
+
+
 def test_nano_v3_reasoning_parser_swaps_reasoning_when_thinking_disabled(
     monkeypatch,
 ):
