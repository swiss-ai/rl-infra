@@ -840,6 +840,15 @@ class VllmAsyncGenerationWorkerImpl(
 
                 return super().model_post_init(context)
 
+        def _invalid_apertus2_history(problem, error):
+            """A request whose messages the format refuses: the client's error.
+
+            HTTP 400 is not retried, unlike the 500 an uncaught error becomes.
+            """
+            message = f"The request's chat history {problem}: {error}"
+            LOGGER.warning("Invalid Apertus 2 chat history: %s", message)
+            return VLLMValidationError(message, parameter="messages")
+
         class NeMoRLOpenAIServingMixin:
             @staticmethod
             def _set_max_tokens(request, max_tokens: int) -> None:
@@ -965,12 +974,17 @@ class VllmAsyncGenerationWorkerImpl(
                     or request.required_prefix_token_ids is None
                 ):
                     if worker_self.is_apertus2:
-                        res[1][0]["prompt_token_ids"] = encode_chat_prompt(
-                            worker_self.model_name,
-                            system_prompt=worker_self.apertus2_system_prompt,
-                            messages=messages_for_replace_prefix_tokens,
-                            tools=apertus2_tool_dicts,
-                        )
+                        try:
+                            res[1][0]["prompt_token_ids"] = encode_chat_prompt(
+                                worker_self.model_name,
+                                system_prompt=worker_self.apertus2_system_prompt,
+                                messages=messages_for_replace_prefix_tokens,
+                                tools=apertus2_tool_dicts,
+                            )
+                        except ValueError as error:
+                            raise _invalid_apertus2_history(
+                                "cannot be encoded as an Apertus 2 prompt", error
+                            ) from error
                     # Clamp the request's max output tokens so that input + output <= max_model_len.
                     # Apertus 2 replaced the prompt vLLM checked, so this always runs.
                     self._clamp_max_tokens(
@@ -1010,6 +1024,10 @@ class VllmAsyncGenerationWorkerImpl(
                             parameter="input_tokens",
                             value=len(model_prefix_token_ids),
                         ) from error
+                    except ValueError as error:
+                        raise _invalid_apertus2_history(
+                            "cannot continue the Apertus 2 conversation", error
+                        ) from error
                 else:
                     # Token-in splice path — shared by staging_chain and direct prefix.
                     last_assistant_message_idx = None
diff --git a/tests/unit/data/test_apertus2_format.py b/tests/unit/data/test_apertus2_format.py
index aebc2fc4c..7ce2e8714 100644
