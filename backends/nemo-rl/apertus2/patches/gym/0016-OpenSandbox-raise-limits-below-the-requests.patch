OpenSandbox provider: a limit below its request is raised to the request. resource_requests is
one map for every sandbox, the limits come from each task.toml, and Kubernetes rejects a pod whose
request exceeds its limit ("spec.containers[0].resources.requests: Invalid value: "3Gi": must be
less than or equal to memory limit of 2Gi"). OpenSandbox then leaves the sandbox Pending until
POD_READY_TIMEOUT (600 s), Gym retries, and the trial ends in EnvironmentStartTimeoutError while it
holds a harbor_agent concurrency slot: with memory_mib 3072, 255 of 588 task images (2 GiB limit)
never started and only ~1068 of 1800 slots had a sandbox (run t2-verified-1k-20261127-135337).
Applies to cpu, memory_mib and disk_gib; a resource without a limit keeps none; each distinct raise
is logged once at INFO.

diff --git a/nemo_gym/sandbox/providers/opensandbox/provider.py b/nemo_gym/sandbox/providers/opensandbox/provider.py
index 51ea6020b..c23bcac18 100644
--- a/nemo_gym/sandbox/providers/opensandbox/provider.py
+++ b/nemo_gym/sandbox/providers/opensandbox/provider.py
@@ -340,6 +340,29 @@ def _resource_map(resources: SandboxResources) -> dict[str, str]:
     return values
 
 
+_RAISED_LIMITS_LOGGED: set[tuple[str, Any, Any]] = set()
+
+
+def _raise_limits_to_requests(limits: SandboxResources, requests: SandboxResources) -> SandboxResources:
+    """Raise each limit below its request to the request.
+
+    The requests are one map for every sandbox, the limits come from each task, and Kubernetes
+    rejects a pod whose request exceeds its limit; OpenSandbox then leaves the sandbox Pending until
+    the ready timeout. A resource without a limit keeps none. Each raise is logged once.
+    """
+    raised: dict[str, Any] = {}
+    for name in ("cpu", "memory_mib", "disk_gib"):
+        limit, request = getattr(limits, name), getattr(requests, name)
+        if limit is not None and request is not None and request > limit:
+            raised[name] = request
+            if (name, limit, request) not in _RAISED_LIMITS_LOGGED:
+                _RAISED_LIMITS_LOGGED.add((name, limit, request))
+                LOGGER.info(
+                    "OpenSandbox: %s limit %s is below the request %s; raised to the request", name, limit, request
+                )
+    return replace(limits, **raised) if raised else limits
+
+
