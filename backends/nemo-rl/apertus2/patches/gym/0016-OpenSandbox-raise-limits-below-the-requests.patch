+async def test_direct_create_raises_limits_below_the_requests(
+    fake_opensandbox_sdk: None,
+) -> None:
+    # Kubernetes rejects a pod whose request exceeds its limit ("must be less than or equal to memory
+    # limit"), and the sandbox then stays Pending until the ready timeout. A limit below the request
+    # is raised to the request; limits above it, and resources without a limit, stay as they are.
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+
+    await provider.create(
+        SandboxSpec(
+            image="mirror.gcr.io/astral/uv:python3.12-bookworm-slim",
+            resources={"cpu": 1, "memory_mib": 2048},
+            provider_options={"resource_requests": {"cpu": 0.5, "memory_mib": 3072, "disk_gib": 1}},
+        ),
+    )
+
+    assert FakeSandbox.created_kwargs["resource"] == {"cpu": "1", "memory": "3072Mi"}
+    assert FakeSandbox.created_kwargs["resource_requests"] == {
+        "cpu": "0.5",
+        "memory": "3072Mi",
+        "ephemeral-storage": "1Gi",
+    }
+
+    await provider.create(
+        SandboxSpec(
+            image="mirror.gcr.io/astral/uv:python3.12-bookworm-slim",
+            resources={"cpu": 1, "memory_mib": 2048, "disk_gib": 10},
+            provider_options={"resource_requests": {"cpu": 2, "memory_mib": 1024, "disk_gib": 20}},
+        ),
+    )
+
+    assert FakeSandbox.created_kwargs["resource"] == {"cpu": "2", "memory": "2048Mi", "ephemeral-storage": "20Gi"}
+    assert FakeSandbox.created_kwargs["resource_requests"] == {
+        "cpu": "2",
+        "memory": "1024Mi",
+        "ephemeral-storage": "20Gi",
+    }
