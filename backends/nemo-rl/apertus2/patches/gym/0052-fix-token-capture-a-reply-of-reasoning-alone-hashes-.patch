From 6ab0e09c8f52d4564ae03edf09156b7e23638f6f Mon Sep 17 00:00:00 2001
From: Lukas Drescher <lukas.drescher@cscs.ch>
Date: Thu, 26 Nov 2026 11:50:33 +0100
Subject: [PATCH] fix(token-capture): a reply of reasoning alone hashes the
 empty-turn marker

A standalone reasoning item neither opened nor closed a turn, so a reply that is only reasoning added nothing
to its call's continuation fingerprint: it equalled the request's, which is the parent's continuation. When a
harness drops such a reply and sends the request again, the new request matches both calls and resolves as
ambiguous, and every later call of the rollout is poisoned.

Seen with Claude Code 2.1.326 on Apertus 2 (rl-infra job 1061395, two of 32 rollouts): the policy ended a turn
inside its reasoning, NeMo-RL finished the reply as `length` (no reply and no usable call), and Claude Code
answered max_tokens by dropping it and re-sending the request with "Output token limit hit. Resume directly"
added. An empty text reply already hashed the empty-turn marker and resolved to the earlier call.

A reasoning item now opens a turn (and still closes none, and hashes nothing), so a reasoning-only reply
hashes the empty-turn marker; reasoning before text or a call is excluded as before. FINGERPRINT_VERSION 7.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 nemo_gym/token_id_capture/fingerprint.py      |  12 +-
 ...test_token_capture_reasoning_only_reply.py | 155 ++++++++++++++++++
 .../test_token_capture_schema_echo.py         |   2 +-
 3 files changed, 165 insertions(+), 4 deletions(-)
 create mode 100644 tests/unit_tests/test_token_capture_reasoning_only_reply.py

diff --git a/nemo_gym/token_id_capture/fingerprint.py b/nemo_gym/token_id_capture/fingerprint.py
index 462d3134..1bdccc4d 100644
--- a/nemo_gym/token_id_capture/fingerprint.py
+++ b/nemo_gym/token_id_capture/fingerprint.py
@@ -44,7 +44,8 @@ import orjson
 # Increment when fingerprint canonicalization or hash layout changes.
 # Resolvers ignore entries stamped with a different version.
 # 6: tool arguments normalized against the request's tool schemas; non-object JSON arguments hash the marker.
-FINGERPRINT_VERSION = 6
+# 7: a standalone reasoning item opens a turn, so a reply of reasoning alone hashes the empty-turn marker.
+FINGERPRINT_VERSION = 7
 
 _FINGERPRINT_DOMAIN = b"nemo-gym-lineage"
 _CONTEXT_DOMAIN = b"nemo-gym-lineage-context"
@@ -75,7 +76,7 @@ def assistant_fingerprint(messages: list[dict]) -> str:
     Dialect-specific tool-call shapes normalize to the same hash input.
 
     A turn is a run of consecutive model-authored items.
-    A turn with no text and no tool call (an empty reply) hashes an explicit marker.
+    A turn with no text and no tool call (an empty reply, or a reply of reasoning alone) hashes an explicit marker.
     Without it, the call that produced an empty reply would share its parent's fingerprint.
     The next request would then match both calls and resolve as ambiguous.
     Non-empty turns hash exactly as before, so their fingerprints do not change.
@@ -101,7 +102,12 @@ def assistant_fingerprint(messages: list[dict]) -> str:
             raise ValueError(f"request item is not an object: {type(message).__name__}")
         if not _is_assistant_authored(message):
             if message.get("type") == "reasoning":
-                # Excluded like reasoning content; it neither opens nor closes a turn.
+                # Excluded like reasoning content and closes no turn. It opens one, though: a reply of reasoning
+                # alone then hashes the empty-turn marker, as an empty reply does, instead of its request's
+                # fingerprint. Otherwise a harness that drops such a reply and sends its request again (Claude Code
+                # after a reply that finished as `length`) continues both that call and its parent: ambiguous.
+                if run_hashed is None:
+                    run_hashed = False
                 continue
             if run_hashed is False:
                 _update_field(hasher, b"\x05", "")
diff --git a/tests/unit_tests/test_token_capture_reasoning_only_reply.py b/tests/unit_tests/test_token_capture_reasoning_only_reply.py
new file mode 100644
index 00000000..f097f0a1
--- /dev/null
+++ b/tests/unit_tests/test_token_capture_reasoning_only_reply.py
@@ -0,0 +1,155 @@
