+++ b/tests/unit_tests/test_token_capture_schema_echo.py
@@ -113,7 +113,7 @@ EDIT = {"file_path": "/app/hello.py", "old_string": "Hello", "new_string": "Hi"}
 
 
 def test_fingerprint_version_is_bumped() -> None:
-    assert FINGERPRINT_VERSION == 6
+    assert FINGERPRINT_VERSION == 7
 
 
 def test_an_echo_with_the_schema_default_filled_in_continues_the_served_call() -> None:
