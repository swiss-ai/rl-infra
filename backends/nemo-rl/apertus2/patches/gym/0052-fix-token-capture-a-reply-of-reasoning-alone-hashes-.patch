+"""A reply of reasoning alone does not share its request's fingerprint.
+
+Observed with Claude Code 2.1.326 on Apertus 2 (rl-infra job 1061395, two of 32 rollouts): the policy ended a
+turn inside its reasoning, so the reply was one reasoning item and the server finished it as ``length``. Claude
+Code answers ``max_tokens`` by dropping the reply and sending the request again with "Output token limit hit.
+Resume directly ..." added after the last tool result. Reasoning is not hashed, so the dropped call's
+continuation fingerprint equalled its request's, which is its parent's continuation: the resent request matched
+both calls, resolved as ambiguous, and every later call of the rollout was poisoned. An empty text reply already
+hashed the empty-turn marker and resolved; a standalone reasoning item now opens a turn as well.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from nemo_gym.token_id_capture.fingerprint import FINGERPRINT_VERSION, assistant_fingerprint
+from nemo_gym.token_id_capture.lineage import FileLineageStore, InMemoryLineageStore
+from nemo_gym.token_id_capture.records import ParentResolutionStatus
+from nemo_gym.token_id_capture.staging.digest import EMPTY_EXTRAS_DIGEST, compute_chain_hash, hash_token_ids
+from nemo_gym.token_id_capture.staging.records import CallRecord, CaptureLedgerCommit
+
+
+USER = {"role": "user", "content": "Fix the failing test in /workspace."}
+REASONING = {"type": "reasoning", "summary": [{"type": "summary_text", "text": "Let me look at the repository."}]}
+CALL = {"type": "function_call", "call_id": "chatcmpl-tool-1", "name": "Bash", "arguments": '{"command": "ls"}'}
+RESULT = {"type": "function_call_output", "call_id": "chatcmpl-tool-1", "output": "setup.py\nsrc\ntests"}
+# the reply that ended inside its reasoning (a tool call written as JSON in the thinking)
+REASONING_ONLY = {
+    "type": "reasoning",
+    "summary": [{"type": "summary_text", "text": 'I will edit it: {"file_path": "src/a.py", "old_string": "x"}'}],
+}
+RESUME = {"role": "user", "content": "Output token limit hit. Resume directly - no apology, no recap."}
+EMPTY_REPLY = {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": ""}]}
+
+
+class _Ledger:
+    """Commit calls into a ledger as the external-staging commit hook does (see test_token_capture_invalid_tool_echo)."""
+
+    def __init__(self, store, rollout_id: str = "r1") -> None:
+        self.store, self.rollout_id = store, rollout_id
+        self.tokens: list[int] = []
+        self.chain_hash: str | None = None
+        self.staging_chain: list[str] = []
+        self.calls: list[str] = []
+
+    async def commit(self, request_items: list[dict], response_items: list[dict], parent: str | None) -> str:
+        call_id = f"c{len(self.calls) + 1}"
+        prev_len = len(self.tokens)
+        delta = list(range(prev_len + 1000, prev_len + 1010))
+        self.tokens += delta
+        self.chain_hash = compute_chain_hash(self.chain_hash, delta)
+        staging_key = f"{self.rollout_id}/{call_id}"
+        self.staging_chain = self.staging_chain + [staging_key]
+        record = CallRecord(
+            model_call_id=call_id,
+            parent_call_id=parent,
+            staging_key=staging_key,
+            weight_version=1,
+            prev_len=prev_len,
+            delta_len=len(delta),
+            cum_len=len(self.tokens),
+            digest="a" * 64,
+            extras_digest=EMPTY_EXTRAS_DIGEST,
+            mode="text" if parent is None else "token_in",
+            response_id=f"chatcmpl-{call_id}",
+            admitted_at=1.0,
+            chain_hash=self.chain_hash,
+            cumulative_hash=hash_token_ids(self.tokens),
+            fingerprint_version=FINGERPRINT_VERSION,
+        )
+        await self.store.record(
+            CaptureLedgerCommit(
+                rollout_id=self.rollout_id,
+                record=record,
+                staging_chain=tuple(self.staging_chain),
+                request_items=request_items,
+                response_items=response_items,
+            )
+        )
+        self.calls.append(call_id)
+        return call_id
+
+
+@pytest.fixture(params=["file", "memory"])
+def store(request, tmp_path):
+    return FileLineageStore(tmp_path) if request.param == "file" else InMemoryLineageStore()
+
+
+async def _serve(store, second_reply: list[dict]) -> _Ledger:
+    """Call 1 runs `ls`; call 2, on its result, is answered with ``second_reply``."""
+    ledger = _Ledger(store)
+    first = await ledger.commit([USER], [REASONING, CALL], parent=None)
+    await ledger.commit([USER, REASONING, CALL, RESULT], second_reply, parent=first)
+    return ledger
+
+
+# --- fingerprint level -------------------------------------------------------
+
+
+def test_a_reply_of_reasoning_alone_changes_the_fingerprint():
+    request = [USER, REASONING, CALL, RESULT]
+    assert assistant_fingerprint(request + [REASONING_ONLY]) != assistant_fingerprint(request)
+
+
+def test_it_hashes_as_an_empty_reply():
+    request = [USER, REASONING, CALL, RESULT]
+    assert assistant_fingerprint(request + [REASONING_ONLY]) == assistant_fingerprint(request + [EMPTY_REPLY])
+
+
+def test_reasoning_before_a_call_is_still_excluded():
+    assert assistant_fingerprint([USER, REASONING, CALL]) == assistant_fingerprint([USER, CALL])
+
+
+def test_an_echo_that_keeps_the_reasoning_only_turn_matches_it():
+    served = assistant_fingerprint([USER, REASONING, CALL, RESULT, REASONING_ONLY])
+    echoed = assistant_fingerprint([USER, REASONING, CALL, RESULT, REASONING_ONLY, RESUME])
+    assert served == echoed
+
+
+# --- resolver level ------------------------------------------------------------
+
+
+async def test_the_resent_request_resolves_to_the_call_before_the_dropped_reply(store):
+    ledger = await _serve(store, [REASONING_ONLY])
+    resolution = await store.resolve("r1", [USER, REASONING, CALL, RESULT, RESUME])
+    assert resolution.status == ParentResolutionStatus.RESOLVED, resolution.reason
+    assert resolution.match.model_call_id == ledger.calls[0]
+
+
+async def test_a_history_that_keeps_the_reasoning_only_reply_continues_it(store):
+    ledger = await _serve(store, [REASONING_ONLY])
+    resolution = await store.resolve("r1", [USER, REASONING, CALL, RESULT, REASONING_ONLY, RESUME])
+    assert resolution.status == ParentResolutionStatus.RESOLVED, resolution.reason
+    assert resolution.match.model_call_id == ledger.calls[1]
+
+
+async def test_control_an_empty_text_reply_resolved_before(store):
+    ledger = await _serve(store, [EMPTY_REPLY])
+    resolution = await store.resolve("r1", [USER, REASONING, CALL, RESULT, RESUME])
+    assert resolution.status == ParentResolutionStatus.RESOLVED, resolution.reason
+    assert resolution.match.model_call_id == ledger.calls[0]
