+def make_thinking_request(reply="The answer.", thinking="Because."):
+    request = make_request(reply)
+    reasoning = NeMoGymResponseReasoningItem(
+        id="rs_1",
+        type="reasoning",
+        summary=[NeMoGymSummary(type="summary_text", text=thinking)],
+    )
+    request.response.output.insert(0, reasoning)
+    return request
+
+
+def test_reasoning_text_reads_the_reasoning_items():
+    assert reasoning_text(make_thinking_request().response) == "Because."
+    assert reasoning_text(make_request().response) == ""
+
+
+@pytest.mark.parametrize(
+    "judged_text, expected",
+    [
+        ("reply", "The answer."),
+        ("thinking_and_reply", "Thinking: Because.\n\nReply: The answer."),
+        (
+            "conversation",
+            "User: Why?\n\nThinking: Because.\n\nAssistant: The answer.",
+        ),
+    ],
+)
+def test_judged_text_sets_what_the_judge_reads(judged_text, expected):
+    response = make_thinking_request().response
+    completion = judged_completion(
+        response, "Why?", judged_text=judged_text, stop_strings=[]
+    )
+    assert completion == expected
+
+
+@pytest.mark.parametrize("judged_text", ["reply", "thinking_and_reply", "conversation"])
+@pytest.mark.asyncio
+async def test_thinking_without_a_reply_skips_the_judge(judged_text):
+    server = make_server(judged_text=judged_text)
+    result = await server.verify(make_thinking_request(reply=""))
+
+    assert result.reward == 0.0
+    server.server_client.post.assert_not_called()
+
+
+@pytest.mark.asyncio
