+def reasoning_text(response: Optional[NeMoGymResponse]) -> str:
+    """The model's thinking from a Responses API payload, verbatim."""
+    if response is None:
+        return ""
+    chunks: List[str] = []
+    for item in response.output or []:
+        if getattr(item, "type", None) != "reasoning":
+            continue
+        for part in getattr(item, "summary", None) or []:
+            chunks.append(getattr(part, "text", "") or "")
+    return "\n".join(chunks)
+
+
+def judged_completion(
+    response: Optional[NeMoGymResponse],
+    question: str,
+    *,
+    judged_text: str,
+    stop_strings: Sequence[str],
+) -> str:
+    """The completion the judge reads, empty when there is no reply.
+
+    Thinking and the question only add to a reply, so an output without one stays
+    unscored in every view.
+    """
+    reply = clean_response(raw_message_text(response), stop_strings)
+    if not reply or judged_text == "reply":
+        return reply
+    thinking = reasoning_text(response).strip()
+    sections = [f"Thinking: {thinking}"] if thinking else []
+    if judged_text == "conversation":
+        return "\n\n".join([f"User: {question}", *sections, f"Assistant: {reply}"])
+    return "\n\n".join([*sections, f"Reply: {reply}"])
+
+
