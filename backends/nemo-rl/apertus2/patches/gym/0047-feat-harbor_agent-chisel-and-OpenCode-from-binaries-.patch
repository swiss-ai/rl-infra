index 000000000..2e2f6893e
--- /dev/null
+++ b/responses_api_agents/harbor_agent/custom_agents/check-mounted-binary.sh.j2
@@ -0,0 +1,21 @@
+#!/bin/bash
+# Install method "mounted": the agent's binary is already in the sandbox (e.g. a read-only volume that the
+# sandbox platform mounts into every pod), so nothing is installed. Fails agent setup (an infra failure) only when
+# the binary is missing or not executable; prints its --version for the log (no version is required).
+# Rendered by installed_compat.check_mounted_binary; name and bin arrive shell-quoted.
+set -euo pipefail
+
+name={{ name }}
+bin={{ bin }}
+
+if [ ! -x "$bin" ]; then
+  echo "$name not found or not executable at $bin (install: mounted)" >&2
+  exit 1
+fi
+# bounded where the image has timeout: a binary that hangs on --version must not hold up the setup
+if command -v timeout >/dev/null 2>&1; then
+  version=$(timeout 10 "$bin" --version 2>&1 | head -n 1) || true
+else
+  version=$("$bin" --version 2>&1 | head -n 1) || true
+fi
+echo "using the mounted $name at $bin, --version: $version"
