index 000000000..76efa3f48
--- /dev/null
+++ b/responses_api_agents/harbor_agent/custom_agents/check-mounted-binary.sh.j2
@@ -0,0 +1,21 @@
+#!/bin/bash
+# Install method "mounted": the agent's binary is already in the sandbox (e.g. a read-only volume that the
+# sandbox platform mounts into every pod), so nothing is installed. Checks that it is executable and prints the
+# expected version; otherwise agent setup fails (an infra failure) instead of the agent failing later.
+# Rendered by installed_compat.check_mounted_binary; name, bin and version arrive shell-quoted.
+set -euo pipefail
+
+name={{ name }}
+bin={{ bin }}
+version={{ version }}
+
+if [ ! -x "$bin" ]; then
+  echo "$name not found or not executable at $bin (install: mounted)" >&2
+  exit 1
+fi
+actual=$("$bin" --version 2>&1 | head -n 1) || true
+if [ "$actual" != "$version" ]; then
+  echo "$name at $bin reports version '$actual', expected $version" >&2
+  exit 1
+fi
+echo "using the mounted $name $actual at $bin"
