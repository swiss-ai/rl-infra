 import inspect
+import shlex
 from pathlib import Path
 from typing import Any, Iterable, Mapping
 
@@ -144,3 +145,21 @@ async def install_from_template(
         (setup_dir / "stderr.txt").write_text(result.stderr)
     if result.return_code != 0:
         raise RuntimeError(f"Agent setup failed with exit code {result.return_code}. See logs in {setup_dir}")
+
+
+MOUNTED_CHECK_TEMPLATE = Path(__file__).parent / "check-mounted-binary.sh.j2"
+
+
+async def check_mounted_binary(agent: BaseAgent, environment: BaseEnvironment, name: str, path: str) -> None:
+    """Install method "mounted": check the binary the sandbox already has at ``path`` instead of installing.
+
+    Only a missing or non-executable binary fails agent setup, like a failed install (same logs under
+    ``<agent logs>/setup/``, same failure class). No version is required: the first line of its ``--version``
+    goes to ``setup/stdout.txt`` and to the agent's logger. Nothing is written into the sandbox but the check
+    script, so a read-only mount works.
+    """
+    variables = {"name": shlex.quote(name), "bin": shlex.quote(path)}
+    await install_from_template(agent, environment, MOUNTED_CHECK_TEMPLATE, variables)
+    stdout = agent.logs_dir / "setup" / "stdout.txt"
+    line = stdout.read_text(errors="replace").strip().splitlines()[-1:] if stdout.exists() else []
+    agent.logger.info("%s", line[0] if line else f"using the mounted {name} at {path} (no --version output)")
