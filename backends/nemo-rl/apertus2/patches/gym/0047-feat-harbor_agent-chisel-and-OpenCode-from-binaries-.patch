+        binary.write_text(
+            "#!/bin/bash\n"
+            f'if [ "$1" = --version ]; then echo "{version_line}"; exit 0; fi\n'
+            'sleep 0.2; echo "server: Listening on http://0.0.0.0:$5"; sleep 30\n'
