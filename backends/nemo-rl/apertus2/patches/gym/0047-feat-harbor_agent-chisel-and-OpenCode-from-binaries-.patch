+    @staticmethod
+    def _mounted(tmp_path: Path, version_line: str) -> ModelTunnelConfig:
+        """A fake chisel in a read-only directory, as on the sandbox platform's volume."""
+        mount = tmp_path / "rl-tools" / "chisel" / "1.12.0"
+        mount.mkdir(parents=True)
+        binary = mount / "chisel"
+        binary.write_text(
+            "#!/bin/bash\n"
+            f'if [ "$1" = --version ]; then echo "{version_line}"; exit 0; fi\n'
+            'sleep 0.2; echo "server: Listening on http://0.0.0.0:$5"; sleep 30\n'
+        )
+        binary.chmod(0o555)
+        mount.chmod(0o555)
+        return ModelTunnelConfig(
+            chisel_dir=str(tmp_path),
+            pod_binary=str(binary),
+            pod_install="mounted",
+            pod_log=str(tmp_path / "server.log"),
+        )
+
+    def test_mounted_server_starts_from_a_read_only_directory(self, tmp_path):
+        cfg = self._mounted(tmp_path, "1.12.0")
+        try:
+            res = subprocess.run(
+                ["sh", "-c", server_start_script(cfg, wait_s=5)], capture_output=True, text=True, timeout=20
+            )
+            assert res.returncode == 0, res.stdout + res.stderr
+            assert "Listening on" in (tmp_path / "server.log").read_text()
+        finally:
+            for pid in _running(Path(cfg.pod_binary)):
+                os.kill(pid, signal.SIGKILL)
+            Path(cfg.pod_binary).parent.chmod(0o755)
