@@ -31,6 +31,7 @@ Harbor 0.1.x ignored them. harbor_agent passes the same kwargs to every agent (a
 """
 
 import inspect
+import shlex
 from pathlib import Path
 from typing import Any, Iterable, Mapping
 
@@ -144,3 +145,19 @@ async def install_from_template(
         (setup_dir / "stderr.txt").write_text(result.stderr)
     if result.return_code != 0:
         raise RuntimeError(f"Agent setup failed with exit code {result.return_code}. See logs in {setup_dir}")
+
+
+MOUNTED_CHECK_TEMPLATE = Path(__file__).parent / "check-mounted-binary.sh.j2"
+
+
+async def check_mounted_binary(
+    agent: BaseAgent, environment: BaseEnvironment, name: str, path: str, version: str
+) -> None:
+    """Install method "mounted": check the binary the sandbox already has at ``path`` instead of installing.
+
+    It must be executable and print ``version`` as the first line of ``--version``; otherwise agent setup
+    fails like a failed install (same logs under ``<agent logs>/setup/``, same failure class). Nothing is
+    written into the sandbox but the check script, so a read-only mount works.
+    """
+    variables = {"name": shlex.quote(name), "bin": shlex.quote(path), "version": shlex.quote(version)}
+    await install_from_template(agent, environment, MOUNTED_CHECK_TEMPLATE, variables)
