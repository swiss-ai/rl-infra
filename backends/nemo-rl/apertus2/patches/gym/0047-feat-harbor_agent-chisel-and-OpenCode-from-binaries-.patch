+MOUNTED_BIN = "/opt/rl-tools/opencode/1.17.11/opencode"
+
+
+@pytest.mark.asyncio
+async def test_mounted_install_only_checks_the_binary(tmp_path: Path) -> None:
+    from responses_api_agents.harbor_agent.custom_agents import installed_compat
+
+    agent = _agent(tmp_path, opencode_install="mounted", opencode_bin=MOUNTED_BIN)
+    env = _Env()
+    await agent.install(env)
+    # nothing but the check script goes into the sandbox
+    ((script, target),) = env.uploads
+    assert target == "/installed-agent/install.sh"
+    assert script.decode() == Environment().from_string(installed_compat.MOUNTED_CHECK_TEMPLATE.read_text()).render(
+        name="opencode", bin=MOUNTED_BIN, version="1.17.11"
+    )
+    assert [c["command"] for c in env.calls] == ["bash /installed-agent/install.sh"]
+    (cmd,) = agent.create_run_agent_commands("x")
+    assert f"{mod.PIPEFAIL_IF_SUPPORTED}{MOUNTED_BIN} --model nemogym/" in cmd.command
+    # the default install still runs `opencode` from PATH
+    (cmd,) = _agent(tmp_path).create_run_agent_commands("x")
+    assert f"{mod.PIPEFAIL_IF_SUPPORTED}opencode --model" in cmd.command
+
+
+@pytest.mark.asyncio
+async def test_failed_mounted_check_fails_setup(tmp_path: Path) -> None:
+    agent = _agent(tmp_path, opencode_install="mounted", opencode_bin=MOUNTED_BIN)
+    with pytest.raises(RuntimeError, match="exit code 1"):
+        await agent.install(_Env(return_code=1))
+
+
+def _run_mounted_check(tmp_path: Path, binary: Path, version: str = "1.17.11"):
+    from responses_api_agents.harbor_agent.custom_agents import installed_compat
+
+    script = tmp_path / "check.sh"
+    script.write_text(
+        Environment()
+        .from_string(installed_compat.MOUNTED_CHECK_TEMPLATE.read_text())
+        .render(name="opencode", bin=shlex.quote(str(binary)), version=shlex.quote(version))
+    )
+    return subprocess.run(["bash", str(script)], capture_output=True, text=True, timeout=30)
+
+
+@needs_bash
+def test_mounted_check_script(tmp_path: Path) -> None:
+    mount = tmp_path / "rl-tools" / "opencode" / "1.17.11"
+    mount.mkdir(parents=True)
+    binary = mount / "opencode"
+    binary.write_text("#!/bin/sh\necho 1.17.11\n")
+    binary.chmod(0o555)
+    mount.chmod(0o555)  # read-only, as the image volume
+    try:
+        ok = _run_mounted_check(tmp_path, binary)
+        assert ok.returncode == 0, ok.stderr
+        assert f"using the mounted opencode 1.17.11 at {binary}" in ok.stdout
+        other = _run_mounted_check(tmp_path, binary, version="1.18.0")
+        assert other.returncode == 1 and "reports version '1.17.11', expected 1.18.0" in other.stderr
+    finally:
+        mount.chmod(0o755)
+    missing = _run_mounted_check(tmp_path, tmp_path / "nothing")
+    assert missing.returncode == 1 and "not found or not executable" in missing.stderr
+
