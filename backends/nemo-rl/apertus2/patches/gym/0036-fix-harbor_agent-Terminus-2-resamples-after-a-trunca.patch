+
+# Job 5356101: after a truncation, Terminus2 appended user(observation) + assistant(truncated reply) and re-asked with
+# "ERROR!! NONE of the actions ...". NemoGymLLM attaches the token ids of the last *answered* call to the newest
+# assistant message, now the truncated one, and the Apertus 2 endpoint takes those ids as the exact prefix and adds only
+# the messages after that message: the model saw its previous prompt + reply + ERROR, never the observation of the
+# commands that did run (619 turns in 412 of 1302 trials). These tests go through the real Chat and NemoGymLLM and
+# check what is sent to the model server.
+REPLY_1 = '{"analysis": "1", "plan": "p", "commands": [], "task_complete": false}'
+REPLY_2 = '{"analysis": "2", "plan": "p", "commands": [], "task_complete": false}'
+
+
+def _completion(content, prompt_ids, generation_ids, finish_reason="stop"):
+    message = {
+        "role": "assistant",
+        "content": content,
+        "prompt_token_ids": prompt_ids,
+        "generation_token_ids": generation_ids,
+        "generation_log_probs": [-0.5] * len(generation_ids),
+    }
+    usage = {"prompt_tokens": len(prompt_ids), "completion_tokens": len(generation_ids)}
+    return {"id": "chatcmpl-1", "choices": [{"message": message, "finish_reason": finish_reason}], "usage": usage}
+
+
+def _server_agent(tmp_path, replies, **kwargs):
+    """Terminus2NemoGym on a real NemoGymLLM whose model server answers ``replies``; returns (agent, requests)."""
+    llm = NemoGymLLM(model_name="test-model", api_base="http://localhost:8000/v1", collect_rollout_details=True)
+    requests = []
+    replies = iter(replies)
+
+    async def post(payload, timeout_sec=None):
+        requests.append(copy.deepcopy(payload))
+        return next(replies)
+
+    llm._post_chat_completions = post
+    agent = Terminus2NemoGym(
+        logs_dir=tmp_path, model_name="test-model", llm=llm, collect_rollout_details=True, **kwargs
+    )
+    return agent, requests
+
+
+@pytest.mark.asyncio
+async def test_after_a_truncation_the_model_is_asked_again_with_the_observation(tmp_path) -> None:
+    agent, requests = _server_agent(
+        tmp_path,
+        [
+            _completion(REPLY_1, [1, 2], [3, 4]),
+            _completion('{"analysis": "a reply that never ends', [1, 2, 3, 4, 5], [8, 8, 8], finish_reason="length"),
+            _completion(REPLY_2, [1, 2, 3, 4, 5], [6, 7]),
+        ],
+    )
+    chat = Chat(agent._llm)
+
+    assert (await agent._query_llm(chat, "do the task")).content == REPLY_1
+    assert (await agent._query_llm(chat, "OBSERVATION")).content == REPLY_2
+
+    truncated_call, next_call = requests[1], requests[2]
+    # the same request again: the observation is the last message and the truncated reply is not in it
+    assert next_call["messages"] == truncated_call["messages"]
+    assert [(m["role"], m["content"]) for m in next_call["messages"]] == [
+        ("user", "do the task"),
+        ("assistant", REPLY_1),
+        ("user", "OBSERVATION"),
+    ]
+    # the token ids are on the reply they were generated for, so the endpoint's prefix + new messages is consistent
+    assert next_call["messages"][1]["prompt_token_ids"] == [1, 2]
+    assert next_call["messages"][1]["generation_token_ids"] == [3, 4]
+    # the chat and the rollout details hold the answered calls only, one entry each
+    assert [(m["role"], m["content"]) for m in chat.messages] == [
+        ("user", "do the task"),
+        ("assistant", REPLY_1),
+        ("user", "OBSERVATION"),
+        ("assistant", REPLY_2),
+    ]
+    assert chat.rollout_details[0]["prompt_token_ids"] == [[1, 2], [1, 2, 3, 4, 5]]
+    assert chat.rollout_details[0]["completion_token_ids"] == [[3, 4], [6, 7]]
+    assert agent._llm._last_completion_token_ids == [6, 7]
+
+
+@pytest.mark.asyncio
+async def test_truncation_retry_harbor_keeps_harbors_error_message(tmp_path) -> None:
+    agent, requests = _server_agent(
+        tmp_path,
+        [
+            _completion(REPLY_1, [1, 2], [3, 4]),
+            _completion('{"analysis": "a reply that never ends', [1, 2, 3, 4, 5], [8, 8, 8], finish_reason="length"),
+            _completion(REPLY_2, [1, 2, 3, 4, 5, 8, 8, 8, 9], [6, 7]),
+        ],
+        truncation_retry="harbor",
+    )
+    chat = Chat(agent._llm)
+
+    await agent._query_llm(chat, "do the task")
+    assert (await agent._query_llm(chat, "OBSERVATION")).content == REPLY_2
+
+    roles = [m["role"] for m in requests[2]["messages"]]
+    assert roles == ["user", "assistant", "user", "assistant", "user"]
+    assert requests[2]["messages"][-1]["content"].startswith("ERROR!! NONE of the actions")
