         On a reply that hit the output limit with nothing salvageable, Terminus2._query_llm appends it plus
         "ERROR!! NONE of the actions ..." and calls itself (this method) again, with no limit; jobs 5350472 and
@@ -158,7 +164,19 @@ class Terminus2NemoGym(Terminus2):
         placeholder unwinds the chain without an exception (one raised inside it would be retried by each
         level's @retry), and the outermost call, outside @retry, raises TruncationLoopError, which run() turns
         into a normal end of the episode, so the verifier still runs.
+
+        Before re-asking, Terminus2 appends the prompt and the truncated reply to the chat and asks with "ERROR!!
+        NONE of the actions you just requested were performed ...". NemoGymLLM attaches the token ids of the last
+        answered call to the newest assistant message, now the truncated one, and the token-in endpoint takes them
+        as the exact prefix and adds only the messages after it: the model got its previous prompt + reply + the
+        ERROR, never the prompt, i.e. the output of the commands that did run (job 5356101, 619 turns in 412 of
+        1302 trials). With truncation_retry "resample" a nested call (only Terminus2's re-ask makes one) takes the
+        two messages back off and asks again with the original prompt: a fresh sample of the same request, so
+        the ids stay on the reply they were generated for. The truncated reply leaves nothing behind: Chat and
+        NemoGymLLM record a call only after the finish_reason check.
         """
+        if self._truncation_depth > 0 and self.options.truncation_retry == "resample":
+            prompt = self._take_back_truncated_exchange(chat, prompt)
         limit = self.options.max_consecutive_truncations
         if limit is not None and self._truncation_depth >= limit:
             self._truncation_limit_hit = True
@@ -175,6 +193,18 @@ class Terminus2NemoGym(Terminus2):
             )
         return response
 
+    def _take_back_truncated_exchange(self, chat, prompt: str) -> str:
+        """Remove the prompt + truncated reply Terminus2 appended before its re-ask; return that prompt."""
+        messages = chat.messages
+        if len(messages) >= 2 and messages[-2].get("role") == "user" and messages[-1].get("role") == "assistant":
+            original_prompt = messages[-2]["content"]
+            del messages[-2:]
+            self.logger.debug("Output length exceeded with nothing salvageable; asking again with the same prompt")
+            return original_prompt
+        # Not what Terminus2 0.25 appends: keep its re-ask rather than guess.
+        self.logger.warning("Unexpected chat after a truncated reply; keeping Terminus2's re-ask")
+        return prompt
+
