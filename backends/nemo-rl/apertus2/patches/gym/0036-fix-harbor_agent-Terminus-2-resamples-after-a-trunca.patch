+def test_preflight_checks_truncation_retry() -> None:
+    Terminus2NemoGym.preflight(kwargs={"truncation_retry": "resample"}, env={})
+    Terminus2NemoGym.preflight(kwargs={"truncation_retry": "harbor"}, env={})
