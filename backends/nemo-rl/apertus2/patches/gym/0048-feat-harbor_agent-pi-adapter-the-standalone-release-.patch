+    ``log_text`` is pi's ``--mode json`` output (one JSON event per line); each assistant message ends with a
+    ``message_end`` event whose message has ``stopReason`` (stop, length, toolUse, error, aborted), ``usage``
+    (input, output, cacheRead, cacheWrite) and, on an error, ``errorMessage`` (pi v1.5.2 packages/ai/src/types.ts).
+    In ``--mode json`` pi exits 0 also when its last message is an error. It ends its loop on a reply without tool
+    calls, also on ``length``; a ``length`` reply with tool calls gets error results and one more call. The same
+    rules as ``opencode_end_flags`` apply: the model server's placeholder (a last ``length`` call without tokens), a
+    context-length error (``stopReason`` error with such a message, when the 400 is propagated), a last ``length``
+    reply cut by the context ceiling.
+    """
+    steps: list[tuple[str, int, int]] = []
+    overflow_error: Optional[str] = None
+    for line in str(log_text or "").splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict) or event.get("type") != "message_end":
+            continue
+        message = event.get("message")
+        if not isinstance(message, dict) or message.get("role") != "assistant":
+            continue
+        usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
+        prompt = _int(usage.get("input")) + _int(usage.get("cacheRead")) + _int(usage.get("cacheWrite"))
+        steps.append((str(message.get("stopReason") or ""), prompt, _int(usage.get("output"))))
+        error = str(message.get("errorMessage") or "")
+        if message.get("stopReason") == "error" and overflow_error is None and _CONTEXT_TEXT.search(error):
+            overflow_error = error
+    return _context_end_flags("pi", steps, overflow_error, context_limit)
+
+
 def classify_rollout(
     trial_result: Optional[dict],
     agent_error_flags: Optional[dict] = None,
