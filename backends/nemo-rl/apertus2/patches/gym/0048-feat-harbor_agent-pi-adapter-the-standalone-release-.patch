+import hashlib
+import io
+import json
+import os
+import shlex
+import shutil
+import subprocess
+import tarfile
+from pathlib import Path
+
+import pytest
+
+
+pytest.importorskip("harbor")
+
+from jinja2 import Environment  # noqa: E402
+
+from responses_api_agents.harbor_agent.custom_agents import pi_nemo_gym as mod  # noqa: E402
+from responses_api_agents.harbor_agent.custom_agents.pi_nemo_gym import PiNemoGym  # noqa: E402
+
+
+API_BASE = "http://127.0.0.1:8000/ng-rollout/3-1/training-token-capture/v1"
+# a policy model name as NeMo-RL passes it: a path (vllm_model replaces the request's model with its own)
+MODEL = "/scratch/models/chonk-sft-v0.2"
+MODEL_INFO = {"max_input_tokens": 65536, "max_output_tokens": 16384}
+needs_bash = pytest.mark.skipif(shutil.which("bash") is None, reason="needs bash")
+
+
+def _release(tmp_path: Path, printed_version: str = "1.5.2") -> tuple[bytes, str]:
+    """A fake pi release archive (the real layout: a `pi/` directory) and its sha256."""
+    files = {
+        "pi/pi": (f"#!/bin/sh\necho {printed_version}\n".encode(), 0o755),
+        "pi/package.json": (b'{"name": "@earendil-works/pi-coding-agent", "version": "1.5.2"}\n', 0o644),
+        "pi/README.md": (b"# pi\n", 0o644),
+        "pi/docs/models.md": (b"docs\n", 0o644),
+        "pi/theme/dark.json": (b"{}\n", 0o644),
+    }
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        for name, (data, mode) in files.items():
+            info = tarfile.TarInfo(name)
+            info.size, info.mode = len(data), mode
+            tar.addfile(info, io.BytesIO(data))
+    return buf.getvalue(), hashlib.sha256(buf.getvalue()).hexdigest()
+
+
+def _archive_dir(tmp_path: Path, version: str = "1.5.2", printed_version: str = "1.5.2") -> tuple[Path, bytes, str]:
+    """A pi_archive_dir with a fake release at <dir>/<version>/<asset>: (dir, bytes, sha256)."""
+    data, digest = _release(tmp_path, printed_version)
+    archive_dir = tmp_path / "pi-archives"
+    (archive_dir / version).mkdir(parents=True, exist_ok=True)
+    (archive_dir / version / mod.DEFAULT_ASSET).write_bytes(data)
+    return archive_dir, data, digest
+
+
+def _agent(tmp_path: Path, **kwargs) -> PiNemoGym:
+    if "pi_archive_dir" not in kwargs:
+        archive_dir, _, digest = _archive_dir(tmp_path / "default")
+        kwargs = {"pi_archive_dir": str(archive_dir), "pi_sha256": digest, **kwargs}
+    return PiNemoGym(logs_dir=tmp_path, model_name=MODEL, api_base=API_BASE, **kwargs)
+
+
+def _command(agent: PiNemoGym, instruction: str = "x"):
+    (cmd,) = agent.create_run_agent_commands(instruction)
+    return cmd
+
+
+def test_requires_api_base(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="api_base"):
+        PiNemoGym(logs_dir=tmp_path, model_name=MODEL)
+
+
+# --- models.json -------------------------------------------------------------------------------------
+
+
+def test_models_json_points_pi_at_the_model_server(tmp_path: Path) -> None:
+    models = _agent(tmp_path, model_info=MODEL_INFO).models_json()
+    (provider_id,) = models["providers"]
+    provider = models["providers"][provider_id]
+    assert provider_id == mod.PROVIDER_ID
+    assert provider["baseUrl"] == API_BASE
+    assert provider["api"] == "openai-completions"
+    # "$NAME" is read from the environment; a literal key starting with "!" would be run as a command
+    assert provider["apiKey"] == f"${mod.API_KEY_ENV}"
+    (model,) = provider["models"]
+    assert model["id"] == mod.MODEL_ID
+    # no thinking level logic: Gym's model server returns the reasoning inside content (<think>...)
+    assert model["reasoning"] is False
+    assert model["input"] == ["text"]
+    assert (model["contextWindow"], model["maxTokens"]) == (65536, 16384)
+    assert "promptCache" not in model
+
+
+def test_models_json_compat_keeps_the_request_to_the_plain_fields(tmp_path: Path) -> None:
+    """pi's defaults for an unknown base URL send store, reasoning_effort, session headers and a
+    prompt-cache key (pi v1.5.2 packages/ai/src/api/openai-completions.ts:761-835, 960-963)."""
+    compat = _agent(tmp_path).models_json()["providers"][mod.PROVIDER_ID]["compat"]
+    assert compat == {
+        "supportsStore": False,
+        "supportsDeveloperRole": False,
+        "supportsReasoningEffort": False,
+        "supportsUsageInStreaming": True,
+        "supportsStrictMode": False,
+        "supportsMidConvoSystemMessages": False,
+        "sendSessionAffinityHeaders": False,
+        "promptCacheKeyMode": "disabled",
+        "maxTokensField": "max_tokens",
+    }
+
+
+def test_models_json_without_model_info_leaves_the_limits_to_pi(tmp_path: Path) -> None:
+    (model,) = _agent(tmp_path).models_json()["providers"][mod.PROVIDER_ID]["models"]
+    assert "contextWindow" not in model and "maxTokens" not in model
+
+
+def test_output_limit_capped_by_request_max_output_tokens(tmp_path: Path) -> None:
+    agent = _agent(tmp_path, model_info=MODEL_INFO, responses_create_params={"max_output_tokens": 4096})
+    (model,) = agent.models_json()["providers"][mod.PROVIDER_ID]["models"]
+    assert model["maxTokens"] == 4096
+
+
+# --- settings.json -----------------------------------------------------------------------------------
+
+
+def test_settings_switch_off_every_call_outside_the_main_loop(tmp_path: Path) -> None:
+    settings = _agent(tmp_path).settings_json()
+    # compaction: summary calls, and compact-and-retry after an overflow or a clamped length stop
+    assert settings["compaction"] == {"enabled": False}
+    # retry re-sends the same prompt and hides the failed attempt from the history
+    assert settings["retry"]["enabled"] is False
+    assert settings["retry"]["provider"]["maxRetries"] == 0
+    # under stream replay no byte arrives before generation ends: no idle or request timeout
+    assert settings["httpIdleTimeoutMs"] == 0
+    # set, it would be the SDK timeout as given (0 = none at all); unset, it follows httpIdleTimeoutMs
+    assert "timeoutMs" not in settings["retry"]["provider"]
+    assert settings["cacheWarming"] == "off"
+    assert settings["enableInstallTelemetry"] is False and settings["enableAnalytics"] is False
+    assert settings["defaultProjectTrust"] == "never"
