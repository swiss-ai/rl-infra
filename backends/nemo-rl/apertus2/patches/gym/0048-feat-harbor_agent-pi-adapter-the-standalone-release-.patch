+#!/bin/bash
+# Installs the standalone pi release (Bun-compiled, no Node/npm) from the archive PiNemoGym uploaded.
+# Rendered by PiNemoGym; version, sha256, install_dir and archive arrive shell-quoted.
+# The archive was checked against sha256 on the node; it is checked again here when the image has
+# sha256sum. Needs tar (and gzip). Only the binary, its package.json (pi reads its version from the
+# package.json next to the executable) and README.md are extracted: themes, docs, the image wasm and the
+# clipboard helper are for the interactive UI, and the sandbox's files live in node memory. The archive is
+# removed at exit for the same reason.
+set -euo pipefail
+
+version={{ version }}
+sha256={{ sha256 }}
+install_dir={{ install_dir }}
+archive={{ archive }}
+dest="$install_dir/pi"
+work=""
+
+cleanup() {
+  if [ -n "$work" ]; then rm -rf "$work"; fi
+  rm -f "$archive"
+}
+trap cleanup EXIT
+
+if [ -x "$dest" ] && [ "$("$dest" --version 2>/dev/null || true)" = "$version" ]; then
+  echo "pi $version already installed at $dest"
+  exit 0
+fi
+
+if [ -n "$sha256" ] && command -v sha256sum >/dev/null 2>&1; then
+  actual=$(sha256sum "$archive")
+  if [ "${actual%% *}" != "$sha256" ]; then
+    echo "sha256 mismatch for the uploaded $archive: expected $sha256" >&2
+    exit 1
+  fi
+fi
+
+work=$(mktemp -d)
+# the release wraps everything in a pi/ directory (scripts/build-binaries.sh:166-172)
+tar -xzf "$archive" -C "$work" pi/pi pi/package.json pi/README.md
+rm -rf "$install_dir"
+mkdir -p "$install_dir"
+install -m 755 "$work/pi/pi" "$dest"
+install -m 644 "$work/pi/package.json" "$install_dir/package.json"
+install -m 644 "$work/pi/README.md" "$install_dir/README.md"
+actual=$("$dest" --version)
+if [ "$actual" != "$version" ]; then
+  echo "pi version mismatch: wanted $version, $dest --version printed $actual" >&2
+  exit 1
+fi
+echo "installed pi $actual at $dest"
