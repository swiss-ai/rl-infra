+@pytest.mark.parametrize("timeout_sec", [None, 30])
+def test_run_command_in_bash_writes_the_config_closes_stdin_and_keeps_the_exit_status(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, timeout_sec: int | None
+) -> None:
+    if timeout_sec and shutil.which("timeout") is None:
+        pytest.skip("needs coreutils timeout")
+    # Stands in for pi: reads stdin to EOF as pi does for a non-TTY stdin (cli/initial-message.ts:27-40),
+    # prints its argv and the config it finds, exits 3.
+    log = _fake_pi(
+        tmp_path,
+        monkeypatch,
+        '#!/bin/bash\nstdin=$(cat)\nprintf "%s\\n" "$@"\necho "stdin=[$stdin]"\n'
+        'ls "$PI_CODING_AGENT_DIR"\necho "key=$NEMO_GYM_API_KEY"\nexit 3\n',
+    )
+    agent = _agent(tmp_path, max_turns=7, model_info=MODEL_INFO, pi_timeout_sec=timeout_sec)
+    cmd = _command(agent, "-fix it")
+    read_end, write_end = os.pipe()  # stdin left open, like the sandbox exec's
+    try:
+        proc = subprocess.run(
+            ["bash", "-c", cmd.command],
+            stdin=read_end,
+            capture_output=True,
+            text=True,
+            env={**os.environ, **cmd.env},
+            timeout=20,
+        )
+    finally:
+        os.close(read_end)
+        os.close(write_end)
+    assert proc.returncode == 3  # pi's status, not tee's 0
+    lines = log.read_text().splitlines()
+    assert lines == proc.stdout.splitlines()
+    assert lines[-7:] == ["--", "-fix it", "stdin=[]", "max-turns.ts", "models.json", "settings.json", "key=EMPTY"]
+    agent_dir = Path(mod.AGENT_DIR)
+    assert json.loads((agent_dir / "models.json").read_text()) == agent.models_json()
+    assert json.loads((agent_dir / "settings.json").read_text()) == agent.settings_json()
