+# The sandbox exec may run the command with /bin/sh (OpenSandbox runs `su -s /bin/sh -c` for a
+# named user). A plain `set -o pipefail` is a special-builtin error in a shell without it (older
+# dash), which ends a non-interactive shell before the agent starts. Probe in a subshell first.
+PIPEFAIL_IF_SUPPORTED = "(set -o pipefail) 2>/dev/null && set -o pipefail; "
+# `timeout -k`: seconds between the agent's SIGTERM at its own time limit and the SIGKILL
+TIMEOUT_KILL_AFTER_SEC = 10
+
+
+def deep_merge(base: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
+    """`base` updated by `overlay`, recursing into dicts; a None value in `overlay` deletes the key."""
+    merged = copy.deepcopy(base)
+    for key, value in overlay.items():
+        if value is None:
+            merged.pop(key, None)
+        elif isinstance(value, dict) and isinstance(merged.get(key), dict):
+            merged[key] = deep_merge(merged[key], value)
+        else:
+            merged[key] = copy.deepcopy(value)
+    return merged
+
+
+@functools.lru_cache(maxsize=8)
+def _file_sha256(path: str, size: int, mtime_ns: int) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def verified_archive(
+    path: Path, sha256: str, what: str = "OpenCode", dir_option: str = "opencode_archive_dir"
+) -> Path:
+    """`path` if it is a file with that sha256. Hashed once per process (and size and mtime): every trial
+    builds an adapter, and the archive does not change during a run. `what` and `dir_option` name the agent
+    and its archive-dir kwarg in the errors."""
+    if not path.is_file():
+        raise FileNotFoundError(f"{what} archive {path} not found ({dir_option}/<version>/<asset>)")
+    stat = path.stat()
+    actual = _file_sha256(str(path), stat.st_size, stat.st_mtime_ns)
+    if actual != sha256:
+        raise ValueError(f"{what} archive {path}: sha256 {actual}, expected {sha256}")
+    return path
+
+
