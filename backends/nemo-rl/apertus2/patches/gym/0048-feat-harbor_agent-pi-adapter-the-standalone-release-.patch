+# --- pi: its `--mode json` event stream (agent/pi.txt) ---------------------------------------------------------------
+# Event shapes of pi v1.5.2: one JSON object per line (modes/print-mode.ts, modes/json-event.ts); an assistant
+# message's message_end carries stopReason and usage (packages/ai/src/types.ts:467-497, 607-609).
+
+
+def _pi_end(stop_reason: str, prompt: int, completion: int, cache_read: int = 0, error: str | None = None) -> str:
+    message = {
+        "role": "assistant",
+        "content": [{"type": "text", "text": "..."}],
+        "api": "openai-completions",
+        "provider": "nemogym",
+        "model": "policy",
+        "usage": {"input": prompt - cache_read, "output": completion, "cacheRead": cache_read, "cacheWrite": 0},
+        "stopReason": stop_reason,
+        "timestamp": 1763000000000,
+    }
+    if error is not None:
+        message["errorMessage"] = error
+    return "\n".join(
+        [
+            json.dumps({"type": "message_start", "message": {**message, "stopReason": "pending"}}),
+            json.dumps(
+                {
+                    "type": "message_update",
+                    "usage": message["usage"],
+                    "assistantMessageEvent": {"type": "text_delta", "delta": "..."},
+                }
+            ),
+            json.dumps({"type": "message_end", "message": message}),
+        ]
+    )
+
+
+def _pi_tool_result() -> str:
+    message = {
+        "role": "toolResult",
+        "toolCallId": "c1",
+        "toolName": "bash",
+        "content": [{"type": "text", "text": "ok"}],
+    }
+    return json.dumps({"type": "message_end", "message": message})
+
+
+def _pi_log(*chunks: str) -> str:
+    return (
+        "\n".join([json.dumps({"type": "session", "id": "s1"}), json.dumps({"type": "agent_start"}), *chunks]) + "\n"
+    )
+
+
+_PI_PLACEHOLDER = _pi_end("length", 0, 0)
+_PI_TOOL_TURN = _pi_end("toolUse", 5406, 80) + "\n" + _pi_tool_result()
+
+
+def test_pi_placeholder_on_the_first_call_is_a_prompt_that_does_not_fit() -> None:
+    flags = pi_end_flags(_pi_log(_PI_PLACEHOLDER), context_limit=65536)
+
+    assert (flags["answered_model_calls"], flags["prompt_over_context_limit"]) == (0, True)
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert failure.detail.startswith("prompt does not fit: ContextLengthExceededError: pi: model call 1 ")
+
+
+def test_pi_placeholder_mid_episode_is_a_context_overflow() -> None:
+    log = _pi_log(_PI_TOOL_TURN, _pi_end("toolUse", 9000, 200, cache_read=5000), _pi_tool_result(), _PI_PLACEHOLDER)
+    flags = pi_end_flags(log, context_limit=65536)
+
+    assert (flags["answered_model_calls"], flags["prompt_over_context_limit"]) == (2, True)
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert failure.detail.startswith("ContextLengthExceededError: pi: model call 3 ")
+
+
+def test_pi_context_length_error_is_a_context_overflow() -> None:
+    # with propagate_context_overflow_errors the 400 reaches pi, which ends the run with stopReason "error"
+    message = "400 This model's maximum context length is 65536 tokens. However, you requested 65601 tokens"
+    flags = pi_end_flags(_pi_log(_PI_TOOL_TURN, _pi_end("error", 0, 0, error=message)), context_limit=None)
+
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert failure.detail == "ContextLengthExceededError: pi: " + message
+
+
+def test_pi_reply_cut_by_the_context_ceiling() -> None:
+    flags = pi_end_flags(_pi_log(_PI_TOOL_TURN, _pi_end("length", 60000, 5536)), context_limit=65536)
+
+    assert (flags["prompt_over_context_limit"], flags["last_truncation_at_context_limit"]) == (False, True)
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert "reply cut by the context limit (prompt 60000 + completion 5536 of 65536); pi ended the episode" in (
+        failure.detail
+    )
