+"""Harbor's installed pi agent (github.com/earendil-works/pi, MIT), pointed at a NeMo Gym model server.
+
+Harbor's own Pi agent installs pi with npm under nvm in the sandbox and raises when pi exits non-zero.
+This subclass installs the standalone release (a Bun-compiled binary, no Node/npm) from an archive the
+adapter uploads into the sandbox, and runs it through `installed_compat` like OpenCodeNemoGym: one
+recorded command, the exit status written down instead of raised.
+
+pi talks to one OpenAI-compatible provider declared in its `models.json`, whose base URL is the
+`api_base` harbor_agent passes (the model server, with the rollout's capture prefix when token capture
+is on). Under token capture a rollout is usable only if all its model calls form one chain, so the
+configuration switches off every call that is not the main loop and every rewrite of the history:
+compaction (summary calls; compact-and-retry after an overflow), auto-retry (re-sends a prompt and drops
+the failed attempt), cache warming; the HTTP idle and request timeouts are off, because under stream
+replay the model server sends no byte before generation ends. `compat` keeps the request to
+`model, messages, tools, stream, stream_options, max_tokens`: on an unknown base URL pi would also send
+`store`, `reasoning_effort`, session headers and a prompt-cache key, and the system prompt as role
+`developer`. Sampling parameters are not set here (pi sends none); set them with the Gym model server's
+`sampling_overrides`. Gym's model server returns the reasoning as a `<think>` block in `content`, so pi
+echoes it back as text, as OpenCode does.
+
+A turn budget (`max_turns`) is a pi extension: in the turn after the last allowed one it blocks every
+tool call with `terminate`, and pi's loop then ends without another model call. (`ctx.abort()` from
+`turn_end`, which Harbor's agent uses, lets the loop start one more, aborted call after a tool turn.)
+
+Keys, flags and file:line references below were checked against the pi source at tag v1.5.2 (commit
+b4afdddf); notes in the alpernates workspace, research/reports/2026-11-24-pi-v1.5.2-source-notes.md.
+Another version may differ, so `version` defaults to that release.
+
+pi runs inside the task sandbox, so `api_base` must be reachable from there (see harbor_agent's
+`harbor_model_base_url`, e.g. the per-sandbox model tunnel). The adapter writes no ATIF trajectory: for
+training the tokens come from model-server capture. pi's `--mode json` event stream goes to
+`/logs/agent/pi.txt` (failure_classes.pi_end_flags reads it), its session to `/logs/agent/pi/sessions`.
+"""
+
+import json
+import re
+import shlex
+from pathlib import Path
+from typing import Any, Mapping
+
+from harbor.agents.installed.base import with_prompt_template
+from harbor.agents.installed.pi import Pi
+from harbor.environments.base import BaseEnvironment
+from harbor.models.agent.context import AgentContext
+
+from responses_api_agents.harbor_agent.custom_agents.installed_compat import (
+    PIPEFAIL_IF_SUPPORTED,
+    TIMEOUT_KILL_AFTER_SEC,
+    ExecInput,
+    deep_merge,
+    drop_shared_kwargs,
+    install_from_template,
+    kwargs_for_harbor_options,
+    run_commands,
+    verified_archive,
+)
+
+
+PROVIDER_ID = "nemogym"
+# Gym's model server replaces the request's model with its own (vllm_model/app.py), so pi gets a fixed
+# id: the policy's name may be a path, and pi resolves --model fuzzily (core/model-resolver.ts:476-533).
+MODEL_ID = "policy"
+API_KEY_ENV = "NEMO_GYM_API_KEY"
+
+# Release whose settings, models.json schema, flags and extension API this adapter was checked against.
+DEFAULT_VERSION = "1.5.2"
+# Bun-compiled for bun-linux-x64-baseline (glibc, no AVX2 needed; scripts/build-binaries.sh:117-122).
+DEFAULT_ASSET = "pi-linux-x64.tar.gz"
+RELEASE_URL = "https://github.com/earendil-works/pi/releases/download/v{version}/{asset}"
+# sha256 of release archives as listed by the GitHub release API ("digest" of the asset).
+KNOWN_ARCHIVE_SHA256 = {
+    ("1.5.2", "pi-linux-x64.tar.gz"): "811c6f2c9e7aaee252b5404252e556fb713aa209c1f7f924226aa77d4ef70cb5",
+}
+INSTALL_TEMPLATE = Path(__file__).parent / "pi_pod" / "install-pi.sh.j2"
+# The binary and the package.json it reads its version from (dirname of the executable, config.ts:418-430).
+INSTALL_DIR = "/opt/pi-nemo-gym"
+PI_BIN = f"{INSTALL_DIR}/pi"
+# where the adapter uploads the release archive (the install script removes it)
+POD_ARCHIVE = "/installed-agent/pi.tar.gz"
+
+LOG_FILE = "/logs/agent/pi.txt"
+# PI_CODING_AGENT_DIR (config.ts:610-636): models.json, settings.json, the turn-budget extension. Under the
+# trial's agent logs, so Harbor downloads it, and written by the run command as the agent's user.
+AGENT_DIR = "/logs/agent/pi-agent"
+SESSION_DIR = "/logs/agent/pi/sessions"  # Harbor's Pi layout (agents/installed/pi.py:122)
+MAX_TURNS_FILE = "max-turns.ts"
+# pi's default tools (settings-manager.ts:85); grep/find/ls would download fd/rg, which --offline forbids
+TOOLS = ("read", "bash", "edit", "write")
+
+# The provider's compat block: only model, messages, tools, stream, stream_options and max_tokens in the request
+# (packages/ai/src/api/openai-completions.ts:761-835, 960-963, 1226; schema providers/compat-schema.ts).
+COMPAT = {
+    "supportsStore": False,
+    "supportsDeveloperRole": False,
+    "supportsReasoningEffort": False,
+    "supportsUsageInStreaming": True,
+    "supportsStrictMode": False,
+    "supportsMidConvoSystemMessages": False,
+    "sendSessionAffinityHeaders": False,
+    "promptCacheKeyMode": "disabled",
+    "maxTokensField": "max_tokens",
+}
+
+_VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z.+-]*$")
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+
+
+class PiNemoGym(Pi):
+    @classmethod
+    def preflight(cls, kwargs: dict[str, Any] | None = None, env: Mapping[str, str] | None = None) -> None:
+        # Harbor 0.25 checks the config's kwargs before any trial (Job.create); ours are taken by __init__
+        super().preflight(kwargs=kwargs_for_harbor_options(cls, kwargs), env=env)
+
+    def __init__(
+        self,
+        *args: Any,
+        api_base: str | None = None,
+        api_key: str = "EMPTY",
+        responses_create_params: dict[str, Any] | None = None,
+        max_turns: int | None = None,
+        model_info: dict[str, Any] | None = None,
+        pi_archive_dir: str | None = None,
+        pi_sha256: str | None = None,
+        pi_asset: str = DEFAULT_ASSET,
+        pi_timeout_sec: int | None = None,
+        pi_workdir: str | None = None,
+        pi_settings: dict[str, Any] | None = None,
+        **kwargs: Any,
+    ) -> None:
+        # Harbor's base keeps `version` (the pi release).
+        super().__init__(*args, **drop_shared_kwargs(kwargs))
+        if not api_base:
+            raise ValueError("PiNemoGym needs api_base (harbor_agent passes the model server URL)")
+        if pi_timeout_sec is not None and int(pi_timeout_sec) <= 0:
+            raise ValueError(f"pi_timeout_sec must be positive, got {pi_timeout_sec!r}")
+        if self._version is None:
+            self._version = DEFAULT_VERSION
+        if not _VERSION_RE.match(self._version):
+            raise ValueError(f"invalid pi version {self._version!r}")
+        if pi_sha256 is not None and not _SHA256_RE.match(pi_sha256):
+            raise ValueError("pi_sha256 must be 64 lowercase hex digits")
+        if pi_workdir is not None and not str(pi_workdir).startswith("/"):
+            raise ValueError(f"pi_workdir must be an absolute path, got {pi_workdir!r}")
+        if not pi_archive_dir:
+            raise ValueError("PiNemoGym needs pi_archive_dir (with <version>/<asset>, e.g. from fetch-pi.sh)")
+        sha256 = pi_sha256 or KNOWN_ARCHIVE_SHA256.get((self._version, pi_asset))
+        if not sha256:
+            raise ValueError(f"pi {self._version} ({pi_asset}) has no known digest: set pi_sha256")
+        self._api_base = api_base
+        self._api_key = api_key
+        self._responses_create_params = responses_create_params or {}
+        self._max_turns = int(max_turns) if max_turns else None
+        self._model_info = model_info or {}
+        self._sha256 = sha256
+        self._timeout_sec = int(pi_timeout_sec) if pi_timeout_sec is not None else None
+        self._workdir = pi_workdir
+        self._settings_overlay = pi_settings or {}
+        self._archive = verified_archive(
+            Path(pi_archive_dir) / self._version / pi_asset, sha256, what="pi", dir_option="pi_archive_dir"
+        )
+
+    @staticmethod
+    def name() -> str:
+        return "pi-nemo-gym"
+
+    # --- install -------------------------------------------------------------------------------
+
+    def install_variables(self) -> dict[str, str]:
+        """Variables of the install script (INSTALL_TEMPLATE)."""
+        return {
+            "version": shlex.quote(self._version),
+            "sha256": shlex.quote(self._sha256),
+            "install_dir": shlex.quote(INSTALL_DIR),
+            "archive": shlex.quote(POD_ARCHIVE),
+        }
+
+    async def install(self, environment: BaseEnvironment) -> None:
+        await environment.upload_file(source_path=self._archive, target_path=POD_ARCHIVE)
+        # as root: it writes to INSTALL_DIR
+        await install_from_template(self, environment, INSTALL_TEMPLATE, self.install_variables())
+
+    # --- configuration -------------------------------------------------------------------------
+
+    def model_limits(self) -> dict[str, int]:
+        """pi's contextWindow / maxTokens from Terminus-2-style `model_info` (empty when unknown).
+
+        `max_input_tokens` is the whole context window in our overlays (max_total_sequence_length), as for
+        Terminus-2; the output limit is additionally capped by the request's max_output_tokens. pi sends
+        min(maxTokens, contextWindow - estimated input) as max_tokens (packages/ai/src/api/simple-options.ts:26-35).
+        """
+        context = self._model_info.get("max_input_tokens") or self._model_info.get("max_tokens")
+        if not context:
+            return {}
+        output = self._model_info.get("max_output_tokens") or context
+        request_cap = self._responses_create_params.get("max_output_tokens")
+        if request_cap:
+            output = min(int(output), int(request_cap))
+        return {"contextWindow": int(context), "maxTokens": int(output)}
+
+    def models_json(self) -> dict[str, Any]:
+        model: dict[str, Any] = {
+            "id": MODEL_ID,
+            "name": self.model_name or MODEL_ID,
+            # no thinking levels: the server puts the reasoning into content, and reasoning_effort is off
+            "reasoning": False,
+            "input": ["text"],
+            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
+            **self.model_limits(),
+        }
+        return {
+            "providers": {
+                PROVIDER_ID: {
+                    "name": "NeMo Gym model server",
+                    "baseUrl": self._api_base,
+                    # "$NAME" is read from the environment (core/model-config.ts); a literal "!..." would run
+                    "apiKey": f"${API_KEY_ENV}",
+                    "api": "openai-completions",
+                    "compat": dict(COMPAT),
+                    "models": [model],
+                }
+            }
+        }
+
+    def settings_json(self) -> dict[str, Any]:
+        settings: dict[str, Any] = {
+            # threshold and overflow compaction, and the compact-and-retry after a clamped "length" stop
+            # (core/agent-session.ts:3106-3201)
+            "compaction": {"enabled": False},
+            # agent-level retry re-sends the prompt and hides the failed attempt (agent-session.ts:3924-3961);
+            # provider.maxRetries: the SDK's own retries
+            "retry": {"enabled": False, "provider": {"maxRetries": 0}},
+            # 0 = no HTTP idle timeout, and the SDK request timeout becomes 2^31-1 ms (settings-schema.ts:406-413,
+            # sdk.ts:340-345). retry.provider.timeoutMs stays unset: it would replace that timeout as given.
+            "httpIdleTimeoutMs": 0,
+            # would replay the last request with max_tokens 1 (settings-manager.ts:941-946)
+            "cacheWarming": "off",
+            "enableInstallTelemetry": False,
+            "enableAnalytics": False,
+            "enableSkillCommands": False,
+            # project-local .pi/ files of the task's repository stay untrusted (core/trust-manager.ts)
+            "defaultProjectTrust": "never",
+            "quietStartup": True,
+        }
+        return deep_merge(settings, self._settings_overlay)
+
+    def max_turns_extension(self) -> str | None:
+        """A pi extension that ends the episode after `max_turns` model calls, or None without a budget.
+
+        A turn is one model call plus its tool calls; turn_end fires after the tool results
+        (packages/agent/src/agent-loop.ts:289-296). In turn max_turns every tool call is blocked with
+        terminate, and when every result of a batch terminates the loop stops without another model call
+        (agent-loop.ts:281, 700-765; ToolCallEventResult in core/extensions/types.ts:1475-1484). The
+        counter is our own: turnIndex restarts at 0 after a retry (agent-session.ts:1369-1385).
+        """
+        if not self._max_turns:
+            return None
+        return f"""export default function (pi: any) {{
+  const maxTurns = {self._max_turns};
+  let completedTurns = 0;
+
+  pi.on("turn_end", () => {{
+    completedTurns += 1;
+  }});
+
+  pi.on("tool_call", () => {{
+    if (completedTurns + 1 >= maxTurns) {{
+      return {{ block: true, terminate: true, reason: `Turn limit reached (${{maxTurns}} model turns).` }};
+    }}
+    return undefined;
+  }});
+}}
+"""
+
+    def pi_env(self) -> dict[str, str]:
+        return {
+            "PI_CODING_AGENT_DIR": AGENT_DIR,
+            # --offline as an env var; also sets PI_SKIP_VERSION_CHECK (main.ts:616-620)
+            "PI_OFFLINE": "1",
+            "PI_SKIP_VERSION_CHECK": "1",
+            # anything but 1/true/yes is off (core/telemetry.ts:8-13)
+            "PI_TELEMETRY": "0",
+            API_KEY_ENV: self._api_key,
+        }
+
+    # --- run -----------------------------------------------------------------------------------
+
+    def create_run_agent_commands(self, instruction: str) -> list[ExecInput]:
+        if instruction.startswith("@"):
+            # pi reads a positional argument starting with "@" as a file to attach, also after "--"
+            # (cli/args.ts:83-91); the instruction would be lost
+            raise ValueError("pi cannot take an instruction that starts with '@' as its message")
+        files = {"models.json": json.dumps(self.models_json()), "settings.json": json.dumps(self.settings_json())}
+        extension = self.max_turns_extension()
+        if extension is not None:
+            files[MAX_TURNS_FILE] = extension
+        # Written by the run itself, so they belong to the agent's user (pi writes to its agent dir too);
+        # printf is a shell builtin, the image needs nothing for it.
+        steps = [f"mkdir -p {shlex.quote(AGENT_DIR)} {shlex.quote(SESSION_DIR)}"]
+        for name, content in files.items():
+            steps.append(f"printf '%s' {shlex.quote(content)} > {shlex.quote(f'{AGENT_DIR}/{name}')}")
+
+        argv: list[str] = []
+        if self._timeout_sec is not None:
+            # Ends pi before Harbor's agent timeout so the command's return code is recorded.
+            argv += ["timeout", "-k", str(TIMEOUT_KILL_AFTER_SEC), str(self._timeout_sec)]
+        argv += [
+            PI_BIN,
+            "--print",
+            "--mode",
+            "json",
+            "--offline",
+            # only our extension: --no-extensions also drops the built-in ones (llama.cpp provider, codemode,
+            # tool_search, mcp); an explicit --extension still loads (core/resource-loader.ts:609-615)
+            "--no-extensions",
+            "--no-mcp",
+            "--no-skills",
+            "--no-prompt-templates",
+            "--no-themes",
+            # project-local .pi/ resources of the task's repository are ignored (cli/args.ts:243-244)
+            "--no-approve",
+            "--session-dir",
+            SESSION_DIR,
+            "--provider",
+            PROVIDER_ID,
+            "--model",
+            MODEL_ID,
+            "--tools",
+            ",".join(TOOLS),
+        ]
+        if extension is not None:
+            argv += ["--extension", f"{AGENT_DIR}/{MAX_TURNS_FILE}"]
+        # "--": an instruction starting with "-" stays the message (cli/args.ts:83-91)
+        argv += ["--", instruction]
+        # stdin from /dev/null: with a non-TTY stdin pi reads it to EOF and prepends it to the message
+        # (main.ts:83-100), and the sandbox exec leaves it open. pipefail keeps pi's exit status (e.g. 124
+        # from timeout) instead of tee's. In --mode json pi exits 0 also after an error; pi_end_flags reads
+        # the events.
+        run = f"{shlex.join(argv)} 2>&1 </dev/null | tee {shlex.quote(LOG_FILE)}"
+        command = PIPEFAIL_IF_SUPPORTED + " && ".join([*steps, run])
+        if self._workdir:
+            # pi's cwd is its project (and in its system prompt); tasks may expect the agent to create it.
+            # If that fails, pi still runs in the exec's cwd.
+            workdir = shlex.quote(self._workdir)
+            command = f"mkdir -p {workdir} && cd {workdir}; {command}"
+        return [ExecInput(command=command, env=self.pi_env())]
+
+    @with_prompt_template
+    async def run(self, instruction: str, environment: BaseEnvironment, context: AgentContext) -> None:
+        await run_commands(self, environment, self.create_run_agent_commands(instruction))
+
+    def populate_context_post_run(self, context: AgentContext) -> None:
+        # Harbor's Pi converts its session into an ATIF trajectory.json, which harbor_agent would turn into
+        # output items; as for OpenCodeNemoGym, the model server's capture holds the rollout instead.
+        pass
