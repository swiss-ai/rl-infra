+def test_turn_budget_extension_ends_after_max_turns_model_calls(tmp_path: Path) -> None:
+    """Drives the extension's handlers as pi's loop does: per turn, tool_call for each call, then turn_end."""
+    source = _agent(tmp_path, max_turns=3).max_turns_extension()
+    script = tmp_path / "drive.mjs"
+    (tmp_path / "ext.mjs").write_text(source.replace("(pi: any)", "(pi)"))
+    script.write_text(
+        """import ext from "./ext.mjs";
+const handlers = {};
+ext({ on: (name, fn) => { handlers[name] = fn; } });
+const results = [];
+for (let turn = 1; turn <= 5; turn++) {
+  const calls = [handlers.tool_call({ toolName: "bash" }), handlers.tool_call({ toolName: "read" })];
+  results.push(calls.map((r) => (r && r.block && r.terminate ? "stop" : "run")).join(","));
+  if (calls.every((r) => r && r.terminate)) break;
+  handlers.turn_end({});
+}
+console.log(results.join(" "));
+"""
+    )
+    proc = subprocess.run(["node", str(script)], capture_output=True, text=True, timeout=30)
+    assert proc.returncode == 0, proc.stderr
+    assert proc.stdout.split() == ["run,run", "run,run", "stop,stop"]
