+def _fake_pi(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, body: str) -> Path:
+    """Points the adapter's pod paths into tmp_path and installs a fake pi there; returns the log path."""
+    pod = tmp_path / "pod"
+    monkeypatch.setattr(mod, "PI_BIN", str(pod / "opt" / "pi"))
+    monkeypatch.setattr(mod, "AGENT_DIR", str(pod / "logs" / "pi-agent"))
+    monkeypatch.setattr(mod, "SESSION_DIR", str(pod / "logs" / "pi" / "sessions"))
+    monkeypatch.setattr(mod, "LOG_FILE", str(pod / "logs" / "pi.txt"))
+    (pod / "opt").mkdir(parents=True)
+    fake = pod / "opt" / "pi"
+    fake.write_text(body)
+    fake.chmod(0o755)
+    return pod / "logs" / "pi.txt"
