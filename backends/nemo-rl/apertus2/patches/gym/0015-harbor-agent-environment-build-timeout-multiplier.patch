harbor_agent: harbor_environment_build_timeout_multiplier sets Harbor's
environment_build_timeout_multiplier, the multiplier of the environment start timeout alone
(task.toml's [environment] build_timeout_sec). A pod that waits in the sandbox cluster's queue
counts against that timeout, and the 933 Terminal-Lego-15k tasks allow 120 s: with about 550
sandboxes requested at once (job 1276171), 50 of their trials failed with
EnvironmentStartTimeoutError. harbor_timeout_multiplier would stretch the agent and verifier
timeouts too. None keeps Harbor's behaviour (harbor_timeout_multiplier applies).

--- a/responses_api_agents/harbor_agent/app.py
+++ b/responses_api_agents/harbor_agent/app.py
@@ -105,6 +105,11 @@
     harbor_verifier_max_timeout: Optional[int] = None
     # Multiplier applied to all Harbor timeouts after override/cap. None = 1.0.
     harbor_timeout_multiplier: Optional[float] = None
+    # Multiplier for the environment start timeout alone (task.toml's
+    # [environment] build_timeout_sec), replacing harbor_timeout_multiplier for
+    # it. A pod that waits in the cluster's queue counts against that timeout,
+    # and some tasks allow only 120 s. None = harbor_timeout_multiplier.
+    harbor_environment_build_timeout_multiplier: Optional[float] = None
 
     # --- Job output ---
     # Directory where Harbor writes job results and trial artifacts.
@@ -581,6 +586,7 @@
             timeout_multiplier=(
                 self.config.harbor_timeout_multiplier if self.config.harbor_timeout_multiplier is not None else 1.0
             ),
+            environment_build_timeout_multiplier=self.config.harbor_environment_build_timeout_multiplier,
             n_concurrent_trials=1,
             quiet=True,
             environment=environment_config,
--- a/responses_api_agents/harbor_agent/tests/test_app.py
+++ b/responses_api_agents/harbor_agent/tests/test_app.py
@@ -553,6 +553,28 @@
         assert config["tasks"][0]["path"] == "/tmp/test_dataset/test_task_123"
         assert config["tasks"][0]["source"] == "test_dataset"
 
+    def test_build_job_config_environment_build_timeout_multiplier(self) -> None:
+        pytest.importorskip("harbor")
+        kwargs = dict(
+            dataset_alias="scientific",
+            task_name="test_task_123",
+            model_name="test_model",
+            api_base="http://policy-host:9000/v1",
+            job_name="test_job",
+            jobs_dir=Path("/tmp/harbor_jobs"),
+        )
+
+        config = _make_server(harbor_environment_type="docker")._build_job_config(**kwargs)
+        assert config["environment_build_timeout_multiplier"] is None
+
+        server = _make_server(
+            harbor_environment_type="docker",
+            harbor_environment_build_timeout_multiplier=5.0,
+        )
+        config = server._build_job_config(**kwargs)
+        assert config["environment_build_timeout_multiplier"] == 5.0
+        assert config["timeout_multiplier"] == 1.0
+
     def test_build_job_config_harbor_no_delete(self) -> None:
         pytest.importorskip("harbor")
         server = _make_server(harbor_no_delete=True, harbor_environment_type="docker")
