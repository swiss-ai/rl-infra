+"""A tool call that a harness echoes as it parsed it keeps its lineage.
+
+Observed with Claude Code 2.1.326 over ``/v1/messages`` (rl-infra experiments/claude-code-probe): the history of
+each request carries the tool calls as Claude Code validated them against its tool schemas, not as the model wrote
+them. ``Edit`` comes back with its schema default ``"replace_all": false`` filled in, and a ``Bash`` ``timeout``
+written as the string ``"5000"`` comes back as the number ``5000``. The served call hashed the model's arguments,
+the echo the parsed ones, so the next call matched no parent and the rollout was masked.
+
+The request's envelope carries the tool schemas, the same for the served call's row and for the echo, so both sides
+are compared as the schema reads them: a value equal to its declared default is dropped, a number or boolean given
+as a string is converted. Arguments that are not a JSON object, served over Messages as
+``{"_ng_unparsed_arguments": <raw>}``, hash as the unparseable marker on both sides.
+"""
+
+from __future__ import annotations
+
+import json
+
+from nemo_gym.anthropic_converter import AnthropicConverter
+from nemo_gym.base_responses_api_model import _request_messages
+from nemo_gym.token_id_capture.fingerprint import (
+    FINGERPRINT_VERSION,
+    assistant_fingerprint,
+    conversation_digest,
+    normalize_to_schema,
+)
+
+
+CONVERTER = AnthropicConverter()
+
+# Tool schemas as Claude Code 2.1.326 sends them (trimmed to the properties that matter here).
+TOOLS = [
+    {
+        "name": "Edit",
+        "description": "Performs exact string replacements in files.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "file_path": {"type": "string"},
+                "old_string": {"type": "string"},
+                "new_string": {"type": "string"},
+                "replace_all": {"type": "boolean", "default": False},
+            },
+            "required": ["file_path", "old_string", "new_string"],
+        },
+    },
+    {
+        "name": "Bash",
+        "description": "Executes a bash command.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "command": {"type": "string"},
+                "timeout": {"type": "number"},
+                "description": {"type": "string"},
+            },
+            "required": ["command"],
+        },
+    },
+]
+SYSTEM = [{"type": "text", "text": "You are Claude Code, Anthropic's official CLI for Claude."}]
+USER = {"role": "user", "content": [{"type": "text", "text": "Change the greeting in hello.py from Hello to Hi."}]}
+
+
+def _request(*messages: dict, tools=TOOLS) -> list[dict]:
+    """A Messages request as the model server's lineage sees it: converted to Responses, envelope prepended."""
+    body = {"model": "policy", "max_tokens": 16384, "system": SYSTEM, "messages": [USER, *messages], "stream": True}
+    if tools is not None:
+        body["tools"] = tools
+    return _request_messages(CONVERTER.anthropic_request_to_responses(body))
+
+
+def _served(name: str, call_id: str, arguments: str) -> dict:
+    """What the model server served: the model's own arguments, as generated."""
+    return {"type": "function_call", "id": f"fc_{call_id}", "call_id": call_id, "name": name, "arguments": arguments}
+
+
+def _echo(name: str, call_id: str, tool_input: dict) -> dict:
+    return {"role": "assistant", "content": [{"type": "tool_use", "id": call_id, "name": name, "input": tool_input}]}
+
+
+def _result(call_id: str, text: str) -> dict:
+    return {"role": "user", "content": [{"type": "tool_result", "tool_use_id": call_id, "content": text}]}
+
+
+def _continues(served: dict, echo: dict, tools=TOOLS) -> bool:
+    """Whether the request after `served` resolves to it: its model-authored turns match the served call's row
+    (request items + output items) and its prefix matches the served call's request."""
+    first = _request(tools=tools)
+    row_fingerprint = assistant_fingerprint(list(first) + [served])
+    nxt = _request(echo, _result(served["call_id"], "ok"), tools=tools)
+    return assistant_fingerprint(nxt) == row_fingerprint and conversation_digest(nxt[: len(first)]) == (
+        conversation_digest(first)
+    )
+
+
+EDIT = {"file_path": "/app/hello.py", "old_string": "Hello", "new_string": "Hi"}
+
+
+def test_fingerprint_version_is_bumped() -> None:
+    assert FINGERPRINT_VERSION == 6
+
+
+def test_an_echo_with_the_schema_default_filled_in_continues_the_served_call() -> None:
+    served = _served("Edit", "call_1", json.dumps(EDIT))
+    assert _continues(served, _echo("Edit", "call_1", {"replace_all": False, **EDIT}))
+
+
+def test_an_echo_with_a_string_number_converted_continues_the_served_call() -> None:
+    served = _served("Bash", "call_2", json.dumps({"command": "echo hi", "timeout": "5000"}))
+    assert _continues(served, _echo("Bash", "call_2", {"command": "echo hi", "timeout": 5000}))
+
+
+def test_a_value_other_than_the_default_still_tells_calls_apart() -> None:
+    served = _served("Edit", "call_3", json.dumps({**EDIT, "replace_all": True}))
+    assert not _continues(served, _echo("Edit", "call_3", {**EDIT, "replace_all": False}))
+    assert _continues(served, _echo("Edit", "call_3", {**EDIT, "replace_all": True}))
+
+
+def test_without_the_tool_schemas_the_arguments_compare_as_they_are() -> None:
+    served = _served("Edit", "call_4", json.dumps(EDIT))
+    assert not _continues(served, _echo("Edit", "call_4", {"replace_all": False, **EDIT}), tools=None)
+
+
+def test_arguments_that_are_not_a_json_object_and_their_messages_echo_hash_the_same() -> None:
+    for raw in ("ls -la", "[1, 2]", '"ls"'):
+        served = _served("Bash", "call_5", raw)
+        # what the Anthropic converter serves for them, and Claude Code echoes back
+        echoed_input = CONVERTER._tool_use_input(raw)
+        assert echoed_input == {"_ng_unparsed_arguments": raw}
+        assert _continues(served, _echo("Bash", "call_5", echoed_input)), raw
+
+
+def test_normalize_to_schema() -> None:
+    schema = {
+        "properties": {
+            "flag": {"type": "boolean", "default": False},
+            "count": {"type": "integer", "default": 0},
+            "limit": {"type": ["integer", "null"]},
+            "ratio": {"type": "number"},
+            "nested": {"type": "object", "default": {}},
+            "name": {"type": "string", "default": "x"},
+        }
+    }
+    assert normalize_to_schema({"flag": False, "count": 0, "name": "x", "nested": {}}, schema) == {}
+    # the default only for a value of its own type: 0 is not False, "0" counts as 0 for an integer
+    assert normalize_to_schema({"flag": 0, "count": "0"}, schema) == {"flag": 0}
+    assert normalize_to_schema({"flag": "true", "limit": "5", "ratio": "2.5"}, schema) == {
+        "flag": True,
+        "limit": 5,
+        "ratio": 2.5,
+    }
+    # strings JSON cannot carry as numbers, and anything not a scalar string, stay as they are
+    assert normalize_to_schema({"ratio": "inf", "limit": "1e400", "other": "5"}, schema) == {
+        "ratio": "inf",
+        "limit": "1e400",
+        "other": "5",
+    }
+    assert normalize_to_schema({"ratio": "1e400"}, schema) == {"ratio": "1e400"}
+    assert normalize_to_schema({"nested": {"flag": "true"}}, schema) == {"nested": {"flag": "true"}}
+
+
+def test_a_call_without_an_id_and_unparseable_arguments_still_hashes() -> None:
+    # no id, so no marker: the raw text is compared as it is, also when the tool has a schema
+    items = [*_request(), {"type": "function_call", "call_id": "", "name": "Bash", "arguments": "ls -la"}]
+    assert assistant_fingerprint(items)
