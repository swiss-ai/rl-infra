+def _tool_schemas(messages: list[dict]) -> dict[str, dict]:
+    """Return the request's tool parameter schemas by tool name, read from its envelope pseudo-turn.
+
+    The served call's ledger row and the echo of that call carry the same envelope, so both sides of a
+    comparison normalize against the same schemas. A request without an envelope gives no schemas.
+    """
+    for message in messages or []:
+        if not isinstance(message, dict) or message.get("role") != REQUEST_ENVELOPE_ROLE:
+            continue
+        try:
+            envelope = json.loads(message.get("content") or "{}")
+        except (TypeError, ValueError):
+            return {}
+        schemas: dict[str, dict] = {}
+        for tool in (envelope.get("tools") if isinstance(envelope, dict) else None) or []:
+            if not isinstance(tool, dict):
+                continue
+            function = tool.get("function") if isinstance(tool.get("function"), dict) else {}
+            name = tool.get("name") or function.get("name")
+            schema = tool.get("parameters") or tool.get("input_schema") or function.get("parameters")
+            if isinstance(name, str) and isinstance(schema, dict):
+                schemas[name] = schema
+        return schemas
+    return {}
+
+
+def normalize_to_schema(arguments: dict, schema: dict) -> dict:
+    """Return top-level tool arguments as a harness that validates them against ``schema`` would echo them.
+
+    A key whose value equals the property's declared ``default`` is dropped, so a call that left it out and
+    an echo that filled it in compare equal. A string where the property is a number, integer or boolean is
+    converted when it reads as one. Everything else, nested values included, stays as it is.
+    """
+    properties = schema.get("properties") if isinstance(schema.get("properties"), dict) else {}
+    normalized = {}
+    for key, value in arguments.items():
+        prop = properties.get(key)
+        if isinstance(prop, dict):
+            value = _coerce_scalar(value, prop.get("type"))
+            if "default" in prop and type(value) is type(prop["default"]) and value == prop["default"]:
+                continue
+        normalized[key] = value
+    return normalized
+
+
+_INTEGER_TEXT = re.compile(r"[+-]?\d+")
+# plain decimal literals only: float() would also take "inf" and "nan", which JSON cannot carry
+_NUMBER_TEXT = re.compile(r"[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?")
+
+
+def _coerce_scalar(value: Any, declared: Any) -> Any:
+    if not isinstance(value, str):
+        return value
+    types = set(declared) if isinstance(declared, list) else {declared}
+    text = value.strip()
+    if "boolean" in types and text in ("true", "false"):
+        return text == "true"
+    if ("integer" in types or "number" in types) and _INTEGER_TEXT.fullmatch(text):
+        return int(text)
+    if "number" in types and _NUMBER_TEXT.fullmatch(text):
+        number = float(text)
+        return number if math.isfinite(number) else value  # "1e400" overflows to inf
+    return value
+
+
