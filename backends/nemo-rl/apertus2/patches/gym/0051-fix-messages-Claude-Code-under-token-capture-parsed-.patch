+def _cut_response(output: list, output_tokens: int | None) -> NeMoGymResponse:
+    """A reply cut by the output limit; with no tokens and no content it is vllm_model's context-overflow
+    placeholder (the empty completion with finish_reason length that answers a prompt that does not fit)."""
+    usage = None
+    if output_tokens is not None:
+        usage = {
+            "input_tokens": 100,
+            "output_tokens": output_tokens,
+            "total_tokens": 100 + output_tokens,
+            "input_tokens_details": {"cached_tokens": 0},
+            "output_tokens_details": {"reasoning_tokens": 0},
+        }
+    return NeMoGymResponse(
+        id=f"resp_{uuid4().hex}",
+        created_at=int(time()),
+        model="downstream-model",
+        object="response",
+        output=output,
+        status="incomplete",
+        incomplete_details={"reason": "max_output_tokens"},
+        usage=usage,
+        tool_choice="auto",
+        parallel_tool_calls=True,
+        tools=[],
+    )
+
+
+_EMPTY_MESSAGE = {
+    "type": "message",
+    "id": "msg_empty",
+    "role": "assistant",
+    "status": "completed",
+    "content": [{"type": "output_text", "text": "", "annotations": []}],
+}
+
+
+def _cut_model(response: NeMoGymResponse):
+    class _CutModel(_BodyOnlyModel):
+        async def responses(self, body: NeMoGymResponseCreateParamsNonStreaming = Body()) -> NeMoGymResponse:
+            return response
+
+    return _CutModel
+
+
+class TestContextOverflowOverMessages:
+    """Claude Code re-sends a request after an empty max_tokens reply, with a resume prompt appended to its
+    history (each re-send another root under capture); a 400 "prompt is too long" ends its episode at once."""
+
+    def _post(self, model_cls, stream: bool):
+        client, _ = _client(model_cls)
+        return client.post(
+            "/v1/messages",
+            json={
+                "model": "policy",
+                "max_tokens": 8,
+                "stream": stream,
+                "messages": [{"role": "user", "content": "x"}],
+            },
+        )
+
+    def test_placeholder_is_answered_with_anthropic_prompt_too_long(self) -> None:
+        for output in ([], [_EMPTY_MESSAGE]):
+            for stream in (False, True):
+                resp = self._post(_cut_model(_cut_response(output, output_tokens=None)), stream)
+                assert resp.status_code == 400, (output, stream)
+                assert resp.json()["type"] == "error"
+                assert resp.json()["error"]["type"] == "invalid_request_error"
+                assert "prompt is too long" in resp.json()["error"]["message"]
+
+    def test_a_reply_really_cut_by_the_output_limit_passes(self) -> None:
+        text = {**_EMPTY_MESSAGE, "content": [{"type": "output_text", "text": "partial", "annotations": []}]}
+        for output, tokens in (([text], 8), ([], 8)):
+            resp = self._post(_cut_model(_cut_response(output, output_tokens=tokens)), stream=False)
+            assert resp.status_code == 200
+            assert resp.json()["stop_reason"] == "max_tokens"
