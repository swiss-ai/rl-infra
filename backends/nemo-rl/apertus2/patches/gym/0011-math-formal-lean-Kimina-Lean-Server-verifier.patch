+++ b/resources_servers/math_formal_lean/tests/test_kimina_lean_client.py
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The Kimina verifier gives the sandbox's result format, so app.py scores it the same way."""
+
+import asyncio
+import json
+from unittest.mock import MagicMock
+
+import httpx
+import pytest
+
+from nemo_gym.openai_utils import (
+    NeMoGymResponse,
+    NeMoGymResponseCreateParamsNonStreaming,
+    NeMoGymResponseOutputMessage,
+    NeMoGymResponseOutputText,
+)
+from nemo_gym.server_utils import ServerClient
+from resources_servers.math_formal_lean.app import (
+    MathFormalLeanResourcesServer,
+    MathFormalLeanResourcesServerConfig,
+    MathFormalLeanVerifyRequest,
+    determine_proof_status,
+    format_error_feedback,
+)
+from resources_servers.math_formal_lean.kimina_lean_client import (
+    LEAN_FILE,
+    KiminaLean4Client,
+    to_sandbox_output,
+)
+
+
+def ok(messages=None, sorries=None):
+    response = {"env": 0}
+    if messages is not None:
+        response["messages"] = messages
+    if sorries is not None:
+        response["sorries"] = sorries
+    return {"id": "proof", "time": 0.1, "response": response}
+
+
+ERROR = {
+    "severity": "error",
+    "pos": {"line": 7, "column": 2},
+    "endPos": {"line": 7, "column": 10},
+    "data": "linarith failed to find a contradiction",
+}
+SORRY = {
+    "severity": "warning",
+    "pos": {"line": 5, "column": 8},
+    "endPos": {"line": 5, "column": 9},
+    "data": "declaration uses 'sorry'",
+}
+
+
+def test_valid_proof_is_completed():
+    out = to_sandbox_output(ok(), 1000)
+    assert out == {"process_status": "completed", "stdout": "", "stderr": ""}
+    assert determine_proof_status(out) == "completed"
+
+
+def test_lean_error_is_failed_with_lean_style_lines():
+    out = to_sandbox_output(ok([ERROR]), 1000)
+    assert out["process_status"] == "failed"
+    assert out["stdout"] == f"{LEAN_FILE}:7:2: error: linarith failed to find a contradiction\n"
+    assert determine_proof_status(out) == "failed"
+    assert "linarith failed" in format_error_feedback(out, "proof")
+
+
+def test_sorry_is_detected():
+    out = to_sandbox_output(ok([SORRY], sorries=[{"pos": {"line": 5, "column": 8}}]), 1000)
+    assert out["process_status"] == "completed"
+    assert determine_proof_status(out) == "has_sorry"
+
+
+def test_sorries_without_a_warning_still_count():
+    out = to_sandbox_output(ok([], sorries=[{"pos": {"line": 5, "column": 8}}]), 1000)
+    assert determine_proof_status(out) == "has_sorry"
+
+
+def test_timeouts_and_server_errors():
+    timed_out = to_sandbox_output({"id": "proof", "error": "Lean REPL command timed out in 30 seconds"}, 1000)
+    assert determine_proof_status(timed_out) == "timeout"
+    broken = to_sandbox_output({"id": "proof", "response": {"message": "unknown environment"}}, 1000)
+    assert determine_proof_status(broken) == "error"
+
+
+def test_output_is_truncated_like_the_sandbox():
+    out = to_sandbox_output(ok([dict(ERROR, data="x" * 5000)]), 100)
+    assert out["stdout"].endswith("<output cut>") and len(out["stdout"]) == 100 + len("<output cut>")
+
+
+class Server:
+    def __init__(self, replies):
+        self.replies = list(replies)
+        self.payloads = []
+
+    def handler(self, request):
+        self.payloads.append(json.loads(request.content))
+        status, body = self.replies.pop(0)
+        return httpx.Response(status, json=body)
+
+
+def test_execute_lean4_sends_one_snippet_and_retries_refusals(monkeypatch):
+    async def no_sleep(_):
+        return None
+
+    monkeypatch.setattr("resources_servers.math_formal_lean.kimina_lean_client.asyncio.sleep", no_sleep)
+    server = Server([(429, {"detail": "busy"}), (200, {"results": [ok([ERROR])]})])
+    client = KiminaLean4Client("http://kimina", transport=httpx.MockTransport(server.handler))
+    out = asyncio.run(client.execute_lean4("theorem t : 1 = 2 := by linarith", timeout=29.5))
+    assert out["process_status"] == "failed"
+    assert len(server.payloads) == 2
+    assert server.payloads[0]["snippets"][0]["code"].startswith("theorem t")
+    assert server.payloads[0]["timeout"] == 30
+
+
+def test_unchecked_proof_is_an_error_not_a_timeout(monkeypatch):
+    async def no_sleep(_):
+        return None
+
+    monkeypatch.setattr("resources_servers.math_formal_lean.kimina_lean_client.asyncio.sleep", no_sleep)
+    server = Server([(503, {})] * 3)
+    client = KiminaLean4Client("http://kimina", n_retries=3, transport=httpx.MockTransport(server.handler))
+    out = asyncio.run(client.execute_lean4("x"))
+    assert out["process_status"] == "error" and "not checked" in out["stderr"]
+
+
+def make_response(text):
+    return NeMoGymResponse(
+        id="r",
+        created_at=0.0,
+        model="m",
+        object="response",
+        output=[
+            NeMoGymResponseOutputMessage(
+                id="msg",
+                content=[NeMoGymResponseOutputText(annotations=[], text=text, type="output_text")],
+                role="assistant",
+                status="completed",
+                type="message",
+            )
+        ],
+        parallel_tool_calls=True,
+        tool_choice="auto",
+        tools=[],
+    )
+
+
+@pytest.mark.parametrize("reply,reward", [(ok(), 1.0), (ok([ERROR]), 0.0), (ok([SORRY]), 0.0)])
+def test_verify_end_to_end_with_kimina(reply, reward):
+    config = MathFormalLeanResourcesServerConfig(
+        host="127.0.0.1", port=0, entrypoint="app.py", name="math_formal_lean",
+        verifier="kimina", kimina_url="http://kimina",
+    )
+    server = MathFormalLeanResourcesServer(config=config, server_client=MagicMock(spec=ServerClient))
+    lean = Server([(200, {"results": [reply]})])
+    server._sandbox_client._transport = httpx.MockTransport(lean.handler)
+    body = MathFormalLeanVerifyRequest(
+        responses_create_params=NeMoGymResponseCreateParamsNonStreaming(input=[]),
+        response=make_response("```lean4\ntheorem t : 1 + 1 = 2 := by\n  norm_num\n```"),
+        header="import Mathlib\n",
+        formal_statement="theorem t : 1 + 1 = 2 := by\n",
+    )
+    result = asyncio.run(server.verify(body))
+    assert result.reward == reward
+    sent = lean.payloads[0]["snippets"][0]["code"]
+    assert sent.startswith("import Mathlib\ntheorem t : 1 + 1 = 2 := by\n") and "norm_num" in sent
+
+
+def test_unknown_verifier_is_refused():
+    config = MathFormalLeanResourcesServerConfig(
+        host="127.0.0.1", port=0, entrypoint="app.py", name="math_formal_lean", verifier="other"
+    )
+    with pytest.raises(ValueError):
+        MathFormalLeanResourcesServer(config=config, server_client=MagicMock(spec=ServerClient))
