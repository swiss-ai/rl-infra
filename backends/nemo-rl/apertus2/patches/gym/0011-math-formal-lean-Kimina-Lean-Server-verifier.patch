@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Lean 4 checks on a Kimina Lean Server (https://github.com/project-numina/kimina-lean-server).
+
+The NeMo-Skills sandbox runs `lake env lean` on every proof, which imports the header
+(all of Mathlib) again each time. Kimina keeps a pool of Lean REPLs that have imported
+the header once and checks each proof in one of them, so a proof costs its own
+elaboration only. This client returns the sandbox's result format, so `app.py` scores
+and formats feedback the same way whichever verifier runs:
+
+- `process_status`: "completed" when Lean reports no error (the sandbox: `lean` exit 0),
+  "failed" when it reports one, "timeout", or "error" when the proof was not checked;
+- `stdout`: Lean's messages as `lean` prints them (`<file>:<line>:<col>: <severity>: <text>`),
+  so a `sorry` warning still reads "declaration uses 'sorry'";
+- `stderr`: the reason for "timeout" or "error".
+
+Requests wait for a free slot (`max_inflight`, set it to the server's MAX_REPLS) instead
+of timing out in httpx's connection pool, so a burst of verifications queues rather than
+scoring proofs that were never checked as timeouts.
+"""
+
+import asyncio
+import logging
+import math
+from typing import Any, Dict, Optional
+
+import httpx
+
+
+LOG = logging.getLogger(__name__)
+
+# Same file prefix as the sandbox's project, which `app.parse_error` looks for.
+LEAN_FILE = "/lean4/my_project/Main.lean"
+
+
+def _truncate(text: str, limit: int) -> str:
+    return text[:limit] + "<output cut>" if len(text) > limit else text
+
+
+def to_sandbox_output(result: Dict[str, Any], max_output_characters: int) -> Dict[str, Any]:
+    """Map one Kimina `ReplResponse` (as JSON) to the sandbox's output dictionary."""
+    error = result.get("error")
+    if error:
+        status = "timeout" if "timed out" in error else "error"
+        return {"process_status": status, "stdout": "", "stderr": _truncate(error, max_output_characters)}
+
+    response = result.get("response") or {}
+    if "message" in response:  # the REPL refused the command itself
+        return {
+            "process_status": "error",
+            "stdout": "",
+            "stderr": _truncate(str(response["message"]), max_output_characters),
+        }
+
+    lines = []
+    has_error = False
+    for message in response.get("messages") or []:
+        severity = message.get("severity", "info")
+        has_error = has_error or severity == "error"
+        pos = message.get("pos") or {}
+        lines.append(
+            f"{LEAN_FILE}:{pos.get('line', 0)}:{pos.get('column', 0)}: {severity}: {message.get('data', '')}"
+        )
+    stdout = "\n".join(lines) + ("\n" if lines else "")
+    # A `sorry` always comes with Lean's "declaration uses 'sorry'" warning; say it anyway
+    # if the REPL reported sorries without one, so app.determine_proof_status sees it.
+    if response.get("sorries") and "sorry" not in stdout:
+        stdout += f"{LEAN_FILE}:0:0: warning: declaration uses 'sorry'\n"
+    return {
+        "process_status": "failed" if has_error else "completed",
+        "stdout": _truncate(stdout, max_output_characters),
+        "stderr": "",
+    }
+
+
+class KiminaLean4Client:
+    """Same interface as `Lean4SandboxClient`, backed by a Kimina Lean Server."""
+
+    def __init__(
+        self,
+        url: str,
+        api_key: Optional[str] = None,
+        max_output_characters: int = 1000,
+        max_inflight: int = 256,
+        n_retries: int = 3,
+        transport: Optional[httpx.AsyncBaseTransport] = None,
+    ):
+        self.url = url.rstrip("/")
+        self.api_key = api_key
+        self.max_output_characters = max_output_characters
+        self.max_inflight = max_inflight
+        self.n_retries = n_retries
+        self._transport = transport
+        self._client: Optional[httpx.AsyncClient] = None
+        self._sem: Optional[asyncio.Semaphore] = None
+
+    async def _get_client(self) -> httpx.AsyncClient:
+        if self._client is None:
+            headers = {"Authorization": f"Bearer {self.api_key}"} if self.api_key else {}
+            self._client = httpx.AsyncClient(
+                headers=headers,
+                limits=httpx.Limits(
+                    max_keepalive_connections=self.max_inflight, max_connections=self.max_inflight
+                ),
+                transport=self._transport,
+            )
+            self._sem = asyncio.Semaphore(self.max_inflight)
+        return self._client
+
+    async def close(self) -> None:
+        if self._client is not None:
+            await self._client.aclose()
+            self._client = None
+
+    async def execute_lean4(self, code: str, timeout: float = 30.0) -> Dict[str, Any]:
+        client = await self._get_client()
+        assert self._sem is not None
+        seconds = max(1, math.ceil(timeout))
+        payload = {"snippets": [{"id": "proof", "code": code}], "timeout": seconds, "reuse": True}
+        # The server may wait for a free REPL and import a header before the check's own
+        # timeout starts; the slot semaphore keeps that wait short.
+        request_timeout = httpx.Timeout(2 * seconds + 180.0, connect=30.0, pool=None)
+        last = ""
+        async with self._sem:
+            for attempt in range(self.n_retries):
+                if attempt:
+                    await asyncio.sleep(min(10.0, 2.0**attempt))
+                try:
+                    response = await client.post(f"{self.url}/api/check", json=payload, timeout=request_timeout)
+                except httpx.HTTPError as e:
+                    last = f"{type(e).__name__}: {e}"
+                    continue
+                if response.status_code in (429, 500, 502, 503, 504):
+                    last = f"Kimina server HTTP {response.status_code}"
+                    continue
+                if response.status_code != 200:
+                    last = f"Kimina server HTTP {response.status_code}: {response.text[:200]}"
+                    break
+                try:
+                    (result,) = response.json()["results"]
+                except (ValueError, KeyError, TypeError):
+                    last = "Invalid response from the Kimina server"
+                    break
+                return to_sandbox_output(result, self.max_output_characters)
+        LOG.error("Proof not checked by the Kimina server: %s", last)
+        return {"process_status": "error", "stdout": "", "stderr": f"Proof not checked: {last}"}
+
+    async def health_check(self, timeout: float = 5.0) -> bool:
+        client = await self._get_client()
+        try:
+            response = await client.get(f"{self.url}/health", timeout=timeout)
+            return response.status_code == 200
+        except httpx.HTTPError:
+            return False
diff --git a/resources_servers/math_formal_lean/tests/test_kimina_lean_client.py b/resources_servers/math_formal_lean/tests/test_kimina_lean_client.py
