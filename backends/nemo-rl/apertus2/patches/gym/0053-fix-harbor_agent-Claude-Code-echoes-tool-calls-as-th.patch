From 15e382d71c58faf9f3aa20a809ff0fc4409234ad Mon Sep 17 00:00:00 2001
From: Lukas Drescher <lukas.drescher@cscs.ch>
Date: Thu, 26 Nov 2026 10:49:45 +0100
Subject: [PATCH] fix(harbor_agent): Claude Code echoes tool calls as the model
 sent them

By default Claude Code 2.1.326 repeats each tool call in the history as it parsed and rendered it: schema
defaults filled in, numbers given as strings converted, keys reordered, trailing whitespace stripped from Write
and Edit text, and a leading `cd <its cwd> && ` dropped from a Bash command. The call after such an echo matches
no parent and its rollout is masked; on the Chonk SFT models, which start most commands with
`cd /workspace && `, that was 12 of 32 rollouts at 32K and 19 of 32 at 64K (rl-infra jobs 1061268, 1061276).

The undocumented CLAUDE_CODE_HUMBLE_HAMMOCK=1 makes Claude Code echo its copies of the inputs as received
(read behind the gate tengu_foamy_spring, which is on without feature flags). rl-infra's claude-code-probe,
scenario `rewrites`: 0 unresolved calls with it, 2 without; every other scenario unchanged, the system prompt
and tools identical. The fingerprint's schema normalization (0051) stays as a fallback.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 responses_api_agents/harbor_agent/README.md                | 7 +++++--
 .../harbor_agent/custom_agents/claude_code_nemo_gym.py     | 6 ++++++
 .../custom_agents/test_claude_code_nemo_gym.py             | 2 ++
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/responses_api_agents/harbor_agent/README.md b/responses_api_agents/harbor_agent/README.md
index b6c621c5..15add049 100644
--- a/responses_api_agents/harbor_agent/README.md
+++ b/responses_api_agents/harbor_agent/README.md
@@ -598,8 +598,11 @@ sub-agent model resolve to the policy, so a stray side call is still visible in
 sampling parameters: use `sampling_overrides`. `max_turns` is the CLI's own `--max-turns`; Claude Code exits 1
 after an error (`result` event with `is_error`); the failure classes read `agent/claude-code.txt`. Behaviour was
 measured with rl-infra's `experiments/claude-code-probe` for the pinned version: one chain per rollout, no calls
-besides `POST /v1/messages`, no rewritten tool results. Tool calls echo as Claude Code parsed them (schema
-defaults filled in, numbers given as strings converted), which the capture's fingerprint has to allow for.
+besides `POST /v1/messages`, no rewritten tool results. By default Claude Code echoes each tool call as it parsed
+and rendered it (schema defaults filled in, numbers given as strings converted, keys reordered, trailing whitespace
+stripped from written text, a leading `cd <its cwd> && ` dropped from a command), and the call after such an echo
+matches no parent. The adapter sets the undocumented `CLAUDE_CODE_HUMBLE_HAMMOCK=1`, with which 2.1.326 echoes each
+call as the model sent it; the fingerprint's schema normalization stays as a fallback.
 
 ```yaml
 harbor_agent_name: null
diff --git a/responses_api_agents/harbor_agent/custom_agents/claude_code_nemo_gym.py b/responses_api_agents/harbor_agent/custom_agents/claude_code_nemo_gym.py
index 3ccab674..8eb210bf 100644
--- a/responses_api_agents/harbor_agent/custom_agents/claude_code_nemo_gym.py
+++ b/responses_api_agents/harbor_agent/custom_agents/claude_code_nemo_gym.py
@@ -260,6 +260,12 @@ class ClaudeCodeNemoGym(ClaudeCode):
             "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
             "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
             "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
+            # the history repeats each tool call as the model sent it. Otherwise Claude Code repeats the input as it
+            # parsed and rendered it (schema defaults filled in, numbers parsed, keys reordered, trailing whitespace
+            # stripped from Write and Edit text, a leading `cd <its cwd> && ` dropped from a command), and the next
+            # call matches no parent. Undocumented; read in 2.1.326 behind the gate tengu_foamy_spring, which is on
+            # without feature flags. rl-infra's claude-code-probe scenario `rewrites` checks it on every version.
+            "CLAUDE_CODE_HUMBLE_HAMMOCK": "1",
             # a per-request block in the system prompt would change it on every call
             "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
             # --- request shape
diff --git a/responses_api_agents/harbor_agent/custom_agents/test_claude_code_nemo_gym.py b/responses_api_agents/harbor_agent/custom_agents/test_claude_code_nemo_gym.py
index 5f545e2f..d6b209c6 100644
--- a/responses_api_agents/harbor_agent/custom_agents/test_claude_code_nemo_gym.py
+++ b/responses_api_agents/harbor_agent/custom_agents/test_claude_code_nemo_gym.py
@@ -99,6 +99,8 @@ def test_env_keeps_claude_code_to_one_chain(tmp_path: Path) -> None:
         "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
         "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
         "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
+        # tool calls echoed verbatim: a leading `cd /workspace && ` dropped from the echo masked 19 of 32 rollouts
+        "CLAUDE_CODE_HUMBLE_HAMMOCK": "1",
         "DISABLE_PROMPT_CACHING": "1",
         "MAX_THINKING_TOKENS": "0",
         "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
