+# --- OpenCode: its `run --format=json` log (agent/opencode.txt) --------------------------------------------------
+# Event shapes of OpenCode v1.17.11 (cli/cmd/run.ts emit(); step-finish parts from session/processor.ts with
+# tokens from Session.getUsage), mixed with its debug log lines as under --print-logs.
+
+
+def _oc_event(event_type: str, **data) -> str:
+    return json.dumps({"type": event_type, "timestamp": 1763000000000, "sessionID": "ses_1", **data})
+
+
+def _oc_step(reason: str, prompt: int, completion: int, reasoning: int = 0, cache_read: int = 0) -> str:
+    tokens = {
+        "input": prompt - cache_read,
+        "output": completion - reasoning,
+        "reasoning": reasoning,
+        "cache": {"read": cache_read, "write": 0},
+    }
+    return "\n".join(
+        [
+            _oc_event("step_start", part={"type": "step-start"}),
+            _oc_event("step_finish", part={"type": "step-finish", "reason": reason, "tokens": tokens, "cost": 0}),
+        ]
+    )
+
+
+def _oc_log(*chunks: str) -> str:
+    return "\n".join(["INFO  2026-11-17T09:46:00 +1ms service=default version=1.17.11 opencode", *chunks]) + "\n"
+
+
+# The Gym model server answers vLLM's 400 "maximum context length" with a placeholder completion (no tokens,
+# no usage, finish_reason "length") unless propagate_context_overflow_errors is set; OpenCode then ends its
+# loop without an error and exits 0.
+_OC_PLACEHOLDER = _oc_step("length", 0, 0)
+_OC_TOOL_STEP = _oc_step("tool-calls", 5406, 80)
+
+
+def test_opencode_placeholder_on_the_first_call_is_a_prompt_that_does_not_fit() -> None:
+    flags = opencode_end_flags(_oc_log(_OC_PLACEHOLDER), context_limit=24576)
+
+    assert flags["context_length_exceeded"] is True
+    assert (flags["answered_model_calls"], flags["prompt_over_context_limit"]) == (0, True)
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert failure.detail.startswith("prompt does not fit: ContextLengthExceededError: OpenCode: ")
+    assert "model call 1" in failure.detail and "placeholder" in failure.detail
+
+
+def test_opencode_placeholder_mid_episode_is_a_context_overflow() -> None:
+    log = _oc_log(_OC_TOOL_STEP, _oc_step("tool-calls", 9000, 200, reasoning=150, cache_read=5000), _OC_PLACEHOLDER)
+    flags = opencode_end_flags(log, context_limit=24576)
+
+    assert (flags["answered_model_calls"], flags["prompt_over_context_limit"]) == (2, True)
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert failure.detail.startswith("ContextLengthExceededError: OpenCode: model call 3 ")
+
+
+def test_opencode_context_overflow_error_event() -> None:
+    # with propagate_context_overflow_errors the 400 reaches OpenCode, which reports it as ContextOverflowError
+    message = "Bad Request: This model's maximum context length is 24576 tokens. However, you requested 24601 tokens"
+    error = {"name": "ContextOverflowError", "data": {"message": message, "responseBody": "{}"}}
+    flags = opencode_end_flags(_oc_log(_OC_TOOL_STEP, _oc_event("error", error=error)), context_limit=None)
+
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert failure.detail == "ContextLengthExceededError: OpenCode: ContextOverflowError: " + message
+
+
+def test_opencode_api_error_with_the_context_length_text_is_a_context_overflow() -> None:
+    error = {"name": "APIError", "data": {"message": "This model's maximum context length is 24576 tokens."}}
+    flags = opencode_end_flags(_oc_log(_oc_event("error", error=error)))
+
+    assert classify_rollout(_trial(), flags).failure_class == "context_overflow"
+
+
+def test_opencode_reply_cut_by_the_context_ceiling() -> None:
+    # the NeMo-RL endpoint clamps max_tokens to the room left: prompt + completion = the limit
+    flags = opencode_end_flags(_oc_log(_OC_TOOL_STEP, _oc_step("length", 20000, 4576)), context_limit=24576)
+
+    assert (flags["prompt_over_context_limit"], flags["last_truncation_at_context_limit"]) == (False, True)
+    failure = classify_rollout(_trial(), flags)
+    assert failure.failure_class == "context_overflow"
+    assert "reply cut by the context limit (prompt 20000 + completion 4576 of 24576)" in failure.detail
+    assert not failure.detail.startswith("prompt does not fit")
+
+
+@pytest.mark.parametrize(
+    "log, context_limit",
+    [
+        pytest.param(_oc_log(_OC_TOOL_STEP, _oc_step("stop", 5600, 40)), 24576, id="stopped"),
