+        pytest.param("{not json\n[1, 2]\n" + _oc_event("text", part={"text": "{"}) + "\n", 24576, id="junk"),
+    ],
+)
+def test_opencode_logs_without_a_context_overflow_give_no_flags(log, context_limit) -> None:
+    assert opencode_end_flags(log, context_limit=context_limit) == {}
