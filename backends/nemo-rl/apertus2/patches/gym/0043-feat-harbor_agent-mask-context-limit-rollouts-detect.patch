+def opencode_context_cut_margin(context_limit: int) -> int:
+    """How far below the context limit a "length" reply still counts as cut by it: max(256, 1% of the limit).
+
+    The rule of Terminus-2's ``nemo_gym_llm.context_cut_margin``, kept here so this module needs no Harbor import.
+    """
+    return max(256, math.ceil(context_limit / 100))
+
+
+def _int(value: Any) -> int:
+    return value if isinstance(value, int) and not isinstance(value, bool) and value > 0 else 0
+
+
+def _opencode_step_tokens(part: dict) -> tuple[int, int]:
+    """(prompt, completion) tokens of an OpenCode step-finish part (Session.getUsage splits both up)."""
+    tokens = part.get("tokens") if isinstance(part.get("tokens"), dict) else {}
+    cache = tokens.get("cache") if isinstance(tokens.get("cache"), dict) else {}
+    prompt = _int(tokens.get("input")) + _int(cache.get("read")) + _int(cache.get("write"))
+    return prompt, _int(tokens.get("output")) + _int(tokens.get("reasoning"))
+
+
+def opencode_end_flags(log_text: str, context_limit: Optional[int] = None) -> dict[str, Any]:
+    """``agent_error_flags.json`` fields for an OpenCode episode that ended at the context limit, else ``{}``.
+
+    ``log_text`` is OpenCode's ``run --format=json`` output (one JSON event per line, debug log lines in
+    between). OpenCode ends its loop on any reply that is not a tool call, also on ``finish_reason: length``,
+    without an error and with exit code 0; the verifier then runs, so without this the rollout reads as ``ok``.
+    The context limit shows up in three ways:
+
+    - the model server's placeholder: Gym's vLLM model server answers vLLM's HTTP 400 "maximum context length"
+      with an empty completion with ``finish_reason: length`` and no usage (unless
+      ``propagate_context_overflow_errors``). OpenCode requests usage (``stream_options.include_usage``), so
+      every answered call has prompt tokens; a last ``length`` step with no tokens at all, after steps that all
+      had tokens, is that placeholder: the prompt did not fit.
+    - an ``error`` event that OpenCode classified as ``ContextOverflowError`` (the 400 propagated), or whose
+      message is a context-length error.
+    - a last ``length`` step whose prompt + completion come within ``opencode_context_cut_margin`` of
+      ``context_limit`` (the endpoint clamps max_tokens to the room left): the reply was cut by the ceiling.
+
+    A ``length`` reply with room left is an ordinary output-limit cut and gives ``{}``.
+    """
+    steps: list[tuple[str, int, int]] = []
+    overflow_error: Optional[str] = None
+    for line in str(log_text or "").splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict):
+            continue
+        if event.get("type") == "step_finish" and isinstance(event.get("part"), dict):
+            steps.append((str(event["part"].get("reason") or ""), *_opencode_step_tokens(event["part"])))
+        elif event.get("type") == "error" and isinstance(event.get("error"), dict) and overflow_error is None:
+            error = event["error"]
+            name = str(error.get("name") or "")
+            data = error.get("data") if isinstance(error.get("data"), dict) else {}
+            message = str(data.get("message") or "")
+            if name == "ContextOverflowError" or _CONTEXT_TEXT.search(message):
+                overflow_error = f"{name}: {message}" if name and message else (name or message)
+
+    answered = sum(1 for _, prompt, _ in steps if prompt > 0)
+    if overflow_error is not None:
+        return {
+            "end_reason": "ContextLengthExceededError",
+            "end_message": "OpenCode: " + overflow_error,
+            "context_length_exceeded": True,
+            "answered_model_calls": answered,
+            "prompt_over_context_limit": True,
+        }
+    if not steps or steps[-1][0] != "length":
+        return {}
+    _, prompt, completion = steps[-1]
+    if prompt == 0 and completion == 0:
+        if answered != len(steps) - 1:
+            return {}  # earlier steps without tokens too: no usage reported, zero tokens tell nothing
+        return {
+            "end_reason": "ContextLengthExceededError",
+            "end_message": f"OpenCode: model call {len(steps)} got the model server's context-overflow placeholder "
+            "(finish_reason length, no tokens): the prompt exceeds the context limit",
+            "context_length_exceeded": True,
+            "answered_model_calls": answered,
+            "prompt_over_context_limit": True,
+        }
+    if context_limit and prompt + completion >= context_limit - opencode_context_cut_margin(context_limit):
+        return {
+            "end_reason": "ContextLengthExceededError",
+            "end_message": f"OpenCode: reply cut by the context limit (prompt {prompt} + completion {completion} "
+            f"of {context_limit}); OpenCode ended the episode",
+            "context_length_exceeded": True,
+            "answered_model_calls": answered,
+            "prompt_over_context_limit": False,
+            "last_truncation_at_context_limit": True,
+        }
+    return {}
+
+
 def classify_rollout(
     trial_result: Optional[dict],
     agent_error_flags: Optional[dict] = None,
