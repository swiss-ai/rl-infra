diff --git a/nemo_gym/token_id_capture/fingerprint.py b/nemo_gym/token_id_capture/fingerprint.py
index efa661c3d..e29937e94 100644
--- a/nemo_gym/token_id_capture/fingerprint.py
+++ b/nemo_gym/token_id_capture/fingerprint.py
@@ -41,7 +41,7 @@ import orjson
 
 # Increment when fingerprint canonicalization or hash layout changes.
 # Resolvers ignore entries stamped with a different version.
-FINGERPRINT_VERSION = 1
+FINGERPRINT_VERSION = 2
 
 _FINGERPRINT_DOMAIN = b"nemo-gym-lineage"
 _CONTEXT_DOMAIN = b"nemo-gym-lineage-context"
@@ -53,22 +53,42 @@ def assistant_fingerprint(messages: list[dict]) -> str:
     The fingerprint identifies the call that produced the last model-authored turn.
     User and tool content is excluded from the lookup key.
     Dialect-specific tool-call shapes normalize to the same hash input.
+
+    A turn is a run of consecutive model-authored items.
+    A turn with no text and no tool call (an empty reply) hashes an explicit marker.
+    Without it, the call that produced an empty reply would share its parent's fingerprint.
+    The next request would then match both calls and resolve as ambiguous.
+    Non-empty turns hash exactly as before, so their fingerprints do not change.
     """
     hasher = hashlib.sha256(_FINGERPRINT_DOMAIN)
     count = 0
+    # Whether the current run of consecutive model-authored items hashed any field.
+    # ``None`` means no run is open.
+    run_hashed: bool | None = None
     for message in messages or []:
         if not isinstance(message, dict):
             raise ValueError(f"request item is not an object: {type(message).__name__}")
         if not _is_assistant_authored(message):
+            if message.get("type") == "reasoning":
+                # Excluded like reasoning content; it neither opens nor closes a turn.
+                continue
+            if run_hashed is False:
+                _update_field(hasher, b"\x05", "")
+            run_hashed = None
             continue
         count += 1
+        run_hashed = bool(run_hashed)
         for content_type, payload in _content_of(message.get("content")):
             _update_field(hasher, b"\x00", content_type)
             _update_field(hasher, b"\x01", payload)
+            run_hashed = True
         for call_id, name, arguments in _tools_of(message):
             _update_field(hasher, b"\x02", call_id)
             _update_field(hasher, b"\x03", name)
             _update_field(hasher, b"\x04", arguments)
+            run_hashed = True
+    if run_hashed is False:
+        _update_field(hasher, b"\x05", "")
     if count == 0:
         return ""
     return hasher.hexdigest()
diff --git a/tests/unit_tests/test_conversation_fingerprint.py b/tests/unit_tests/test_conversation_fingerprint.py
index 9b1a755a5..95f7dfe21 100644
--- a/tests/unit_tests/test_conversation_fingerprint.py
+++ b/tests/unit_tests/test_conversation_fingerprint.py
@@ -94,3 +94,52 @@ def test_a_non_object_item_raises_for_the_caller_to_handle():
         assistant_fingerprint([42])
     with pytest.raises(ValueError):
         conversation_digest(["not a dict"])
+
+
+def test_an_empty_assistant_turn_still_counts_as_a_turn():
+    # An agent that answers a parse error with a re-prompt echoes the model's
+    # empty reply. If empty turns hashed as nothing, the call that produced the
+    # empty reply would share its fingerprint with its parent, and the next
+    # request would match both (unresolved parent, job 5256202).
+    answer = {"role": "assistant", "content": "answer"}
+    empty = {"role": "assistant", "content": ""}
+    retry = {"role": "user", "content": "Previous response had parsing errors"}
+    one = assistant_fingerprint([answer, retry, empty])
+    two = assistant_fingerprint([answer, retry, empty, retry, empty])
+    assert len({assistant_fingerprint([answer]), one, two}) == 3
+    assert assistant_fingerprint([empty]) != assistant_fingerprint([empty, retry, empty])
+
+
+def test_an_empty_assistant_turn_hashes_identically_across_dialects():
+    shapes = [
+        {"role": "assistant", "content": ""},
+        {"role": "assistant", "content": None},
+        {"role": "assistant", "content": []},
+        {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "", "annotations": []}]},
+        {"role": "assistant", "content": [{"type": "text", "text": ""}]},
+        # A standalone reasoning item is excluded; it neither adds nor splits a turn.
+        [{"type": "reasoning", "summary": []}, {"role": "assistant", "content": ""}],
+    ]
+    fingerprints = {assistant_fingerprint(shape if isinstance(shape, list) else [shape]) for shape in shapes}
+    assert len(fingerprints) == 1 and fingerprints != {""}
+
+
+def test_an_empty_text_part_next_to_a_tool_call_is_not_an_empty_turn():
+    # Chat sends a tool-call-only turn with content None or "", Responses may
+    # add an empty message item before the function_call item. All of them
+    # carry the same model output and must keep hashing the same.
+    call = {"type": "function_call", "call_id": "c1", "name": "f", "arguments": "{}"}
+    chat_none = {
+        "role": "assistant",
+        "content": None,
+        "tool_calls": [{"id": "c1", "function": {"name": "f", "arguments": "{}"}}],
+    }
+    chat_empty = dict(chat_none, content="")
+    responses_with_empty_message = [{"type": "message", "role": "assistant", "content": []}, call]
+    fingerprints = {
+        assistant_fingerprint([call]),
+        assistant_fingerprint([chat_none]),
+        assistant_fingerprint([chat_empty]),
+        assistant_fingerprint(responses_with_empty_message),
+    }
+    assert len(fingerprints) == 1
diff --git a/tests/unit_tests/test_token_capture_empty_assistant.py b/tests/unit_tests/test_token_capture_empty_assistant.py
new file mode 100644
index 000000000..c380d9d16
--- /dev/null
+++ b/tests/unit_tests/test_token_capture_empty_assistant.py
@@ -0,0 +1,309 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
