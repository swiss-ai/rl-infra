+        assert tunnel._proc is None
+
+    @pytest.mark.asyncio
+    async def test_failed_health_check_fails_open_and_stops_client(self, chisel_dir, tmp_path):
+        _fake_chisel(chisel_dir / f"chisel_1.12.0_linux_{NODE_ARCH}", tmp_path / "c.json")
