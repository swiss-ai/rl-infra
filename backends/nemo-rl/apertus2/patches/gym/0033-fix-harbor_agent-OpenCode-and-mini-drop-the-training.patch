From 0bbf8eb76e6b56f6aaca0c4b92a6f14512b95236 Mon Sep 17 00:00:00 2001
From: Philip Mueller <claude@philipmueller.ch>
Date: Fri, 13 Nov 2026 06:30:44 +0000
Subject: [PATCH 33/34] fix(harbor_agent): OpenCode and mini drop the training
 yaml's Terminus-2 kwargs

configs/harbor_agent_opensandbox_training.yaml, which every run loads, sets
the Terminus-2 options enable_summarize, collect_rollout_details,
trajectory_config and nemo_model_server_timeout_sec. An OpenCode or mini
overlay merged on top cannot delete them (OmegaConf), so these agents got
them too. Harbor 0.1.42 ignored them; Harbor 0.25 rejects them as unknown
options, in Job.create's preflight and again in BaseAgent.__init__, so no
trial ran (job 5330618: 16/16 rollouts empty, 0 model calls).

They join SHARED_AGENT_KWARGS, which both the preflight
(kwargs_for_harbor_options) and __init__ (drop_shared_kwargs) drop. The
tests build the kwargs from the real yaml.

Signed-off-by: Philip Mueller <claude@philipmueller.ch>
---
 .../custom_agents/installed_compat.py         | 16 ++++++++--
 .../test_mini_swe_agent_nemo_gym.py           | 11 +++++++
 .../custom_agents/test_opencode_nemo_gym.py   | 31 +++++++++++++++++++
 3 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/responses_api_agents/harbor_agent/custom_agents/installed_compat.py b/responses_api_agents/harbor_agent/custom_agents/installed_compat.py
index 530123ab1..be09bbc40 100644
--- a/responses_api_agents/harbor_agent/custom_agents/installed_compat.py
+++ b/responses_api_agents/harbor_agent/custom_agents/installed_compat.py
@@ -40,8 +40,20 @@ from jinja2 import Environment
 from pydantic import BaseModel
 
 
-# kwargs that harbor_agent or the shared Terminus-2 harbor_agent_kwargs give to whichever agent runs
-SHARED_AGENT_KWARGS = ("responses_create_params", "temperature", "interleaved_thinking", "max_turns", "model_info")
+# kwargs that harbor_agent or the shared Terminus-2 harbor_agent_kwargs give to whichever agent runs. The last four
+# are Terminus-2 options from Gym's configs/harbor_agent_opensandbox_training.yaml, which every run loads; an agent
+# overlay merged on top cannot delete them (OmegaConf), so OpenCode and mini get them too (job 5330618).
+SHARED_AGENT_KWARGS = (
+    "responses_create_params",
+    "temperature",
+    "interleaved_thinking",
+    "max_turns",
+    "model_info",
+    "enable_summarize",
+    "collect_rollout_details",
+    "trajectory_config",
+    "nemo_model_server_timeout_sec",
+)
 
 
 def drop_shared_kwargs(kwargs: dict[str, Any], keep: Iterable[str] = ()) -> dict[str, Any]:
diff --git a/responses_api_agents/harbor_agent/custom_agents/test_mini_swe_agent_nemo_gym.py b/responses_api_agents/harbor_agent/custom_agents/test_mini_swe_agent_nemo_gym.py
index f0d673f1a..e971a616b 100644
--- a/responses_api_agents/harbor_agent/custom_agents/test_mini_swe_agent_nemo_gym.py
+++ b/responses_api_agents/harbor_agent/custom_agents/test_mini_swe_agent_nemo_gym.py
@@ -264,3 +264,14 @@ def test_preflight_accepts_the_kwargs_harbor_agent_passes() -> None:
 def test_preflight_still_rejects_an_unknown_option() -> None:
     with pytest.raises(ValueError, match="Unknown option 'not_an_option'"):
         MiniSweAgentNemoGym.preflight(kwargs={"api_base": "http://127.0.0.1:8000/v1", "not_an_option": 1}, env={})
+
+
+def test_preflight_accepts_the_training_yaml_kwargs() -> None:
+    # job 5330618: Gym's training yaml gives every agent its Terminus-2-only kwargs (see the OpenCode test)
+    from omegaconf import OmegaConf
+
+    path = Path(__file__).parents[1] / "configs" / "harbor_agent_opensandbox_training.yaml"
+    cfg = OmegaConf.to_container(OmegaConf.load(path), resolve=False)
+    kwargs = dict(cfg["harbor_agent"]["responses_api_agents"]["harbor_agent"]["harbor_agent_kwargs"])
+    kwargs.update(api_base="http://127.0.0.1:8000/v1", version="8e8a515fdcecf3a8e45c3909f7f196bfe18ca89a")
+    MiniSweAgentNemoGym.preflight(kwargs=kwargs, env={})
diff --git a/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py b/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py
index 1cc472c5a..817687e2b 100644
--- a/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py
+++ b/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py
@@ -494,3 +494,34 @@ def test_preflight_accepts_the_kwargs_harbor_agent_passes() -> None:
 def test_preflight_still_rejects_an_unknown_option() -> None:
     with pytest.raises(ValueError, match="Unknown option 'not_an_option'"):
         OpenCodeNemoGym.preflight(kwargs={"api_base": API_BASE, "not_an_option": 1}, env={})
+
+
+# Job 5330618: Gym's harbor_agent_opensandbox_training.yaml (a config_paths entry of every run) sets Terminus-2-only
+# kwargs; an OpenCode overlay merged on top cannot delete them (OmegaConf), so OpenCode gets them too and Harbor 0.25
+# rejected them as unknown options, in Job.create's preflight and again in BaseAgent.__init__.
+def _training_yaml_kwargs() -> dict:
+    from omegaconf import OmegaConf
+
+    path = Path(__file__).parents[1] / "configs" / "harbor_agent_opensandbox_training.yaml"
+    cfg = OmegaConf.to_container(OmegaConf.load(path), resolve=False)
+    return cfg["harbor_agent"]["responses_api_agents"]["harbor_agent"]["harbor_agent_kwargs"]
+
+
+def _training_yaml_plus_opencode() -> dict:
+    return {
+        **_training_yaml_kwargs(),
+        "api_base": API_BASE,
+        "responses_create_params": {"temperature": 1.0},
+        "temperature": 1.0,
+        "opencode_install": "binary",
+        "opencode_workdir": "/app",
+        "version": "1.17.11",
+    }
+
+
+def test_preflight_accepts_the_training_yaml_kwargs() -> None:
+    OpenCodeNemoGym.preflight(kwargs=_training_yaml_plus_opencode(), env={})
+
+
+def test_init_accepts_the_training_yaml_kwargs(tmp_path: Path) -> None:
+    OpenCodeNemoGym(logs_dir=tmp_path, model_name=MODEL, **_training_yaml_plus_opencode())
