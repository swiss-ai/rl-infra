OpenSandbox: provider_options.image_auth_file, a file holding username:password for the image
registry, read when the options are parsed, so that the registry password stays out of configs
(NeMo-RL prints the resolved one), command lines and the job environment. It becomes image_auth;
giving both is an error, and image_auth is left out of the options repr.

The verified Harbor tasks pull their images from a private registry project for which the
OpenSandbox cluster has no pull secret; swiss-ai/nemo-rl-development passes the credentials as
image_auth through oc.env instead.

diff --git a/nemo_gym/sandbox/providers/opensandbox/provider.py b/nemo_gym/sandbox/providers/opensandbox/provider.py
index c6208711..51ea6020 100644
--- a/nemo_gym/sandbox/providers/opensandbox/provider.py
+++ b/nemo_gym/sandbox/providers/opensandbox/provider.py
@@ -615,9 +615,14 @@ class OpenSandboxProviderOptions:
 
     ``image_auth``, ``network_policy``, ``platform``, and ``volumes`` entries are passed through to the
     OpenSandbox SDK, so their inner fields are validated by the SDK rather than here.
+
+    ``image_auth_file`` names a file holding ``username:password`` for the image registry, read
+    when the options are parsed, so that the password stays out of configs (NeMo-RL prints the
+    resolved one) and the job's environment. It becomes ``image_auth``; giving both is an error.
     """
 
-    image_auth: Mapping[str, Any] | None = None
+    image_auth: Mapping[str, Any] | None = field(default=None, repr=False)
+    image_auth_file: str | None = None
     network_policy: Mapping[str, Any] | None = None
     platform: Mapping[str, Any] | None = None
     snapshot_id: str | None = None
@@ -652,6 +657,14 @@ class OpenSandboxProviderOptions:
         image_auth = options.get("image_auth")
         if image_auth is not None and not isinstance(image_auth, Mapping):
             raise TypeError("OpenSandbox provider option 'image_auth' must be a mapping")
+        image_auth_file = options.get("image_auth_file")
+        if image_auth_file is not None:
+            if image_auth is not None:
+                raise ValueError("OpenSandbox provider options 'image_auth' and 'image_auth_file' are exclusive")
+            username, sep, password = Path(image_auth_file).read_text().strip().partition(":")
+            if not sep or not username or not password:
+                raise ValueError(f"OpenSandbox image_auth_file {image_auth_file} must hold 'username:password'")
+            image_auth = {"username": username, "password": password}
         network_policy = options.get("network_policy")
         if network_policy is not None and not isinstance(network_policy, Mapping):
             raise TypeError("OpenSandbox provider option 'network_policy' must be a mapping")
@@ -676,6 +689,7 @@ class OpenSandboxProviderOptions:
 
         return cls(
             image_auth=dict(image_auth) if image_auth is not None else None,
+            image_auth_file=image_auth_file,
             network_policy=dict(network_policy) if network_policy is not None else None,
             platform=dict(platform) if platform is not None else None,
             snapshot_id=snapshot_id,
diff --git a/tests/unit_tests/test_opensandbox_provider.py b/tests/unit_tests/test_opensandbox_provider.py
index 97ba4f62..b09126e6 100644
--- a/tests/unit_tests/test_opensandbox_provider.py
+++ b/tests/unit_tests/test_opensandbox_provider.py
@@ -1981,3 +1981,18 @@ async def test_shared_memory_metadata_reaches_create_api(fake_opensandbox_sdk, s
     provider = OpenSandboxProvider(attribution={"enabled": False}, probe={"command": None})
     await provider.create(SandboxSpec(image="image:tag", metadata={"nemo.nvidia.com/shm": size}))
     assert FakeSandbox.created_kwargs["metadata"]["nemo.nvidia.com/shm"] == size
+
+
+def test_provider_options_image_auth_file(tmp_path) -> None:
+    options_cls = opensandbox_provider.OpenSandboxProviderOptions
+    cred = tmp_path / "cred"
+    cred.write_text(f"user:{TEST_REGISTRY_PASSWORD}\n")
+    parsed = options_cls.from_mapping({"image_auth_file": str(cred)})
+    assert parsed.image_auth == {"username": "user", "password": TEST_REGISTRY_PASSWORD}
+    assert TEST_REGISTRY_PASSWORD not in repr(parsed)
+
+    with pytest.raises(ValueError, match="exclusive"):
+        options_cls.from_mapping({"image_auth_file": str(cred), "image_auth": {"username": "u", "password": "p"}})
+    cred.write_text("no-colon\n")
+    with pytest.raises(ValueError, match="username:password"):
+        options_cls.from_mapping({"image_auth_file": str(cred)})
