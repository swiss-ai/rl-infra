@@ -0,0 +1,41 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+import json
+from pathlib import Path
+
+import pytest
+
+
+pytest.importorskip("harbor")
+
+from responses_api_agents.harbor_agent.custom_agents.opencode_nemo_gym import OpenCodeNemoGym  # noqa: E402
+
+
+API_BASE = "http://policy-host:9000/ng-rollout/3-1/training-token-capture/v1"
+
+
+def _agent(tmp_path: Path, **kwargs) -> OpenCodeNemoGym:
+    return OpenCodeNemoGym(logs_dir=tmp_path, model_name="Qwen/Qwen3-4B-Instruct-2507", api_base=API_BASE, **kwargs)
+
+
+def test_requires_api_base(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="api_base"):
+        OpenCodeNemoGym(logs_dir=tmp_path, model_name="Qwen/Qwen3-4B-Instruct-2507")
+
+
+def test_run_command_points_opencode_at_the_model_server(tmp_path: Path) -> None:
+    (cmd,) = _agent(tmp_path).create_run_agent_commands("print 'hi' > /app/out.txt")
+    assert cmd.command.startswith("opencode --model nemogym/Qwen/Qwen3-4B-Instruct-2507 run --format=json ")
+    assert "'print '\"'\"'hi'\"'\"' > /app/out.txt'" in cmd.command
+    config = json.loads(cmd.env["OPENCODE_CONFIG_CONTENT"])
+    provider = config["provider"]["nemogym"]
+    assert provider["npm"] == "@ai-sdk/openai-compatible"
+    assert provider["options"]["baseURL"] == API_BASE
+    assert list(provider["models"]) == ["Qwen/Qwen3-4B-Instruct-2507"]
+    assert config["model"] == config["small_model"] == "nemogym/Qwen/Qwen3-4B-Instruct-2507"
+
+
+def test_ignores_harbor_agent_extra_kwargs(tmp_path: Path) -> None:
+    # harbor_agent always passes these; the agent must accept and ignore them
+    agent = _agent(tmp_path, responses_create_params={"temperature": 1.0}, temperature=1.0)
+    assert agent.create_run_agent_commands("x")
diff --git a/responses_api_agents/harbor_agent/tests/test_app.py b/responses_api_agents/harbor_agent/tests/test_app.py
index bcfa0947e..ae57dd8aa 100644
--- a/responses_api_agents/harbor_agent/tests/test_app.py
+++ b/responses_api_agents/harbor_agent/tests/test_app.py
@@ -490,6 +490,24 @@ class TestApp:
             == "http://policy-host:9000/ng-rollout/3-1/training-token-capture/v1"
         )
 
+    def test_mask_without_capture_follows_output_items(self) -> None:
+        server = _make_server()
+        server.server_client.global_config_dict = {}
+        verified = {"verifier_result": {"rewards": {"reward": 1.0}}}
+        assert server._should_mask(verified, []) is True
+        assert server._should_mask(verified, [{"type": "message"}]) is False
+
+    def test_mask_with_capture_ignores_empty_output_but_not_failed_trials(self) -> None:
+        server = _make_server(token_id_capture=True)
+        server.server_client.global_config_dict = {"token_id_capture": {"enabled": True}}
+        verified = {"verifier_result": {"rewards": {"reward": 0.0}}}
+        # OpenCode writes no ATIF: empty output, tokens come from the capture ledger
+        assert server._should_mask(verified, []) is False
+        # run() fell into its except branch
+        assert server._should_mask(None, []) is True
+        # trial ended without a verifier result (setup or agent crash)
+        assert server._should_mask({"verifier_result": None}, [{"type": "message"}]) is True
+
     def test_model_base_url_capture_needs_agent_opt_in(self) -> None:
         server = _make_server()
         server.server_client.global_config_dict = {"token_id_capture": {"enabled": True}}
