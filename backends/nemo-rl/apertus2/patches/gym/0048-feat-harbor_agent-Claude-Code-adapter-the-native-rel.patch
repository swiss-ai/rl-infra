+def _run_install(tmp_path: Path, printed_version: str = VERSION, sha256: str | None = None, tools=BASIC_TOOLS):
+    """Renders the install script for a fake uploaded archive and runs it with only `tools` on PATH."""
+    binary = _binary(printed_version)
+    pod_archive = tmp_path / "installed-agent" / "claude.gz"
+    pod_archive.parent.mkdir(parents=True, exist_ok=True)
+    pod_archive.write_bytes(gzip.compress(binary, mtime=0))
+    bin_dir = tmp_path / "path"
+    bin_dir.mkdir(exist_ok=True)
+    for tool in (*tools, "sh"):
+        if not (bin_dir / tool).exists() and shutil.which(tool):
+            (bin_dir / tool).symlink_to(shutil.which(tool))
+    variables = {
+        **_agent(tmp_path).install_variables(),
+        "sha256": shlex.quote(hashlib.sha256(binary).hexdigest() if sha256 is None else sha256),
+        "install_dir": shlex.quote(str(tmp_path / "opt" / "claude")),
+        "archive": shlex.quote(str(pod_archive)),
+    }
+    script = tmp_path / "install.sh"
+    script.write_text(Environment().from_string(mod.INSTALL_TEMPLATE.read_text()).render(**variables))
+    result = subprocess.run(
+        [str(bin_dir / "bash"), str(script)], capture_output=True, text=True, timeout=60, env={"PATH": str(bin_dir)}
+    )
+    return result, pod_archive
