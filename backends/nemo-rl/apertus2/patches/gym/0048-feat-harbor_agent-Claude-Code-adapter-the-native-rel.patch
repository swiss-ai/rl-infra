+#!/bin/bash
+# Installs the native Claude Code release binary from the gzipped copy ClaudeCodeNemoGym uploaded.
+# Rendered by ClaudeCodeNemoGym; version, sha256, install_dir and archive arrive shell-quoted.
+# The .gz was checked on the node; the binary inside is checked here against the release manifest's sha256 when
+# the image has sha256sum. Needs gzip. The upload is removed at exit: the sandbox's files live in node memory.
+set -euo pipefail
+
+version={{ version }}
+sha256={{ sha256 }}
+install_dir={{ install_dir }}
+archive={{ archive }}
+dest="$install_dir/claude"
+tmp=""
+
+cleanup() {
+  if [ -n "$tmp" ]; then rm -f "$tmp"; fi
+  rm -f "$archive"
+}
+trap cleanup EXIT
+
+installed_version() {
+  # "2.1.326 (Claude Code)"
+  "$1" --version 2>/dev/null | awk '{print $1; exit}' || true
+}
+
+if [ -x "$dest" ] && [ "$(installed_version "$dest")" = "$version" ]; then
+  echo "Claude Code $version already installed at $dest"
+  exit 0
+fi
+
+mkdir -p "$install_dir"
+tmp="$dest.part.$$"
+gzip -dc "$archive" > "$tmp"
+if [ -n "$sha256" ] && command -v sha256sum >/dev/null 2>&1; then
+  actual=$(sha256sum "$tmp")
+  if [ "${actual%% *}" != "$sha256" ]; then
+    echo "sha256 mismatch for the Claude Code binary unpacked from $archive: expected $sha256" >&2
+    exit 1
+  fi
+fi
+chmod 755 "$tmp"
+mv -f "$tmp" "$dest"
+tmp=""
+actual=$(installed_version "$dest")
+if [ "$actual" != "$version" ]; then
+  echo "Claude Code version mismatch: wanted $version, $dest --version printed ${actual:-nothing}" >&2
+  exit 1
+fi
+echo "installed Claude Code $actual at $dest"
