+import gzip
+import hashlib
+import json
+import os
+import shlex
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+
+pytest.importorskip("harbor")
+
+from jinja2 import Environment  # noqa: E402
+
+from responses_api_agents.harbor_agent.custom_agents import claude_code_nemo_gym as mod  # noqa: E402
+from responses_api_agents.harbor_agent.custom_agents.claude_code_nemo_gym import ClaudeCodeNemoGym  # noqa: E402
+
+
+API_BASE = "http://127.0.0.1:8000/ng-rollout/3-1/training-token-capture/v1"
+# a policy model name as NeMo-RL passes it: a path (vllm_model replaces the request's model with its own)
+MODEL = "/scratch/models/chonk-sft-v0.2"
+MODEL_INFO = {"max_input_tokens": 65536, "max_output_tokens": 16384}
+VERSION = "2.1.326"
+needs_bash = pytest.mark.skipif(shutil.which("bash") is None, reason="needs bash")
+
+
+def _binary(printed_version: str = VERSION) -> bytes:
+    """A stand-in for the release binary: prints the version as `claude --version` does."""
+    return f'#!/bin/sh\necho "{printed_version} (Claude Code)"\n'.encode()
+
+
+def _archive_dir(tmp_path: Path, version: str = VERSION, printed_version: str = VERSION) -> tuple[Path, bytes, str]:
+    """A claude_archive_dir as fetch-claude-code.sh leaves it: <dir>/<version>/claude-<platform>.gz and its .sha256
+    sidecar. Returns (dir, gz bytes, sha256 of the binary)."""
+    binary = _binary(printed_version)
+    data = gzip.compress(binary, mtime=0)
+    archive_dir = tmp_path / "claude-code"
+    gz = archive_dir / version / f"claude-{mod.DEFAULT_PLATFORM}.gz"
+    gz.parent.mkdir(parents=True, exist_ok=True)
+    gz.write_bytes(data)
+    (gz.parent / (gz.name + ".sha256")).write_text(hashlib.sha256(data).hexdigest() + "\n")
+    return archive_dir, data, hashlib.sha256(binary).hexdigest()
+
+
+def _agent(tmp_path: Path, **kwargs) -> ClaudeCodeNemoGym:
+    if "claude_archive_dir" not in kwargs:
+        archive_dir, _, digest = _archive_dir(tmp_path / "default")
+        kwargs = {"claude_archive_dir": str(archive_dir), "claude_sha256": digest, **kwargs}
+    return ClaudeCodeNemoGym(logs_dir=tmp_path, model_name=MODEL, api_base=API_BASE, **kwargs)
+
+
+def _command(agent: ClaudeCodeNemoGym, instruction: str = "x"):
+    (cmd,) = agent.create_run_agent_commands(instruction)
+    return cmd
+
+
+def test_requires_api_base(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="api_base"):
+        ClaudeCodeNemoGym(logs_dir=tmp_path, model_name=MODEL)
+
+
+# --- environment and settings --------------------------------------------------------------------------
+
+
+def test_env_points_claude_code_at_the_model_server(tmp_path: Path) -> None:
+    env = _agent(tmp_path).claude_env()
+    # Claude Code appends /v1/messages itself
+    assert env["ANTHROPIC_BASE_URL"] == API_BASE.removesuffix("/v1")
+    assert env["ANTHROPIC_API_KEY"] == "EMPTY"
+    # every tier resolves to the policy, so a stray side call still reaches the model server
+    assert {name: env[name] for name in mod.MODEL_ENV_VARS} == {name: mod.MODEL_ID for name in mod.MODEL_ENV_VARS}
+    assert env["CLAUDE_CONFIG_DIR"] == mod.CONFIG_DIR
+    assert env["IS_SANDBOX"] == "1"
+
+
+def test_env_keeps_claude_code_to_one_chain(tmp_path: Path) -> None:
+    """Each of these was a second call or a changed history in the probe (rl-infra experiments/claude-code-probe)."""
+    env = _agent(tmp_path).claude_env()
+    for name, value in {
+        "DISABLE_COMPACT": "1",
+        "DISABLE_AUTO_COMPACT": "1",
+        "CLAUDE_CODE_MAX_RETRIES": "0",
+        "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
+        "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
+        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
+        "DISABLE_PROMPT_CACHING": "1",
+        "MAX_THINKING_TOKENS": "0",
+        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
+        "DISABLE_TELEMETRY": "1",
+        "DISABLE_AUTOUPDATER": "1",
+    }.items():
+        assert env[name] == value, name
+
+
+def test_request_timeouts_are_at_least_the_agent_time_limit(tmp_path: Path) -> None:
+    # under stream replay the model server sends nothing before generation ends
+    assert _agent(tmp_path, claude_timeout_sec=7200).claude_env()["API_TIMEOUT_MS"] == "7200000"
+    assert _agent(tmp_path, claude_timeout_sec=870).claude_env()["API_TIMEOUT_MS"] == "3600000"
+    env = _agent(tmp_path).claude_env()
+    assert env["API_TIMEOUT_MS"] == env["CLAUDE_STREAM_IDLE_TIMEOUT_MS"] == "3600000"
+
+
+def test_limits_from_model_info_capped_by_the_request(tmp_path: Path) -> None:
+    env = _agent(tmp_path, model_info=MODEL_INFO).claude_env()
+    assert (env["CLAUDE_CODE_MAX_OUTPUT_TOKENS"], env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"]) == ("16384", "65536")
+    env = _agent(tmp_path, model_info=MODEL_INFO, responses_create_params={"max_output_tokens": 6144}).claude_env()
+    assert env["CLAUDE_CODE_MAX_OUTPUT_TOKENS"] == "6144"
+    env = _agent(tmp_path).claude_env()
+    assert "CLAUDE_CODE_MAX_OUTPUT_TOKENS" not in env and "CLAUDE_CODE_MAX_CONTEXT_TOKENS" not in env
+
+
+def test_env_overlay_is_deep_merged_last(tmp_path: Path) -> None:
+    env = _agent(
+        tmp_path, claude_env={"CLAUDE_CODE_MAX_RETRIES": 2, "DISABLE_TELEMETRY": None, "FOO": "bar"}
+    ).claude_env()
+    assert (env["CLAUDE_CODE_MAX_RETRIES"], env["FOO"]) == ("2", "bar")
+    assert "DISABLE_TELEMETRY" not in env
+
+
+def test_settings_switch_off_compaction_and_deny_sub_agents_and_web_tools(tmp_path: Path) -> None:
+    settings = _agent(tmp_path).settings_json()
+    assert settings["autoCompactEnabled"] is False
+    assert settings["includeCoAuthoredBy"] is False
+    assert set(settings["permissions"]["deny"]) == {"Task", "Agent", "WebFetch", "WebSearch"}
+    overlaid = _agent(tmp_path, claude_settings={"autoCompactEnabled": True, "permissions": {"allow": ["Bash"]}})
+    settings = overlaid.settings_json()
+    assert settings["autoCompactEnabled"] is True
+    assert settings["permissions"] == {"deny": list(mod.DISALLOWED_TOOLS), "allow": ["Bash"]}
+
+
+# --- the run command -------------------------------------------------------------------------------------
+
+
+def test_run_command(tmp_path: Path) -> None:
+    agent = _agent(tmp_path, max_turns=30, claude_timeout_sec=1740)
+    argv = agent.claude_argv("-fix it")
+    assert argv[:5] == ["timeout", "-k", "10", "1740", mod.CLAUDE_BIN]
+    for flag in (
+        "--print",
+        "--output-format=stream-json",
+        "--verbose",
+        "--permission-mode=bypassPermissions",
+        "--strict-mcp-config",
+        "--disable-slash-commands",
+    ):
+        assert flag in argv
+    pairs = {argv[i]: argv[i + 1] for i in range(len(argv) - 1) if argv[i].startswith("--")}
+    assert pairs["--tools"] == "Bash,Read,Edit,Write,Glob,Grep"
+    assert pairs["--disallowed-tools"] == "Task,Agent,WebFetch,WebSearch"
+    assert pairs["--setting-sources"] == "user"
+    assert pairs["--prompt-suggestions"] == "false"
+    # the capture's envelope: the first call's system prompt is resent verbatim (off by default under --bare)
+    assert pairs["--system-prompt-snapshot"] == "on"
+    assert json.loads(pairs["--settings"]) == agent.settings_json()
+    assert pairs["--max-turns"] == "30"
+    assert "--bare" not in argv
+    # "--": an instruction starting with "-" stays the prompt
+    assert argv[-2:] == ["--", "-fix it"]
+    cmd = _command(agent, "-fix it")
+    assert cmd.command.startswith(mod.PIPEFAIL_IF_SUPPORTED)
+    assert cmd.command.endswith(f"2>&1 </dev/null | tee {mod.LOG_FILE}")
+    assert cmd.env == agent.claude_env()
+
+
+def test_bare_profile_and_debug_file(tmp_path: Path) -> None:
+    argv = _agent(tmp_path, claude_profile="bare", claude_debug=True).claude_argv("x")
+    assert "--bare" in argv
+    assert argv[argv.index("--debug-file") + 1] == f"{mod.CONFIG_DIR}/debug.log"
+    assert "--max-turns" not in argv and argv[0] == mod.CLAUDE_BIN
+
+
+@pytest.mark.parametrize(
+    "kwargs, match",
+    [
+        ({"claude_timeout_sec": 0}, "claude_timeout_sec"),
+        ({"claude_profile": "full"}, "claude_profile"),
+        ({"claude_workdir": "app"}, "absolute"),
+        ({"claude_platform": "darwin-arm64"}, "claude_platform"),
+        ({"claude_sha256": "ABC"}, "claude_sha256"),
+        ({"version": "2.1.326; rm -rf /"}, "version"),
+        ({"claude_archive_dir": None}, "claude_archive_dir"),
+    ],
+)
+def test_rejects_bad_kwargs(tmp_path: Path, kwargs: dict, match: str) -> None:
+    with pytest.raises((ValueError, FileNotFoundError), match=match):
+        _agent(tmp_path, **kwargs)
+
+
+def _fake_claude(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, body: str) -> Path:
+    """Points the adapter's pod paths into tmp_path and installs a fake claude there; returns the log path."""
+    pod = tmp_path / "pod"
+    monkeypatch.setattr(mod, "CLAUDE_BIN", str(pod / "opt" / "claude"))
+    monkeypatch.setattr(mod, "CONFIG_DIR", str(pod / "logs" / "sessions"))
+    monkeypatch.setattr(mod, "LOG_FILE", str(pod / "logs" / "claude-code.txt"))
+    (pod / "opt").mkdir(parents=True)
+    (pod / "logs").mkdir(parents=True)
+    fake = pod / "opt" / "claude"
+    fake.write_text(body)
+    fake.chmod(0o755)
+    return pod / "logs" / "claude-code.txt"
+
+
+@needs_bash
+@pytest.mark.parametrize("timeout_sec", [None, 30])
+def test_run_command_in_bash_closes_stdin_and_keeps_the_exit_status(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, timeout_sec: int | None
+) -> None:
+    if timeout_sec and shutil.which("timeout") is None:
+        pytest.skip("needs coreutils timeout")
+    # Stands in for claude: reads stdin to EOF, prints its last two arguments and its config dir, exits 1 (as after
+    # an API error).
+    log = _fake_claude(
+        tmp_path,
+        monkeypatch,
+        '#!/bin/bash\nstdin=$(cat)\nn=$#\nprintf "%s\\n" "${@:n-1}"\necho "stdin=[$stdin]"\n'
+        'test -d "$CLAUDE_CONFIG_DIR" && echo config-dir\necho "key=$ANTHROPIC_API_KEY"\nexit 1\n',
+    )
+    cmd = _command(_agent(tmp_path, claude_timeout_sec=timeout_sec), "-fix it")
+    read_end, write_end = os.pipe()  # stdin left open, like the sandbox exec's
+    try:
+        proc = subprocess.run(
+            ["bash", "-c", cmd.command],
+            stdin=read_end,
+            capture_output=True,
+            text=True,
+            env={**os.environ, **cmd.env},
+            timeout=20,
+        )
+    finally:
+        os.close(read_end)
+        os.close(write_end)
+    assert proc.returncode == 1  # claude's status, not tee's 0
+    lines = log.read_text().splitlines()
+    assert lines == proc.stdout.splitlines()
+    assert lines == ["--", "-fix it", "stdin=[]", "config-dir", "key=EMPTY"]
+
+
+@pytest.mark.parametrize("shell", ["sh", "dash"])
+def test_run_command_starts_claude_in_a_posix_sh(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, shell: str) -> None:
+    """The sandbox exec may use /bin/sh; a shell without pipefail must still run Claude Code."""
+    if shutil.which(shell) is None:
+        pytest.skip(f"needs {shell}")
+    log = _fake_claude(tmp_path, monkeypatch, "#!/bin/sh\necho started\nexit 3\n")
+    cmd = _command(_agent(tmp_path))
+    proc = subprocess.run(
+        [shell, "-c", cmd.command], capture_output=True, text=True, env={**os.environ, **cmd.env}, timeout=20
+    )
+    supports_pipefail = subprocess.run([shell, "-c", "set -o pipefail"], capture_output=True).returncode == 0
+    assert log.read_text().splitlines() == ["started"]
+    assert proc.returncode == (3 if supports_pipefail else 0)
+
