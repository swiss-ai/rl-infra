+# --- Claude Code: its `--output-format=stream-json --verbose` events (agent/claude-code.txt) ---------------------
+# Event shapes of Claude Code 2.1.326 as recorded by rl-infra's experiments/claude-code-probe: one `assistant` event per
+# content block of a served reply (all with the reply's id, stop_reason and usage); an API error as an `assistant`
+# event with is_api_error_message and model <synthetic>; a final `result` event.
+
+
+def _cc_reply(message_id: str, stop_reason: str, prompt: int, completion: int, blocks=("text", "tool_use")) -> str:
+    usage = {"input_tokens": prompt, "output_tokens": completion, "cache_read_input_tokens": 0}
+    return "\n".join(
+        json.dumps(
+            {
+                "type": "assistant",
+                "message": {
+                    "id": message_id,
+                    "model": "policy",
+                    "role": "assistant",
+                    "type": "message",
+                    "content": [{"type": block}],
+                    "stop_reason": stop_reason,
+                    "usage": usage,
+                },
+            }
+        )
+        for block in blocks
+    )
+
+
+def _cc_api_error(text: str, status: int) -> str:
+    message = {
+        "id": "1f15ca59-3800-423b-b1aa-6b60564365bd",
+        "model": "<synthetic>",
+        "role": "assistant",
+        "content": [{"type": "text", "text": text}],
+        "stop_reason": "stop_sequence",
+        "usage": {"input_tokens": 0, "output_tokens": 0},
+    }
+    return json.dumps(
+        {"type": "assistant", "message": message, "is_api_error_message": True, "api_error_status": status}
+    )
+
+
+def _cc_result(terminal_reason: str, result: str, is_error: bool, subtype: str = "success") -> str:
+    return json.dumps(
+        {
+            "type": "result",
+            "subtype": subtype,
+            "is_error": is_error,
+            "terminal_reason": terminal_reason,
+            "result": result,
+        }
+    )
+
+
+def _cc_log(*chunks: str) -> str:
+    # tool results come as `user` events between the replies; the parser does not read them
+    return "\n".join([json.dumps({"type": "system", "subtype": "init", "session_id": "s1"}), *chunks]) + "\n"
+
