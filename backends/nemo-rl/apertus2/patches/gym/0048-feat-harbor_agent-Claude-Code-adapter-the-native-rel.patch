+"""Harbor's installed Claude Code agent, pointed at a NeMo Gym model server over Anthropic Messages.
+
+Harbor's own ClaudeCode installs the CLI in the sandbox with Anthropic's bootstrap script or npm (it needs curl,
+bash, Node.js, npm, procps and internet in the image) and raises when the CLI exits non-zero. This subclass uploads
+the pinned native release binary, gzipped on the node by rl-infra's fetch-claude-code.sh, and runs it through
+`installed_compat` like PiNemoGym and OpenCodeNemoGym: one recorded command, the exit status written down instead
+of raised.
+
+Claude Code speaks only Anthropic Messages: it posts to `ANTHROPIC_BASE_URL` + `/v1/messages`. Every Gym model
+server serves that route (nemo_gym/base_responses_api_model.py, AnthropicConverter to Responses), also under a
+rollout's capture prefix, so ANTHROPIC_BASE_URL is harbor_agent's `api_base` without its trailing `/v1`.
+
+Under token capture a rollout is usable only if all its model calls form one chain whose system prompt and tool
+list stay byte-stable, so the configuration keeps Claude Code to its main loop: no compaction, retries, non-streaming
+fallback, sub-agents, web tools, MCP servers, skills, slash commands, prompt suggestions or background tasks; the
+system prompt is recorded on the first call and resent verbatim (`--system-prompt-snapshot on`, which `--bare` would
+otherwise turn off); the attribution block, prompt-cache markers and experimental betas are off. Every request
+timeout is at or above the agent's own time limit, because under stream replay the model server sends no byte
+before generation ends. Sampling parameters come from the Gym model server's `sampling_overrides`.
+
+Claude Code is closed source: flags and environment variables below were checked by their effect on the requests
+it sends, with rl-infra's experiments/claude-code-probe (a stub of the Gym endpoint), for the version pinned here.
+Another version needs the probe again.
+
+The CLI runs inside the task sandbox, so `api_base` must be reachable from there (harbor_agent's
+`harbor_model_base_url`, e.g. the per-sandbox model tunnel). The adapter writes no ATIF trajectory: for training the
+tokens come from model-server capture. The stream-json event log goes to `/logs/agent/claude-code.txt`
+(failure_classes.claude_code_end_flags reads it), the session to `/logs/agent/sessions` (CLAUDE_CONFIG_DIR).
+"""
+
+import json
+import re
+import shlex
+from pathlib import Path
+from typing import Any, Mapping
+
+from harbor.agents.installed.base import with_prompt_template
+from harbor.agents.installed.claude_code import ClaudeCode
+from harbor.environments.base import BaseEnvironment
+from harbor.models.agent.context import AgentContext
+
+from responses_api_agents.harbor_agent.custom_agents.installed_compat import (
+    PIPEFAIL_IF_SUPPORTED,
+    TIMEOUT_KILL_AFTER_SEC,
+    ExecInput,
+    deep_merge,
+    drop_shared_kwargs,
+    install_from_template,
+    kwargs_for_harbor_options,
+    run_commands,
+    verified_archive,
+)
+
+
+# Gym's model server replaces the request's model with its own (vllm_model/app.py); the policy's name may be a path.
+MODEL_ID = "policy"
+# Every model tier Claude Code may pick resolves to the policy, so a stray side call still reaches the model server
+# (and is then visible as a second root in the capture).
+MODEL_ENV_VARS = (
+    "ANTHROPIC_MODEL",
+    "ANTHROPIC_SMALL_FAST_MODEL",
+    "ANTHROPIC_DEFAULT_OPUS_MODEL",
+    "ANTHROPIC_DEFAULT_SONNET_MODEL",
+    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
+    "ANTHROPIC_DEFAULT_FABLE_MODEL",
+    "CLAUDE_CODE_SUBAGENT_MODEL",
+)
+
+# Release whose flags and environment this adapter was probed against.
+DEFAULT_VERSION = "2.1.326"
+DEFAULT_PLATFORM = "linux-x64"
+# platforms.<platform>.checksum of https://downloads.claude.ai/claude-code-releases/<version>/manifest.json: the
+# sha256 of the binary itself, checked again in the sandbox after it is unpacked.
+KNOWN_BINARY_SHA256 = {
+    ("2.1.326", "linux-x64"): "b6b3647d981130dc44fc670846ae97b6cde531ffb667cf9c4d17cfcafb38cb37",
+    ("2.1.326", "linux-arm64"): "98d56f6ffe53469767a74864a38eaf359d62ef557a8de1b1ad524d61a66ec119",
+}
+INSTALL_TEMPLATE = Path(__file__).parent / "claude_code_pod" / "install-claude-code.sh.j2"
+INSTALL_DIR = "/opt/claude-nemo-gym"
+CLAUDE_BIN = f"{INSTALL_DIR}/claude"
+# where the adapter uploads the gzipped binary (the install script removes it)
+POD_ARCHIVE = "/installed-agent/claude.gz"
+
+LOG_FILE = "/logs/agent/claude-code.txt"  # Harbor's ClaudeCode layout
+CONFIG_DIR = "/logs/agent/sessions"  # CLAUDE_CONFIG_DIR, Harbor's layout; the session JSONL lands under projects/
+
+PROFILES = ("default", "bare")
+# Built-in tools offered to the model (--tools); the rest of the default set (sub-agents, web, notebooks, todo and
+# plan tools, ...) is not offered at all.
+DEFAULT_TOOLS = ("Bash", "Read", "Edit", "Write", "Glob", "Grep")
+# Denied as well, in case a version brings one back into a restricted set: each would start calls outside the
+# main loop (a sub-agent) or reach the internet.
+DISALLOWED_TOOLS = ("Task", "Agent", "WebFetch", "WebSearch")
+
+_VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z.+-]*$")
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_PLATFORM_RE = re.compile(r"^linux-(x64|arm64)(-musl)?$")
+
+
+class ClaudeCodeNemoGym(ClaudeCode):
+    @classmethod
+    def preflight(cls, kwargs: dict[str, Any] | None = None, env: Mapping[str, str] | None = None) -> None:
+        # Harbor 0.25 checks the config's kwargs before any trial (Job.create); ours are taken by __init__
+        super().preflight(kwargs=kwargs_for_harbor_options(cls, kwargs), env=env)
+
+    @classmethod
+    def check_model_credentials(cls, connection, *, kwargs, env, explicit_env=None) -> None:
+        # The model server takes any key; Harbor's Anthropic credential rules (API key, OAuth) do not apply.
+        return None
+
+    def __init__(
+        self,
+        *args: Any,
+        api_base: str | None = None,
+        api_key: str = "EMPTY",
+        responses_create_params: dict[str, Any] | None = None,
+        max_turns: int | None = None,
+        model_info: dict[str, Any] | None = None,
+        claude_archive_dir: str | None = None,
+        claude_sha256: str | None = None,
+        claude_platform: str = DEFAULT_PLATFORM,
+        claude_timeout_sec: int | None = None,
+        claude_workdir: str | None = None,
+        claude_profile: str = "default",
+        claude_tools: str | None = None,
+        claude_settings: dict[str, Any] | None = None,
+        claude_env: dict[str, Any] | None = None,
+        claude_debug: bool = False,
+        **kwargs: Any,
+    ) -> None:
+        # Harbor's base keeps `version` (the Claude Code release).
+        super().__init__(*args, **drop_shared_kwargs(kwargs))
+        if not api_base:
+            raise ValueError("ClaudeCodeNemoGym needs api_base (harbor_agent passes the model server URL)")
+        if claude_timeout_sec is not None and int(claude_timeout_sec) <= 0:
+            raise ValueError(f"claude_timeout_sec must be positive, got {claude_timeout_sec!r}")
+        if claude_profile not in PROFILES:
+            raise ValueError(f"claude_profile must be one of {PROFILES}, got {claude_profile!r}")
+        if self._version is None:
+            self._version = DEFAULT_VERSION
+        if not _VERSION_RE.match(self._version):
+            raise ValueError(f"invalid Claude Code version {self._version!r}")
+        if not _PLATFORM_RE.match(claude_platform):
+            raise ValueError(f"invalid claude_platform {claude_platform!r} (linux-x64, linux-arm64, ...-musl)")
+        if claude_sha256 is not None and not _SHA256_RE.match(claude_sha256):
+            raise ValueError("claude_sha256 must be 64 lowercase hex digits")
+        if claude_workdir is not None and not str(claude_workdir).startswith("/"):
+            raise ValueError(f"claude_workdir must be an absolute path, got {claude_workdir!r}")
+        if not claude_archive_dir:
+            raise ValueError(
+                "ClaudeCodeNemoGym needs claude_archive_dir (with <version>/claude-<platform>.gz, "
+                "e.g. from fetch-claude-code.sh)"
+            )
+        sha256 = claude_sha256 or KNOWN_BINARY_SHA256.get((self._version, claude_platform))
+        if not sha256:
+            raise ValueError(f"Claude Code {self._version} ({claude_platform}) has no known digest: set claude_sha256")
+        archive = Path(claude_archive_dir) / self._version / f"claude-{claude_platform}.gz"
+        # The .gz is ours (fetch-claude-code.sh wrote it after checking the binary against `sha256`); its own digest
+        # is in the sidecar, so a truncated or replaced file fails here and not in 64 sandboxes.
+        sidecar = archive.with_name(archive.name + ".sha256")
+        if not sidecar.is_file():
+            raise FileNotFoundError(f"{sidecar} not found (fetch-claude-code.sh writes it next to the archive)")
+        self._archive = verified_archive(
+            archive, sidecar.read_text().strip(), what="Claude Code", dir_option="claude_archive_dir"
+        )
+        self._api_base = api_base
+        self._api_key = api_key
+        self._responses_create_params = responses_create_params or {}
+        self._max_turns = int(max_turns) if max_turns else None
+        self._model_info = model_info or {}
+        self._sha256 = sha256
+        self._timeout_sec = int(claude_timeout_sec) if claude_timeout_sec is not None else None
+        self._workdir = claude_workdir
+        self._profile = claude_profile
+        self._tools = claude_tools if claude_tools is not None else ",".join(DEFAULT_TOOLS)
+        self._settings_overlay = claude_settings or {}
+        self._env_overlay = claude_env or {}
+        self._debug = bool(claude_debug)
+
+    @staticmethod
+    def name() -> str:
+        return "claude-code-nemo-gym"
+
+    # --- install -------------------------------------------------------------------------------
+
+    def install_variables(self) -> dict[str, str]:
+        """Variables of the install script (INSTALL_TEMPLATE)."""
+        return {
+            "version": shlex.quote(self._version),
+            "sha256": shlex.quote(self._sha256),
+            "install_dir": shlex.quote(INSTALL_DIR),
+            "archive": shlex.quote(POD_ARCHIVE),
+        }
+
+    async def install(self, environment: BaseEnvironment) -> None:
+        await environment.upload_file(source_path=self._archive, target_path=POD_ARCHIVE)
+        # as root: it writes to INSTALL_DIR
+        await install_from_template(self, environment, INSTALL_TEMPLATE, self.install_variables())
+
+    # --- configuration -------------------------------------------------------------------------
+
+    def model_limits(self) -> dict[str, int]:
+        """Context window and per-reply output limit from Terminus-2-style `model_info` (empty when unknown).
+
+        `max_input_tokens` is the whole context window in our overlays (max_total_sequence_length), as for
+        Terminus-2; the output limit is additionally capped by the request's max_output_tokens.
+        """
+        context = self._model_info.get("max_input_tokens") or self._model_info.get("max_tokens")
+        if not context:
+            return {}
+        output = self._model_info.get("max_output_tokens") or context
+        request_cap = self._responses_create_params.get("max_output_tokens")
+        if request_cap:
+            output = min(int(output), int(request_cap))
+        return {"context": int(context), "output": int(output)}
+
+    def request_timeout_ms(self) -> int:
+        """Claude Code's API request timeout: at least the agent's own time limit (one turn may take all of it,
+        and under stream replay nothing arrives before generation ends)."""
+        return max(self._timeout_sec or 0, 3600) * 1000
+
+    def settings_json(self) -> dict[str, Any]:
+        settings: dict[str, Any] = {
+            # threshold compaction is a summary call under another prompt (and rewrites the history)
+            "autoCompactEnabled": False,
+            # no co-author trailer or attribution text in commits and PRs the agent writes
+            "includeCoAuthoredBy": False,
+            "permissions": {"deny": list(DISALLOWED_TOOLS)},
+        }
+        return deep_merge(settings, self._settings_overlay)
+
+    def claude_env(self) -> dict[str, str]:
+        timeout_ms = str(self.request_timeout_ms())
+        env: dict[str, Any] = {
+            # --- the endpoint: Claude Code appends /v1/messages itself
+            "ANTHROPIC_BASE_URL": self._api_base.removesuffix("/").removesuffix("/v1"),
+            # x-api-key; under --bare the only credential Claude Code reads. The server takes any key.
+            "ANTHROPIC_API_KEY": self._api_key,
+            **{name: MODEL_ID for name in MODEL_ENV_VARS},
+            # --- one chain of calls per rollout
+            "DISABLE_COMPACT": "1",
+            "DISABLE_AUTO_COMPACT": "1",
+            # a retry or a non-streaming fallback is a second call for the same turn
+            "CLAUDE_CODE_MAX_RETRIES": "0",
+            "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
+            "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
+            "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
+            "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
+            # a per-request block in the system prompt would change it on every call
+            "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
+            # --- request shape
+            "DISABLE_PROMPT_CACHING": "1",
+            "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
+            "DISABLE_INTERLEAVED_THINKING": "1",
+            # the policy's server owns reasoning; Claude Code asks for no thinking budget
+            "MAX_THINKING_TOKENS": "0",
+            # --- silent calls under stream replay
+            "API_TIMEOUT_MS": timeout_ms,
+            "CLAUDE_STREAM_IDLE_TIMEOUT_MS": timeout_ms,
+            # --- isolation: no traffic to Anthropic, no updates, no feature flags
+            "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
+            "DISABLE_TELEMETRY": "1",
+            "DISABLE_ERROR_REPORTING": "1",
+            "DISABLE_AUTOUPDATER": "1",
+            "CLAUDE_CODE_DISABLE_FEATURE_FLAGS": "1",
+            # bypassPermissions as root (Harbor sets it too)
+            "IS_SANDBOX": "1",
+            "CLAUDE_CONFIG_DIR": CONFIG_DIR,
+        }
+        limits = self.model_limits()
+        if limits:
+            env["CLAUDE_CODE_MAX_OUTPUT_TOKENS"] = str(limits["output"])
+            # otherwise Claude Code assumes its own model's window for an unknown model name
+            env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(limits["context"])
+        env = deep_merge(env, self._env_overlay)
+        return {key: str(value) for key, value in env.items()}
+
+    # --- run -----------------------------------------------------------------------------------
+
+    def claude_argv(self, instruction: str) -> list[str]:
+        argv: list[str] = []
+        if self._timeout_sec is not None:
+            # Ends Claude Code before Harbor's agent timeout so the command's return code is recorded.
+            argv += ["timeout", "-k", str(TIMEOUT_KILL_AFTER_SEC), str(self._timeout_sec)]
+        argv += [
+            CLAUDE_BIN,
+            "--print",
+            "--output-format=stream-json",
+            # stream-json in print mode requires --verbose
+            "--verbose",
+            "--permission-mode=bypassPermissions",
+            "--tools",
+            self._tools,
+            "--disallowed-tools",
+            ",".join(DISALLOWED_TOOLS),
+            # no MCP servers, and none of the task repository's settings, hooks, skills or commands
+            "--strict-mcp-config",
+            "--setting-sources",
+            "user",
+            "--disable-slash-commands",
+            "--prompt-suggestions",
+            "false",
+            # the system prompt of the first call is resent verbatim (the capture's envelope)
+            "--system-prompt-snapshot",
+            "on",
+            "--settings",
+            json.dumps(self.settings_json(), separators=(",", ":")),
+        ]
+        if self._profile == "bare":
+            argv.append("--bare")
+        if self._max_turns:
+            argv += ["--max-turns", str(self._max_turns)]
+        if self._debug:
+            argv += ["--debug-file", f"{CONFIG_DIR}/debug.log"]
+        # "--": an instruction starting with "-" stays the prompt
+        argv += ["--", instruction]
+        return argv
+
+    def create_run_agent_commands(self, instruction: str) -> list[ExecInput]:
+        # stdin from /dev/null: the sandbox exec leaves it open, and with a non-TTY stdin the CLI would wait for it.
+        # pipefail keeps Claude Code's exit status (e.g. 124 from timeout) instead of tee's.
+        run = f"{shlex.join(self.claude_argv(instruction))} 2>&1 </dev/null | tee {shlex.quote(LOG_FILE)}"
+        command = PIPEFAIL_IF_SUPPORTED + f"mkdir -p {shlex.quote(CONFIG_DIR)} && {run}"
+        if self._workdir:
+            # Claude Code's cwd is its project (and in its system prompt); tasks may expect the agent to create it.
+            # If that fails, it still runs in the exec's cwd.
+            workdir = shlex.quote(self._workdir)
+            command = f"mkdir -p {workdir} && cd {workdir}; {command}"
+        return [ExecInput(command=command, env=self.claude_env())]
+
+    @with_prompt_template
+    async def run(self, instruction: str, environment: BaseEnvironment, context: AgentContext) -> None:
+        await run_commands(self, environment, self.create_run_agent_commands(instruction))
+
+    def populate_context_post_run(self, context: AgentContext) -> None:
+        # Harbor's ClaudeCode converts its session into an ATIF trajectory.json, which harbor_agent would turn into
+        # output items; as for PiNemoGym, the model server's capture holds the rollout instead.
+        pass
diff --git a/responses_api_agents/harbor_agent/custom_agents/claude_code_pod/install-claude-code.sh.j2 b/responses_api_agents/harbor_agent/custom_agents/claude_code_pod/install-claude-code.sh.j2
