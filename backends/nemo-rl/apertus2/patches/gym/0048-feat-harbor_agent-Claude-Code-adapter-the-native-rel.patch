+# Claude Code's own wording of a context overflow (its `result` text and synthetic error message), next to the vLLM
+# phrases of _CONTEXT_TEXT that its `result` repeats when the endpoint's 400 carries them.
+_CLAUDE_CODE_CONTEXT_TEXT = re.compile(r"prompt is too long", re.IGNORECASE)
+
+
+def claude_code_end_flags(log_text: str, context_limit: Optional[int] = None) -> dict[str, Any]:
+    """``agent_error_flags.json`` fields for a Claude Code episode that ended at the context limit, else ``{}``.
+
+    ``log_text`` is Claude Code's ``--print --output-format=stream-json --verbose`` output (one JSON event per line).
+    Each served reply appears as one ``assistant`` event per content block, all with the reply's ``message.id``,
+    ``stop_reason`` and ``usage`` (``input_tokens``, ``output_tokens``, cache fields); an API error appears as an
+    ``assistant`` event with ``is_api_error_message`` and model ``<synthetic>``, which is not a model call. The last
+    event is ``result``: ``terminal_reason`` (``prompt_too_long``, ``api_error``, ``max_turns``, ...), ``is_error``
+    and the ``result`` text. Claude Code exits 1 after an error. A context overflow shows up as:
+
+    - ``terminal_reason: prompt_too_long``, or an error ``result`` with a context-length text: the endpoint answered
+      the overflow with a 400 (Gym's Messages route does for its context-overflow placeholder), and Claude Code ended
+      the episode without retrying;
+    - the rules of ``opencode_end_flags`` on the replies (a last ``max_tokens`` reply without tokens; a last
+      ``max_tokens`` reply cut by the context ceiling).
+
+    Checked with rl-infra's experiments/claude-code-probe for Claude Code 2.1.326.
+    """
+    steps: list[tuple[str, int, int]] = []
+    seen: set[str] = set()
+    overflow_error: Optional[str] = None
+    for line in str(log_text or "").splitlines():
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(event, dict):
+            continue
+        if event.get("type") == "result":
+            text = str(event.get("result") or "")
+            if overflow_error is None and (
+                event.get("terminal_reason") == "prompt_too_long"
+                or (event.get("is_error") and (_CONTEXT_TEXT.search(text) or _CLAUDE_CODE_CONTEXT_TEXT.search(text)))
+            ):
+                overflow_error = f"{event.get('terminal_reason') or 'error'}: {text}".strip()
+            continue
+        if event.get("type") != "assistant" or event.get("is_api_error_message"):
+            continue
+        message = event.get("message")
+        if not isinstance(message, dict) or message.get("model") == "<synthetic>":
+            continue
+        message_id = str(message.get("id") or "")
+        if message_id in seen:
+            continue  # the same reply, another content block
+        seen.add(message_id)
+        usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
+        prompt = (
+            _int(usage.get("input_tokens"))
+            + _int(usage.get("cache_read_input_tokens"))
+            + _int(usage.get("cache_creation_input_tokens"))
+        )
+        reason = "length" if message.get("stop_reason") == "max_tokens" else str(message.get("stop_reason") or "")
+        steps.append((reason, prompt, _int(usage.get("output_tokens"))))
+    return _context_end_flags("claude-code", steps, overflow_error, context_limit)
+
