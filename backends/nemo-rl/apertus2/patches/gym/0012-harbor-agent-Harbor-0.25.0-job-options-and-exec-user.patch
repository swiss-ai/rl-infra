+def _write_trial_result(jobs_dir: Path, job_name: str) -> Path:
+    trial_dir = jobs_dir / job_name / "trial-0"
+    trial_dir.mkdir(parents=True)
+    (trial_dir / "result.json").write_text("{}")
+    return trial_dir
+
