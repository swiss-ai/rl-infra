From d63869ba362e8955be8b76a28662616c4a740f9a Mon Sep 17 00:00:00 2001
From: Philip Mueller <claude@philipmueller.ch>
Date: Wed, 11 Nov 2026 07:33:27 +0000
Subject: [PATCH] feat(opensandbox): image_auth from a credentials file,
 limited to one registry

image_auth.credentials_file names a file with one name:password line, read
when the image spec is built, so that the registry password stays out of the
config (which training frameworks print and save in full). image_auth.registry
limits the credentials to images from that host: the OpenSandbox server keys
the pull secret by each image's own registry, so one provider-wide image_auth
would also send them to Docker Hub for python:3.12-slim.

Errors about the file name it but never quote its contents.

Signed-off-by: Philip Mueller <claude@philipmueller.ch>
---
 .../sandbox/providers/opensandbox/provider.py |  29 ++++-
 tests/unit_tests/test_opensandbox_provider.py | 101 ++++++++++++++++++
 2 files changed, 129 insertions(+), 1 deletion(-)

diff --git a/nemo_gym/sandbox/providers/opensandbox/provider.py b/nemo_gym/sandbox/providers/opensandbox/provider.py
index 024cca80d..cc557117c 100644
--- a/nemo_gym/sandbox/providers/opensandbox/provider.py
+++ b/nemo_gym/sandbox/providers/opensandbox/provider.py
@@ -374,12 +374,39 @@ def _to_volumes(volumes: list[Mapping[str, Any]]) -> list[Any]:
     return [Volume(**dict(volume)) for volume in volumes]
 
 
+def _image_registry(image: str) -> str:
+    """The registry host of an image reference, ``docker.io`` when it names none (as the OpenSandbox server)."""
+    first, sep, _ = image.partition("/")
+    if sep and ("." in first or ":" in first or first == "localhost"):
+        return first
+    return "docker.io"
+
+
 def _to_image_spec(image: str, image_auth: Mapping[str, Any] | None) -> Any:
+    """Image spec with pull credentials.
+
+    ``image_auth`` holds ``username`` and ``password``, or ``credentials_file``: a file with one
+    ``name:password`` line, read here so that the password stays out of configs and logs. With
+    ``registry`` (a host), only images from that registry get the credentials; the server would
+    otherwise send them to any image's registry (Docker Hub for ``python:3.12-slim``).
+    """
     if image_auth is None:
         return image
+    auth = dict(image_auth)
+    registry = auth.pop("registry", None)
+    if registry is not None and _image_registry(image) != str(registry):
+        return image
+    credentials_file = auth.pop("credentials_file", None)
+    if credentials_file is not None:
+        if "username" in auth or "password" in auth:
+            raise ValueError("image_auth takes either credentials_file or username/password, not both")
+        name, sep, password = Path(credentials_file).read_text(encoding="utf-8").strip().partition(":")
+        if not sep or not name or not password:
+            raise ValueError(f"image_auth credentials_file {credentials_file} must hold one name:password line")
+        auth.update(username=name, password=password)
     from opensandbox.models.sandboxes import SandboxImageAuth, SandboxImageSpec
 
-    return SandboxImageSpec(image, auth=SandboxImageAuth(**dict(image_auth)))
+    return SandboxImageSpec(image, auth=SandboxImageAuth(**auth))
 
 
 def _to_sandbox_status(state: Any) -> SandboxStatus:
diff --git a/tests/unit_tests/test_opensandbox_provider.py b/tests/unit_tests/test_opensandbox_provider.py
index f3877eb2a..a327f4322 100644
--- a/tests/unit_tests/test_opensandbox_provider.py
+++ b/tests/unit_tests/test_opensandbox_provider.py
@@ -1965,3 +1965,104 @@ async def test_shared_memory_metadata_reaches_create_api(fake_opensandbox_sdk, s
     provider = OpenSandboxProvider(attribution={"enabled": False}, probe={"command": None})
     await provider.create(SandboxSpec(image="image:tag", metadata={"nemo.nvidia.com/shm": size}))
     assert FakeSandbox.created_kwargs["metadata"]["nemo.nvidia.com/shm"] == size
+
+
+ROBOT_NAME = "robot$swe_lego_v05_1+puller"
+ROBOT_PASSWORD = "pw:with:colons"  # pragma: allowlist secret
+
+
+@dataclass
+class FakeImageAuth:
+    username: str
+    password: str
+
+
+@dataclass
+class FakeImageSpec:
+    image: str
+    auth: FakeImageAuth | None = None
+
+
+@pytest.fixture
+def fake_image_models(monkeypatch: pytest.MonkeyPatch) -> None:
+    """The SDK's image models, so these tests run without the opensandbox package."""
+    models = SimpleNamespace(SandboxImageAuth=FakeImageAuth, SandboxImageSpec=FakeImageSpec)
+    monkeypatch.setitem(sys.modules, "opensandbox", SimpleNamespace(models=SimpleNamespace(sandboxes=models)))
+    monkeypatch.setitem(sys.modules, "opensandbox.models", SimpleNamespace(sandboxes=models))
+    monkeypatch.setitem(sys.modules, "opensandbox.models.sandboxes", models)
+
+
+def _credentials_file(tmp_path: Path, text: str) -> Path:
+    path = tmp_path / "registry_cred"
+    path.write_text(text)
+    return path
+
+
+async def test_image_auth_credentials_file_supplies_username_and_password(
+    fake_opensandbox_sdk: None, fake_image_models: None, tmp_path: Path
+) -> None:
+    cred = _credentials_file(tmp_path, f"{ROBOT_NAME}:{ROBOT_PASSWORD}\n")
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+
+    await provider.create(
+        SandboxSpec(
+            image="rl-registry.example/swe_lego_v05_1/task@sha256:abc",
+            provider_options={"image_auth": {"credentials_file": str(cred)}},
+        )
+    )
+
+    image = FakeSandbox.created_kwargs["image"]
+    assert image.auth.username == ROBOT_NAME
+    assert image.auth.password == ROBOT_PASSWORD
+
+
+async def test_image_auth_registry_limits_credentials_to_that_registry(
+    fake_opensandbox_sdk: None, fake_image_models: None, tmp_path: Path
+) -> None:
+    cred = _credentials_file(tmp_path, f"{ROBOT_NAME}:{ROBOT_PASSWORD}\n")
+    auth = {"credentials_file": str(cred), "registry": "rl-registry.example"}
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+
+    # Docker Hub (no host in the reference) and another registry: no credentials sent
+    for other in ("python:3.12-slim", "docker.io/library/python:3.12-slim", "mirror.gcr.io/astral/uv:latest"):
+        await provider.create(SandboxSpec(image=other, provider_options={"image_auth": auth}))
+        assert FakeSandbox.created_kwargs["image"] == other
+
+    await provider.create(
+        SandboxSpec(image="rl-registry.example/swe_lego_v05_1/task:1", provider_options={"image_auth": auth})
+    )
+    assert FakeSandbox.created_kwargs["image"].auth.username == ROBOT_NAME
+
+
+async def test_image_auth_registry_with_inline_credentials(
+    fake_opensandbox_sdk: None, fake_image_models: None
+) -> None:
+    auth = {"username": "user", "password": TEST_REGISTRY_PASSWORD, "registry": "registry.example"}
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+
+    await provider.create(SandboxSpec(image="python:3.12-slim", provider_options={"image_auth": auth}))
+    assert FakeSandbox.created_kwargs["image"] == "python:3.12-slim"
+
+    await provider.create(SandboxSpec(image="registry.example/repo:tag", provider_options={"image_auth": auth}))
+    assert FakeSandbox.created_kwargs["image"].auth.password == TEST_REGISTRY_PASSWORD
+
+
+def test_image_auth_credentials_file_errors_do_not_leak_the_file(fake_image_models: None, tmp_path: Path) -> None:
+    cred = _credentials_file(tmp_path, "no-colon-secret-value\n")
+    with pytest.raises(ValueError, match="name:password") as err:
+        opensandbox_provider._to_image_spec("registry.example/repo:tag", {"credentials_file": str(cred)})
+    assert "no-colon-secret-value" not in str(err.value)
+
+    with pytest.raises(ValueError, match="either credentials_file or username/password"):
+        opensandbox_provider._to_image_spec(
+            "registry.example/repo:tag",
+            {"credentials_file": str(cred), "username": "user", "password": TEST_REGISTRY_PASSWORD},
+        )
+
+
+def test_image_auth_options_hold_only_the_file_path(tmp_path: Path) -> None:
+    cred = _credentials_file(tmp_path, f"{ROBOT_NAME}:{ROBOT_PASSWORD}\n")
+    options = opensandbox_provider.OpenSandboxProviderOptions.from_mapping(
+        {"image_auth": {"credentials_file": str(cred), "registry": "rl-registry.example"}}
+    )
+    assert ROBOT_PASSWORD not in repr(options)
-- 
