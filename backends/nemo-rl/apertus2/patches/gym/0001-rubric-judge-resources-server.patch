+"""rubric_judge resource server.
+
+Rewards a free-form response with an LLM judge, for domains with no verifiable
+answer. The server fills each configured rubric with the question and the
+response, asks the judge model for a one-token verdict on each, and returns the
+weighted mean of the expected verdicts (see `scoring.py`).
+
+The rubrics and the annotation scheme are adapted from UltraFeedback through
+ActiveUltraFeedback (https://github.com/lasgroup/ActiveUltraFeedback).
+
+With `alpaca_eval` set, the same server does AlpacaEval 2.0's validation instead: it
+shows the judge the reply and the row's `baseline_answer` with AlpacaEval's prompt and
+rewards the weighted win. Training rewards stay with the rubrics.
+
+The judge is an ordinary `vllm_model` server. NeMo-RL points it at the fixed-model
+vLLM pool it runs on the job's reward nodes (`env.judge_pool`).
+"""
+
+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+import yaml
+from pydantic import ConfigDict, Field
+
+from nemo_gym.base_resources_server import (
+    BaseResourcesServerConfig,
+    BaseRunRequest,
+    BaseVerifyRequest,
+    BaseVerifyResponse,
+    SimpleResourcesServer,
+)
+from nemo_gym.config_types import ModelServerRef
+from nemo_gym.judge import JudgeError, call_judge
+from nemo_gym.openai_utils import (
+    NeMoGymChatCompletion,
+    NeMoGymChatCompletionCreateParamsNonStreaming,
+    NeMoGymResponse,
+)
+from resources_servers.rubric_judge.scoring import Rubric, clean_response, pairwise_win, score_rubrics
+
+
+_DEFAULT_RUBRICS_PATH = str(Path(__file__).parent / "prompts" / "rubrics.yaml")
+_ALPACA_EVAL_PATH = Path(__file__).parent / "prompts" / "alpaca_eval.yaml"
+
+
+def raw_message_text(response: Optional[NeMoGymResponse]) -> str:
+    """Assistant text from a Responses API payload, verbatim."""
+    if response is None:
+        return ""
+    chunks: List[str] = []
+    for item in response.output or []:
+        if getattr(item, "type", None) != "message":
+            continue
+        for content in getattr(item, "content", None) or []:
+            if getattr(content, "type", None) == "output_text":
+                chunks.append(content.text or "")
+    return "\n".join(chunks)
+
+
+def hit_token_limit(response: Optional[NeMoGymResponse]) -> bool:
+    """Whether a token limit cut the reply off.
+
+    NeMo-RL clamps each request to the room left under max_total_sequence_length, so a reply
+    can stop short of max_output_tokens. Either limit comes back as this incomplete reason.
+    """
+    details = response.incomplete_details if response is not None else None
+    return details is not None and details.reason == "max_output_tokens"
+
+
+class RubricJudgeConfig(BaseResourcesServerConfig):
+    judge_model_server: ModelServerRef
+    rubrics_path: str = Field(
+        default=_DEFAULT_RUBRICS_PATH,
+        description="YAML file with a `system` prompt and `rubrics`, each with {prompt} and {completion}.",
+    )
+    rubric_weights: Dict[str, float] = Field(
+        default_factory=dict,
+        description="Rubrics to score, by name in the rubrics file, and their weight in the reward.",
+    )
+    alpaca_eval: bool = Field(
+        default=False,
+        description="Reward the AlpacaEval win over each row's baseline_answer, ignoring the rubrics.",
+    )
+    stop_strings: List[str] = Field(
+        default_factory=list,
+        description="The reply ends at the first of these. Set it to the policy's few-shot turn marker.",
+    )
+    truncated_reward: float = Field(
+        default=0.0,
+        description="Reward of a reply cut off by a token limit, given without a judge call.",
+    )
+    # The verdict comes from the distribution, not the sampled token, so these only
+    # have to match the judge pool's own sampling, which NeMo-RL's server enforces.
+    temperature: float = 1.0
+    top_p: float = 1.0
+    top_logprobs: int = 20
+    judge_retries: int = 2
+    max_concurrent_judge_calls: int = 512
+
+
+class RubricJudgeRunRequest(BaseRunRequest):
+    model_config = ConfigDict(extra="allow")
+
+    # The bare user request. `responses_create_params` can hold few-shot examples
+    # around it, which are for the policy and not for the judge.
+    question: str
+    # The reference reply of an AlpacaEval row.
+    baseline_answer: Optional[str] = None
+
+
+class RubricJudgeVerifyRequest(RubricJudgeRunRequest, BaseVerifyRequest):
+    pass
+
+
+class RubricJudgeVerifyResponse(BaseVerifyResponse):
+    # Extra `rubric_<name>` fields carry the per-rubric scores, which NeMo-RL logs
+    # as per-agent metrics.
+    model_config = ConfigDict(extra="allow")
+
+    judge_truncated: bool = False
+    judge_failed: bool = False
+    # NeMo-RL drops flagged samples from the loss.
+    instance_config: Dict[str, Any] = Field(default_factory=lambda: {"mask_sample": False})
+
+
+class RubricJudgeServer(SimpleResourcesServer):
+    """LLM rubric grader for rewards that have no verifiable answer."""
+
+    config: RubricJudgeConfig
+
+    def model_post_init(self, context):
+        if self.config.alpaca_eval:
+            prompt_file = yaml.safe_load(_ALPACA_EVAL_PATH.read_text())
+            self._pairwise_template: str = prompt_file["user"]
+            self._rubrics = {}
+        else:
+            prompt_file = yaml.safe_load(Path(self.config.rubrics_path).read_text())
+            self._rubrics = {
+                name: Rubric(template=prompt_file["rubrics"][name], weight=weight)
+                for name, weight in self.config.rubric_weights.items()
+            }
+        self._system_prompt: str = prompt_file["system"]
+        self._judge_calls = asyncio.Semaphore(self.config.max_concurrent_judge_calls)
+        return super().model_post_init(context)
+
+    async def _call_judge(self, prompt: str) -> List[Tuple[str, float]]:
+        params = NeMoGymChatCompletionCreateParamsNonStreaming(
+            messages=[
+                {"role": "system", "content": self._system_prompt},
+                {"role": "user", "content": prompt},
+            ],
+            max_tokens=1,
+            temperature=self.config.temperature,
+            top_p=self.config.top_p,
+            logprobs=True,
+            top_logprobs=self.config.top_logprobs,
+        )
+        async with self._judge_calls:
+            completion = await call_judge(
+                self.server_client,
+                server_name=self.config.judge_model_server.name,
+                url_path="/v1/chat/completions",
+                json=params,
+                response_model=NeMoGymChatCompletion,
+            )
+        # A prompt over the judge's context comes back as an empty completion.
+        logprobs = completion.choices[0].logprobs if completion.choices else None
+        if logprobs is None or not logprobs.content:
+            return []
+        return [(top.token, top.logprob) for top in logprobs.content[0].top_logprobs]
+
+    def _verify_response(
+        self,
+        body: RubricJudgeVerifyRequest,
+        reward: float,
+        scores: Optional[Dict[str, float]] = None,
+        truncated: bool = False,
+        failed: Optional[List[str]] = None,
+    ) -> RubricJudgeVerifyResponse:
+        rubric_fields = {f"rubric_{name}": (scores or {}).get(name, 0.0) for name in self._rubrics}
+        return RubricJudgeVerifyResponse(
+            **body.model_dump(exclude={"reward"}),
+            reward=reward,
+            judge_truncated=truncated,
+            judge_failed=bool(failed),
+            failure_reason=f"no verdict from the judge on: {', '.join(failed)}" if failed else None,
+            instance_config={"mask_sample": bool(failed)},
+            **rubric_fields,
+        )
+
+    async def _verify_alpaca_eval(self, body: RubricJudgeVerifyRequest) -> RubricJudgeVerifyResponse:
+        # AlpacaEval judges a reply as it stands, so truncation is reported but not penalized.
+        truncated = hit_token_limit(body.response)
+        answer = clean_response(raw_message_text(body.response), self.config.stop_strings)
+        if not answer:
+            return self._verify_response(body, 0.0, truncated=truncated)
+        win = await pairwise_win(
+            self._pairwise_template,
+            body.question,
+            answer,
+            body.baseline_answer or "",
+            self._call_judge,
+            retries=self.config.judge_retries,
+            retry_on=(JudgeError,),
+        )
+        if win is None:
+            return self._verify_response(body, 0.0, truncated=truncated, failed=["alpaca_eval"])
+        return self._verify_response(body, win, truncated=truncated)
+
+    async def verify(self, body: RubricJudgeVerifyRequest) -> RubricJudgeVerifyResponse:
+        if self.config.alpaca_eval:
+            return await self._verify_alpaca_eval(body)
+
+        if hit_token_limit(body.response):
+            return self._verify_response(body, self.config.truncated_reward, truncated=True)
+
+        answer = clean_response(raw_message_text(body.response), self.config.stop_strings)
+        if not answer:
+            return self._verify_response(body, 0.0)
+
+        result = await score_rubrics(
+            self._rubrics,
+            body.question,
+            answer,
+            self._call_judge,
+            retries=self.config.judge_retries,
+            retry_on=(JudgeError,),
+        )
+        # A judge outage says nothing about the response, so a failed sample is left
+        # out of the loss instead of being taught that it scored 0.
+        return self._verify_response(body, result.reward, scores=result.scores, failed=result.failed)
+
+
+if __name__ == "__main__":
+    RubricJudgeServer.run_webserver()
