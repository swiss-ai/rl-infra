+# limitations under the License.
+"""Tests for the rubric_judge resource server, with the judge model stubbed."""
+
+import json
+import math
+from pathlib import Path
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+import yaml
+
+from nemo_gym.config_types import ModelServerRef
+from nemo_gym.openai_utils import (
+    NeMoGymResponse,
+    NeMoGymResponseCreateParamsNonStreaming,
+    NeMoGymResponseOutputMessage,
+    NeMoGymResponseOutputText,
+)
+from nemo_gym.server_utils import ServerClient
+from resources_servers.rubric_judge.app import (
+    RubricJudgeConfig,
+    RubricJudgeServer,
+    RubricJudgeVerifyRequest,
+    hit_token_limit,
+    raw_message_text,
+)
+
+
+RUBRICS_PATH = Path(__file__).resolve().parents[1] / "prompts" / "rubrics.yaml"
+
+
+def judge_reply(verdicts):
+    """A chat completion whose first token has the given {token: probability}."""
+    top = [{"token": token, "logprob": math.log(prob), "bytes": None} for token, prob in verdicts.items()]
+    first = {"token": next(iter(verdicts)), "logprob": top[0]["logprob"], "bytes": None, "top_logprobs": top}
+    return {
+        "id": "chatcmpl-1",
+        "object": "chat.completion",
+        "created": 0,
+        "model": "judge",
+        "choices": [
+            {
+                "index": 0,
+                "finish_reason": "length",
+                "message": {"role": "assistant", "content": first["token"]},
+                "logprobs": {"content": [first], "refusal": None},
+            }
+        ],
+    }
+
+
+def stub_http(payload, ok=True):
+    response = MagicMock()
+    response.status = 200 if ok else 503
+    response.ok = ok
+    response.json = AsyncMock(return_value=payload)
+    response.read = AsyncMock(return_value=json.dumps(payload).encode())
+    response.text = AsyncMock(return_value=json.dumps(payload))
+    response.content = MagicMock()
+    response.content.read = AsyncMock(return_value=json.dumps(payload).encode())
+    return response
+
+
+def make_server(payloads=None, **config):
+    client = MagicMock(spec=ServerClient)
+    client.post = AsyncMock(side_effect=[stub_http(p) for p in (payloads or [])])
+    settings = dict(
+        name="rubric_judge",
+        host="0.0.0.0",
+        port=8080,
+        entrypoint="",
+        judge_model_server=ModelServerRef(type="responses_api_models", name="judge_model"),
+        rubric_weights={"helpfulness": 1.0, "instruction_following": 3.0},
+        stop_strings=["\nUser:"],
+        judge_retries=0,
+    )
+    return RubricJudgeServer(config=RubricJudgeConfig(**(settings | config)), server_client=client)
+
+
+def make_request(text="A fine answer.", incomplete=False, baseline_answer=None):
+    message = NeMoGymResponseOutputMessage(
+        id="msg-1",
+        content=[NeMoGymResponseOutputText(type="output_text", text=text, annotations=[])],
+        role="assistant",
+        status="completed",
+        type="message",
+    )
+    response = NeMoGymResponse(
+        id="resp-1",
+        created_at=0.0,
+        model="policy",
+        object="response",
+        output=[message],
+        incomplete_details={"reason": "max_output_tokens"} if incomplete else None,
+        parallel_tool_calls=False,
+        tool_choice="none",
+        tools=[],
+    )
+    return RubricJudgeVerifyRequest(
+        responses_create_params=NeMoGymResponseCreateParamsNonStreaming(
+            input=[{"role": "user", "content": "User: few-shot\nUser: Why?\nAssistant:"}],
+            max_output_tokens=16,
+        ),
+        response=response,
+        question="Why?",
+        baseline_answer=baseline_answer,
+    )
+
+
+def test_rubric_file_has_every_placeholder():
+    rubric_file = yaml.safe_load(RUBRICS_PATH.read_text())
+    assert rubric_file["system"]
+    for name, template in rubric_file["rubrics"].items():
+        assert template.format(prompt="QQQ", completion="AAA").count("QQQ") == 1, name
+        assert template.format(prompt="QQQ", completion="AAA").count("AAA") == 1, name
+
+
+def test_raw_message_text_reads_the_assistant_text():
+    assert raw_message_text(make_request("Hello").response) == "Hello"
+    assert raw_message_text(None) == ""
+
+
+def test_hit_token_limit_reads_the_incomplete_reason():
+    assert not hit_token_limit(make_request().response)
+    assert not hit_token_limit(None)
+    # No generated-token count needed: the sequence limit stops replies short of max_output_tokens.
+    assert hit_token_limit(make_request(incomplete=True).response)
+
+
+@pytest.mark.asyncio
+async def test_reward_is_the_weighted_mean_of_expected_verdicts():
+    # helpfulness 5 -> 1.0 with weight 1; instruction_following 3 -> 0.5 with weight 3.
+    server = make_server([judge_reply({"5": 1.0}), judge_reply({"3": 1.0})])
+    result = await server.verify(make_request())
+
+    assert math.isclose(result.reward, (1.0 + 3 * 0.5) / 4)
+    assert not result.judge_failed
+    assert result.instance_config == {"mask_sample": False}
+    dumped = result.model_dump()
+    assert dumped["rubric_helpfulness"] == 1.0
+    assert dumped["rubric_instruction_following"] == 0.5
+
+
+@pytest.mark.asyncio
+async def test_judge_gets_the_bare_question_and_the_clean_reply():
+    server = make_server([judge_reply({"5": 1.0}), judge_reply({"5": 1.0})])
+    await server.verify(make_request("The answer.\nUser: next turn"))
+
+    prompts = [call.kwargs["json"].messages[1]["content"] for call in server.server_client.post.call_args_list]
+    for prompt in prompts:
+        assert "<USER_INPUT>Why?</USER_INPUT>" in prompt
+        assert "<ASSISTANT_RESPONSE_TO_EVALUATE>The answer.</ASSISTANT_RESPONSE_TO_EVALUATE>" in prompt
+        assert "few-shot" not in prompt
+        assert "next turn" not in prompt
+
+
+@pytest.mark.asyncio
+async def test_judge_request_asks_for_one_token_with_its_distribution():
+    server = make_server([judge_reply({"5": 1.0}), judge_reply({"5": 1.0})], rubric_weights={"helpfulness": 1.0})
+    await server.verify(make_request())
+
+    call = server.server_client.post.call_args_list[0].kwargs
+    assert call["url_path"] == "/v1/chat/completions"
+    assert call["server_name"] == "judge_model"
+    assert call["json"].max_tokens == 1
+    assert call["json"].logprobs is True
+    assert call["json"].top_logprobs == 20
+    assert call["json"].messages[0]["role"] == "system"
+
+
+@pytest.mark.asyncio
+async def test_truncated_reply_skips_the_judge():
+    server = make_server(truncated_reward=0.25)
+    result = await server.verify(make_request(incomplete=True))
+
+    assert result.reward == 0.25
+    assert result.judge_truncated
+    server.server_client.post.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_empty_reply_skips_the_judge():
+    server = make_server()
+    result = await server.verify(make_request("\nUser: only a marker"))
+
+    assert result.reward == 0.0
+    assert not result.judge_failed
+    server.server_client.post.assert_not_called()
+
+
+@pytest.mark.asyncio
+async def test_a_reply_without_a_verdict_is_masked():
+    server = make_server([judge_reply({"The": 1.0}), judge_reply({"5": 1.0})])
+    result = await server.verify(make_request())
+
+    assert result.reward == 0.0
+    assert result.judge_failed
+    assert result.instance_config == {"mask_sample": True}
+    assert "helpfulness" in result.failure_reason
+
+
+@pytest.mark.asyncio
+async def test_an_empty_completion_is_masked():
+    empty = judge_reply({"5": 1.0}) | {"choices": []}
+    server = make_server([empty, judge_reply({"5": 1.0})])
+    result = await server.verify(make_request())
+
+    assert result.instance_config == {"mask_sample": True}
+
+
+@pytest.mark.asyncio
+async def test_a_judge_outage_is_masked_instead_of_raised():
+    server = make_server()
+    server.server_client.post = AsyncMock(side_effect=ConnectionError("judge down"))
+    result = await server.verify(make_request())
+
+    assert result.reward == 0.0
+    assert result.instance_config == {"mask_sample": True}
+
+
+@pytest.mark.asyncio
+async def test_alpaca_eval_rewards_the_win_averaged_over_both_orders():
+    # The reply wins 0.8 when shown first and 0.6 when shown second (`M` is the second output).
+    server = make_server([judge_reply({"m": 0.8, "M": 0.2}), judge_reply({"M": 0.6, "m": 0.4})], alpaca_eval=True)
+    result = await server.verify(make_request(baseline_answer="The reference."))
+
+    assert math.isclose(result.reward, 0.7)
+    prompts = [call.kwargs["json"].messages[1]["content"] for call in server.server_client.post.call_args_list]
+    assert prompts[0].index("A fine answer.") < prompts[0].index("The reference.")
+    assert prompts[1].index("The reference.") < prompts[1].index("A fine answer.")
+
+
+@pytest.mark.asyncio
+async def test_alpaca_eval_judges_a_truncated_reply_as_it_stands():
+    server = make_server([judge_reply({"m": 1.0}), judge_reply({"m": 1.0})], alpaca_eval=True)
+    result = await server.verify(make_request(incomplete=True, baseline_answer="The reference."))
+
+    assert result.judge_truncated
+    assert server.server_client.post.call_count == 2
+
+
+@pytest.mark.asyncio
+async def test_alpaca_eval_masks_a_reply_without_a_verdict():
+    server = make_server([judge_reply({"The": 1.0}), judge_reply({"m": 1.0})], alpaca_eval=True)
+    result = await server.verify(make_request(baseline_answer="The reference."))
+
+    assert result.instance_config == {"mask_sample": True}
