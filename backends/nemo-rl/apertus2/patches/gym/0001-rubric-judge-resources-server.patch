+"""Tests for the rubric scoring core. They need neither Gym nor pytest."""
+
+import asyncio
+import math
+
+from resources_servers.rubric_judge.scoring import (
+    Rubric,
+    clean_response,
+    expected_score,
+    fill_pairwise,
+    normalize,
+    pairwise_win,
+    score_rubrics,
+    win_probability,
+)
+
+
+def lp(prob):
+    return math.log(prob)
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+def test_expected_score_is_the_mean_of_the_verdict_distribution():
+    assert math.isclose(expected_score([("5", lp(0.5)), ("3", lp(0.5))]), 4.0)
+
+
+def test_expected_score_renormalizes_over_the_scale():
+    # Mass on other tokens is dropped, as in the verl recipe.
+    top = [("4", lp(0.2)), ("2", lp(0.2)), ("The", lp(0.6))]
+    assert math.isclose(expected_score(top), 3.0)
+
+
+def test_expected_score_accepts_spaced_tokens_and_merges_them():
+    assert math.isclose(expected_score([(" 5", lp(0.25)), ("5", lp(0.25)), ("1", lp(0.5))]), 3.0)
+
+
+def test_expected_score_ignores_digits_off_the_scale():
