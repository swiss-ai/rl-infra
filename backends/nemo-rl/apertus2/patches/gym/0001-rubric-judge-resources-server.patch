+"""Rubric scoring, free of Gym dependencies so it can be tested on its own.
+
+A judge reads one filled rubric and gives a one-token verdict from 1 to 5. The
+score is the expected value of that verdict under the judge's first-token
+distribution, not the token it happened to pick, so rewards are continuous and
+16 rollouts of one prompt rarely tie.
+
+AlpacaEval's weighted win rate reads the first token the same way, as the share of
+`m` against `M` when the judge picks the better of two outputs.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import math
+import re
+from dataclasses import dataclass
+from typing import Awaitable, Callable, Dict, List, Mapping, NamedTuple, Optional, Sequence, Tuple, Type
+
+
+SCALE = (1, 2, 3, 4, 5)
+# AlpacaEval's model identifiers: `m` is output_1, `M` is output_2.
+FIRST, SECOND = "m", "M"
+
+# (token, logprob) pairs of the judge's first output token.
+TopLogprobs = Sequence[Tuple[str, float]]
+JudgeFn = Callable[[str], Awaitable[TopLogprobs]]
+
+
+class Rubric(NamedTuple):
+    template: str
+    weight: float
+
+
+@dataclass
+class RubricScores:
+    # Weighted mean of the rubric scores, in [0, 1]. 0 when a rubric failed.
+    reward: float
+    # Rubric name -> score in [0, 1], for the rubrics that got a verdict.
+    scores: Dict[str, float]
+    # Rubrics with no usable verdict after the retries.
+    failed: List[str]
+
+
+def expected_score(top_logprobs: TopLogprobs) -> Optional[float]:
+    """Expected verdict on `SCALE`, or None when the judge gave no digit on it."""
+    probs: Dict[int, float] = {}
+    for token, logprob in top_logprobs:
+        text = token.strip()
+        if text.isdigit() and int(text) in SCALE:
+            probs[int(text)] = probs.get(int(text), 0.0) + math.exp(logprob)
+    total = sum(probs.values())
+    if total == 0.0:
+        return None
+    return sum(value * prob for value, prob in probs.items()) / total
+
+
+def win_probability(top_logprobs: TopLogprobs, winner: str, loser: str) -> Optional[float]:
+    """P(winner) / (P(winner) + P(loser)), or None when the judge gave neither token."""
+    probs = {winner: 0.0, loser: 0.0}
+    for token, logprob in top_logprobs:
+        text = token.strip()
+        if text in probs:
+            probs[text] += math.exp(logprob)
+    total = sum(probs.values())
+    if total == 0.0:
+        return None
+    return probs[winner] / total
+
+
+def normalize(score: float) -> float:
+    """Map a verdict on `SCALE` to [0, 1]."""
+    return (score - SCALE[0]) / (SCALE[-1] - SCALE[0])
+
+
+def clean_response(text: str, stop_strings: Sequence[str]) -> str:
+    """The reply the judge should read: up to the first stop string, stripped.
+
+    Few-shot prompts stop at the next `User:` turn, and that marker can survive
+    in the text when the stop string was reached in the last token.
+    """
+    for stop in stop_strings:
+        index = text.find(stop)
+        if index != -1:
+            text = text[:index]
+    return text.strip()
+
+
+def fill_pairwise(template: str, instruction: str, output_1: str, output_2: str) -> str:
+    """Fill AlpacaEval's prompt, whose JSON-like text has braces of its own, in one pass."""
+    values = {"instruction": instruction, "output_1": output_1, "output_2": output_2}
+    return re.sub(r"\{(instruction|output_1|output_2)\}", lambda match: values[match.group(1)], template)
+
+
+async def _ask(
+    prompt: str,
+    judge: JudgeFn,
+    parse: Callable[[TopLogprobs], Optional[float]],
+    retries: int,
+    retry_on: Tuple[Type[BaseException], ...],
+    backoff_s: float,
+) -> Optional[float]:
+    for attempt in range(retries + 1):
+        try:
+            return parse(await judge(prompt))
+        except retry_on:
+            if attempt == retries:
+                return None
+            await asyncio.sleep(backoff_s * 2**attempt)
+    return None
+
+
+async def score_rubrics(
+    rubrics: Mapping[str, Rubric],
+    question: str,
+    answer: str,
+    judge: JudgeFn,
+    retries: int = 2,
+    retry_on: Tuple[Type[BaseException], ...] = (Exception,),
+    backoff_s: float = 1.0,
+) -> RubricScores:
+    """Score one response on every rubric at once.
+
+    A reply that parses to no verdict is not retried: the judge is deterministic
+    here, so a retry would read the same distribution.
+    """
+    names = list(rubrics)
+    verdicts = await asyncio.gather(
+        *(
+            _ask(
+                rubrics[name].template.format(prompt=question, completion=answer),
+                judge,
+                expected_score,
+                retries,
+                retry_on,
+                backoff_s,
+            )
+            for name in names
+        )
+    )
+    scores = {name: normalize(v) for name, v in zip(names, verdicts) if v is not None}
+    failed = [name for name, v in zip(names, verdicts) if v is None]
+    if failed:
+        return RubricScores(reward=0.0, scores=scores, failed=failed)
+    total_weight = sum(rubrics[name].weight for name in names)
+    reward = sum(rubrics[name].weight * scores[name] for name in names) / total_weight
+    return RubricScores(reward=reward, scores=scores, failed=[])
+
+
+async def pairwise_win(
+    template: str,
+    question: str,
+    answer: str,
+    baseline: str,
+    judge: JudgeFn,
+    retries: int = 2,
+    retry_on: Tuple[Type[BaseException], ...] = (Exception,),
+    backoff_s: float = 1.0,
+) -> Optional[float]:
+    """Weighted win of `answer` over `baseline`, averaged over both orders to cancel position bias."""
+
+    def ask(output_1: str, output_2: str, winner: str, loser: str) -> Awaitable[Optional[float]]:
+        return _ask(
+            fill_pairwise(template, question, output_1, output_2),
+            judge,
+            lambda top_logprobs: win_probability(top_logprobs, winner, loser),
+            retries,
+            retry_on,
+            backoff_s,
+        )
+
+    wins = await asyncio.gather(ask(answer, baseline, FIRST, SECOND), ask(baseline, answer, SECOND, FIRST))
+    if None in wins:
+        return None
+    return sum(wins) / len(wins)
