+rubric_judge:
+  resources_servers:
+    rubric_judge:
+      entrypoint: app.py
+      domain: rlhf
+      verified: false
+      description: Rewards free-form responses with an LLM judge on weighted rubrics
+      value: Train on domains with no verifiable answer, such as general chat
+      judge_model_server:
+        type: responses_api_models
+        name: judge_model
+      rubric_weights:
+        helpfulness: 1.0
+        instruction_following: 1.0
+        truthfulness: 1.0
+        honesty: 1.0
+      stop_strings: []
+      # A reply cut off by a token limit gets this reward without a judge call, so the judge never
+      # scores a half-finished reply and the policy learns to finish within the limit.
+      truncated_reward: 0.0
+
+rubric_judge_simple_agent:
+  responses_api_agents:
+    simple_agent:
+      entrypoint: app.py
+      resources_server:
+        type: resources_servers
+        name: rubric_judge
+      model_server:
+        type: responses_api_models
+        name: policy_model
+      datasets:
+        - name: example
+          type: example
+          jsonl_fpath: resources_servers/rubric_judge/data/example.jsonl
+
+# Validation: the same code in AlpacaEval mode, with the same judge model. Rows name this agent.
+# truncated_reward does not apply here: a cut-off reply is judged as it stands, as in AlpacaEval,
+# and is only reported in judge_truncated.
+alpaca_eval_judge:
+  resources_servers:
+    rubric_judge:
+      entrypoint: app.py
+      domain: rlhf
+      verified: false
+      description: AlpacaEval 2.0 weighted win rate against a reference reply, with a local judge
+      value: Validate training on domains with no verifiable answer
+      alpaca_eval: true
+      judge_model_server:
+        type: responses_api_models
+        name: judge_model
+      stop_strings: []
+
+alpaca_eval_simple_agent:
+  responses_api_agents:
+    simple_agent:
+      entrypoint: app.py
+      resources_server:
+        type: resources_servers
+        name: alpaca_eval_judge
+      model_server:
+        type: responses_api_models
+        name: policy_model
+      datasets:
+        - name: example
+          type: example
+          jsonl_fpath: resources_servers/rubric_judge/data/example_alpaca_eval.jsonl
+
+# The judge. Its base_url and model come from NeMo-RL's env.judge_pool, or from the
+# overrides of whoever runs it by hand.
+judge_model:
+  responses_api_models:
+    vllm_model:
+      entrypoint: app.py
+      base_url: ???
+      api_key: dummy_key
+      model: ???
+      return_token_id_information: false
+      uses_reasoning_parser: false
+      # The verdict has to be the first token, so the judge must not think first.
+      chat_template_kwargs:
+        enable_thinking: false
