From 62137a2592ed9b970e90161b9b6ce654d7043e0b Mon Sep 17 00:00:00 2001
From: Philip Mueller <claude@philipmueller.ch>
Date: Tue, 10 Nov 2026 07:29:28 +0000
Subject: [PATCH 28/31] fix(harbor_agent): OpenCode run command sets pipefail
 only where the shell has it

The sandbox exec may run the command with /bin/sh (OpenSandbox uses
`su -s /bin/sh -c` for a named user). In a shell without pipefail (older
dash) `set -o pipefail` is a special-builtin error that ends the
non-interactive shell before OpenCode starts. Probe it in a subshell first;
without pipefail the command still runs, only tee's exit status is recorded.

Signed-off-by: Philip Mueller <claude@philipmueller.ch>
---
 .../custom_agents/opencode_nemo_gym.py        |  8 +++++-
 .../custom_agents/test_opencode_nemo_gym.py   | 28 +++++++++++++++++--
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/responses_api_agents/harbor_agent/custom_agents/opencode_nemo_gym.py b/responses_api_agents/harbor_agent/custom_agents/opencode_nemo_gym.py
index d2a95b878..98d5489dd 100644
--- a/responses_api_agents/harbor_agent/custom_agents/opencode_nemo_gym.py
+++ b/responses_api_agents/harbor_agent/custom_agents/opencode_nemo_gym.py
@@ -91,6 +91,12 @@ _VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z.+-]*$")
 _SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
 
 
+# The sandbox exec may run the command with /bin/sh (OpenSandbox runs `su -s /bin/sh -c` for a
+# named user). A plain `set -o pipefail` is a special-builtin error in a shell without it (older
+# dash), which ends a non-interactive shell before OpenCode starts. Probe in a subshell first.
+PIPEFAIL_IF_SUPPORTED = "(set -o pipefail) 2>/dev/null && set -o pipefail; "
+
+
 def deep_merge(base: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
     """`base` updated by `overlay`, recursing into dicts; a None value in `overlay` deletes the key."""
     merged = copy.deepcopy(base)
@@ -299,7 +305,7 @@ class OpenCodeNemoGym(OpenCode):
         # stdin from /dev/null: with a non-TTY stdin `opencode run` reads it to EOF before doing
         # anything (cli/cmd/run.ts:399), and the sandbox exec leaves it open. pipefail keeps
         # OpenCode's exit status (e.g. 124 from timeout) instead of tee's.
-        command = f"set -o pipefail; {shlex.join(argv)} 2>&1 </dev/null | tee {LOG_FILE}"
+        command = f"{PIPEFAIL_IF_SUPPORTED}{shlex.join(argv)} 2>&1 </dev/null | tee {LOG_FILE}"
         if self._install_method == "npm":
             command = f"{NVM_PREFIX}{command}"
         return [ExecInput(command=command, env=self.opencode_env())]
diff --git a/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py b/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py
index df0371250..58b9f1a3f 100644
--- a/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py
+++ b/responses_api_agents/harbor_agent/custom_agents/test_opencode_nemo_gym.py
@@ -67,7 +67,7 @@ def test_requires_api_base(tmp_path: Path) -> None:
 def test_run_command(tmp_path: Path) -> None:
     (cmd,) = _agent(tmp_path).create_run_agent_commands("print 'hi' > /app/out.txt")
     assert cmd.command == (
-        f"set -o pipefail; opencode --model nemogym/{MODEL} run --format=json --title 'NeMo Gym' "
+        f"{mod.PIPEFAIL_IF_SUPPORTED}opencode --model nemogym/{MODEL} run --format=json --title 'NeMo Gym' "
         "-- 'print '\"'\"'hi'\"'\"' > /app/out.txt' 2>&1 </dev/null | tee /logs/agent/opencode.txt"
     )
     assert "timeout" not in cmd.command
@@ -76,7 +76,9 @@ def test_run_command(tmp_path: Path) -> None:
 
 def test_run_command_timeout_wrapper_and_debug_logs(tmp_path: Path) -> None:
     (cmd,) = _agent(tmp_path, opencode_timeout_sec=870, opencode_debug=True).create_run_agent_commands("-x")
-    assert cmd.command.startswith(f"set -o pipefail; timeout -k 10 870 opencode --model nemogym/{MODEL} run ")
+    assert cmd.command.startswith(
+        f"{mod.PIPEFAIL_IF_SUPPORTED}timeout -k 10 870 opencode --model nemogym/{MODEL} run "
+    )
     assert "--title 'NeMo Gym' --print-logs --log-level DEBUG -- -x 2>&1 </dev/null |" in cmd.command
 
 
@@ -121,6 +123,28 @@ def test_run_command_in_bash_closes_stdin_and_keeps_the_exit_status(
     assert lines[:5] == ["--model", f"nemogym/{MODEL}", "run", "--format=json", "--title"]
 
 
+@pytest.mark.parametrize("shell", ["sh", "dash"])
+def test_run_command_starts_opencode_in_a_posix_sh(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, shell: str
+) -> None:
+    """The sandbox exec may use /bin/sh; a shell without pipefail must still run OpenCode."""
+    if shutil.which(shell) is None:
+        pytest.skip(f"needs {shell}")
+    log = tmp_path / "opencode.txt"
+    monkeypatch.setattr(mod, "LOG_FILE", str(log))
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    fake = bin_dir / "opencode"
+    fake.write_text("#!/bin/sh\necho started\nexit 3\n")
+    fake.chmod(0o755)
+    (cmd,) = _agent(tmp_path).create_run_agent_commands("x")
+    env = {**os.environ, "PATH": f"{bin_dir}:{os.environ['PATH']}"}
+    proc = subprocess.run([shell, "-c", cmd.command], capture_output=True, text=True, env=env, timeout=20)
+    supports_pipefail = subprocess.run([shell, "-c", "set -o pipefail"], capture_output=True).returncode == 0
+    assert log.read_text().splitlines() == ["started"]
+    assert proc.returncode == (3 if supports_pipefail else 0)
+
+
 # --- environment ---------------------------------------------------------------------------------
 
 
