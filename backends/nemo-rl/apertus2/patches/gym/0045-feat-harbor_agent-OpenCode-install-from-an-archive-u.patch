+                raise ValueError("opencode_install 'upload' needs opencode_archive_dir (with <version>/<asset>)")
+            if not self._sha256:
+                raise ValueError(f"opencode_install 'upload' of OpenCode {self._version} needs opencode_sha256")
+            self._archive = verified_archive(Path(opencode_archive_dir) / self._version / opencode_asset, self._sha256)
 
     @staticmethod
     def name() -> str:
@@ -177,6 +212,7 @@ class OpenCodeNemoGym(OpenCode):
             "url": shlex.quote(RELEASE_URL.format(version=self._version, asset=self._asset)),
             "sha256": shlex.quote(self._sha256 or ""),
             "install_dir": shlex.quote(BINARY_INSTALL_DIR),
+            "archive": shlex.quote(POD_ARCHIVE if self._archive is not None else ""),
         }
 
     async def install(self, environment: BaseEnvironment) -> None:
@@ -184,6 +220,8 @@ class OpenCodeNemoGym(OpenCode):
             # Harbor's: system packages, Node (nvm, or the packaged one on musl), `npm i -g opencode-ai@<v>`
             await super().install(environment)
             return
+        if self._archive is not None:
+            await environment.upload_file(source_path=self._archive, target_path=POD_ARCHIVE)
         # as root: it writes to BINARY_INSTALL_DIR
