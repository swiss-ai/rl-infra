 # Harbor 0.25 installs OpenCode with npm under nvm and sources it before running (opencode.py:913)
 NVM_PREFIX = "[ -f ~/.nvm/nvm.sh ] && . ~/.nvm/nvm.sh; "
 
@@ -111,6 +117,27 @@ def deep_merge(base: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
     return merged
 
 
+@functools.lru_cache(maxsize=8)
+def _file_sha256(path: str, size: int, mtime_ns: int) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def verified_archive(path: Path, sha256: str) -> Path:
+    """`path` if it is a file with that sha256. Hashed once per process (and size and mtime): every trial
+    builds an adapter, and the archive does not change during a run."""
+    if not path.is_file():
+        raise FileNotFoundError(f"OpenCode archive {path} not found (opencode_archive_dir/<version>/<asset>)")
+    stat = path.stat()
+    actual = _file_sha256(str(path), stat.st_size, stat.st_mtime_ns)
+    if actual != sha256:
+        raise ValueError(f"OpenCode archive {path}: sha256 {actual}, expected {sha256}")
+    return path
+
