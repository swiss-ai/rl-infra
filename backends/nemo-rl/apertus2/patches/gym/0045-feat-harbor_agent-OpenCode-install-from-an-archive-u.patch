 url={{ url }}
 sha256={{ sha256 }}
 install_dir={{ install_dir }}
+uploaded={{ archive }}
 dest="$install_dir/opencode"
+work=""
+
+cleanup() {
+  if [ -n "$work" ]; then rm -rf "$work"; fi
+  if [ -n "$uploaded" ]; then rm -f "$uploaded"; fi
+}
+trap cleanup EXIT
 
 if [ -x "$dest" ] && [ "$("$dest" --version 2>/dev/null || true)" = "$version" ]; then
   echo "opencode $version already installed at $dest"
@@ -17,8 +29,7 @@ if [ -x "$dest" ] && [ "$("$dest" --version 2>/dev/null || true)" = "$version" ]
 fi
 
 work=$(mktemp -d)
-trap 'rm -rf "$work"' EXIT
-archive="$work/opencode.tar.gz"
+archive="${uploaded:-$work/opencode.tar.gz}"
 
 # Any Python 3 (task images ship 3.5 and later): no f-strings, no assignment expressions.
 download_python3() {
@@ -71,25 +82,36 @@ download_wget() {
   wget -q --tries=3 -O "$archive" "$url" && check_sha256
 }
 
-tried=""
-downloaded=""
-for tool in python3 curl wget; do
-  command -v "$tool" >/dev/null 2>&1 || continue
-  tried="$tried $tool"
-  rm -f "$archive"
-  if "download_$tool"; then
-    downloaded="$tool"
-    break
-  fi
-  echo "download with $tool failed" >&2
-done
-if [ -z "$downloaded" ]; then
+download() {
+  local tried="" tool
+  for tool in python3 curl wget; do
+    command -v "$tool" >/dev/null 2>&1 || continue
+    tried="$tried $tool"
+    rm -f "$archive"
+    if "download_$tool"; then
+      return 0
+    fi
+    echo "download with $tool failed" >&2
+  done
   if [ -z "$tried" ]; then
     echo "installing opencode needs python3, curl or wget in the task image" >&2
   else
     echo "download of $url failed with:$tried" >&2
   fi
-  exit 1
+  return 1
+}
+
+if [ -n "$uploaded" ]; then
+  if [ -n "$sha256" ] && command -v sha256sum >/dev/null 2>&1; then
+    actual=$(sha256sum "$archive")
+    if [ "${actual%% *}" != "$sha256" ]; then
+      echo "sha256 mismatch for the uploaded $archive: expected $sha256" >&2
+      exit 1
+    fi
+  fi
+  echo "using the uploaded $archive"
+else
+  download || exit 1
 fi
 
