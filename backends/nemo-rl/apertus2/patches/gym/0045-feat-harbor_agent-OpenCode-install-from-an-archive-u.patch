+# --- upload: the release archive comes from the node (opencode_archive_dir), not from GitHub -------
+
+
+def _archive_dir(tmp_path: Path, version: str = "1.17.11") -> tuple[Path, bytes, str]:
+    """An opencode_archive_dir with a fake release archive at <dir>/<version>/<asset>: (dir, bytes, sha256)."""
+    _, digest = _release(tmp_path, version)
+    data = (tmp_path / "release" / "opencode.tar.gz").read_bytes()
+    archive_dir = tmp_path / "opencode"
+    (archive_dir / version).mkdir(parents=True)
+    (archive_dir / version / mod.DEFAULT_ASSET).write_bytes(data)
+    return archive_dir, data, digest
+
+
+@pytest.mark.asyncio
+async def test_upload_install_uploads_the_archive_then_runs_the_script(tmp_path: Path) -> None:
+    archive_dir, data, digest = _archive_dir(tmp_path)
+    agent = _agent(tmp_path, opencode_install="upload", opencode_archive_dir=str(archive_dir), opencode_sha256=digest)
+    assert agent.install_variables()["archive"] == shlex.quote(mod.POD_ARCHIVE)
+    env = _Env()
+    await agent.install(env)
+    script = Environment().from_string(mod.BINARY_INSTALL_TEMPLATE.read_text()).render(**agent.install_variables())
+    assert env.uploads == [(data, mod.POD_ARCHIVE), (script.encode(), "/installed-agent/install.sh")]
+    assert env.calls[-1]["command"] == "bash /installed-agent/install.sh"
+
+
+def test_upload_install_refuses_an_archive_with_another_digest(tmp_path: Path) -> None:
+    archive_dir, _, _ = _archive_dir(tmp_path)  # the fake archive is not the pinned 1.17.11 release
+    with pytest.raises(ValueError, match="sha256"):
+        _agent(tmp_path, opencode_install="upload", opencode_archive_dir=str(archive_dir))
+
+
+def test_upload_install_needs_an_archive_dir(tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="opencode_archive_dir"):
+        _agent(tmp_path, opencode_install="upload")
+
+
+def test_upload_install_needs_the_archive(tmp_path: Path) -> None:
+    with pytest.raises(FileNotFoundError, match=mod.DEFAULT_ASSET):
+        _agent(tmp_path, opencode_install="upload", opencode_archive_dir=str(tmp_path))
+
+
+def test_upload_install_needs_a_digest(tmp_path: Path) -> None:
+    archive_dir, _, _ = _archive_dir(tmp_path, version="1.18.1")
+    with pytest.raises(ValueError, match="opencode_sha256"):
+        _agent(tmp_path, opencode_install="upload", opencode_archive_dir=str(archive_dir), version="1.18.1")
+
+
+def _uploaded(tmp_path: Path) -> tuple[Path, str]:
+    """A fake release archive where the pod would have it after the upload, and its sha256."""
+    _, data, digest = _archive_dir(tmp_path)
+    pod_archive = tmp_path / "installed-agent" / "opencode.tar.gz"
+    pod_archive.parent.mkdir()
+    pod_archive.write_bytes(data)
+    return pod_archive, digest
+
+
+# Job 5427428: one Terminal-Lego task image has no python3, curl or wget (8 of 640 trials failed setup).
+@needs_path_tools
+def test_install_script_installs_an_uploaded_archive_without_download_tools(tmp_path: Path) -> None:
+    pod_archive, digest = _uploaded(tmp_path)
+    bin_dir = _tool_dir(tmp_path, {})
+    result = _run_install_with_path(tmp_path, bin_dir, "file:///nonexistent.tar.gz", digest, str(pod_archive))
+    assert result.returncode == 0, result.stderr
+    assert "installed opencode 1.17.11" in result.stdout
+    # the sandbox's files live in node memory: the archive goes once the binary is installed
+    assert not pod_archive.exists()
+
+
+@needs_path_tools
+def test_install_script_checks_the_digest_of_an_uploaded_archive(tmp_path: Path) -> None:
+    pod_archive, _ = _uploaded(tmp_path)
+    result = _run_install_with_path(tmp_path, _tool_dir(tmp_path, {}), "file:///x", "0" * 64, str(pod_archive))
+    assert result.returncode != 0
+    assert "sha256 mismatch" in result.stderr
+    assert not (tmp_path / "bin" / "opencode").exists()
+
+
 def test_unknown_kwargs_still_fail(tmp_path: Path) -> None:
     with pytest.raises(ValueError, match="Unknown option 'bogus'"):
         _agent(tmp_path, bogus=1)
