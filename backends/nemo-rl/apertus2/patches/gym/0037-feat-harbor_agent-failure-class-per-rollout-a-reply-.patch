+"""Why a Harbor rollout ended: one failure class per rollout, from what harbor_agent sees.
+
+Inputs are the trial's result.json (Harbor's ``exception_info`` with the formatted traceback, the verifier phase
+timing, ``verifier_result``), the agent's ``agent_error_flags.json`` (Terminus2NemoGym writes the exception that
+ended its episode there, since it catches it so the verifier still runs) and an error raised by the Harbor job
+itself. Classes, first matching rule wins:
+
+- ``infra``: the sandbox, the model server or Harbor failed, not the policy (the exception types Harbor's own
+  error_policy.py files under SANDBOX_FAILED, plus the Gym/OpenSandbox ones): sandbox start/setup timeouts, sandbox
+  API errors (HTTP 502 backend unreachable, OOM-killed sandbox, memory limit), OpenSandbox command-status timeouts, also when
+  Harbor's ``_verify_with_timeout`` reports one as VerifierTimeoutError (it catches every TimeoutError), a
+  VerifierTimeoutError that ended well before its cap, connection errors to the model server, a Harbor job that
+  failed without a trial result. Also when the agent's episode ended on such an error and the verifier then ran.
+- ``agent_timeout``: the task's agent time limit (AgentTimeoutError).
+- ``verifier_timeout``: the verifier ran to its cap.
+- ``context_overflow``: the context is exhausted: the prompt did not fit (at the start or mid-episode), a reply cut
+  by the context ceiling, or a truncation loop whose last truncation was cut by the context ceiling.
+- ``model_truncation_loop``: the policy's replies hit the output limit too often in a row with room left (0035 cap).
+- ``other``: anything not recognised (the exception type is kept in the detail); also no verifier result.
+- ``ok``: the verifier ran and nothing above applies (task complete, max_turns, the agent stopped).
+"""
+
+import re
+from dataclasses import dataclass
+from datetime import datetime
+from typing import Any, Optional
+
+
+FAILURE_CLASSES = (
+    "ok",
+    "context_overflow",
+    "model_truncation_loop",
+    "agent_timeout",
+    "verifier_timeout",
+    "infra",
+    "other",
+)
+
+# A VerifierTimeoutError that ended before this share of its cap was not the cap.
+_EARLY_TIMEOUT_SHARE = 0.9
+
+_CONTEXT_TYPES = {"ContextLengthExceededError", "ContextWindowExceededError"}
+_INFRA_TYPES = {
+    # Harbor: sandbox / environment / setup
+    "EnvironmentStartTimeoutError",
+    "AgentSetupTimeoutError",
+    "SandboxBuildFailedError",
+    "HealthcheckError",
+    "SandboxLikelyOutOfMemoryError",
+    "MemoryLimitExceededError",
+    "RuntimeRequestError",
+    "AddTestsDirError",
+    "DownloadVerifierDirError",
+    # Gym sandbox providers (OpenSandbox)
+    "SandboxBackendUnreachableError",
+    "SandboxPtyError",
+    "SandboxCreateError",
+    "SandboxCreateVerificationError",
+    "OpenSandboxCreateError",
+    "OpenSandboxCreateTimeoutError",
+    "OpenSandboxCreateVerificationError",
+    # OpenSandbox SDK
+    "SandboxException",
+    "SandboxApiException",
+    "SandboxRateLimitException",
+    "SandboxWakeTimeoutException",
+    "SandboxInternalException",
+    "SandboxTimeoutException",
+    "SandboxConnectionException",
+    "SandboxUnhealthyException",
+    "SandboxReadyTimeoutException",
+    # Harbor: model provider unreachable or failing (its MODEL_PROVIDER_FAILED connection/server errors)
+    "ApiConnectionError",
+    "APIConnectionError",
+    "ApiConnectionClosedError",
+    "ApiResponseStalledError",
+    "ApiInternalServerError",
+    "InternalServerError",
+    "ServiceUnavailableError",
+    "NetworkConnectionError",
+    # transport to the model server or the sandbox API (httpx, aiohttp, builtins)
+    "ConnectError",
+    "ConnectTimeout",
+    "ReadTimeout",
+    "WriteTimeout",
+    "PoolTimeout",
+    "ReadError",
+    "WriteError",
+    "RemoteProtocolError",
+    "ClientConnectorError",
+    "ServerDisconnectedError",
+    "ClientOSError",
+    "ConnectionError",
+    "ConnectionRefusedError",
+    "ConnectionResetError",
+    "BrokenPipeError",
+}
+# Text of the errors above when they arrive wrapped (RuntimeError, TimeoutError, VerifierTimeoutError, ...).
+_INFRA_TEXT = re.compile(
+    r"OpenSandbox|SandboxApiException|SandboxBackendUnreachable|BACKEND_CONNECTION_FAILED|"
+    r"\bHTTP 50[234]\b|\b50[234] (?:Bad Gateway|Service Unavailable|Gateway Timeout)|"
+    r"Could not connect to the backend|all connection attempts failed|connection refused|"
+    r"model_tunnel|chisel",
+    re.IGNORECASE,
+)
+# "Type: message" lines at column 0 of a formatted traceback, one per exception of the chain.
+_TRACEBACK_EXC_LINE = re.compile(r"^([A-Za-z_][\w.]*(?:Error|Exception|Timeout|Exit|Cancelled)\w*)(?::\s?(.*))?$")
+_TIMEOUT_SECONDS = re.compile(r"timed out after ([0-9.]+) seconds")
+
+# Masking, as .claude/tools/_safe.py of the rl-infra analysis tools: a detail may end up in logs and TensorBoard
+# tables, and exception messages can carry URLs, headers or command lines.
+_ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\r")
+_AUTH = re.compile(r"(authorization[\"']?\s*[:=]\s*).*", re.IGNORECASE)
+_BEARER = re.compile(r"((?:Bearer|Basic)\s+)\S+", re.IGNORECASE)
+_KV = re.compile(
+    r"((?:api[_-]?key|apikey|password|passwd|secret|x-api-key|token|access[_-]?key)[\"']?\s*[:=]\s*)"
+    r"(\"[^\"]*\"|'[^']*'|[^\s,}&]+)",
+    re.IGNORECASE,
+)
+_URL_USERINFO = re.compile(r"(\b[a-z][a-z0-9+.-]*://)[^/\s:@]+:[^/\s@]+@", re.IGNORECASE)
+_OPAQUE = re.compile(r"\b(?=[A-Za-z0-9_\-]*[A-Z])(?=[A-Za-z0-9_\-]*[a-z])(?=[A-Za-z0-9_\-]*\d)[A-Za-z0-9_\-]{32,}\b")
+_DETAIL_WIDTH = 240
+
+
+def mask_secrets(text: str) -> str:
+    """``text`` with key=value secrets, authorization/bearer values, URL credentials and long opaque tokens masked."""
+    text = _ANSI.sub("", text)
+    text = _AUTH.sub(r"\1<MASKED>", text)
+    text = _BEARER.sub(r"\1<MASKED>", text)
+    text = _KV.sub(lambda m: m.group(1) + "<MASKED>", text)
+    text = _URL_USERINFO.sub(r"\1<MASKED>@", text)
+    return _OPAQUE.sub("<MASKED>", text)
+
+
+def short_error(exc_type: str, message: Any) -> str:
+    """'Type: first line of the message', masked and cut to a log-friendly width."""
+    first = str(message or "").strip().splitlines()[0] if str(message or "").strip() else ""
+    text = f"{exc_type}: {first}" if first else exc_type
+    return mask_secrets(text)[:_DETAIL_WIDTH]
+
+
+@dataclass(frozen=True)
+class FailureClassification:
+    failure_class: str
+    detail: str
+
+    def metrics(self) -> dict[str, int]:
+        """One 0/1 field per class, e.g. ``failure_infra``; NeMo-RL logs each as a per-agent mean."""
+        return {f"failure_{name}": int(name == self.failure_class) for name in FAILURE_CLASSES}
+
+
+def _short_type(name: Optional[str]) -> str:
+    return (name or "").rsplit(".", 1)[-1]
+
+
+def _chain(traceback_text: Optional[str]) -> list[tuple[str, str]]:
+    """(type, first line) of each exception in a formatted traceback, innermost cause first."""
+    out = []
+    for line in str(traceback_text or "").splitlines():
+        match = _TRACEBACK_EXC_LINE.match(line)
+        if match:
+            out.append((_short_type(match.group(1)), (match.group(2) or "").strip()))
+    return out
+
+
+def _is_infra(exc_type: str, message: str) -> bool:
+    return _short_type(exc_type) in _INFRA_TYPES or bool(_INFRA_TEXT.search(message or ""))
+
+
+def _phase_seconds(phase: Any) -> Optional[float]:
+    if not isinstance(phase, dict):
+        return None
+    try:
+        start = datetime.fromisoformat(str(phase["started_at"]).replace("Z", "+00:00"))
+        end = datetime.fromisoformat(str(phase["finished_at"]).replace("Z", "+00:00"))
+    except (KeyError, TypeError, ValueError):
+        return None
+    return (end - start).total_seconds()
+
+
+def classify_rollout(
+    trial_result: Optional[dict],
+    agent_error_flags: Optional[dict] = None,
+    run_error: Optional[BaseException] = None,
+) -> FailureClassification:
+    """The failure class of one rollout (see the module docstring for the rules)."""
+    flags = agent_error_flags or {}
+
+    if run_error is not None or trial_result is None:
+        if run_error is None:
+            return FailureClassification("other", "no trial result")
+        exc_type, message = type(run_error).__name__, str(run_error)
+        detail = "Harbor job failed: " + short_error(exc_type, message)
+        return FailureClassification("infra" if _is_infra(exc_type, message) else "other", detail)
+
+    info = trial_result.get("exception_info") or {}
+    exc_type = _short_type(info.get("exception_type"))
+    exc_message = str(info.get("exception_message") or "")
+    chain = _chain(info.get("exception_traceback"))
+    end_type = _short_type(flags.get("end_reason"))
+    end_message = str(flags.get("end_message") or "")
+
+    # 1. Infra anywhere: Harbor's exception, any cause in its chain, or the error that ended the agent's episode.
+    if exc_type:
+        for cause_type, cause_message in [*chain, (exc_type, exc_message)]:
+            if _is_infra(cause_type, cause_message):
+                if cause_type == exc_type and cause_message == exc_message:
+                    return FailureClassification("infra", short_error(exc_type, exc_message))
+                return FailureClassification(
+                    "infra", short_error(exc_type, exc_message) + " <- " + short_error(cause_type, cause_message)
+                )
+        if exc_type == "VerifierTimeoutError":
+            limit = _TIMEOUT_SECONDS.search(exc_message)
+            elapsed = _phase_seconds(trial_result.get("verifier"))
+            if limit and elapsed is not None and elapsed < _EARLY_TIMEOUT_SHARE * float(limit.group(1)):
+                return FailureClassification(
+                    "infra",
+                    short_error(exc_type, exc_message) + f" (ended after {elapsed:.0f} s: not the cap)",
+                )
+    if end_type and _is_infra(end_type, end_message):
+        return FailureClassification("infra", "agent: " + short_error(end_type, end_message))
+
+    # 2. What Harbor recorded.
+    if exc_type == "AgentTimeoutError":
+        return FailureClassification("agent_timeout", short_error(exc_type, exc_message))
+    if exc_type == "VerifierTimeoutError":
+        return FailureClassification("verifier_timeout", short_error(exc_type, exc_message))
+    if exc_type in _CONTEXT_TYPES:
+        return FailureClassification("context_overflow", short_error(exc_type, exc_message))
+    if exc_type:
+        return FailureClassification("other", short_error(exc_type, exc_message))
+
+    # 3. How the agent's episode ended (Terminus2NemoGym catches these so the verifier still runs).
+    if end_type in _CONTEXT_TYPES or flags.get("context_length_exceeded"):
+        detail = short_error(end_type or "ContextLengthExceededError", end_message)
+        if flags.get("answered_model_calls") == 0:
+            detail = "prompt does not fit: " + detail
+        return FailureClassification("context_overflow", detail)
+    if end_type == "TruncationLoopError":
+        if flags.get("last_truncation_at_context_limit"):
+            return FailureClassification(
+                "context_overflow", "truncation loop at the context limit: " + short_error(end_type, end_message)
+            )
+        return FailureClassification("model_truncation_loop", short_error(end_type, end_message))
+    if end_type:
+        return FailureClassification("other", "agent: " + short_error(end_type, end_message))
+
+    if not trial_result.get("verifier_result"):
+        return FailureClassification("other", "no verifier result")
+    return FailureClassification("ok", "")
