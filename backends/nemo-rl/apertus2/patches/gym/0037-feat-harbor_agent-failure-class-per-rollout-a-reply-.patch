+def _http_status_error(status: int, body: str) -> httpx.HTTPStatusError:
+    request = httpx.Request("GET", "https://opensandbox.example/v1/sandboxes/sb-1/files/download?path=/logs/artifacts")
+    response = httpx.Response(status, text=body, request=request)
+    return httpx.HTTPStatusError(
+        f"Client error '{status}' for url '{request.url}'", request=request, response=response
+    )
+
