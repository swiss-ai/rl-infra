diff --git a/nemo_gym/sandbox/providers/opensandbox/provider.py b/nemo_gym/sandbox/providers/opensandbox/provider.py
index 4e9e7e5a3..a3feba71a 100644
--- a/nemo_gym/sandbox/providers/opensandbox/provider.py
+++ b/nemo_gym/sandbox/providers/opensandbox/provider.py
@@ -64,6 +64,41 @@ class _MissingSandboxTerminateFilter(logging.Filter):
 logging.getLogger("opensandbox.adapters.sandboxes_adapter").addFilter(_MissingSandboxTerminateFilter())
 
 
+class _MissingFileReadFilter(logging.Filter):
+    """Turn the SDK's ERROR + traceback for reading a file that does not exist into one DEBUG line.
+
+    ``filesystem_adapter.read_bytes`` logs every failed read at ERROR with the full httpx traceback and then
+    raises SandboxApiException anyway. Harbor probes optional paths this way: "Collecting main service
+    artifacts" reads ``/logs/artifacts`` in every task without one (113 trials of job 5359900) and treats the
+    failure as best-effort. Only an HTTP 404 whose body says the file is missing is demoted; the exception still
+    reaches the caller, and any other read failure (a dead sandbox, 502, a missing sandbox) keeps its ERROR.
+    """
+
+    _MESSAGES = ("Failed to read file ", "Failed to stream file ")
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        if record.levelno < logging.ERROR or not record.exc_info:
+            return True
+        message = record.getMessage()
+        if not message.startswith(self._MESSAGES):
+            return True
+        error = record.exc_info[1]
+        response = getattr(error, "response", None)
+        status = getattr(response, "status_code", None) if response is not None else _exception_status_code(error)
+        try:
+            body = str(getattr(response, "text", "") or "")
+        except Exception:
+            body = ""
+        body = (body or str(error)).lower()
+        if status != 404 or "sandbox_not_found" in body or "file not found" not in body:
+            return True
+        LOGGER.debug("OpenSandbox: %s: HTTP 404 file not found (the caller handles it)", message)
+        return False
+
+
+logging.getLogger("opensandbox.adapters.filesystem_adapter").addFilter(_MissingFileReadFilter())
+
+
