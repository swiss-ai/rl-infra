+def test_sdk_read_of_a_missing_file_is_one_debug_line(caplog: pytest.LogCaptureFixture) -> None:
+    # job 5359900: Harbor's best-effort artifact collection reads /logs/artifacts in every task without one; the SDK
+    # logged each 404 at ERROR with the full httpx traceback (113 trials), next to real sandbox failures
+    sdk_logger = logging.getLogger("opensandbox.adapters.filesystem_adapter")
+    missing = _http_status_error(404, '{"code":"FILE_NOT_FOUND","message":"file not found. open /logs/artifacts"}')
+    sandbox_gone = _http_status_error(404, '{"code":"KUBERNETES::SANDBOX_NOT_FOUND","message":"file not found"}')
+    bad_gateway = _http_status_error(502, '{"code":"BACKEND_CONNECTION_FAILED","message":"file not found"}')
+
+    with caplog.at_level(logging.DEBUG, logger=opensandbox_provider.LOGGER.name):
+        sdk_logger.error("Failed to read file /logs/artifacts", exc_info=missing)
+        sdk_logger.error("Failed to read file /logs/verifier/reward.txt", exc_info=sandbox_gone)
+        sdk_logger.error("Failed to read file /logs/agent/x", exc_info=bad_gateway)
+        sdk_logger.error("Failed to write 1 files", exc_info=missing)
+
+    sdk_records = [r for r in caplog.records if r.name == sdk_logger.name]
+    assert [(r.levelno, r.getMessage()) for r in sdk_records] == [
+        (logging.ERROR, "Failed to read file /logs/verifier/reward.txt"),
+        (logging.ERROR, "Failed to read file /logs/agent/x"),
+        (logging.ERROR, "Failed to write 1 files"),
+    ]
+    debug = [r for r in caplog.records if r.name == opensandbox_provider.LOGGER.name]
+    assert [(r.levelno, r.getMessage(), r.exc_info) for r in debug] == [
+        (
+            logging.DEBUG,
+            "OpenSandbox: Failed to read file /logs/artifacts: HTTP 404 file not found (the caller handles it)",
+            None,
+        )
+    ]
