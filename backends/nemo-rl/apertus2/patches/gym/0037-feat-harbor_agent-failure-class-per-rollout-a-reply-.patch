+"""Failure classes of Harbor rollouts; cases taken from jobs 5356101, 5358015 and 5359900."""
+
+import pytest
+
+from responses_api_agents.harbor_agent.failure_classes import (
+    FAILURE_CLASSES,
+    classify_rollout,
+    mask_secrets,
+)
+
+
+VERIFIED = {"rewards": {"reward": 0.0}}
+
+
+def _trial(exception_type=None, message="", traceback="", verifier_seconds=None, verifier_result=VERIFIED):
+    result = {"verifier_result": verifier_result}
+    if exception_type is not None:
+        result["exception_info"] = {
+            "exception_type": exception_type,
+            "exception_message": message,
+            "exception_traceback": traceback,
+            "occurred_at": "2026-11-15T08:00:00Z",
+        }
+    if verifier_seconds is not None:
+        result["verifier"] = {
+            "started_at": "2026-11-15T08:00:00.000000Z",
+            "finished_at": f"2026-11-15T08:{int(verifier_seconds) // 60:02d}:{int(verifier_seconds) % 60:02d}.000000Z",
+        }
+    return result
+
+
+def _traceback(*lines):
+    """A formatted chained traceback whose exception lines are ``lines`` (innermost first)."""
+    blocks = [f'Traceback (most recent call last):\n  File "x.py", line 1, in f\n    g()\n{line}' for line in lines]
+    return "\n\nThe above exception was the direct cause of the following exception:\n\n".join(blocks) + "\n"
+
+
+VERIFIER_CAP = "Verifier execution timed out after 1200.0 seconds"
+# Harbor's _verify_with_timeout catches every TimeoutError, also the provider's own (job 5356101: 8 of 32).
+OPENSANDBOX_STATUS_TIMEOUT = _traceback(
+    "asyncio.exceptions.CancelledError",
+    "TimeoutError",
+    "TimeoutError: Timed out during OpenSandbox command status after 10s; sandbox_id='69a270b9-a497-495b'",
+    f"harbor.trial.errors.VerifierTimeoutError: {VERIFIER_CAP}",
+)
+REAL_VERIFIER_TIMEOUT = _traceback(
+    "asyncio.exceptions.CancelledError",
+    "TimeoutError",
+    f"harbor.trial.errors.VerifierTimeoutError: {VERIFIER_CAP}",
+)
+
+
