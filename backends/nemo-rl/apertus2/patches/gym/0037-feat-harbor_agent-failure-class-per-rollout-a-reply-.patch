+def test_classify_rollout(trial_result, flags, expected_class, detail_part) -> None:
+    result = classify_rollout(trial_result, flags)
+
+    assert result.failure_class == expected_class
+    assert detail_part in result.detail
+
+
+def test_harbor_job_errors_are_infra_only_when_they_look_like_it() -> None:
+    connect = classify_rollout(None, {}, ConnectionRefusedError("[Errno 111] Connection refused"))
+    config = classify_rollout(None, {}, ValueError("Invalid kwargs for agent 'x': Unknown option 'y'."))
+
+    assert (connect.failure_class, config.failure_class) == ("infra", "other")
+    assert config.detail == "Harbor job failed: ValueError: Invalid kwargs for agent 'x': Unknown option 'y'."
+
+
+def test_an_infra_failure_wins_over_what_followed() -> None:
+    # 5356101: the sandbox stopped answering during the episode, then the verifier "timed out" at its cap
+    trial = _trial("VerifierTimeoutError", VERIFIER_CAP, REAL_VERIFIER_TIMEOUT, 1210.0, None)
+    flags = {"end_reason": "TimeoutError", "end_message": "Timed out during OpenSandbox command status after 10s"}
+
+    assert classify_rollout(trial, flags).failure_class == "infra"
+
+
+def test_metrics_are_one_hot_over_every_class() -> None:
+    metrics = classify_rollout(_trial("AgentTimeoutError", "x"), {}).metrics()
+
+    assert list(metrics) == [f"failure_{name}" for name in FAILURE_CLASSES]
+    assert metrics["failure_agent_timeout"] == 1
+    assert sum(metrics.values()) == 1
