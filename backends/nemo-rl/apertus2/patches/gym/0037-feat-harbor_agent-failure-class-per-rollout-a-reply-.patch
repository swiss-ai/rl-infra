+    def _cut_by_context_limit(self, payload: dict[str, Any], response_dict: dict[str, Any]) -> str | None:
+        """For a reply with finish_reason "length": why it was cut by the context ceiling, or None.
+
+        The NeMo-RL endpoint clamps max_tokens to max_model_len - len(prompt), so near the end of the context a
+        reply stops at the ceiling, and a resample of the same prompt hits the same ceiling (job 5359900: 72 of 73
+        truncation loops had < max_new_tokens of room left, median 90 tokens). Uses the server's usage numbers
+        (Terminus2's own token count misses the thinking kept in the token-in prompt), else the returned token
+        ids. Cut by the context: fewer completion tokens than the output limit (the request's max_tokens, else
+        model_info.max_output_tokens), or prompt + completion reaching model_info.max_input_tokens. Without the
+        numbers or the limits: None (treated as an ordinary truncation).
+        """
+        usage = response_dict.get("usage") if isinstance(response_dict.get("usage"), dict) else {}
+        choices = response_dict.get("choices") or [{}]
+        message = (choices[0] or {}).get("message") if isinstance(choices[0], dict) else None
+        message = message if isinstance(message, dict) else {}
+
+        def count(usage_key: str, ids_key: str) -> int | None:
+            value = usage.get(usage_key)
+            if isinstance(value, int) and value >= 0:
+                return value
+            ids = message.get(ids_key)
+            return len(ids) if isinstance(ids, list) else None
+
+        prompt_tokens = count("prompt_tokens", "prompt_token_ids")
+        completion_tokens = count("completion_tokens", "generation_token_ids")
+        if completion_tokens is None:
+            return None
+
+        output_limit = payload.get("max_tokens") or payload.get("max_completion_tokens")
+        if not (isinstance(output_limit, int) and output_limit > 0):
+            output_limit = self._model_info.get("max_output_tokens")
+        if isinstance(output_limit, int) and output_limit > 0 and completion_tokens < output_limit:
+            return f"{completion_tokens} completion tokens < output limit {output_limit}"
+
+        context_limit = self._model_info.get("max_input_tokens")
+        if (
+            isinstance(context_limit, int)
+            and context_limit > 0
+            and prompt_tokens is not None
+            and prompt_tokens + completion_tokens >= context_limit
+        ):
+            return f"{prompt_tokens} prompt + {completion_tokens} completion tokens >= context limit {context_limit}"
+        return None
+
     def get_model_context_limit(self) -> int:
         fallback_context_limit = 1000000
 
