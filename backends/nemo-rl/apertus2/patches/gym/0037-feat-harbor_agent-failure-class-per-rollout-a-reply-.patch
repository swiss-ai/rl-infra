+
+
+# Job 5359900: 72 of 73 truncation loops had less room left than max_new_tokens (median 90 tokens): the endpoint
+# clamps max_tokens to max_model_len - len(prompt), so the reply stops at the context ceiling, and a resample of the
+# same prompt meets the same ceiling, 8 times. A reply cut by the ceiling now ends the episode as a context overflow.
+CONTEXT_MODEL_INFO = {"max_input_tokens": 24, "max_output_tokens": 10}
+ENDLESS = '{"analysis": "a reply that never ends'
+
+
+def _context_agent(tmp_path, replies, **kwargs):
+    # as in Gym's training config (configs/harbor_agent_opensandbox_training.yaml); with it on, Terminus2 answers a
+    # ContextLengthExceededError by summarizing instead of ending the episode
+    kwargs.setdefault("enable_summarize", False)
+    agent, requests = _server_agent(tmp_path, replies, **kwargs)
+    agent._llm._model_info = dict(CONTEXT_MODEL_INFO)
+    return agent, requests
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "prompt_ids, completion_ids",
+    [
+        pytest.param(list(range(20)), [8] * 4, id="prompt+reply-reach-the-context-limit"),
+        pytest.param(list(range(5)), [8] * 3, id="reply-shorter-than-the-output-limit"),
+    ],
+)
+async def test_a_reply_cut_by_the_context_limit_ends_the_episode_as_an_overflow(
+    tmp_path, prompt_ids, completion_ids
+) -> None:
+    from harbor.llms.base import ContextLengthExceededError
+
+    agent, requests = _context_agent(
+        tmp_path,
+        [_completion(ENDLESS, prompt_ids, completion_ids, finish_reason="length"), _completion(REPLY_1, [1], [2])],
+    )
+    chat = Chat(agent._llm)
+
+    with pytest.raises(ContextLengthExceededError, match="cut by the context limit"):
+        await agent._query_llm(chat, "do the task")
+
+    assert len(requests) == 1  # no resample
+    assert chat.messages == []
+    assert agent._llm.context_length_exceeded is True
+    assert agent._llm.context_limit_truncations == 1
+
+
+@pytest.mark.asyncio
+async def test_a_reply_cut_by_the_output_limit_with_room_left_is_still_resampled(tmp_path) -> None:
+    agent, requests = _context_agent(
+        tmp_path,
+        [_completion(ENDLESS, [1, 2], [8] * 10, finish_reason="length"), _completion(REPLY_1, [1, 2], [3, 4])],
+    )
+    chat = Chat(agent._llm)
+
+    assert (await agent._query_llm(chat, "do the task")).content == REPLY_1
+    assert requests[1]["messages"] == requests[0]["messages"]
+    assert agent._llm.context_length_exceeded is False
+    assert agent._llm.last_truncation_at_context_limit is False
+
+
+@pytest.mark.asyncio
+async def test_without_usage_numbers_or_limits_a_truncation_is_an_ordinary_one(tmp_path) -> None:
+    # no model_info: nothing to compare with, so the 0036 resample path is unchanged
+    agent, requests = _server_agent(
+        tmp_path,
+        [_completion(ENDLESS, list(range(20)), [8] * 4, finish_reason="length"), _completion(REPLY_1, [1], [2])],
+    )
+    assert (await agent._query_llm(Chat(agent._llm), "do the task")).content == REPLY_1
+    assert len(requests) == 2
+
+
+@pytest.mark.asyncio
+async def test_context_limit_truncation_resample_keeps_the_old_behaviour(tmp_path) -> None:
+    clamp = _completion(ENDLESS, list(range(20)), [8] * 4, finish_reason="length")
+    agent, requests = _context_agent(
+        tmp_path, [clamp] * 3, context_limit_truncation="resample", max_consecutive_truncations=3
+    )
+
+    with pytest.raises(Exception, match="3 consecutive replies") as caught:
+        await agent._query_llm(Chat(agent._llm), "do the task")
+
+    assert type(caught.value).__name__ == "TruncationLoopError"
+    assert len(requests) == 3
+    assert agent._llm.context_length_exceeded is False
+    assert agent._llm.context_limit_truncations == 3
+    assert agent._llm.last_truncation_at_context_limit is True
+
+
+def test_preflight_checks_context_limit_truncation() -> None:
+    Terminus2NemoGym.preflight(kwargs={"context_limit_truncation": "overflow"}, env={})
+    Terminus2NemoGym.preflight(kwargs={"context_limit_truncation": "resample"}, env={})
+    with pytest.raises(ValueError):
+        Terminus2NemoGym.preflight(kwargs={"context_limit_truncation": "error"}, env={})
+
+
+@pytest.mark.asyncio
