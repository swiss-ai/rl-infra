@@ -19,39 +20,75 @@ work=$(mktemp -d)
 trap 'rm -rf "$work"' EXIT
 archive="$work/opencode.tar.gz"
 
-if command -v python3 >/dev/null 2>&1; then
+# Any Python 3 (task images ship 3.5 and later): no f-strings, no assignment expressions.
+download_python3() {
   python3 - "$url" "$archive" "$sha256" <<'PY'
 import hashlib
 import sys
 import time
-import urllib.request
+from urllib.request import urlopen
 
 url, out, want = sys.argv[1:4]
+digest = None
 for attempt in range(1, 4):
     try:
         digest = hashlib.sha256()
-        with urllib.request.urlopen(url, timeout=120) as response, open(out, "wb") as f:
-            while chunk := response.read(1 << 20):
-                f.write(chunk)
-                digest.update(chunk)
+        response = urlopen(url, timeout=120)
+        try:
+            with open(out, "wb") as f:
+                while True:
+                    chunk = response.read(1 << 20)
+                    if not chunk:
+                        break
+                    f.write(chunk)
+                    digest.update(chunk)
+        finally:
+            response.close()
         break
-    except Exception as e:  # network errors: retry, then fail the setup
+    except Exception as e:  # network errors: retry, then fail this download
         if attempt == 3:
-            sys.exit(f"download of {url} failed: {e}")
-        print(f"download attempt {attempt} failed: {e}", file=sys.stderr)
+            sys.exit("download of %s failed: %s" % (url, e))
+        sys.stderr.write("download attempt %d failed: %s\n" % (attempt, e))
         time.sleep(5 * attempt)
 got = digest.hexdigest()
-print(f"downloaded {url} sha256 {got}")
+print("downloaded %s sha256 %s" % (url, got))
 if want and got != want:
-    sys.exit(f"sha256 mismatch for {url}: expected {want}, got {got}")
+    sys.exit("sha256 mismatch for %s: expected %s, got %s" % (url, want, got))
 PY
-elif command -v curl >/dev/null 2>&1; then
-  curl -fsSL --retry 3 -o "$archive" "$url"
+}
+
+check_sha256() {
   if [ -n "$sha256" ]; then
     echo "$sha256  $archive" | sha256sum -c -
   fi
-else
-  echo "installing opencode needs python3 or curl in the task image" >&2
+}
+
+download_curl() {
+  curl -fsSL --retry 3 -o "$archive" "$url" && check_sha256
+}
+
+download_wget() {
+  wget -q --tries=3 -O "$archive" "$url" && check_sha256
+}
+
+tried=""
+downloaded=""
+for tool in python3 curl wget; do
+  command -v "$tool" >/dev/null 2>&1 || continue
+  tried="$tried $tool"
+  rm -f "$archive"
+  if "download_$tool"; then
+    downloaded="$tool"
+    break
+  fi
+  echo "download with $tool failed" >&2
+done
+if [ -z "$downloaded" ]; then
+  if [ -z "$tried" ]; then
+    echo "installing opencode needs python3, curl or wget in the task image" >&2
+  else
+    echo "download of $url failed with:$tried" >&2
+  fi
   exit 1
 fi
 
