     assert "version mismatch" in result.stderr
 
 
+def _python_downloader() -> str:
+    """The Python program the install script feeds to python3 (its <<'PY' here-document)."""
+    template = mod.BINARY_INSTALL_TEMPLATE.read_text()
+    return template.split("<<'PY'\n", 1)[1].split("\nPY\n", 1)[0]
+
+
+# Job 5425513: task images with a python3 older than 3.8 (R2E-Gym, SWE-Lego) failed the install with
+# "SyntaxError" on `while chunk := ...`, 64 of 640 trials. The downloader must run on any Python 3.
+def test_python_downloader_parses_on_old_python3() -> None:
+    import ast
+
+    tree = ast.parse(_python_downloader(), feature_version=(3, 7))  # the oldest ast can check: no walrus
+    f_strings = [node.lineno for node in ast.walk(tree) if isinstance(node, ast.JoinedStr)]
+    assert not f_strings, f"f-strings need Python 3.6, lines {f_strings}"
+
+
+# what the install script runs besides the download tools
+BASIC_TOOLS = ("bash", "tar", "gzip", "mktemp", "rm", "mkdir", "install", "sha256sum", "cp")
+
+
+def _tool_dir(tmp_path: Path, tools: dict[str, str]) -> Path:
+    """A PATH directory with the basic tools the script needs plus fake download tools (name -> script)."""
+    bin_dir = tmp_path / "path"
+    bin_dir.mkdir()
+    for tool in BASIC_TOOLS:
+        (bin_dir / tool).symlink_to(shutil.which(tool))
+    for name, body in tools.items():
+        (bin_dir / name).write_text(body)
+        (bin_dir / name).chmod(0o755)
+    return bin_dir
+
+
+# copies a file:// URL to -O <file>, as `wget -q -O <file> <url>` downloads it
+FAKE_WGET = """#!/bin/bash
+out=""; url=""
+while [ $# -gt 0 ]; do
+  case "$1" in -O) out="$2"; shift 2 ;; -*) shift ;; *) url="$1"; shift ;; esac
+done
+cp "${url#file://}" "$out"
+"""
+FAILING_PYTHON = "#!/bin/sh\necho 'python3: cannot download' >&2\nexit 1\n"
+
+needs_path_tools = pytest.mark.skipif(
+    any(shutil.which(tool) is None for tool in BASIC_TOOLS), reason="needs " + ", ".join(BASIC_TOOLS)
+)
+
+
+def _run_install_with_path(tmp_path: Path, bin_dir: Path, url: str, sha256: str):
+    variables = {
+        **_agent(tmp_path).install_variables(),
+        "url": shlex.quote(url),
+        "sha256": shlex.quote(sha256),
+        "install_dir": shlex.quote(str(tmp_path / "bin")),
+    }
+    script = tmp_path / "install.sh"
+    script.write_text(Environment().from_string(mod.BINARY_INSTALL_TEMPLATE.read_text()).render(**variables))
+    return subprocess.run(
+        [str(bin_dir / "bash"), str(script)], capture_output=True, text=True, timeout=60, env={"PATH": str(bin_dir)}
+    )
+
+
+@needs_path_tools
+def test_install_script_falls_back_to_wget_when_python3_fails_and_curl_is_missing(tmp_path: Path) -> None:
+    url, digest = _release(tmp_path, "1.17.11")
+    bin_dir = _tool_dir(tmp_path, {"python3": FAILING_PYTHON, "wget": FAKE_WGET})
+    result = _run_install_with_path(tmp_path, bin_dir, url, digest)
+    assert result.returncode == 0, result.stderr
+    assert "download with python3 failed" in result.stderr
+    assert "installed opencode 1.17.11" in result.stdout
+
+
+@needs_path_tools
+def test_install_script_checks_the_digest_of_a_wget_download(tmp_path: Path) -> None:
+    url, _ = _release(tmp_path, "1.17.11")
+    result = _run_install_with_path(tmp_path, _tool_dir(tmp_path, {"wget": FAKE_WGET}), url, "0" * 64)
+    assert result.returncode != 0
+    assert not (tmp_path / "bin" / "opencode").exists()
+
+
+@needs_path_tools
+def test_install_script_without_any_download_tool_says_what_it_needs(tmp_path: Path) -> None:
+    url, digest = _release(tmp_path, "1.17.11")
+    result = _run_install_with_path(tmp_path, _tool_dir(tmp_path, {}), url, digest)
+    assert result.returncode != 0
+    assert "needs python3, curl or wget" in result.stderr
+
+
 def test_unknown_kwargs_still_fail(tmp_path: Path) -> None:
     with pytest.raises(ValueError, match="Unknown option 'bogus'"):
         _agent(tmp_path, bogus=1)
