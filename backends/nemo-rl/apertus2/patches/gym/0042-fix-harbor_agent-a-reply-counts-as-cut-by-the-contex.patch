+def context_cut_margin(context_limit: int) -> int:
+    """How far below the context limit a "length" reply still counts as cut by it: max(256, 1% of the limit).
+
+    With the endpoint's clamp the sum is exactly the limit; the margin absorbs tokens counted on one side only
+    (e.g. template or frame tokens outside usage; none known, UNVERIFIED) and is small against the output limit
+    (256 of 6144 at 24k), so a reply that stopped this close to the ceiling would not get much further anyway.
+    """
+    return max(256, math.ceil(context_limit / 100))
+
+
+@dataclass(frozen=True)
+class _LengthNumbers:
+    """Token numbers of a reply that finished with "length"; None where the response or the config lacks them."""
+
+    prompt: int | None
+    completion: int | None
+    output_limit: int | None
+    context_limit: int | None
+
+    def text(self) -> str:
+        def show(value: int | None) -> str:
+            return "?" if value is None else str(value)
+
+        total = "?" if self.prompt is None or self.completion is None else str(self.prompt + self.completion)
+        return (
+            f"{show(self.prompt)} prompt + {show(self.completion)} completion = {total} tokens; "
+            f"output limit {show(self.output_limit)}, context limit {show(self.context_limit)}"
+        )
+
+
