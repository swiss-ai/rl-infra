+    @staticmethod
+    def _cut_by_context_limit(numbers: "_LengthNumbers") -> bool:
+        """Whether a reply with finish_reason "length" was cut by the context ceiling.
+
+        The NeMo-RL endpoint clamps max_tokens to max_model_len - len(prompt), so a reply cut by the ceiling has
+        prompt + completion = the context limit, and a resample of the same prompt meets the same ceiling (job
+        5359900: 72 of 73 truncation loops). Cut: prompt + completion within CONTEXT_CUT_MARGIN of
+        model_info.max_input_tokens. A shorter length reply had room left: the Apertus 2 endpoint also ends an
+        output without a reply frame with "length" (job 5365870: 22 of 0037's 73 "cuts" ended well below the
+        limit, one at 1163 + 232 tokens); it is an ordinary truncation (resampled). Without the numbers or the
+        limit: not a cut.
+        """
+        if numbers.prompt is None or numbers.completion is None or numbers.context_limit is None:
+            return False
+        return numbers.prompt + numbers.completion >= numbers.context_limit - context_cut_margin(numbers.context_limit)
 
     def get_model_context_limit(self) -> int:
         fallback_context_limit = 1000000
