diff --git a/responses_api_agents/harbor_agent/overrides.txt b/responses_api_agents/harbor_agent/overrides.txt
new file mode 100644
index 00000000..94577a3f
--- /dev/null
+++ b/responses_api_agents/harbor_agent/overrides.txt
@@ -0,0 +1,9 @@
+# harbor -> dirhash -> scantree imports pathspec, which Gym otherwise never
+# installs: it is listed in the root pyproject.toml's override-dependencies as
+# "pathspec; sys_platform == 'never'" (copyleft, MPL-2.0), and server venvs
+# inherit that list through the editable nemo-gym install. Without this, every
+# Harbor job dies at `from harbor.job import Job` with ModuleNotFoundError and
+# every rollout is masked as degenerate.
+#
+# Same remedy, same reason, as responses_api_agents/miniswe_sandboxed_agent.
+pathspec
