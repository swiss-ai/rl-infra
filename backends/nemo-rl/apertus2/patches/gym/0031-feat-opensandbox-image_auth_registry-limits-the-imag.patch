From a40c77f89a741c3a71d46257031123a46cc58026 Mon Sep 17 00:00:00 2001
From: Philip Mueller <claude@philipmueller.ch>
Date: Wed, 11 Nov 2026 09:46:16 +0000
Subject: [PATCH 31/31] feat(opensandbox): image_auth_registry limits the image
 credentials to one registry

provider_options.image_auth_registry (a registry host, e.g. rl-registry.example
or host:5000) makes image_auth, inline or from image_auth_file, go only to
images from that registry; any other image is pulled without credentials. The
OpenSandbox server builds the pull secret for whatever registry each image
names, so one provider-wide image_auth also sent the robot credentials to
Docker Hub for python:3.12-slim. A reference without a registry host is a
Docker Hub image (docker.io), as on the server. Without image_auth_registry,
image_auth goes to every image as before; giving it without image_auth or
image_auth_file is an error.

Replaces our earlier image_auth.credentials_file/registry patch on top of the
Harbor 0.25.0 series: the credentials file is image_auth_file now.

Signed-off-by: Philip Mueller <claude@philipmueller.ch>
---
 .../sandbox/providers/opensandbox/provider.py |  30 +++++-
 tests/unit_tests/test_opensandbox_provider.py | 100 ++++++++++++++++++
 2 files changed, 128 insertions(+), 2 deletions(-)

diff --git a/nemo_gym/sandbox/providers/opensandbox/provider.py b/nemo_gym/sandbox/providers/opensandbox/provider.py
index 51ea6020b..4e9e7e5a3 100644
--- a/nemo_gym/sandbox/providers/opensandbox/provider.py
+++ b/nemo_gym/sandbox/providers/opensandbox/provider.py
@@ -374,9 +374,20 @@ def _to_volumes(volumes: list[Mapping[str, Any]]) -> list[Any]:
     return [Volume(**dict(volume)) for volume in volumes]
 
 
-def _to_image_spec(image: str, image_auth: Mapping[str, Any] | None) -> Any:
+def _image_registry(image: str) -> str:
+    """The registry host of an image reference, ``docker.io`` when it names none (as the OpenSandbox server)."""
+    first, sep, _ = image.partition("/")
+    if sep and ("." in first or ":" in first or first == "localhost"):
+        return first.lower()
+    return "docker.io"
+
+
+def _to_image_spec(image: str, image_auth: Mapping[str, Any] | None, registry: str | None = None) -> Any:
+    """Image spec with pull credentials; with ``registry`` only for images from that registry host."""
     if image_auth is None:
         return image
+    if registry is not None and _image_registry(image) != registry.lower():
+        return image
     from opensandbox.models.sandboxes import SandboxImageAuth, SandboxImageSpec
 
     return SandboxImageSpec(image, auth=SandboxImageAuth(**dict(image_auth)))
@@ -619,10 +630,16 @@ class OpenSandboxProviderOptions:
     ``image_auth_file`` names a file holding ``username:password`` for the image registry, read
     when the options are parsed, so that the password stays out of configs (NeMo-RL prints the
     resolved one) and the job's environment. It becomes ``image_auth``; giving both is an error.
+
+    ``image_auth_registry`` (a registry host, e.g. ``registry.example:5000``) limits ``image_auth`` to
+    images from that registry; others are pulled without credentials. The OpenSandbox server builds the
+    pull secret for whatever registry each image names, so without it the credentials also go to Docker
+    Hub for ``python:3.12-slim``. A reference without a host is a Docker Hub image (``docker.io``).
     """
 
     image_auth: Mapping[str, Any] | None = field(default=None, repr=False)
     image_auth_file: str | None = None
+    image_auth_registry: str | None = None
     network_policy: Mapping[str, Any] | None = None
     platform: Mapping[str, Any] | None = None
     snapshot_id: str | None = None
@@ -665,6 +682,14 @@ class OpenSandboxProviderOptions:
             if not sep or not username or not password:
                 raise ValueError(f"OpenSandbox image_auth_file {image_auth_file} must hold 'username:password'")
             image_auth = {"username": username, "password": password}
+        image_auth_registry = options.get("image_auth_registry")
+        if image_auth_registry is not None:
+            if not isinstance(image_auth_registry, str) or not image_auth_registry or "/" in image_auth_registry:
+                raise TypeError("OpenSandbox provider option 'image_auth_registry' must be a registry host")
+            if image_auth is None:
+                raise ValueError(
+                    "OpenSandbox provider option 'image_auth_registry' needs image_auth or image_auth_file"
+                )
         network_policy = options.get("network_policy")
         if network_policy is not None and not isinstance(network_policy, Mapping):
             raise TypeError("OpenSandbox provider option 'network_policy' must be a mapping")
@@ -690,6 +715,7 @@ class OpenSandboxProviderOptions:
         return cls(
             image_auth=dict(image_auth) if image_auth is not None else None,
             image_auth_file=image_auth_file,
+            image_auth_registry=image_auth_registry,
             network_policy=dict(network_policy) if network_policy is not None else None,
             platform=dict(platform) if platform is not None else None,
             snapshot_id=snapshot_id,
@@ -1351,7 +1377,7 @@ class OpenSandboxProvider:
         if options.resource_requests is not None:
             kwargs["resource_requests"] = _resource_map(SandboxResources.from_mapping(options.resource_requests))
         if spec.image is not None:
-            kwargs["image"] = _to_image_spec(spec.image, options.image_auth)
+            kwargs["image"] = _to_image_spec(spec.image, options.image_auth, options.image_auth_registry)
         if options.snapshot_id is not None:
             kwargs["snapshot_id"] = options.snapshot_id
         if options.secure_access is not None:
diff --git a/tests/unit_tests/test_opensandbox_provider.py b/tests/unit_tests/test_opensandbox_provider.py
index b09126e63..09e451848 100644
--- a/tests/unit_tests/test_opensandbox_provider.py
+++ b/tests/unit_tests/test_opensandbox_provider.py
@@ -1996,3 +1996,103 @@ def test_provider_options_image_auth_file(tmp_path) -> None:
     cred.write_text("no-colon\n")
     with pytest.raises(ValueError, match="username:password"):
         options_cls.from_mapping({"image_auth_file": str(cred)})
+
+
+ROBOT_NAME = "robot$swe_lego_v05_1+puller"
+ROBOT_PASSWORD = "pw:with:colons"  # pragma: allowlist secret
+
+
+@dataclass
+class FakeImageAuth:
+    username: str
+    password: str
+
+
+@dataclass
+class FakeImageSpec:
+    image: str
+    auth: FakeImageAuth | None = None
+
+
+@pytest.fixture
+def fake_image_models(monkeypatch: pytest.MonkeyPatch) -> None:
+    """The SDK's image models, so these tests run without the opensandbox package."""
+    models = SimpleNamespace(SandboxImageAuth=FakeImageAuth, SandboxImageSpec=FakeImageSpec)
+    monkeypatch.setitem(sys.modules, "opensandbox", SimpleNamespace(models=SimpleNamespace(sandboxes=models)))
+    monkeypatch.setitem(sys.modules, "opensandbox.models", SimpleNamespace(sandboxes=models))
+    monkeypatch.setitem(sys.modules, "opensandbox.models.sandboxes", models)
+
+
+async def test_image_auth_registry_limits_credentials_to_that_registry(
+    fake_opensandbox_sdk: None, fake_image_models: None, tmp_path: Path
+) -> None:
+    cred = tmp_path / "registry_cred"
+    cred.write_text(f"{ROBOT_NAME}:{ROBOT_PASSWORD}\n")
+    options = {"image_auth_file": str(cred), "image_auth_registry": "rl-registry.example"}
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+
+    # Docker Hub (no host in the reference, or docker.io) and another registry: no credentials sent
+    for other in ("python:3.12-slim", "docker.io/library/python:3.12-slim", "mirror.gcr.io/astral/uv:latest"):
+        await provider.create(SandboxSpec(image=other, provider_options=options))
+        assert FakeSandbox.created_kwargs["image"] == other
+
+    await provider.create(SandboxSpec(image="rl-registry.example/swe_lego_v05_1/task:1", provider_options=options))
+    image = FakeSandbox.created_kwargs["image"]
+    assert (image.auth.username, image.auth.password) == (ROBOT_NAME, ROBOT_PASSWORD)
+
+
+async def test_image_auth_registry_with_inline_credentials(
+    fake_opensandbox_sdk: None, fake_image_models: None
+) -> None:
+    options = {
+        "image_auth": {"username": "user", "password": TEST_REGISTRY_PASSWORD},
+        "image_auth_registry": "Registry.Example:5000",
+    }
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+
+    await provider.create(SandboxSpec(image="python:3.12-slim", provider_options=options))
+    assert FakeSandbox.created_kwargs["image"] == "python:3.12-slim"
+    # same host, other port: another registry
+    await provider.create(SandboxSpec(image="registry.example/repo", provider_options=options))
+    assert FakeSandbox.created_kwargs["image"] == "registry.example/repo"
+    await provider.create(SandboxSpec(image="registry.example:5000/repo:tag", provider_options=options))
+    assert FakeSandbox.created_kwargs["image"].auth.password == TEST_REGISTRY_PASSWORD
+
+
+async def test_image_auth_without_registry_goes_to_every_registry(
+    fake_opensandbox_sdk: None, fake_image_models: None
+) -> None:
+    options = {"image_auth": {"username": "user", "password": TEST_REGISTRY_PASSWORD}}
+    provider = opensandbox_provider.OpenSandboxProvider(probe={"command": None})
+    await provider.create(SandboxSpec(image="python:3.12-slim", provider_options=options))
+    assert FakeSandbox.created_kwargs["image"].auth.username == "user"
+
+
+@pytest.mark.parametrize(
+    "image, registry",
+    [
+        ("python:3.12-slim", "docker.io"),
+        ("library/python", "docker.io"),
+        ("docker.io/library/python:3.12", "docker.io"),
+        ("localhost/repo:tag", "localhost"),
+        ("localhost:5000/repo", "localhost:5000"),
+        ("Registry.Example/repo@sha256:abc", "registry.example"),
+    ],
+)
+def test_image_registry(image: str, registry: str) -> None:
+    assert opensandbox_provider._image_registry(image) == registry
+
+
+def test_provider_options_image_auth_registry(tmp_path: Path) -> None:
+    options_cls = opensandbox_provider.OpenSandboxProviderOptions
+    cred = tmp_path / "cred"
+    cred.write_text(f"{ROBOT_NAME}:{ROBOT_PASSWORD}\n")
+    parsed = options_cls.from_mapping({"image_auth_file": str(cred), "image_auth_registry": "rl-registry.example"})
+    assert parsed.image_auth_registry == "rl-registry.example"
+    assert ROBOT_PASSWORD not in repr(parsed)
+
+    with pytest.raises(ValueError, match="needs image_auth or image_auth_file"):
+        options_cls.from_mapping({"image_auth_registry": "rl-registry.example"})
+    for bad in ("", "rl-registry.example/project", 5):
+        with pytest.raises(TypeError, match="registry host"):
+            options_cls.from_mapping({"image_auth_file": str(cred), "image_auth_registry": bad})
-- 
