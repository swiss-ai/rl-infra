diff --git a/nemo_gym/token_id_capture/staging/terminal.py b/nemo_gym/token_id_capture/staging/terminal.py
index bc66fe73..7488860e 100644
--- a/nemo_gym/token_id_capture/staging/terminal.py
+++ b/nemo_gym/token_id_capture/staging/terminal.py
@@ -99,7 +99,14 @@ def select_terminal_call(records: Sequence[CallRecord]) -> TerminalSelection:
 
     def survivors(candidates: list[CallRecord]) -> list[CallRecord]:
         extended = [record for record in candidates if children.get(record.model_call_id)]
-        return extended or candidates
+        if extended:
+            return extended
+        # A harness that drops an empty reply and re-sends the request leaves the
+        # empty call as a childless sibling of the continuation. Prefer the
+        # sibling that produced visible text or a tool call; two non-empty
+        # siblings remain ambiguous.
+        non_empty = [record for record in candidates if not record.empty_reply]
+        return non_empty or candidates
 
     root_pool = survivors(roots)
     node = min(root_pool, key=key)
