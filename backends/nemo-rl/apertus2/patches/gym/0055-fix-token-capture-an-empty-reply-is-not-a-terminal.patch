+"""An empty reply is not a terminal answer; its continuation sibling is."""
+
+from nemo_gym.token_id_capture.records import response_items_have_output
+
+
+def test_reasoning_only_reply_is_empty():
+    assert not response_items_have_output(
+        [{"type": "reasoning", "summary": [{"type": "summary_text", "text": "thinking"}]}]
+    )
+
+
+def test_empty_text_reply_is_empty():
+    assert not response_items_have_output(
+        [{"type": "message", "role": "assistant", "content": [{"type": "text", "text": ""}]}]
+    )
+
+
+def test_visible_text_is_output():
+    assert response_items_have_output(
+        [{"type": "message", "role": "assistant", "content": [{"type": "text", "text": "Done."}]}]
+    )
+
+
+def test_tool_call_is_output():
+    assert response_items_have_output(
+        [{"type": "message", "role": "assistant", "content": [{"type": "tool_use", "id": "t1", "name": "Bash"}]}]
+    )
+    assert response_items_have_output([{"type": "function_call", "name": "Bash", "arguments": "{}"}])
