diff --git a/nemo_gym/token_id_capture/records.py b/nemo_gym/token_id_capture/records.py
index 09dd072a..3e7acc84 100644
--- a/nemo_gym/token_id_capture/records.py
+++ b/nemo_gym/token_id_capture/records.py
@@ -300,6 +300,36 @@ def response_to_output_items(payload: dict) -> list[dict]:
     return items
 
 
+def response_items_have_output(items: list[dict]) -> bool:
+    """Whether normalized response items carry visible text or a tool call.
+
+    A reply of reasoning alone, or one whose only text block is empty, is an
+    empty turn: a harness that drops it and sends its request again leaves the
+    dropped call as a dead sibling of the continuation. Terminal selection uses
+    this to prefer the sibling that actually produced output.
+    """
+    for item in items or []:
+        if not isinstance(item, dict):
+            continue
+        item_type = item.get("type")
+        if item_type in {"function_call", "custom_tool_call", "computer_call"}:
+            return True
+        if item_type != "message":
+            continue
+        content = item.get("content")
+        if isinstance(content, str) and content.strip():
+            return True
+        for block in content or []:
+            if not isinstance(block, dict):
+                continue
+            block_type = block.get("type")
+            if block_type in {"tool_use", "function_call", "custom_tool_call", "computer_call"}:
+                return True
+            if block_type in {"output_text", "text"} and str(block.get("text") or "").strip():
+                return True
+    return False
+
+
 def strip_token_fields(items: list[dict]) -> tuple[list[dict], int | None]:
     """Drop the token arrays from output items, keeping the content.
 
