@@ -81,6 +83,27 @@ def test_two_abandoned_siblings_under_the_last_fork_are_ambiguous():
     assert select_terminal_call(rows) == TerminalSelection(None, "ambiguous_terminal")
 
 
+def test_empty_reply_sibling_loses_to_the_continuation():
+    # Claude Code after an empty max_tokens reply: it drops the reply and re-sends
+    # the request, which leaves both calls under the same parent. The empty call
+    # is not a terminal answer; the continuation is.
+    rows = [
+        _row("c1", admitted_at=100.0),
+        _row("c2-empty", parent_call_id="c1", prev_len=10, admitted_at=101.0, empty_reply=True),
+        _row("c3-continue", parent_call_id="c1", prev_len=10, admitted_at=102.0),
+    ]
+    assert select_terminal_call(rows) == TerminalSelection("c3-continue", "selected")
+
+
+def test_two_non_empty_siblings_stay_ambiguous():
+    rows = [
+        _row("c1", admitted_at=100.0),
+        _row("c2-a", parent_call_id="c1", prev_len=10, admitted_at=101.0),
+        _row("c2-b", parent_call_id="c1", prev_len=10, admitted_at=102.0),
+    ]
+    assert select_terminal_call(rows) == TerminalSelection(None, "ambiguous_terminal")
+
+
 def test_two_roots_earliest_admission_wins():
     main = _chain("m1", "m2", start_at=100.0)
     aux = _chain("a1", "a2", start_at=200.0)
