# NeMo-RL source for the Apertus 2 stack. Same recipe as the Chonk example in
# eth-cscs/alps-extended-images#64 (Andres Nowak): the swiss-ai fork at a fixed commit with
# three PRs merged on top, which is the combination that runs with that image's vLLM 0.28
# Apertus2 fork. Our Alps ray.sub patch (../patches/) goes on top of that.
NEMO_RL_URL=https://github.com/swiss-ai/Nemo-RL.git
NEMO_RL_COMMIT=f196ef0a1ccb54d6ce71cd63277fb6a0e01168db
NEMO_RL_BRANCH=apertus2
# "<repo> <pr> [<commit>]" lines, merged in this order. #2517 (vLLM DP path for EP) is merged with
# -Xtheirs and the fork's tests/unit/test_recipes_and_test_suites.py kept, as in the example.
# A line with a commit merges that commit instead of the PR head, and setup.sh also merges it
# into an existing clone that lacks it. #8 is the Megatron trainer's FP8 expert-cache fix.
# #2517 is pinned at 05db6ab36 (2026-05-29): its later head (1c42be6aa, 2026-10-23) makes #8
# conflict in nemo_rl/models/policy/workers/megatron_policy_worker.py.
NEMO_RL_PRS="swiss-ai/Nemo-RL 5 fe7e3fe71c80c1630487c09a7d49a27e27a3b71e
swiss-ai/Nemo-RL 1 40a766b21dcfc65c9548fd0cc1ff02869c585869
NVIDIA-NeMo/RL 2517 05db6ab36b7a0c528c178cbeb44903dbe82fda5d
swiss-ai/Nemo-RL 8 19843e5a523254ebf3bed49a47a1e852dca29a70"
# The DTensor (HF) trainer imports nemo_automodel; the image does not ship it, so the clone's
# submodule (this commit, the fork's pin) goes on PYTHONPATH instead.
AUTOMODEL_COMMIT=72daceffa54d77783e1f73a5ac165eb39b6b5ea1
# The Megatron trainer imports Megatron-Core and Megatron-Bridge, which the image does not ship
# either; same sources as the Megatron examples of alps-extended-images#64. Megatron-LM-MoE at
# the head of PR #88 (port of the fork to current NeMo-RL/Bridge), Bridge at the head of PR #5
# (Apertus2 provider and checkpoint conversion).
MEGATRON_URL=https://github.com/swiss-ai/Megatron-LM-MoE.git
MEGATRON_COMMIT=0536034901962160aac9742d134a84c55e28d224
MEGATRON_REF=pull/88/head
BRIDGE_URL=https://github.com/swiss-ai/Megatron-Bridge.git
BRIDGE_COMMIT=6ccdb3c369491374f1fef4320886e8bb1394bb3e
BRIDGE_REF=pull/5/head
# The image's vLLM (swiss-ai/vllm d4d41485) predates swiss-ai/vllm#24: DP dummy steps during an
# in-flight weight update wrote KDA state into live requests' KV blocks, which gave NaN logprobs.
# The runner at the merge commit is the image's one plus that fix; the EDF mounts it over it.
VLLM_RUNNER_URL=https://raw.githubusercontent.com/swiss-ai/vllm/b5161a48e6946d96f499c8b019d0d8020223a02b/vllm/v1/worker/gpu_model_runner.py
VLLM_RUNNER_BLOB=4ec55eef55352090b50a255ee021cbe41daae06f
