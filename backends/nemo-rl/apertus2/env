# Apertus 2 stack: overrides of the stock backends/nemo-rl/env, loaded by sites/load.sh after the
# cluster profile (sites/<SITE>.env, which supplies SCRATCH, PROJECTS_DIR and the APERTUS2_*
# image masters) and before the stock stack. Same rule everywhere: a variable already set wins.
# Requires APERTUS2_DIR (this directory).

: "${NEMO_RL_DIR:=${PROJECTS_DIR}/nemo-rl-apertus2}"
: "${MEGATRON_DIR:=${PROJECTS_DIR}/megatron-lm-moe-apertus2}"
: "${BRIDGE_DIR:=${PROJECTS_DIR}/megatron-bridge-apertus2}"
: "${VLLM_RUNNER:=${NEMO_RL_DIR}-vllm/gpu_model_runner.py}"
: "${VLLM_APERTUS2:=${NEMO_RL_DIR}-vllm/apertus2.py}"
: "${PIN_FILE:=${APERTUS2_DIR}/pin}"
: "${CONTAINER_SPEC:=${APERTUS2_DIR}/edf.toml.template}"
: "${EDF_NAME:=nemo-rl-apertus2}"
# The image has no /opt/nemo_rl_venv; driver.sh runs the image's system Python.
: "${DRIVER_PYTHON:=bash ${APERTUS2_DIR}/driver.sh}"
# Runtime overlay on PYTHONPATH (driver.sh installs it when missing).
: "${PYDEPS:=${SCRATCH}/nemo-rl-apertus2/pydeps}"

# NeMo-RL image of alps-extended-images#64 at the digest its Chonk example uses (built
# 2026-10-07, tag alps7-dev-cfcfede4...); Megatron, Apertus2 kernels and the vLLM 0.28 fork.
# Jobs do not run it directly: uccl-fix/build_image.sh builds the image below from it.
# An empty APERTUS2_REGISTRY (sites without access to it) leaves the refs empty: nothing is imported.
: "${IMAGE_REF:=${APERTUS2_REGISTRY:+${APERTUS2_REGISTRY}/nemo-rl-cuda@sha256:6dc3748ee1e86d4eefe2265083a4a69d33b0e6da6a2f776743962c94421ab386}}"
: "${BASE_IMAGE_MASTER:=${APERTUS2_BASE_IMAGE_MASTER:-}}"
: "${BASE_IMAGE_WORK:=${SCRATCH}/container-images/nemo-rl-apertus2-cfcfede4.sqsh}"
# The image jobs run: the one above with UCCL rebuilt with patches/uccl (uccl-project/uccl#1085,
# illegal memory accesses in EP combine). It is not in JFrog; the master is its backup. A site
# may run it from the master in place (APERTUS2_IMAGE_WORK = APERTUS2_IMAGE_MASTER).
: "${IMAGE_MASTER:=${APERTUS2_IMAGE_MASTER:-}}"
: "${IMAGE_WORK:=${APERTUS2_IMAGE_WORK:-${SCRATCH}/container-images/nemo-rl-apertus2-cfcfede4-ucclfix.sqsh}}"

# Standalone Apertus2 vLLM image (alps-extended-images#67) for serving tests outside NeMo-RL.
: "${VLLM_IMAGE_REF:=${APERTUS2_REGISTRY:+${APERTUS2_REGISTRY}/vllm-apertus2-cuda@sha256:2daf3b1906ab62291c00b6a78d9eaa8aa85aad792abffb6695dc89ce9dcc9e05}}"
: "${VLLM_IMAGE_MASTER:=${APERTUS2_VLLM_IMAGE_MASTER:-}}"
: "${VLLM_IMAGE_WORK:=${SCRATCH}/container-images/vllm-apertus2-2daf3b19.sqsh}"
