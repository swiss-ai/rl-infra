# CSCS Alps (Clariden): 4x GH200 per node, Slingshot, CSCS Container Engine (EDF).
# Loaded by sites/load.sh; a variable already set (environment, site.env) wins.

# Slurm
: "${ACCOUNT:=infra01}"
: "${DEFAULT_PARTITION:=normal}"
# run.sh's partition: long jobs go to the preemptable queue and are requeued.
: "${RUN_PARTITION:=preemptable}"
: "${GPUS_PER_NODE:=4}"
# Extra sbatch flags for every job (space-separated, no spaces inside a flag).
: "${SBATCH_EXTRA=}"
# Comma-separated nodes to keep out of every job; set EXCLUDE_NODES= at launch for none.
: "${EXCLUDE_NODES=}"

# Filesystems. SCRATCH holds everything jobs write (logs, checkpoints, caches) and is purged;
# PROJECTS_DIR holds the source clones; SITE_MOUNTS are mounted into the container as is.
: "${SCRATCH:=/iopsstor/scratch/cscs/${USER}}"
: "${PROJECTS_DIR:=/users/${USER}/projects}"
SITE_MOUNTS=(/iopsstor /users /capstor)

# Containers: EDF files in ~/.edf, rendered by setup.sh from the stack's edf.toml.template.
: "${CONTAINER_RUNTIME:=edf}"
# Network settings come from the EDF (hooks and [env]); nothing extra here.
SITE_ENV=()

# Persistent copies (not purged) that the scratch working copies are staged from.
: "${STORE:=/capstor/store/cscs/swissai/infra01}"
: "${NEMO_RL_IMAGE_MASTER:=${STORE}/MLLM/containers/nvcr.io#nvidia+nemo-rl+v0.7.0.aarch64.sqsh}"
: "${APERTUS2_BASE_IMAGE_MASTER:=${STORE}/MLLM/containers/jfrog.svc.cscs.ch#alps-images+nemo-rl-cuda+alps7-dev-cfcfede4.aarch64.sqsh}"
: "${APERTUS2_IMAGE_MASTER:=${STORE}/MLLM/containers/nemo-rl-apertus2-cfcfede4-ucclfix.aarch64.sqsh}"
: "${APERTUS2_VLLM_IMAGE_MASTER:=${STORE}/MLLM/containers/jfrog.svc.cscs.ch#alps-images+vllm-apertus2-cuda+2daf3b19.aarch64.sqsh}"
# The JFrog registry the Apertus 2 base images are imported from when a master is missing.
: "${APERTUS2_REGISTRY:=jfrog.svc.cscs.ch#docker-group-csstaff/alps-images}"
# Chonk HF export; experiments/grpo-chonk/stage_model.sh copies it to scratch.
: "${CHONK_MODEL_SRC:=${STORE}/apertus_checkpoints/v2/hf/chonk/pretraining/long_context/long-context-iter-0003576}"
: "${CHONK_MODEL_STAGE:=copy}"
