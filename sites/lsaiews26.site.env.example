# Settings for the LSAIE course accounts on CSCS Alps (project lsaiews26). Copy to site.env in the repository root:
#   cp sites/lsaiews26.site.env.example site.env
# The course accounts cannot read the infra01 store of sites/alps.env; the course keeps its own copy of the
# Apertus 2 NeMo-RL image (ucclfix), read-only, which jobs run in place: no 28 GB copy into each scratch.

: "${ACCOUNT:=lsaiews26}"
: "${DEFAULT_PARTITION:=normal}"
: "${RUN_PARTITION:=normal}"

: "${APERTUS2_IMAGE_MASTER:=/capstor/store/cscs/ethz/lsaiews26/containers/nemo-rl-apertus2-cfcfede4-ucclfix.aarch64.sqsh}"
: "${APERTUS2_IMAGE_WORK:=${APERTUS2_IMAGE_MASTER}}"

# Weights & Biases for full runs (debug runs need none): your own entity, the key in ~/.wandb_api_key (chmod 600).
# : "${WANDB_ENTITY:=your_wandb_user_or_team}"
# : "${WANDB_PROJECT:=apertus-v11}"
